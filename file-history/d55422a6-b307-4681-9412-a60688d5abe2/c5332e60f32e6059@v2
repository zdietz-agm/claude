#%% Step 5: Summary table — avg & median return by imbal bucket
def summary_row(label, df):
    if len(df) == 0:
        return dict(bucket=label, n=0, avg_bps=np.nan, median_bps=np.nan,
                    avg_imbal_m=np.nan, n_up=0, n_down=0, n_flat=0)
    return dict(
        bucket=label,
        n=len(df),
        avg_bps=df["return_bps"].mean(),
        median_bps=df["return_bps"].median(),
        win_rate_buying_pct=(df["return_bps"] > 0).mean() * 100,
        avg_twap_bps=df["return_twap_bps"].mean(),
        median_twap_bps=df["return_twap_bps"].median(),
        win_rate_twap_pct=(df["return_twap_bps"] > 0).mean() * 100,
        avg_imbal_m=df["spy_exchange_net_imbalance"].mean() / 1e6,
        n_up=(df["market_type"] == "Up").sum(),
        n_down=(df["market_type"] == "Down").sum(),
        n_flat=(df["market_type"] == "Flat").sum(),
    )

ana_valid = ana.dropna(subset=["return_bps", "spy_exchange_net_imbalance"]).copy()

