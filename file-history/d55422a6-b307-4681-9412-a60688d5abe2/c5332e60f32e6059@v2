#%% Helper Functions
def get_vbam_engine(db):
    """Create VBAM DB engine for given schema."""
    return create_engine(f'mysql+pymysql://{VBAM_USER}:{VBAM_PASS}@{VBAM_HOST}/{db}')

def parse_date(s):
    """Convert 'YYYY-MM-DD' string to date."""
    return dt.datetime.strptime(s, "%Y-%m-%d").date()

def classify_market_type(market_ratio):
    """Up if > 0.5, Down if < -0.5, else Flat."""
    if pd.isna(market_ratio):
        return None
    if market_ratio > 0.5:
        return "Up"
    if market_ratio < -0.5:
        return "Down"
    return "Flat"

