												abs_chg_stats=helpers.ABS_CHG_IMBAL_STATS_355PM,  # intentionally-low 355 set (see helpers.py)
												is_test=IS_TEST,
												puts_size_mult=_puts_mult_355,
												calls_size_mult=_calls_mult_355,
												)
	print(f"{pretty_time()} -- Finished prep_trades() 355PM")

	# _____________________________________________________________Resize Trades_____________________________________________________________
	# 355pm-specific: when a CLOSER variant trades, decrement its parent's size by the CLOSER's size.
	# Parent floors at 1 lot. Defined in helpers.apply_closer_resize so simulate_prod.py
	# can call the exact same function (no copy-paste drift).
	# Runs BEFORE apply_size_limits so the loss-cap sees post-resize sizes.
	apply_closer_resize(trade_dict, log_fn=lambda msg: print(f"{pretty_time()} -- {msg}"))

	# Apply size limits (loss-cap pro-rata) -- AFTER apply_closer_resize so resizes are reflected.
	try:
		from position_logging_helper import apply_size_limits
		print(f"{pretty_time()} -- Starting size limit check (355PM)")
		apply_size_limits(trade_dict, is_test=IS_TEST, explanations_dict=explanations_dict, max_loss_cap=MAX_LOSS_CAP_355)  # v7 cap: pipeline runs at v7 sizing until the V8 RESIZING SECTION
		print(f"{pretty_time()} -- Finished size limit check (355PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in size limit check (355PM): {e}")

	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	#~~~~~~~~~~~~~~~~~~~~~~~~~~ V8 RESIZING SECTION (TEMPORARY) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	# The ONLY place sizes are scaled for the v8 parallel run. Everything upstream (prep_trades,
	# apply_closer_resize, loss caps) ran at exact v7 sizing; every trade_dict entry is scaled
	# here in one pass, immediately before the send. v7_unscaled_size is audit-only; nothing may
	# consume it.
	# NOTE: hacker trades are deliberately NOT touched by this pattern -- they fire during the
	# send (after this section) and derive from already-scaled 350PM_V8 fills; scaling them
	# again would double-scale.
	# DECOMMISSION (when the v7 scripts retire): delete this whole section; sizing is then
	# byte-identical to v7. Nothing else in this script scales sizes.
	print("_" * 66)
	print(f"Applying V8_SIZE_RATIO = {V8_SIZE_RATIO:.2f}")
	for _t in trade_dict["trades"]:
		if _t.get("size", 0) > 0:
			_t["v7_unscaled_size"] = _t["size"]
			_t["size"] = max(1, int(_t["size"] * V8_SIZE_RATIO))
			print(f"{_t['name']}: {_t['v7_unscaled_size']} --> {_t['size']}")
	print("_" * 66)
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ END V8 RESIZING SECTION ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

	# _____________________________________________________________Send Trades_____________________________________________________________
	# V8 account swap. IS_TEST -> everything to the v8 test account (T.AGM* only exists on v7).
	# Prod -> V8_ACCOUNT_MAP; an unmapped account (shouldn't happen -- startup assert covers
	# configs, and 355 has no bumped/closer/extra modules) gets the next free EOD slot with a
	# LOUD warning. Hard assert: no order may leave this script on a non-v8 account.
	if IS_TEST:
		for trade in trade_dict["trades"]:
			trade["account"] = "T.AGMV8.01"
	else:
		_used_slots = {int(v[3:-4]) for v in V8_ACCOUNT_MAP.values()}
		for trade in trade_dict["trades"]:
			_acct = trade["account"]
			if _acct not in V8_ACCOUNT_MAP:
				_free = next((n for n in range(_V8_ACCT_FLOOR, _V8_ACCT_CEIL + 1) if n not in _used_slots), None)
				if _free is None:
					raise AssertionError(f"[V8] no free v8 account slot for unmapped '{_acct}'")
				V8_ACCOUNT_MAP[_acct] = f"EOD{_free}_C42"
				_used_slots.add(_free)
				print(f"{'!' * 10} [V8] account '{_acct}' was NOT in the static map; assigned "
				      f"{V8_ACCOUNT_MAP[_acct]} on the fly -- ADD IT to V8_ACCOUNT_MAP + "
				      f"get_spdr_execs.py {'!' * 10}")
			trade["account"] = V8_ACCOUNT_MAP[_acct]
		for trade in trade_dict["trades"]:
			assert trade["account"].startswith("EOD") and trade["account"].endswith("_C42") and \
				_V8_ACCT_FLOOR <= int(trade["account"][3:-4]) <= _V8_ACCT_CEIL, \
				f"[V8] account '{trade['account']}' outside EOD{_V8_ACCT_FLOOR}-{_V8_ACCT_CEIL}_C42"

	print(f"{pretty_time()} -- Starting orchestrate_batched_send() 355PM (+ fire_hackers concurrently)")
	if SEND_TRADES:
