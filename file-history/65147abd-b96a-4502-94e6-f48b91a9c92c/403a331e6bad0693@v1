	factor_dict["factor_market_type"] = 1 if market_355 == "UP" else -1 if market_355 == "DOWN" else 0

	# _____________________________________________________________Poll 355PM SPX Imbalance_____________________________________________________________

	# Gate to 3:55:01. Nasdaq published imbal at 3:55:00.000, DB replication lag pushes visibility to ~3:55:01
	wait_until(_v8_gate(8 if IS_TEST else LAST_HOUR, 55, 1), poll_interval=0.05)  # (+V8_GATE_DELAY_S)

	print(f"{pretty_time()} -- Starting get_355_imbal('.SPX')")
	imbal_355 = get_355_imbal(is_test=IS_TEST, test_imbal=TEST_355PM_IMBAL, basket_name='.SPX', sleep_between=0.1, max_attempts=40)
	print(f"{pretty_time()} -- SPX 355PM imbal: {imbal_355 / 1e9:.2f}B" if imbal_355 != NO_IMBAL_VAL else f"{pretty_time()} -- SPX 355PM imbal: NOT FOUND")

	# NDX 355PM imbal - uncomment when adding NDX confirmation factors
	# print(f"{pretty_time()} -- Starting get_355_imbal('.NDX')")
	# ndx_imbal_355 = get_355_imbal(is_test=IS_TEST, test_imbal=TEST_355PM_NDX_IMBAL, basket_name='.NDX')
	# print(f"{pretty_time()} -- NDX 355PM imbal: {ndx_imbal_355 / 1e9:.2f}B" if ndx_imbal_355 != NO_IMBAL_VAL else f"{pretty_time()} -- NDX 355PM imbal: NOT FOUND")
	ndx_imbal_355 = None

	if imbal_355 == NO_IMBAL_VAL:
