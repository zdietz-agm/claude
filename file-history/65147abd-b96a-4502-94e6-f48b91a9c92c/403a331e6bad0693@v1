# --- V8 gate delay -----------------------------------------------------------------------------
# EVERY wait-gate in this script fires this many seconds AFTER the corresponding v7 gate, so the
# two simultaneous processes never hit shared resources on the same tick. 0.0 -> identical timing
# to 355pm_script.py. TEMPORARY for the parallel-run period.
V8_GATE_DELAY_S = 0.0

def _v8_gate(h, m, s, us=0):
	"""The v7 gate time (pass v7's exact h/m/s/us) shifted by V8_GATE_DELAY_S."""
	base = dt.datetime.combine(dt.date.today(), dt.time(h, m, s, us))
	return (base + dt.timedelta(seconds=V8_GATE_DELAY_S)).time()

