		# ~100ms so orchestrator's wave-1 hits SR first, then fire during orchestrator's
		# Phase-3 3s sleep. Wall-time added by hackers: 0s (they fit inside orchestrator's
		# ~3-4s window). Hackers append themselves to trade_dict so log_trades sees them.
		async def _fire_all_355():
			tasks = [orchestrate_batched_send(
				trade_dict, orderDuration=30,
				srtrade_pool=srtrade_pool_355,
				sranalytics_pool=sranalytics_pool_355,
			)]
			if HACKING_350_ENABLED and hacker_fills:
				tasks.append(fire_hackers(
					trade_dict=trade_dict,
					hacker_fills=hacker_fills,
					factor_355_imbal_less_than_neg_950m=factor_dict.get("factor_355_imbal_less_than_neg_950m", 0),
					factor_355_imbal_greater_than_950m=factor_dict.get("factor_355_imbal_greater_than_950m", 0),
					today=today, is_test=IS_TEST,
					delay_start_seconds=0.05,   # 50ms head start for orchestrator wave-1 -- sranalytics SELECT adds another ~20-50ms of implicit buffer
					log_fn=lambda msg: print(f"{pretty_time()} -- [hacker] {msg}"),
					# Regime inputs for the floored 355-methodology edge blend (same set 355PM uses).
					vix=vix, atm_vol_0dte=today_vol, abs_imbal=abs(imbal_355), abs_chg_imbal=abs_chg_imbal,
				))
			await asyncio.gather(*tasks, return_exceptions=True)
		asyncio.run(_fire_all_355())
	print(f"{pretty_time()} -- Finished orchestrate_batched_send() 355PM (+ hackers)")

	# Log net option positions
	try:
		from position_logging_helper import log_positions
		print(f"{pretty_time()} -- Starting position logging (355PM)")
		log_positions(trade_dict, script_name="355PM_V8", is_test=IS_TEST)
		print(f"{pretty_time()} -- Finished position logging (355PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in position logging (355PM): {e}")

	# _____________________________________________________________Summary_____________________________________________________________

	summary += f"SPX: {spx:,.2f}. 350PM Imbal: {imbal_350:,.0f}. 355PM Imbal: {imbal_355:,.0f}.\n"
	summary += f"Market at 3:55: {market_355}.\n"
	summary += f"SPY 3:40-3:50: {spy_chg_1540_1550_bps:.1f}bps. SPY 3:50-3:55: {spy_chg_1550_1555_bps:.1f}bps.\n"
	if ndx_imbal_355 is not None:
		summary += f"NDX 355PM Imbal: {ndx_imbal_355 / 1e9:.2f}B.\n"
	else:
		summary += "NDX 355PM Imbal: N/A.\n"
	summary += f"Today's Vol: {today_vol:.3f}.\n"
	summary += f"Regime inputs: VIX={vix:.2f}, atmVol={today_vol:.3f}, absImbal={abs(imbal_355)/1e9:.2f}B.\n"

	summary_dict = {}

	for trade, trade_type in zip(trade_dict["trades"], trade_dict["trade_types"]):
		if not trade["name"] in summary_dict:
			summary_dict[trade["name"]] = f"""\n*{trade["name"]}* ({trade["account"]}):\n"""
		if trade_type == "complex":
			if trade["direction"] == "Sell":
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["short_legs"][0].okey_xx} {trade["long_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""
			else:
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["long_legs"][0].okey_xx} {trade["short_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""
		else:
			summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["option"].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""

	for single_algo_summary in summary_dict.values():
		summary += single_algo_summary

	summary += "\n*Explanations:*"
	for algo_name, explanations in explanations_dict.items():
		summary += f"""\n{algo_name}:\n"""
		summary += explanations["put"]
		summary += explanations["call"]

	#~~~~~~~~~~~~~~~~~~~~~~~~~~ V8 FEATURES RECAP (helpers_v8) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	# LOG ONLY (not added to the chat summary): F2 spot-vs-uPrc line (+ any fallback) and one line
	# per order/wave (hackers included): chunks, sprc/smrk/anchor, limit sent vs the v7 limit.
	print(_hv8.format_v8_recap(_v8_chain_info))
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

	# Prepend any loud send-phase warnings (wave-1 not confirmed terminal -> hedged wave-2 from the
	# orchestrator; FULL-SIZE-NOT-SENT 4-order-cap drops from trade_complex) so they sit at the TOP.
	_warns = (trade_dict.get("send_warnings") or []) + drain_send_warnings()
	_warn_block = ("\n".join(_warns) + "\n\n") if _warns else ""
	print(summary)
	send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + _warn_block + summary, my_chat)

	# Log per-algo trade attempts to optionsResearch.algo_trade_log (60s wait for SR fills to settle).
	# Wrapped in try/except so logging failure never affects trading (trading is already done at this point).
	# Skipped entirely in test mode -- we don't want test trades polluting the prod log table.
	# Note: 355PM doesn't capture rsi / high_low / 3m_realized_chg / qqq_imbal / paired_imbal -> logged NULL.
	if IS_TEST:
		print(f"{pretty_time()} -- algo_trade_logger SKIPPED (IS_TEST=True)")
	else:
		try:
			from algo_trade_logger import log_trades
			factors_for_log = {
				"spx_price":       float(spx) if spx is not None else None,
				"vix":             float(vix) if vix is not None else None,
				"atm_vol":         float(today_vol) if today_vol is not None else None,
				"market_ratio":    float(today_move_355 / std_355) if std_355 else None,
				"rsi":             None,
				"high_low_ratio":  None,
				"realized_3m_chg": None,
				"imbal_340":       None,
				"imbal_350":       int(imbal_350) if (not isinstance(imbal_350, str) and imbal_350 is not None) else None,
				"imbal_355":       int(imbal_355) if (not isinstance(imbal_355, str) and imbal_355 is not None) else None,
				"qqq_imbal":       None,
				"paired_imbal":    None,
			}
			print(f"{pretty_time()} -- Starting algo_trade_logger (60s wait for SR fills)")
			log_trades(trade_dict, factors_for_log, wait_seconds=60, script_name="355PM_V8")
			print(f"{pretty_time()} -- Finished algo_trade_logger")
			# Second pass for wave-3 resting hackers (fills can land up to 16:00, after the
			# 60s snapshot above). Fast no-op on non-hack days; sleeps to ~16:00:30 otherwise.
			from hacker_trades import refresh_hacker_fills
			refresh_hacker_fills(trade_dict, factors_for_log, script_name="355PM_V8",
			                     log_fn=lambda msg: print(f"{pretty_time()} -- [hacker] {msg}"))
		except Exception as _log_e:
			print(f"{pretty_time()} -- ERROR in algo_trade_logger (non-fatal): {_log_e}")
			traceback.print_exc()

	if srtrade_pool_355 is not None:     srtrade_pool_355.close()
	if sranalytics_pool_355 is not None: sranalytics_pool_355.close()
