	abs_chg_imbal = None
	if (isinstance(imbal_350, (int, float)) and isinstance(imbal_355, (int, float))
	    and imbal_350 != NO_IMBAL_VAL and imbal_355 != NO_IMBAL_VAL):
		abs_chg_imbal = abs(imbal_355 - imbal_350)
	_chg_str = f"{abs_chg_imbal/1e9:.2f}B" if abs_chg_imbal is not None else "None"
	print(f"{pretty_time()} -- Regime edge inputs: VIX={vix:.2f}, atmVol={today_vol:.3f}, absImbal={abs(imbal_355)/1e9:.2f}B, absChgImbal={_chg_str}")
	# Live-reload SIZE_MULT_355_PUTS/CALLS from algo_globals so mid-run edits take effect.
	from algo_globals import get_live_size_mults
	_puts_mult_355, _calls_mult_355 = get_live_size_mults("355")
	print(f"{pretty_time()} -- Live size mults (355): puts={_puts_mult_355}, calls={_calls_mult_355}")
	trade_dict, explanations_dict = prep_trades(configs=configs,
												factor_dict=factor_dict,
												option_chains=option_chains,
												today=today,
												trigger_all=TRIGGER_ALL,
