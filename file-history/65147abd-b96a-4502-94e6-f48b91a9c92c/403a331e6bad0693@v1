	factor_dict["factor_spy_chg_1550_1555_gt_12bps"] = 1 if spy_chg_1550_1555_bps > 12 else 0
	factor_dict["factor_spy_chg_1550_1555_gt_8bps"] = 1 if spy_chg_1550_1555_bps > 8 else 0
	factor_dict["factor_spy_chg_1540_1550_lt_neg7bps"] = 1 if spy_chg_1540_1550_bps < -7 else 0

