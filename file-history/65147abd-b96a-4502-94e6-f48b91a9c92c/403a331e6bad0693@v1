	if _v8_chain_info is None:
		calls = run_query(get_closest_and_slightly_itm_calls_sql, verbose=True, tag="refresh355_calls")
		puts = run_query(get_closest_and_slightly_itm_puts_sql, verbose=True, tag="refresh355_puts")
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	spx = puts.uprc[0]
	# Log each side's own uprc and its nearest-to-ATM strike: the ITM window in these SQLs
	# gates on each ROW's own uprc, not on the puts.uprc[0] used as spot downstream, so when
	# the two diverge the CLOSER (msd=-1) can silently lose its near-ATM strike (observed
	# 8/24/26 on v8: puts uprc 7655.83 but 7655C absent -> CLOSER landed on its parent's
	# 7660/7665). Highest put / lowest call returned make that visible per side.
	calls_uprc = calls.uprc[0] if len(calls) else float("nan")
	lowest_call = calls.okey_xx[0] if len(calls) else float("nan")
	highest_put = puts.okey_xx[0] if len(puts) else float("nan")
	print(f"{pretty_time()} -- Finished refreshing. SPX: {spx:,.2f} (puts uprc, highest put "
		  f"strike returned: {highest_put:,.0f}); calls uprc: {calls_uprc:,.2f}, lowest call "
		  f"strike returned: {lowest_call:,.0f}")

