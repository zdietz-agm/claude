	# 355PM imbal factors
	factor_dict["factor_355_imbal_greater_than_0"] = 1 if imbal_355 > 0 else 0
	factor_dict["factor_355_imbal_less_than_0"] = 1 if imbal_355 < 0 else 0
	factor_dict["factor_355_imbal_greater_than_1b"] = 1 if imbal_355 > 1e9 else 0
	factor_dict["factor_355_imbal_less_than_neg_1B"] = 1 if imbal_355 < -1e9 else 0
	# Hacker-gate-only factors (8/21/26): 950M = 1B minus a live-vs-T+1 jitter buffer.
