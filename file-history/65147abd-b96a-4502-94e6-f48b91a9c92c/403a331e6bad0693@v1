	factor_dict["factor_355_imbal_greater_than_950m"] = 1 if imbal_355 > 0.95e9 else 0
	factor_dict["factor_355_imbal_less_than_neg_950m"] = 1 if imbal_355 < -0.95e9 else 0
	factor_dict["factor_355_imbal_less_than_minus_1p5b"] = 1 if imbal_355 < -1.5e9 else 0
	factor_dict["factor_355_imbal_greater_than_1p5B"] = 1 if imbal_355 > 1.5e9 else 0
	factor_dict["factor_355_imbal_less_than_500M"] = 1 if imbal_355 < 0.5e9 else 0
	factor_dict["factor_355_imbal_greater_than_neg_500M"] = 1 if imbal_355 > -0.5e9 else 0

