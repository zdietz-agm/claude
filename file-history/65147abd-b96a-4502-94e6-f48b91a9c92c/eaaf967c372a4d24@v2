			print(f"{pretty_time()} -- {closer_spread_summary}")
		_closer_ok = True
	except Exception as _closer_e:
		closer_spread_summary = f"ERROR in closer spread trader: {_closer_e} -- rolling back trade_dict"
		print(f"{pretty_time()} -- {closer_spread_summary}")
		try:
			import traceback as _closer_tb
			_closer_tb.print_exc()
		except Exception:
			pass
	finally:
		# Restore trade_dict if CLOSER did NOT complete cleanly. Uses identity-preserving
		# mutation (list slice assignment) so any external references still see the rollback.
		if not _closer_ok and _closer_saved is not None:
			try:
				trade_dict["trades"][:]      = _closer_saved["trades"]
				trade_dict["trade_types"][:] = _closer_saved["trade_types"]
				print(f"{pretty_time()} -- [closer_spread] trade_dict restored from snapshot")
			except Exception as _restore_e:
				# Last-resort: if even the restore fails, log loudly. The pre-CLOSER state is gone;
				# the script will continue with whatever trade_dict currently looks like.
				print(f"{pretty_time()} -- CRITICAL: closer rollback failed: {_restore_e}")

	# Apply size limits (loss-cap pro-rata) -- runs AFTER CLOSER so it sees post-resize strikes/widths.
	# Runs BEFORE bumped spreads (bumped intentionally bypasses the cap, same as prior behavior).
	try:
		from position_logging_helper import apply_size_limits
		print(f"{pretty_time()} -- Starting size limit check (350PM)")
		apply_size_limits(trade_dict, is_test=IS_TEST, explanations_dict=explanations_dict, max_loss_cap=MAX_LOSS_CAP_350)  # v7 cap: pipeline runs at v7 sizing until the V8 RESIZING SECTION
		print(f"{pretty_time()} -- Finished size limit check (350PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in size limit check (350PM): {e}")

	# Bumped spread trades (sell bumped strikes on 1-lot days, low vol only)
	bumped_spread_summary = ""
	try:
		from bumped_spread_trader import get_bumped_spread_trades
		bumped_trades = get_bumped_spread_trades(
			trade_dict=trade_dict, puts=puts, calls=calls,
			today=today, today_vol=today_vol,
			vix=vix, abs_imbal=abs(imbal),
			abs_chg_imbal=abs_chg_imbal_350,
			force_test=FORCE_BUMPED_TEST if (FORCE_BUMPED_TEST and IS_TEST) else False,
			rebal_355_B=rebal_355_B,   # adverse levered-rebal veto (loaded at 3:49:55, ADVERSE LEVERED-REBAL VETO block)
		)
		# Insert each bumped trade IMMEDIATELY BEFORE its parent (inherits parent's send-order
		# priority + fires ahead of the parent's 1-lot residual). Same pattern as CLOSER.
		from helpers import insert_before_parent
		for trade_entry, trade_type, parent_trade in bumped_trades:
			insert_before_parent(trade_dict, trade_entry, trade_type, parent_trade=parent_trade)
		if bumped_trades:
			bumped_spread_summary = f"{len(bumped_trades)} bumped spread(s) added to trade queue"
			print(f"{pretty_time()} -- {bumped_spread_summary}")
	except Exception as e:
		bumped_spread_summary = f"ERROR in bumped spread trader: {e}"
		print(f"{pretty_time()} -- {bumped_spread_summary}")

	# _____________________________________________________________Send Trades_____________________________________________________________
	# 350PM uses the batched orchestrator (script-level batched fill-check + deduped refresh_legs)
	# instead of per-order send_complex_two_waves. Saves ~3-4 seconds during the send phase on
	# multi-order days. Grouping_codes are attached to each trade dict by the orchestrator so
	# downstream position_logging_helper + algo_trade_logger pick them up unchanged.
	# 340PM and 355PM still use send_complex_two_waves (unchanged).
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	#~~~~~~~~~~~~~~~~~~~~~~~~~~ V8 RESIZING SECTION (TEMPORARY) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	# The ONLY place sizes are scaled for the v8 parallel run. Everything upstream (prep_trades,
	# closer, bumped, loss caps) ran at exact v7 sizing; every trade_dict entry -- parents,
	# outrights, closer, bumped -- is scaled here in one pass, immediately before the send.
	# v7_unscaled_size is audit-only; nothing may consume it.
	# extra_spread_trader's ladder never enters trade_dict (it sends its own orders after the
	# orchestrator), so its module SIZE_RATIO is set HERE to keep all resizing in this section.
	# NOTE: 355PM_V8 hacker trades are deliberately NOT touched by this pattern -- they derive
	# from already-scaled 350PM_V8 fills (scaling them again would double-scale).
	# DECOMMISSION (when the v7 scripts retire): delete this whole section; sizing is then
	# byte-identical to v7. Nothing else in this script scales sizes.
	print("_" * 66)
	print(f"Applying V8_SIZE_RATIO = {V8_SIZE_RATIO:.2f}")
	for _t in trade_dict["trades"]:
		if _t.get("size", 0) > 0:
			_t["v7_unscaled_size"] = _t["size"]
			_t["size"] = max(1, int(_t["size"] * V8_SIZE_RATIO))
			print(f"{_t['name']}: {_t['v7_unscaled_size']} --> {_t['size']}")
	_est.SIZE_RATIO = V8_SIZE_RATIO   # extra-spread ladder sizes (scaled inside extra_spread_trader)
	print(f"extra_spread_trader.SIZE_RATIO = {V8_SIZE_RATIO:.2f}")
	print("_" * 66)
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ END V8 RESIZING SECTION ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

	# V8 account swap -- runs AFTER closer/bumped so derived trades (which copy parent accounts)
	# are covered too. IS_TEST -> everything to the v8 test account (T.AGM* only exists on v7).
	# Prod -> V8_ACCOUNT_MAP (EOD41+); an account missing from the map (shouldn't happen -- the map
	# is built from the same configs) gets the next free slot with a LOUD warning. Hard assert at
	# the end: no order may leave this script on a non-v8 account.
	if IS_TEST:
		for trade in trade_dict["trades"]:
			trade["account"] = "T.AGMV8.01"
	else:
		_used_slots = {int(v[3:-4]) for v in V8_ACCOUNT_MAP.values()}
		for trade in trade_dict["trades"]:
			_acct = trade["account"]
			if _acct not in V8_ACCOUNT_MAP:
				_free = next((n for n in range(_V8_ACCT_FLOOR, _V8_ACCT_CEIL + 1) if n not in _used_slots), None)
				if _free is None:
					raise AssertionError(f"[V8] no free v8 account slot for unmapped '{_acct}'")
				V8_ACCOUNT_MAP[_acct] = f"EOD{_free}_C42"
				_used_slots.add(_free)
				print(f"{'!' * 10} [V8] account '{_acct}' was NOT in the static map; assigned "
				      f"{V8_ACCOUNT_MAP[_acct]} on the fly -- ADD IT to V8_ACCOUNT_MAP + "
				      f"get_spdr_execs.py {'!' * 10}")
			trade["account"] = V8_ACCOUNT_MAP[_acct]
		for trade in trade_dict["trades"]:
			assert trade["account"].startswith("EOD") and trade["account"].endswith("_C42") and \
				_V8_ACCT_FLOOR <= int(trade["account"][3:-4]) <= _V8_ACCT_CEIL, \
				f"[V8] account '{trade['account']}' outside EOD{_V8_ACCT_FLOOR}-{_V8_ACCT_CEIL}_C42"

	print(f"{pretty_time()} -- Starting orchestrate_batched_send() 350PM")
	if SEND_TRADES:
		asyncio.run(orchestrate_batched_send(
			trade_dict, orderDuration=30,
			srtrade_pool=srtrade_pool, sranalytics_pool=sranalytics_pool,
		))
	print(f"{pretty_time()} -- Finished orchestrate_batched_send() 350PM")

	# Log net option positions
	try:
		from position_logging_helper import log_positions
		print(f"{pretty_time()} -- Starting position logging (350PM)")
		log_positions(trade_dict, script_name="350PM_V8", is_test=IS_TEST)
		print(f"{pretty_time()} -- Finished position logging (350PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in position logging (350PM): {e}")

	# Extra spread limit orders (supplementary to parent outright strategies)
	extra_spread_summary = ""
	try:
		from extra_spread_trader import send_extra_spread_orders
		print(f"{pretty_time()} -- Starting extra spread orders")
		extra_spread_summary = send_extra_spread_orders(
			trade_dict=trade_dict, puts=puts, calls=calls,
			today=today, counter=counter, is_test=IS_TEST, send_trades=SEND_TRADES,
		)
		print(f"{pretty_time()} -- Finished extra spread orders")
	except Exception as e:
		extra_spread_summary = f"ERROR in extra spread trader: {e}"
		print(f"{pretty_time()} -- ERROR in extra spread trader: {e}")

	# _____________________________________________________________Summary_____________________________________________________________

	summary += f"SPX: {spx:,.2f}. Imbal: {imbal if isinstance(imbal, str) else f'{imbal:,.0f}'}. Market: {market} since current SPY move is {today_move:.4f} and {LOOKBACK} day std dev is {std:.4f}.\n"
	summary += f"QQQ Market Ratio: {qqq_market_ratio:.2f}. QQQ Imbal: {f'{qqq_imbal_350 / 1e9:.2f}B' if qqq_imbal_350 is not None else 'N/A'}.\n"
	summary += f"Imbal: {imbal_mag}. Imbal signed: {imbal_signed}. 340PM: {imbal340:,.0f}.\n"
	summary += f"First Tick: {firstTickBps:.1f} bps.\n"
	summary += f"Today's Vol: {today_vol:.3f} ({to_percentile_string(bin_today_vol(today_vol))}). VIX: {vix:.2f} ({to_percentile_string(bin_vix(vix))}). High/Low: {hl_raw:.2f} ({to_percentile_string(bin_high_low(hl))}).\n"
	summary += f"RSI: {rsi} ({to_percentile_string(bin_rsi(rsi))}). Chg 3M Realized: {'+' if change_in_realized > 0 else '-'}{abs(change_in_realized * 100):.2f} Vol Points. ({to_percentile_string(bin_realized_change(change_in_realized), n=10)})\n"
	if paired_recreated is not None:
		summary += f"Paired Imbal: {paired_recreated / 1e9:.1f} Bil.\n"
	else:
		summary += "Paired Imbal: N/A.\n"
	summary += f"Regime inputs: VIX={vix:.2f}, atmVol={today_vol:.3f}, absImbal={abs(imbal) / 1e9:.2f}B.\n"

	summary_dict = {}

	for trade, trade_type in zip(trade_dict["trades"], trade_dict["trade_types"]):
		if not trade["name"] in summary_dict:
			summary_dict[trade["name"]] = f"""\n*{trade["name"]}* ({trade["account"]}):\n"""
		if trade_type == "complex":
			if trade["symbol"] == "SPXW":
				if trade["direction"] == "Sell":
					equiv_str = f" (Equivalents: {myGetSpyEquivalent(trade['short_legs'][0].okey_xx):.2f} - {myGetSpyEquivalent(trade['long_legs'][0].okey_xx):.2f})"
				else:
					equiv_str = f" (Equivalents: {myGetSpyEquivalent(trade['long_legs'][0].okey_xx):.2f} - {myGetSpyEquivalent(trade['short_legs'][0].okey_xx):.2f})"
			else:
				equiv_str = ""
			if trade["direction"] == "Sell":
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["short_legs"][0].okey_xx} {trade["long_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.{equiv_str}\n"""
			else:
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["long_legs"][0].okey_xx} {trade["short_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.{equiv_str}\n"""
		else:
			equiv_str = f" (Equivalents: {myGetSpyEquivalent(trade['option'].okey_xx):.2f})" if trade["symbol"] == "SPXW" else ""
			summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["option"].okey_xx} {trade["structure"]} for {trade["price"]}.{equiv_str}\n"""
		
	for single_algo_summary in summary_dict.values():
		summary += single_algo_summary

	summary += "\n*Explanations:*"
	for algo_name, explanations in explanations_dict.items():
		summary += f"""\n{algo_name}:\n"""
		summary += explanations["put"]
		summary += explanations["call"]

	if extra_spread_summary:
		summary += f"\n*Extra Spreads:*\n{extra_spread_summary}\n"

	if bumped_spread_summary:
		summary += f"\n*Bumped Spreads:*\n{bumped_spread_summary}\n"

	if closer_spread_summary:
		summary += f"\n*Closer Spreads:*\n{closer_spread_summary}\n"

	if np.isnan(firstTickBps):
		summary = "WARNING: first tick was NaN.\n\n" + summary

	#~~~~~~~~~~~~~~~~~~~~~~~~~~ V8 FEATURES RECAP (helpers_v8) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	# LOG ONLY (not added to the chat summary): F2 spot-vs-uPrc line (+ any fallback) and one line
	# per order/wave: chunks, sprc/smrk/anchor, limit sent vs the v7 sprc-based limit.
	print(_hv8.format_v8_recap(_v8_chain_info))
	#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

	# Prepend any loud send-phase warnings (wave-1 not confirmed terminal -> hedged wave-2 from the
	# orchestrator; FULL-SIZE-NOT-SENT 4-order-cap drops from trade_complex) so they sit at the TOP.
	_warns = (trade_dict.get("send_warnings") or []) + drain_send_warnings()
	_warn_block = ("\n".join(_warns) + "\n\n") if _warns else ""
	print(summary)
	send_message(f"{getNowEst().time().strftime("%I:%M:%S %p")}\n" + _warn_block + summary, my_chat)

	# Log per-algo trade attempts to optionsResearch.algo_trade_log (60s wait for SR fills to settle).
	# Wrapped in try/except so logging failure never affects trading (trading is already done at this point).
	# Skipped entirely in test mode -- we don't want test trades polluting the prod log table.
	if IS_TEST:
		print(f"{pretty_time()} -- algo_trade_logger SKIPPED (IS_TEST=True)")
	else:
		try:
			from algo_trade_logger import log_trades
			factors_for_log = {
				"spx_price":       float(spx) if spx is not None else None,
				"vix":             float(vix) if vix is not None else None,
				"atm_vol":         float(today_vol) if today_vol is not None else None,
				"market_ratio":    float(today_move / std) if std else None,
				"rsi":             float(rsi) if rsi is not None else None,
				"high_low_ratio":  float(hl) if hl is not None else None,
				"realized_3m_chg": float(change_in_realized) if change_in_realized is not None else None,
				"imbal_340":       int(imbal340) if (not isinstance(imbal340, str) and imbal340 is not None) else None,
				"imbal_350":       int(imbal) if (not isinstance(imbal, str) and imbal is not None) else None,
				"imbal_355":       None,
				"qqq_imbal":       int(qqq_imbal_350) if qqq_imbal_350 is not None else None,
				"paired_imbal":    int(paired_recreated) if paired_recreated is not None else None,
			}
			print(f"{pretty_time()} -- Starting algo_trade_logger (60s wait for SR fills)")
			log_trades(trade_dict, factors_for_log, wait_seconds=60, script_name="350PM_V8")
			print(f"{pretty_time()} -- Finished algo_trade_logger")
		except Exception as _log_e:
			print(f"{pretty_time()} -- ERROR in algo_trade_logger (non-fatal): {_log_e}")
			import traceback as _log_tb; _log_tb.print_exc()

	# Close pool conns cleanly. Non-fatal on error -- script is done anyway.
	try:
		if srtrade_pool is not None:
			srtrade_pool.close()
		if sranalytics_pool is not None:
			sranalytics_pool.close()
		print(f"{pretty_time()} -- Closed srtrade + sranalytics pools")
	except Exception as _e:
		print(f"{pretty_time()} -- Non-fatal: pool close raised: {_e}")








