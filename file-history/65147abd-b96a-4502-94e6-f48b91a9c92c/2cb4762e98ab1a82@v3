]
MAX_SIZES = {
    "ALGO_42_350PM_SPREAD_SALES_SPX_IMBAL_GROWS": 1,
    "ALGO_42_350PM_SPREAD_SALES_SPX_IMBAL_VS_MARKET": 1,
}
ACCOUNTS = {
    "ALGO_42_350PM_SPREAD_SALES_SPX_IMBAL_GROWS": "EOD26_C42",
