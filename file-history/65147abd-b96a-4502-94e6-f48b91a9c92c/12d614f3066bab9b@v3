def _build_live_imbal_factors(imbal):
    """Build live-imbal factor dict. If imbal is None (poll failed/stale), all factors = 0
    so triggers requiring them will not fire.
    """
    if imbal is None:
        return {
            "factor_live_imbal_lt_100M":     0,
            "factor_live_imbal_gt_neg_100M": 0,
            "factor_live_imbal_lt_neg_100M": 0,
            "factor_live_imbal_gt_100M":     0,
        }
    return {
        "factor_live_imbal_lt_100M":     1 if imbal <  100e6 else 0,
        "factor_live_imbal_gt_neg_100M": 1 if imbal > -100e6 else 0,
        "factor_live_imbal_lt_neg_100M": 1 if imbal < -100e6 else 0,
        "factor_live_imbal_gt_100M":     1 if imbal >  100e6 else 0,
    }


