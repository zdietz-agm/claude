async def _safe_send(coro, trade_name):
    """Wrap a trade coroutine so one failure does not kill the rest."""
    try:
        await coro
    except Exception as e:
        print(f"ERROR sending trade '{trade_name}': {e}")


def _fire_trades(trade_dict, fired_keys, now_t, trackers, btic_price, fired_details, scale_mult=None):
    """Send any positive-size trades in trade_dict whose (name, side) has not yet fired.

    Also re-checks each trade's tracker.is_valid_time(now_t) before firing as defense in
    depth (the main loop already filters, but this guards against any caller that doesn't).

    Appends one dict per fired trade to `fired_details` for use in the end-of-day recap.
    scale_mult is the resolved size-up multiplier for this config (None when the config
    has no size_multiplier_factors); stored in fired_details so the recap can show it.

    Returns count of trades fired.
    """
    pending = []
    for trade, trade_type in zip(trade_dict["trades"], trade_dict["trade_types"]):
        if trade.get("size", 0) <= 0:
            continue
        key = (trade["name"], _trade_side(trade))
        if key in fired_keys:
            continue
        tracker = trackers.get(trade["name"])
        if tracker is not None and not tracker.is_valid_time(now_t):
            continue
        if trade_type == "complex":
            order = send_complex_two_waves(
                trade["symbol"], trade["size"], trade["short_legs"], trade["long_legs"],
                trade["exp"], trade["account"],
                edge_target1=trade["edge_target1"], max_edge1=trade["max_edge1"],
                edge_target2=trade["edge_target2"], max_edge2=trade["max_edge2"],
                is_sale=trade["is_sale"], userData=trade["name"], orderDuration=30,
                min_price=trade.get("min_price", 0.2),
            )
        else:
            order = send_outright_limit_order(
                trade["symbol"], trade["option"], trade["size"], DIRECTION=trade["direction"],
                ACCOUNT=trade["account"], offset=trade["offset"], userData=trade["name"],
                orderDuration=30, min_price=trade.get("min_price", 0.2),
            )
        pending.append((order, trade["name"], key, trade, trade_type))

    if not pending:
        return 0

    if SEND_TRADES:
        async def _run_all():
            await asyncio.gather(*[_safe_send(coro, name) for coro, name, _key, _t, _tt in pending])
        asyncio.run(_run_all())

    for (_coro, _name, key, _trade, _trade_type) in pending:
        fired_keys.add(key)

    # Append per-trade details for the recap. Done after fire so we only record
    # trades that actually attempted to send.
    for (_coro, name, key, trade, trade_type) in pending:
        short_strikes = [round(float(l.okey_xx), 2) for l in trade.get("short_legs", [])]
        long_strikes  = [round(float(l.okey_xx), 2) for l in trade.get("long_legs", [])]
        fired_details.append({
            "name":     name,
            "side":     key[1],                              # 'put' or 'call'
            "account":  trade.get("account"),
            "size":     trade.get("size"),
            "structure":trade.get("structure"),
            "direction":trade.get("direction"),
            "short_strikes": short_strikes,
            "long_strikes":  long_strikes,
            "price":    trade.get("price"),                  # net credit (sell) or debit (buy)
            "trigger_time": now_t.strftime("%H:%M:%S"),
            "btic_at_trigger": round(float(btic_price), 2) if btic_price is not None else None,
            "scale_mult":      scale_mult,                   # None when config lacks size_multiplier_factors
        })
    return len(pending)


