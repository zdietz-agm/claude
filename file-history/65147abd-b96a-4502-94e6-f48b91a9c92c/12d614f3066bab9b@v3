def _imbal_is_fresh(capture_time, now_t):
    """Return True if capture_time is within IMBAL_MAX_AGE_SEC of now_t.
    capture_time / now_t are dt.time objects (today, ET).
    """
    if capture_time is None:
        return False
    today_d = dt.date.today()
    cap_dt = dt.datetime.combine(today_d, capture_time)
    now_dt = dt.datetime.combine(today_d, now_t)
    return (now_dt - cap_dt).total_seconds() <= IMBAL_MAX_AGE_SEC


def _trade_side(trade):
    """Return 'put' or 'call' based on the structure field. prep_trades sets
    structure to f"Put{explanation_name}" or f"Call{explanation_name}".
    """
    return "put" if trade["structure"].startswith("Put") else "call"


def _build_tick_schedule():
    """Pre-compute tick times from MAIN_LOOP_START_TIME to MAIN_LOOP_END_TIME at
    DATA_REFRESH_INTERVAL spacing. Returns list of dt.time (ET, today).

    dt.time values route wait_until to its time-only comparison branch, which
    avoids the naive-vs-tz-aware mismatch with getNowEst() (which is tz-aware).
    """
    today_d = dt.date.today()
    start = dt.datetime.combine(today_d, MAIN_LOOP_START_TIME)
    end   = dt.datetime.combine(today_d, MAIN_LOOP_END_TIME)
    out = []
    cur = start
    while cur <= end:
        out.append(cur.time())
        cur = cur + dt.timedelta(seconds=DATA_REFRESH_INTERVAL)
    return out


# ---------------------------------------------------------------------------
# Pre-flight trigger check: reuses helpers.get_size so the local fast-path uses
# the SAME factor-tuple logic prep_trades would apply (no reimplementation).
# Returns True if (cfg, side) is unfired AND a trade-factor tuple matches AND
# no dont-trade-factor tuple matches.
# ---------------------------------------------------------------------------

def _config_side_can_fire(cfg, side, factor_dict, fired_keys):
    if (cfg["name"], side) in fired_keys:
        return False
    cp_type = "P" if side == "put" else "C"
    size_mult, _explanation = get_size(
        factor_dict,
        cp_type,
        call_dont_trade_factors=cfg["call_dont_trade_factors"],
        call_trade_factors=cfg["call_trade_factors"],
        call_small_trade_factors=cfg["call_small_trade_factors"],
        put_dont_trade_factors=cfg["put_dont_trade_factors"],
        put_trade_factors=cfg["put_trade_factors"],
        put_small_trade_factors=cfg["put_small_trade_factors"],
        explanation_name=cfg.get("explanation_name", ""),
    )
    return size_mult > 0


