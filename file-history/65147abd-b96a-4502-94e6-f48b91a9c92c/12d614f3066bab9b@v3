# Static-day factor builders. Polled ONCE per day (atmVol pre-loop, 350 imbal
# on first tick >= IMBAL_350_POLL_TIME). Consumed by SIGN_MATCH's
# size_multiplier_factors to scale dollar_target + max_size on qualifying days.
# Failure modes (poll error, None, or NO_IMBAL_VAL) -> factors stay 0 ->
# no scale-up. Default config behavior is unchanged.
# ---------------------------------------------------------------------------

def _poll_atmvol_once():
    """Single-shot pull of SPXW 0DTE ATM put implied vol. Returns float or None.
    Uses the SR puts query already used inside the tick loop; satm.iloc[0] is the
    closest-to-spot put's IV (consistent with the backtest's per-day atmVol).
    """
    try:
        puts = run_query(get_closest_and_slightly_itm_puts_sql)
        if puts is None or puts.empty:
            return None
        v = float(puts.satm.iloc[0])
        if v != v:                                    # NaN guard
            return None
        return v
    except Exception as e:
        print(f"{pretty_time()} -- atmVol poll error: {e}")
        return None


def _atmvol_factors(atmvol):
    """Per-day atmVol factor dict. None -> all 0 (no scale-up)."""
    if atmvol is None:
        return {"factor_atmVol_lt_15": 0, "factor_atmVol_gt_15": 0}
    return {
        "factor_atmVol_lt_15": 1 if atmvol <  0.15 else 0,
        "factor_atmVol_gt_15": 1 if atmvol >= 0.15 else 0,
    }


def _imbal_350_sign_factors(imbal_350):
    """Per-day 350 SPX imbal sign factor dict. None / NO_IMBAL_VAL -> all 0."""
    if imbal_350 is None or imbal_350 == helpers.NO_IMBAL_VAL:
        return {"factor_350_imbal_signed_pos": 0, "factor_350_imbal_signed_neg": 0}
    return {
        "factor_350_imbal_signed_pos": 1 if imbal_350 > 0 else 0,
        "factor_350_imbal_signed_neg": 1 if imbal_350 < 0 else 0,
