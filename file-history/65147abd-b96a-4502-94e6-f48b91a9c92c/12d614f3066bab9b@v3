    fired_keys = set()
    fired_details = []   # one dict per fired trade -- used in end-of-day recap
    tick_schedule = _build_tick_schedule()
    print(f"{pretty_time()} -- Entering tick loop: {len(tick_schedule)} ticks scheduled "
          f"({MAIN_LOOP_START_TIME} -> {MAIN_LOOP_END_TIME} every {DATA_REFRESH_INTERVAL}s)")

    for tick_t in tick_schedule:
        wait_until(tick_t)
        now_t = getNowEst().time()

        # Hard stop guard (covers clock drift past the schedule end).
        if now_t >= MAIN_LOOP_END_TIME:
            break

        # ---- One-time 350 imbal poll at 15:50:10 (flag-guarded) ----
        # Runs on first tick where now_t >= IMBAL_350_POLL_TIME. Pre-poll triggers
        # have signed_pos/neg = 0 -> no 1.2x / no 1.8x. Mirrors backtest's
        # fill_t >= 15:50:10 gate exactly.
        if not imbal_350_polled and now_t >= IMBAL_350_POLL_TIME:
            try:
                imbal_350 = helpers.get_350_imbal()
            except Exception as e:
                print(f"{pretty_time()} -- 350 imbal poll error: {e}")
                imbal_350 = None
            static_day_factors.update(_imbal_350_sign_factors(imbal_350))
            imbal_350_polled = True
            imbal_350_str = (
                f"{imbal_350/1e6:+.0f}M"
                if (imbal_350 is not None and imbal_350 != helpers.NO_IMBAL_VAL)
                else "NA"
            )
            print(f"{pretty_time()} -- 350 imbal poll: {imbal_350_str}  factors={_imbal_350_sign_factors(imbal_350)}")

        # ---- Determine which configs are active right now ----
        # Per-config tracker.is_valid_time decides. If no config is valid, skip the
        # tick ENTIRELY -- no BDP, no DB, no tracker update. Prevents cross-config
        # contamination through latched breaches in dead windows.
        active_cfgs = [cfg for cfg in configs if trackers[cfg["name"]].is_valid_time(now_t)]
        if not active_cfgs:
            continue

        # ---- Poll BTIC + imbal (once, shared across active configs) ----
        btic_price = poll_btic_price(btic_ticker)
        if btic_price is None:
            print(f"{pretty_time()} -- BTIC poll returned None; skipping tick")
            continue
        imbal, capture_time = poll_latest_imbal()
        fresh = _imbal_is_fresh(capture_time, now_t)

        # Per-tick poll log: useful for post-hoc debugging from saved script logs.
        imbal_str = f"{imbal/1e6:+.0f}M" if imbal is not None else "NA"
        cap_str   = capture_time.strftime("%H:%M:%S") if capture_time is not None else "NA"
        print(f"{pretty_time()} -- poll BTIC={btic_price:.2f}  Imbal={imbal_str}  cap={cap_str}  fresh={fresh}")

        # ---- Update only the active trackers (others stay frozen at last valid state) ----
        for cfg in active_cfgs:
            trackers[cfg["name"]].update(btic_price, ts=tick_t, gate_open=fresh)

        # ---- Local trigger pre-flight: skip chain refresh + prep_trades entirely
        #      on ticks where no config has a live trigger. This is the vast majority. ----
        live_imbal_factors = _build_live_imbal_factors(imbal if fresh else None)
        configs_to_prep = []
        for cfg in active_cfgs:
            factor_dict = trackers[cfg["name"]].factor_dict()
            factor_dict.update(live_imbal_factors)
            factor_dict.update(static_day_factors)   # atmVol + 350 imbal sign (SIGN_MATCH scale-up)
            if (_config_side_can_fire(cfg, "put",  factor_dict, fired_keys) or
                _config_side_can_fire(cfg, "call", factor_dict, fired_keys)):
                configs_to_prep.append((cfg, factor_dict))

        if not configs_to_prep:
            continue  # no triggers live -- skip chain refresh + prep_trades

        # ---- Refresh chain once for this tick (only reached when a trigger is live) ----
        try:
            calls = run_query(get_closest_and_slightly_itm_calls_sql)
            puts  = run_query(get_closest_and_slightly_itm_puts_sql)
        except Exception as e:
            print(f"{pretty_time()} -- chain query error: {e}; skipping tick")
            continue
        if calls is None or puts is None or calls.empty or puts.empty:
            print(f"{pretty_time()} -- empty chain; skipping tick")
            continue

        spx = puts.uprc[0]
        option_chains = {"SPXW": {
            "puts":  puts.reset_index(drop=True),
            "calls": calls.reset_index(drop=True),
            "underlying": spx,
        }}

        # ---- prep_trades per ready config ----
        # Live-reload SIZE_MULT_BTIC_PUTS/CALLS once per tick (only when we're actually
        # about to fire something -- configs_to_prep is non-empty). Mid-run edits to
        # algo_globals.py take effect on the next tick.
        from algo_globals import get_live_size_mults
        _puts_mult_btic, _calls_mult_btic = get_live_size_mults("BTIC")
        print(f"{pretty_time()} -- Live size mults (BTIC): puts={_puts_mult_btic}, calls={_calls_mult_btic}")
        total_fired_this_tick = 0
        for cfg, factor_dict in configs_to_prep:
            try:
                trade_dict, _expl = prep_trades(
                    configs=[cfg],
                    factor_dict=factor_dict,
                    option_chains=option_chains,
                    today=today,
                    trigger_all=False,
                    trigger_all_size=0,
                    magnets=[],
                    puts_size_mult=_puts_mult_btic,
                    calls_size_mult=_calls_mult_btic,
                )
            except Exception as e:
                print(f"{pretty_time()} -- prep_trades error for {cfg['name']}: {e}; skipping config this tick")
                continue

            # Resolve scale_mult once per (cfg, tick). None for configs without
            # size_multiplier_factors -> recap suppresses the suffix for them.
            cfg_scale_mult = None
            if cfg.get("size_multiplier_factors"):
                cfg_scale_mult, matched = _describe_size_multiplier(factor_dict, cfg["size_multiplier_factors"])
                if any(t.get("size", 0) > 0 for t in trade_dict.get("trades", [])):
                    if matched is not None:
                        print(f"{pretty_time()} -- {cfg['name']} scale_mult={cfg_scale_mult}x  matched=[{', '.join(matched)}]")
                    else:
                        print(f"{pretty_time()} -- {cfg['name']} scale_mult=1.0x  (no rule matched)")

            total_fired_this_tick += _fire_trades(trade_dict, fired_keys, now_t, trackers, btic_price, fired_details, scale_mult=cfg_scale_mult)

        if total_fired_this_tick:
            print(f"{pretty_time()} -- Fired {total_fired_this_tick} trade(s). BTIC={btic_price:.2f} "
                  f"Imbal={imbal/1e6 if imbal is not None else 'NA'}M  fresh={fresh}")
            print(f"{pretty_time()} -- fired_keys now: {fired_keys}")

        # Early exit: every config has fired both sides -- nothing more to do this day.
        max_possible_keys = 2 * len(configs)  # one per (config, side)
        if len(fired_keys) >= max_possible_keys:
            print(f"{pretty_time()} -- All sides fired ({len(fired_keys)}); exiting loop")
            break

    # ----- Summary -----
    summary = f"{dt.date.today().strftime('%m/%d/%Y')} BTIC+IMBAL RECAP:\n\n"
    summary += f"BTIC ticker: {btic_ticker}. Pre-3:45 HIGH={high_pre:.2f} LOW={low_pre:.2f}.\n"
    for name, tr in trackers.items():
        summary += (f"{name}: last={tr.last_price}  running max={tr.running_max}  "
                    f"min={tr.running_min}  updates={tr.n_updates}.\n")
    summary += f"Edge Mult: {vix_edge_mult:.2f}x (VIX: {startup_vix:.1f}).\n"

    # Per-trade detail block: one line per fired trade, grouped by config name.
    # Format mirrors 355pm's summary_dict but appends trigger time + BTIC@trigger.
    if fired_details:
        per_cfg = {}
        for d in fired_details:
            key = f"*{d['name']}* ({d['account']})"
            per_cfg.setdefault(key, []).append(d)
        for header, trades in per_cfg.items():
            summary += f"\n{header}:\n"
            for d in trades:
                # Sell credit spread shows SHORT first, then LONG; buy shows LONG first.
                if d['direction'] == 'Sell':
                    legs = f"{' '.join(str(k) for k in d['short_strikes'])} {' '.join(str(k) for k in d['long_strikes'])}"
                else:
                    legs = f"{' '.join(str(k) for k in d['long_strikes'])} {' '.join(str(k) for k in d['short_strikes'])}"
                price_str = f"{d['price']}" if d['price'] is not None else "?"
                btic_str  = f"{d['btic_at_trigger']}" if d['btic_at_trigger'] is not None else "?"
                scale_suffix = f" (scale: {d['scale_mult']}x)" if d.get('scale_mult') is not None else ""
                summary += (f"{d['direction']} {d['size']} SPXW {legs} {d['structure']} "
                            f"for {price_str} @ {d['trigger_time']} (BTIC={btic_str}){scale_suffix}\n")
    else:
        summary += "\nNo trades fired today.\n"

    print(summary)
    send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + summary, my_chat)
