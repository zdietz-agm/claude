def _rebal_355_factors(rebal_355_B):
    """Per-day 3:55pm rebal factor dict. None -> factor 0 (graceful degrade:
    PUT trades allowed as if the check never happened, per the design spec).
    """
    if rebal_355_B is None:
        return {"factor_355_rebal_lt_neg_9b": 0}
    return {"factor_355_rebal_lt_neg_9b": 1 if rebal_355_B < REBAL_355_THRESHOLD_B else 0}


def _describe_size_multiplier(factor_dict, size_multiplier_factors):
    """Walk the rules and return (mult, matched_factor_names) for the first match.
    No match (or empty rules) -> (1.0, None). Mirrors helpers.resolve_size_multiplier
    but also returns which factor names lit -- useful for the trade-time log line.
    """
    if not size_multiplier_factors:
        return 1.0, None
    for factor_tuple, mult in size_multiplier_factors:
        if all(factor_dict.get(col) == val for col, val in factor_tuple):
            return float(mult), [col for col, _val in factor_tuple]
    return 1.0, None


