# In-memory cache for run_query by SQL string (same sql reuses data; different expiry/side pulls fresh).
# Entries expire after CACHE_TTL_S, and the cache is also cleared right after the 4pm wait,
# so the execution phase can never reuse preview-time rows.
CACHE_TTL_S = 10
_run_query_cache = {}


def run_query_cached(sql):
	"""Run SQL via run_query, caching result in memory by sql with a short TTL. Returns a copy on a cache hit."""
	hit = _run_query_cache.get(sql)
	if hit is not None and (getNowEst() - hit[0]).total_seconds() < CACHE_TTL_S:
		return hit[1].copy()
	df = run_query(sql)
	_run_query_cache[sql] = (getNowEst(), df)
	return df

