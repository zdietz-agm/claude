		})
		df = pd.concat([df, new_row], ignore_index=True)

	df.to_csv(IMPLIED_MOVE_FILE, index=False)
	print(f"Saved implied move for tomorrow: {implied_move:.2f}%")


# ========================== Streak Tracking (Mean Reversion) ==========================
# Used by mean_reversion trigger: trade when sell or buy side has enough consecutive losses.
def compute_losing_streak(pnl_array):
	"""Compute consecutive losing streak ending at each position."""
	streaks = np.zeros(len(pnl_array))
	current_streak = 0
	for i in range(len(pnl_array)):
		if pnl_array[i] < 0:  # Loss
			current_streak += 1
		else:
			current_streak = 0
		streaks[i] = current_streak
	return streaks


def get_streak_data(spx=None, settle_in_memory=False):
	"""Load DAILY_PNL_FILE and return current consecutive losing streaks for sell and buy (mean-reversion trigger).
	Returns (sell_losing_streak, buy_losing_streak). Only rows with settled P&L are used (no lookahead).

	spx: Normally provided when called from check_mean_reversion (main passes current SPX). If provided together
	with settle_in_memory=True, any row with exp<=today and PNL_sell NaN is settled in memory (no CSV write).
	Not provided when called standalone without SPX; then only rows already settled on disk are used.

	settle_in_memory: Normally True when spx is provided (check_mean_reversion sets settle_in_memory = (spx is not None)).
	True = fill P&L for unsettled exp<=today rows in memory so streaks are up-to-date (test and production). False = use
	only rows that already have PNL_sell/PNL_buy in the CSV (default; use if no SPX available)."""
	if not os.path.exists(DAILY_PNL_FILE):
		print(f"Warning: {DAILY_PNL_FILE} not found. Returning 0 streaks.")
		return 0, 0

	df = pd.read_csv(DAILY_PNL_FILE, parse_dates=["trade_date", "exp"])
	if df.empty:
		return 0, 0

	df["trade_date"] = pd.to_datetime(df["trade_date"]).apply(lambda x: x.date() if hasattr(x, 'date') else x)
	df["exp"] = pd.to_datetime(df["exp"]).apply(lambda x: x.date() if hasattr(x, 'date') else x)
	df = df.sort_values("trade_date").reset_index(drop=True)

	# If settle_in_memory, calculate P&L for unsettled rows where exp <= today
	if settle_in_memory and spx is not None:
		for idx, row in df.iterrows():
			if row["exp"] <= today and pd.isna(row["PNL_sell"]):
				short_call = row["lower_call_strike"]
				long_call = row["higher_call_strike"]
				short_put = row["higher_put_strike"]
				long_put = row["lower_put_strike"]

				call_sell = calc_expiry_pnl_sell(short_call, long_call, spx, "Call")
				put_sell = calc_expiry_pnl_sell(short_put, long_put, spx, "Put")
				pnl_sell = row["bid_price"] + call_sell + put_sell

				call_buy = calc_expiry_pnl_buy(short_call, long_call, spx, "Call")
				put_buy = calc_expiry_pnl_buy(short_put, long_put, spx, "Put")
				pnl_buy = call_buy + put_buy - row["ask_price"]

				df.loc[idx, "PNL_sell"] = round(pnl_sell, 2)
				df.loc[idx, "PNL_buy"] = round(pnl_buy, 2)
				print(f"  [In-memory settle] {row['trade_date']}: PNL_sell={pnl_sell:.2f}, PNL_buy={pnl_buy:.2f}")

	# Only use rows with settled P&L (no lookahead: today's trade is not settled yet)
	df_settled = df.dropna(subset=["PNL_sell", "PNL_buy"])
	if df_settled.empty:
		return 0, 0

	# Ensure exactly one row per calendar day (hypothetical streak is per day). Keep last if duplicates exist.
	df_settled = df_settled.drop_duplicates(subset=["trade_date"], keep="last").sort_values("trade_date").reset_index(drop=True)

	sell_streaks = compute_losing_streak(df_settled["PNL_sell"].values)
	buy_streaks = compute_losing_streak(df_settled["PNL_buy"].values)

	# Streak at last row = current streak as of yesterday
	sell_losing_streak = int(sell_streaks[-1]) if len(sell_streaks) > 0 else 0
	buy_losing_streak = int(buy_streaks[-1]) if len(buy_streaks) > 0 else 0

	return sell_losing_streak, buy_losing_streak


def save_daily_pnl(trade_date, expiry, calls, puts, bid_price, ask_price, spx_at_trade, atmVol):
	"""Save daily trade data for streak tracking. P&L calculated at settlement."""
	if os.path.exists(DAILY_PNL_FILE):
		df = pd.read_csv(DAILY_PNL_FILE, parse_dates=["trade_date", "exp"])
	else:
		df = pd.DataFrame(columns=["trade_date", "exp", "lower_put_strike", "higher_put_strike",
								   "lower_call_strike", "higher_call_strike", "PNL_buy", "PNL_sell",
								   "bid_price", "ask_price", "spx_on_trade_date", "spx_on_exp", "atmVol"])

	df["trade_date"] = pd.to_datetime(df["trade_date"]).apply(lambda x: x.date() if hasattr(x, 'date') else x)
	trade_date_val = trade_date.date() if hasattr(trade_date, 'date') else trade_date

	# Upsert: update strikes/prices for today if row exists, else append (PNL left NaN until settle_daily_pnl)
	if trade_date_val in df["trade_date"].values:
		# Update existing row (don't overwrite P&L if already settled)
		idx = df[df["trade_date"] == trade_date_val].index[0]
		# Column names match "long_put = lower, short_put = higher" etc. for iron condor
		df.loc[idx, "exp"] = expiry
		df.loc[idx, "lower_put_strike"] = puts["long_strike"]
		df.loc[idx, "higher_put_strike"] = puts["short_strike"]
		df.loc[idx, "lower_call_strike"] = calls["short_strike"]
		df.loc[idx, "higher_call_strike"] = calls["long_strike"]
		df.loc[idx, "bid_price"] = bid_price
		df.loc[idx, "ask_price"] = ask_price
		df.loc[idx, "spx_on_trade_date"] = spx_at_trade
		df.loc[idx, "atmVol"] = atmVol
	else:
		# Add new row
		new_row = pd.DataFrame({
			"trade_date": [trade_date_val],
			"exp": [expiry],
			"lower_put_strike": [puts["long_strike"]],
			"higher_put_strike": [puts["short_strike"]],
			"lower_call_strike": [calls["short_strike"]],
			"higher_call_strike": [calls["long_strike"]],
			"PNL_buy": [np.nan],
			"PNL_sell": [np.nan],
			"bid_price": [bid_price],
			"ask_price": [ask_price],
			"spx_on_trade_date": [spx_at_trade],
			"spx_on_exp": [np.nan],
			"atmVol": [atmVol]
		})
		df = pd.concat([df, new_row], ignore_index=True)

	# Ensure date columns are written without time (date-only strings in CSV)
	df["trade_date"] = df["trade_date"].apply(lambda x: x.date() if hasattr(x, "date") else x)
	df["exp"] = df["exp"].apply(lambda x: x.date() if hasattr(x, "date") else x)
	# Enforce exactly one row per calendar day (keep last so today's upsert wins)
	df = df.drop_duplicates(subset=["trade_date"], keep="last").sort_values("trade_date").reset_index(drop=True)
	df.to_csv(DAILY_PNL_FILE, index=False)
	print(f"Saved daily trade data for {trade_date_val}")


def settle_daily_pnl(spx):
	"""Settle any unsettled daily P&L entries where exp <= today."""
	if not os.path.exists(DAILY_PNL_FILE):
		return

	df = pd.read_csv(DAILY_PNL_FILE, parse_dates=["trade_date", "exp"])
	if df.empty:
		return

	df["trade_date"] = pd.to_datetime(df["trade_date"]).apply(lambda x: x.date() if hasattr(x, 'date') else x)
	df["exp"] = pd.to_datetime(df["exp"]).apply(lambda x: x.date() if hasattr(x, 'date') else x)
	df = df.sort_values("trade_date").reset_index(drop=True)

	settled_count = 0
	for idx, row in df.iterrows():
		if row["exp"] <= today and pd.isna(row["PNL_sell"]):
			short_call = row["lower_call_strike"]
			long_call = row["higher_call_strike"]
			short_put = row["higher_put_strike"]
			long_put = row["lower_put_strike"]

			call_sell = calc_expiry_pnl_sell(short_call, long_call, spx, "Call")
			put_sell = calc_expiry_pnl_sell(short_put, long_put, spx, "Put")
			pnl_sell = row["bid_price"] + call_sell + put_sell

			call_buy = calc_expiry_pnl_buy(short_call, long_call, spx, "Call")
			put_buy = calc_expiry_pnl_buy(short_put, long_put, spx, "Put")
			pnl_buy = (call_buy + put_buy) - row["ask_price"]

			df.loc[idx, "spx_on_exp"] = spx
			df.loc[idx, "PNL_sell"] = round(pnl_sell, 2)
			df.loc[idx, "PNL_buy"] = round(pnl_buy, 2)
			settled_count += 1
			print(f"DEBUG settle_daily_pnl: trade_date={row['trade_date']} exp={row['exp']} | SPX={spx:.2f} | "
			      f"PNL_sell={pnl_sell:.2f} (bid={row['bid_price']:.2f}+call_sell+put_sell), PNL_buy={pnl_buy:.2f} (call_buy+put_buy-ask={row['ask_price']:.2f})")

	if settled_count > 0:
		# Ensure date columns are written without time (date-only strings in CSV)
		df["trade_date"] = df["trade_date"].apply(lambda x: x.date() if hasattr(x, "date") else x)
		df["exp"] = df["exp"].apply(lambda x: x.date() if hasattr(x, "date") else x)
		# One row per calendar day (keep last)
		df = df.drop_duplicates(subset=["trade_date"], keep="last").sort_values("trade_date").reset_index(drop=True)
		df.to_csv(DAILY_PNL_FILE, index=False)
		print(f"Settled {settled_count} daily P&L entries with SPX={spx:.2f}")


# ========================== Trigger Evaluation ==========================
# Each config has trigger_condition: always | end_of_week | two_consecutive_losses | big_move | mean_reversion.

def is_max_loss(row, pnl_override=None, tolerance=10):
	"""Check if a trade hit max loss (within tolerance). Max loss = 1000 * size - premium_sold."""
	# Per spread max loss = width (10 pts) * 100 - premium; total = size * that
	max_loss_amount = 1000 * row["size"] - row["premium_sold"]
	pnl = pnl_override if pnl_override is not None else row["pnl"]
	# Max loss means pnl == -max_loss_amount; we allow a small tolerance ($10)
	return abs(pnl + max_loss_amount) <= tolerance


def calculate_trade_pnl(row, spx):
	"""Calculate the P&L for a trade given current SPX price."""
	call_pnl = calc_expiry_pnl_sell(row["short_call_strike"], row["long_call_strike"], spx, "Call")
	put_pnl = calc_expiry_pnl_sell(row["short_put_strike"], row["long_put_strike"], spx, "Put")
	premium_collected = row["price"] * row["size"] * 100
	return ((call_pnl + put_pnl) * row["size"] * 100) + premium_collected


def check_two_consecutive_losses(reference_log_folder, spx=None):
	"""Returns True if the last 2 trades (including unsettled) in the reference log were MAX losses.
	Used by two_consecutive_losses trigger: 'regular' strategy log is the reference."""
	max_date = dt.date(2020, 1, 1)
	for file in os.listdir(reference_log_folder):
		if file.endswith(".csv"):
			try:
				file_date = dt.datetime.strptime(file.split(".csv")[0], "%Y_%m_%d").date()
				if file_date > max_date:
					max_date = file_date
			except ValueError:
				continue

	if max_date == dt.date(2020, 1, 1):
		print("No log files found in reference folder for two_consecutive_losses check.")
		return False

	log_data = pd.read_csv(f"{reference_log_folder}/{max_date.strftime('%Y_%m_%d')}.csv")
	if log_data.empty:
		return False

	# Sort chronologically by trade_date to ensure correct order
	log_data["trade_date"] = pd.to_datetime(log_data["trade_date"])
	log_data = log_data.sort_values(by="trade_date", ascending=True).reset_index(drop=True)

	# We need the last 2 trades - including any unsettled trade
	if len(log_data) < 2:
		return False

	last_two = log_data.tail(2)
	max_loss_checks = []

	print(f"DEBUG check_two_consecutive_losses: Checking last 2 trades (spx={spx})")

	for i, (_, row) in enumerate(last_two.iterrows()):
		max_loss_amt = 1000 * row["size"] - row["premium_sold"]

		# If pnl is NaN (unsettled trade), calculate it using current SPX
		if pd.isna(row["pnl"]):
			if spx is None:
				print(f"DEBUG check_two_consecutive_losses: Trade {i+1}: pnl=NaN (unsettled), but no SPX provided - skipping")
				return False  # Can't evaluate without SPX
			calculated_pnl = calculate_trade_pnl(row, spx)
			is_max = is_max_loss(row, pnl_override=calculated_pnl)
			print(f"DEBUG check_two_consecutive_losses: Trade {i+1}: pnl=NaN->calculated={calculated_pnl:.0f}, max_loss_amt={max_loss_amt:.0f}, is_max_loss={is_max}")
		else:
			calculated_pnl = None
			is_max = is_max_loss(row)
			print(f"DEBUG check_two_consecutive_losses: Trade {i+1}: pnl={row['pnl']:.0f}, max_loss_amt={max_loss_amt:.0f}, is_max_loss={is_max}")

		max_loss_checks.append(is_max)

	return all(max_loss_checks)


def get_pnl_tracker_from_log(log_folder, spx=None):
	"""Returns the ACTUAL current pnl_tracker, including P&L from unsettled trades.
	Used to decide if we 'need recovery' (pnl_tracker < 0) for two_consecutive_losses trigger."""
	if log_folder is None:
		return 0

	if not os.path.exists(log_folder):
		return 0

	# Find latest log file
	max_date = dt.date(2020, 1, 1)
	for file in os.listdir(log_folder):
		if file.endswith(".csv"):
			try:
				file_date = dt.datetime.strptime(file.split(".csv")[0], "%Y_%m_%d").date()
				if file_date > max_date:
					max_date = file_date
			except ValueError:
				continue

	if max_date == dt.date(2020, 1, 1):
		return 0

	log_data = pd.read_csv(f"{log_folder}/{max_date.strftime('%Y_%m_%d')}.csv")
	if log_data.empty:
		return 0

	last_row = log_data.iloc[-1]
	stored_pnl_tracker = last_row["pnl_tracker"]

	# If there's an unsettled trade (pnl is NaN) and we have SPX, calculate the actual P&L
	if spx is not None and pd.isna(last_row["pnl"]):
		# Calculate P&L from the last trade based on current SPX
		call_pnl = calc_expiry_pnl_sell(last_row["short_call_strike"], last_row["long_call_strike"], spx, "Call")
		put_pnl = calc_expiry_pnl_sell(last_row["short_put_strike"], last_row["long_put_strike"], spx, "Put")
		premium_collected = last_row["price"] * last_row["size"] * 100
		trade_pnl = ((call_pnl + put_pnl) * last_row["size"] * 100) + premium_collected

		actual_pnl_tracker = stored_pnl_tracker + trade_pnl
		print(f"DEBUG get_pnl_tracker_from_log: stored={stored_pnl_tracker}, trade_pnl={trade_pnl:.0f}, actual={actual_pnl_tracker:.0f}")
		return actual_pnl_tracker

	return stored_pnl_tracker


def check_big_move(yesterday_implied_move):
	"""Returns (triggered, info_dict). Triggered if SPX moved > 1.6x implied move OR VVIX < 82.
	Note: returns tuple (bool, dict); should_trade expects that for big_move."""
	if pd.isna(yesterday_implied_move):
		print("Big Move Check: Cannot evaluate - yesterday's implied move is NaN")
		return False, {
			"spx_pct_chg": np.nan,
			"implied_move": np.nan,
			"move_ratio": np.nan,
			"vvix": np.nan,
			"big_move_triggered": False,
			"vvix_triggered": False,
			"reason": "Cannot evaluate - yesterday's implied move is unavailable (NaN)"
		}

	# Get VVIX
	try:
		vvix = blp.bdh("VVIX Index", "PX_LAST", today, today).iloc[0, 0]
	except Exception as e:
		print(f"Error fetching VVIX: {e}")
		vvix = 100  # Default to not triggering

	# Get SPX 1-day % change
	try:
		spx_pct_chg = abs(blp.bdh("SPX Index", "CHG_PCT_1D", today, today).iloc[0, 0])
	except Exception as e:
		print(f"Error fetching SPX CHG_PCT_1D: {e}")
		spx_pct_chg = 0  # Default to not triggering

	# Check conditions
	move_ratio = spx_pct_chg / yesterday_implied_move if yesterday_implied_move > 0 else 0
	big_move_triggered = move_ratio > 1.58 # slightly lower to catch borderline days
	vvix_triggered = vvix < 82

	print(f"Big Move Check: SPX chg={spx_pct_chg:.2f}%, implied={yesterday_implied_move:.2f}%, ratio={move_ratio:.2f}x, VVIX={vvix:.2f}")
	print(f"  -> big_move_triggered={big_move_triggered}, vvix_triggered={vvix_triggered}")

	# Build reason string
	triggered = big_move_triggered or vvix_triggered
	if triggered:
		reasons = []
		if big_move_triggered:
			reasons.append(f"SPX moved {move_ratio:.2f}x implied (>{1.6}x threshold)")
		if vvix_triggered:
			reasons.append(f"VVIX={vvix:.2f} (<82 threshold)")
		reason = " AND ".join(reasons)
	else:
		reason = f"SPX move {move_ratio:.2f}x (move={spx_pct_chg:.2f}%, implied={yesterday_implied_move:.2f}%, need >1.6x) and VVIX={vvix:.2f} (need <82)"

	return triggered, {
		"spx_pct_chg": spx_pct_chg,
		"implied_move": yesterday_implied_move,
		"move_ratio": move_ratio,
		"vvix": vvix,
		"big_move_triggered": big_move_triggered,
		"vvix_triggered": vvix_triggered,
		"reason": reason
	}


def check_mean_reversion(config, spx=None):
	"""Check mean reversion trigger based on losing streaks.
	Returns (should_trade, trigger_info) where trigger_info includes 'direction'.
	If spx is provided, unsettled rows with exp<=today are settled in memory so test mode matches production."""
	sell_streak_threshold = config.get("sell_streak_threshold", 4)
	buy_streak_threshold = config.get("buy_streak_threshold", 2)

	settle_in_memory = spx is not None
	sell_losing_streak, buy_losing_streak = get_streak_data(spx=spx, settle_in_memory=settle_in_memory)

	print(f"Mean Reversion Check: sell_streak={sell_losing_streak} (threshold={sell_streak_threshold}), "
		  f"buy_streak={buy_losing_streak} (threshold={buy_streak_threshold})")

	sell_signal = sell_losing_streak >= sell_streak_threshold
	buy_signal = buy_losing_streak >= buy_streak_threshold

	# If both sell and buy streaks are at threshold, we still trade once; direction = Sell by preference
	if sell_signal and buy_signal:
		return True, {
			"direction": "Sell",
			"reason": f"Both signals active (sell_streak={sell_losing_streak}, buy_streak={buy_losing_streak}), choosing SELL",
			"sell_streak": sell_losing_streak,
			"buy_streak": buy_losing_streak
		}
	elif sell_signal:
		return True, {
			"direction": "Sell",
			"reason": f"SELL signal: {sell_losing_streak} consecutive sell losses (>= {sell_streak_threshold})",
			"sell_streak": sell_losing_streak,
			"buy_streak": buy_losing_streak
		}
	elif buy_signal:
		return True, {
			"direction": "Buy",
			"reason": f"BUY signal: {buy_losing_streak} consecutive buy losses (>= {buy_streak_threshold})",
			"sell_streak": sell_losing_streak,
			"buy_streak": buy_losing_streak
		}
	else:
		return False, {
			"reason": f"No signal: sell_streak={sell_losing_streak} (need {sell_streak_threshold}), "
					  f"buy_streak={buy_losing_streak} (need {buy_streak_threshold})",
			"sell_streak": sell_losing_streak,
			"buy_streak": buy_losing_streak
		}


def should_trade(config, end_of_week, yesterday_implied_move, spx=None):
	"""Evaluate if a strategy should trade based on its trigger_condition. Returns (should_trade, trigger_info)."""
	trigger = config.get("trigger_condition", "always")

	if trigger == "always":
		return True, {"reason": "Always trades daily"}
	elif trigger == "end_of_week":
		# END_OF_WEEK is True when (tomorrow - today).days >= 3 (e.g. Friday -> Monday)
		if end_of_week:
			return True, {"reason": f"End of week (next trading day is {(tomorrow - today).days} days away)"}
		else:
			return False, {"reason": f"Not end of week (next trading day is {(tomorrow - today).days} day(s) away)"}
	elif trigger == "two_consecutive_losses":
		ref_folder = config.get("reference_log_folder", "./iron_condor_logs/")   # "Regular" strategy log
		own_log_folder = config.get("log_folder")   # This strategy's log (e.g. recovery strategy)

		regular_two_losses = check_two_consecutive_losses(ref_folder, spx=spx)
		own_pnl_tracker = get_pnl_tracker_from_log(own_log_folder, spx=spx)

		print(f"DEBUG two_consecutive_losses: own_log_folder={own_log_folder}, actual_pnl_tracker={own_pnl_tracker}")
		print(f"DEBUG two_consecutive_losses: regular_two_losses={regular_two_losses}")

		needs_recovery = own_pnl_tracker < 0

		# Trade if we're in the hole (recover) OR if regular just had 2 max losses (fresh trigger)
		if needs_recovery:
			return True, {"reason": f"Recovering losses (pnl_tracker={own_pnl_tracker:,.0f})"}
		elif regular_two_losses:
			return True, {"reason": "Regular strategy lost 2 days in a row (fresh trigger)"}
		else:
			return False, {"reason": "Regular did NOT lose 2 in a row AND no losses to recover"}
	elif trigger == "big_move":
		return check_big_move(yesterday_implied_move)  # Returns (bool, dict)
	elif trigger == "mean_reversion":
		return check_mean_reversion(config, spx=spx)  # Returns (bool, dict) with direction for Buy/Sell
	elif trigger == "mwf":
		# MWF: trade on Monday (0), Wednesday (2), Friday (4)
		if is_mwf(today):
			return True, {"reason": f"MWF day ({today.strftime('%A')})"}
		else:
			return False, {"reason": f"Not an MWF day ({today.strftime('%A')})"}
	else:
		print(f"Unknown trigger_condition: {trigger}")
		return False, {"reason": f"Unknown trigger: {trigger}"}


