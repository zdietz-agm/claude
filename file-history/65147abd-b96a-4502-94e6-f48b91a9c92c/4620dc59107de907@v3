# ========================== Config Loading ==========================
def load_icon_configs(directory="./configs_icon"):
	"""Load all ICON strategy configs from directory."""
	configs = []
	for filename in os.listdir(directory):
		if filename.endswith(".py"):
			filepath = os.path.join(directory, filename)
			# Load .py file as a module without adding it to sys.modules by name
			spec = importlib.util.spec_from_file_location("module.name", filepath)
			module = importlib.util.module_from_spec(spec)
			spec.loader.exec_module(module)
			if hasattr(module, "config"):
				configs.append(module.config)
	# Only return configs that are enabled (default True if key missing)
	return [cfg for cfg in configs if cfg.get("enabled", True)]


# ========================== Implied Move Management ==========================
# Implied move = 1-day vol-derived move (annual vol / sqrt(252) -> %), scaled by 0.8.
# Used for big_move trigger and for display in recap.
def get_implied_move_for_tomorrow():
	"""Calculate tomorrow's implied move using SPX ATM vol."""
	spxVol = getVols("SPXW", atmOnly=True)
	tomorrowVol = spxVol.loc[tomorrow].values[0]
	# Annual vol -> 1-day move in %; 0.8 is an empirical scaling factor
	implied_move = tomorrowVol / np.sqrt(252) * 100 * 0.8
	return round(implied_move, 2)


def get_yesterday_implied_move():
	"""Read yesterday's implied move from the CSV file. Returns NaN if unavailable."""
	if not os.path.exists(IMPLIED_MOVE_FILE):
		print(f"WARNING: {IMPLIED_MOVE_FILE} not found. Returning NaN.")
		return np.nan

	df = pd.read_csv(IMPLIED_MOVE_FILE)
	df["next_trade_date"] = pd.to_datetime(df["next_trade_date"]).apply(lambda x: x.date())

	# CSV stores: trade_date, next_trade_date, implied_move. We want the row where next_trade_date == today (that row was written yesterday).
	today_row = df[df["next_trade_date"] == today]
	if today_row.empty:
		print(f"WARNING: No implied move found for today ({today}). Using latest available.")
		if df.empty:
			print(f"WARNING: Implied move file is empty. Returning NaN.")
			return np.nan
		return df.iloc[-1]["implied_move"]

	return today_row.iloc[0]["implied_move"]


def save_implied_move_for_tomorrow(implied_move):
	"""Save today's implied move for tomorrow to the CSV file."""
	if os.path.exists(IMPLIED_MOVE_FILE):
		df = pd.read_csv(IMPLIED_MOVE_FILE)
	else:
		df = pd.DataFrame(columns=["trade_date", "next_trade_date", "implied_move"])

	df["trade_date"] = pd.to_datetime(df["trade_date"]).apply(lambda x: x.date())

	# Upsert: update row for today if present, else append (allows re-runs / test overwrites)
	if today in df["trade_date"].values:
		df.loc[df["trade_date"] == today, "implied_move"] = implied_move
	else:
