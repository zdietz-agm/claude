def get_expiry_for_config(config):
	"""Determine expiry date based on config trigger condition."""
	trigger = config.get("trigger_condition", "always")

	if trigger == "end_of_week":
		# Weekly: 5 trading days from today; if that lands on Monday, use prior Friday
		expiry = x_days_ahead(5, today)
		if expiry.weekday() == 0:  # Monday
			expiry = x_days_ago(1, expiry)

		# Require option to span a weekend: next trading day after expiry must be 3+ calendar days later
		next_day_after_expiry = x_days_ahead(1, expiry)
		days_gap = (next_day_after_expiry - expiry).days

		if days_gap < 3:
			expiry = x_days_ago(1, expiry)
			next_day_after_expiry = x_days_ahead(1, expiry)
			days_gap = (next_day_after_expiry - expiry).days
			if days_gap < 3:
				raise ValueError(f"Weekly expiry calculation failed: expiry {expiry} has only {days_gap} day gap to next trading day {next_day_after_expiry}. Expected 3+ days.")

		print(f"Weekly expiry: {expiry} (next trading day {next_day_after_expiry} is {days_gap} days later)")
		return expiry
	elif trigger == "mwf":
		# MWF expiry with holiday-aware fallback (from calendar_utils)
		expiry = get_mwf_expiry(today)
		print(f"MWF expiry: {expiry} ({expiry.strftime('%A')})")
		return expiry
	else:
		return tomorrow  # Daily strategies: 1DTE


def get_spreads_for_expiry(cp, spx_price, expiry, symbol="SPXW", target=None, limit=30):
	"""Fetch live option data and select spread strikes nearest to target mid price.

	Uses shared get_spreads() for strike selection, then wraps result with
	prod-specific fields needed for order submission.
	"""
	params = SYMBOL_PARAMS[symbol]
	if target is None:
		target = params["spread_target"]
	spread_width = params["spread_width"]

	# Quote table read at call time from _srof.IMPLIED_QUOTE_TABLE: v7 default is
	# sranalytics.msgoptionimpliedquote (byte-identical SQL); use_v8 flips it to the v8
	# msgliveimpliedquoteadj (the v7 name does not exist on the v8 host).
	if cp == "Call":
		sql = f"""SELECT * FROM {_srof.IMPLIED_QUOTE_TABLE}
		WHERE okey_tk = '{symbol}' AND okey_xx > uprc AND okey_cp = 'Call' AND okey_yr = {expiry.year} AND okey_mn = {expiry.month} AND okey_dy = {expiry.day} ORDER BY okey_xx ASC LIMIT {limit};"""
	else:
		sql = f"""SELECT * FROM {_srof.IMPLIED_QUOTE_TABLE}
		WHERE okey_tk = '{symbol}' AND okey_xx < uprc AND okey_cp = 'Put' AND okey_yr = {expiry.year} AND okey_mn = {expiry.month} AND okey_dy = {expiry.day} ORDER BY okey_xx DESC LIMIT {limit};"""

	df = run_query_cached(sql).rename(columns={"okey_xx": "strike", "sprc": "srPrc", "obid": "bidPrc", "oask": "askPrc", "svol": "srVol"})

	result = get_spreads(df, spx_price, cp, spread_width, target, normalize_targets_and_widths=False)
	if result is None:
		return None

	short_leg = result["short_leg"]
	long_leg = result["long_leg"]

	return {
		"cp": cp,
		"long_option": long_leg.rename({"srPrc": "sprc", "strike": "okey_xx"}),
		"short_option": short_leg.rename({"srPrc": "sprc", "strike": "okey_xx"}),
		"long_strike": result["long_strike"],
		"short_strike": result["short_strike"],
		"long_bid": long_leg.bidPrc,
		"long_ask": long_leg.askPrc,
		"short_bid": short_leg.bidPrc,
		"short_ask": short_leg.askPrc,
		"long_mid": long_leg.srPrc,
		"short_mid": short_leg.srPrc,
		"spread_price_cross": short_leg.bidPrc - long_leg.askPrc,
		"spread_price_mid": result["spread_price_mid"],
		"vol": long_leg.srVol
	}


def calc_expiry_pnl_sell(short_strike, long_strike, close_price, cp):
	"""Seller's expiry P&L component per share for a credit spread; negative when ITM, 0 when OTM. Caller: pnl_sell = bid_price + call_sell + put_sell."""
	if cp == "Call":
		if close_price <= short_strike:
			return 0
		elif close_price <= long_strike:
			return short_strike - close_price  # In the spread: loss (negative)
		else:
			return short_strike - long_strike  # Max loss: minus width
	else:
		if close_price >= short_strike:
			return 0
		elif close_price >= long_strike:
			return close_price - short_strike  # In the spread: loss (negative)
		else:
			return long_strike - short_strike  # Below both: max loss (negative; for puts long < short)


def calc_expiry_pnl_buy(short_strike, long_strike, close_price, cp):
	"""Buyer's expiry P&L component per share for a debit spread; positive when ITM, 0 when OTM. Caller: pnl_buy = call_buy + put_buy - ask_price."""
	if cp == "Call":
		if close_price <= short_strike:
			return 0
		elif close_price <= long_strike:
			return close_price - short_strike  # In the spread: receive (positive)
		else:
			return long_strike - short_strike  # Max: width
	else:
		if close_price >= short_strike:
			return 0
		elif close_price >= long_strike:
			return short_strike - close_price  # In the spread: receive (positive)
		else:
			return short_strike - long_strike  # Max: width (positive; for puts short > long)


def calculate_daily_pnl_for_streaks(spx_at_trade, spx_at_expiry, calls, puts, bid_price_spread):
	"""Calculate what the P&L would have been for both selling and buying (for streak tracking). Per-share (no multiplier)."""
	call_pnl_sell = calc_expiry_pnl_sell(calls["short_strike"], calls["long_strike"], spx_at_expiry, "Call")
	put_pnl_sell = calc_expiry_pnl_sell(puts["short_strike"], puts["long_strike"], spx_at_expiry, "Put")
	pnl_sell = bid_price_spread + call_pnl_sell + put_pnl_sell

	call_pnl_buy = calc_expiry_pnl_buy(calls["short_strike"], calls["long_strike"], spx_at_expiry, "Call")
	put_pnl_buy = calc_expiry_pnl_buy(puts["short_strike"], puts["long_strike"], spx_at_expiry, "Put")
	ask_price_spread = (calls["short_ask"] - calls["long_bid"]) + (puts["short_ask"] - puts["long_bid"])
	pnl_buy = call_pnl_buy + put_pnl_buy - ask_price_spread

	return pnl_sell, pnl_buy


# ========================== Log Processing ==========================
# Per-strategy CSV logs: trade_date, exp, strikes, size, price, pnl_tracker, pnl, premium_sold, is_buy, etc.
# Filenames: YYYY_MM_DD.csv (one file per calendar day; contains that day's trade and history for premium calc).
def get_latest_log_file(log_folder):
	"""Find the most recent log file in a folder (by date in filename)."""
	max_date = dt.date(2020, 1, 1)
	for file in os.listdir(log_folder):
		if file.endswith(".csv"):
			try:
				file_date = dt.datetime.strptime(file.split(".csv")[0], "%Y_%m_%d").date()
				if file_date > max_date:
					max_date = file_date
			except ValueError:
				continue
	return max_date if max_date > dt.date(2020, 1, 1) else None


def settle_previous_trade(config, spx):
	"""Settle only rows whose exp == today and pnl is NaN. Never overwrite already-settled PnL. Call only when not IS_TEST."""
	log_folder = config.get("log_folder")
	if log_folder is None:
		return
	if not os.path.exists(log_folder):
		return

	latest_date = get_latest_log_file(log_folder)
	if latest_date is None:
		return

	log_path = f"{log_folder}/{latest_date.strftime('%Y_%m_%d')}.csv"
	log_data = pd.read_csv(log_path)
	if log_data.empty:
		return

	# Normalize exp to date for comparison
	log_data["exp"] = pd.to_datetime(log_data["exp"]).apply(lambda x: x.date() if hasattr(x, "date") else x)

	# Only settle rows where exp == today and pnl is NaN (do not overwrite previously settled trades)
	to_settle = (log_data["exp"] == today) & pd.isna(log_data["pnl"])
	if not to_settle.any():
		return

	settled_count = 0
	for idx in log_data.index[to_settle]:
		row = log_data.loc[idx]
		is_buy = row.get("is_buy", False) if "is_buy" in row else False

		if is_buy:
			call_pnl = calc_expiry_pnl_buy(row["short_call_strike"], row["long_call_strike"], spx, "Call")
			put_pnl = calc_expiry_pnl_buy(row["short_put_strike"], row["long_put_strike"], spx, "Put")
			premium_paid = row["price"] * row["size"] * 100
			pnl = ((call_pnl + put_pnl) * row["size"] * 100) - premium_paid
		else:
			call_pnl = calc_expiry_pnl_sell(row["short_call_strike"], row["long_call_strike"], spx, "Call")
			put_pnl = calc_expiry_pnl_sell(row["short_put_strike"], row["long_put_strike"], spx, "Put")
			premium_collected = row["price"] * row["size"] * 100
			pnl = ((call_pnl + put_pnl) * row["size"] * 100) + premium_collected

		log_data.loc[idx, "spx_on_exp"] = spx
		log_data.loc[idx, "pnl"] = pnl
		settled_count += 1
		print(f"{ts()} -- [{config['name']}] Settled trade (exp={today}) P&L: {pnl:,.2f}")

	if settled_count > 0:
		log_data.to_csv(log_path, index=False)


def calculate_premium_and_pnl(config, spx, calls, puts, bid_price_spread, is_test=False):
	"""Calculate premium target and size for a strategy based on its log history.
	When is_test and last row is unsettled, uses expiry date's SPX close so sizing matches production."""
	log_folder = config.get("log_folder")
	default_premium = config["default_premium"]
	double_down = config.get("double_down", True)

	# If no log folder or no double-down, just use default premium
	if log_folder is None or not double_down:
		return {
			"premium": default_premium,
			"pnl_tracker": 0,
			"pnl": 0,
			"log_data": pd.DataFrame(),
			"pnl_total": 0
		}

	# Find latest log
	latest_date = get_latest_log_file(log_folder)

	if latest_date is None:
		# No log exists, start fresh
		return {
			"premium": default_premium,
			"pnl_tracker": 0,
			"pnl": 0,
			"log_data": pd.DataFrame(),
			"pnl_total": 0
		}

	log_data = pd.read_csv(f"{log_folder}/{latest_date.strftime('%Y_%m_%d')}.csv")

	if log_data.empty:
		return {
			"premium": default_premium,
			"pnl_tracker": 0,
			"pnl": 0,
			"log_data": log_data,
			"pnl_total": 0
		}

	log_data["trade_date"] = pd.to_datetime(log_data["trade_date"]).apply(lambda x: x.date())
	log_data["exp"] = pd.to_datetime(log_data["exp"]).apply(lambda x: x.date())
	log_data.sort_values(by=["trade_date"], inplace=True)

	# Get the last row (most recent trade)
	last_row = log_data.iloc[[-1]]

	# Check if this was a buy or sell trade
	is_buy = last_row["is_buy"].values[0] if "is_buy" in last_row.columns else False

	# Last trade P&L: use stored value if settled; else compute. When exp <= today use current spx (settled-as-of-today) so sizing is correct.
	if pd.notna(last_row["pnl"].values[0]):
		pnl = last_row["pnl"].values[0]
	else:
		exp_date = last_row["exp"].values[0]
		if exp_date <= today:
			# Expired trade: always use current SPX so "pnl from last" and size reflect settled outcome (defensive if settle_previous_trade didn't run or file was stale).
			spx_for_pnl = spx
		elif is_test:
			try:
				spx_for_pnl = blp.bdh(tickers=["SPX INDEX"], flds="PX_LAST", start_date=exp_date, end_date=exp_date)["SPX INDEX"].values[0][0]
			except Exception as e:
				print(f"Warning: could not fetch SPX for expiry {exp_date} in test mode ({e}), using current spx")
				spx_for_pnl = spx
		else:
			spx_for_pnl = spx

		if is_buy:
			call_pnl = calc_expiry_pnl_buy(last_row["short_call_strike"].values[0], last_row["long_call_strike"].values[0], spx_for_pnl, "Call")
			put_pnl = calc_expiry_pnl_buy(last_row["short_put_strike"].values[0], last_row["long_put_strike"].values[0], spx_for_pnl, "Put")
			premium_paid = last_row["price"].values[0] * last_row["size"].values[0] * 100
			pnl = ((call_pnl + put_pnl) * last_row["size"].values[0] * 100) - premium_paid
		else:
			call_pnl = calc_expiry_pnl_sell(last_row["short_call_strike"].values[0], last_row["long_call_strike"].values[0], spx_for_pnl, "Call")
			put_pnl = calc_expiry_pnl_sell(last_row["short_put_strike"].values[0], last_row["long_put_strike"].values[0], spx_for_pnl, "Put")
			premium_last = last_row["price"].values[0] * last_row["size"].values[0] * 100
			pnl = ((call_pnl + put_pnl) * last_row["size"].values[0] * 100) + premium_last

	pnl_tracker = last_row["pnl_tracker"].values[0] + pnl

	if pnl_tracker > 0:
		premium = default_premium
		pnl_tracker = 0
	else:
		premium = default_premium + abs(pnl_tracker)

	return {
		"premium": premium,
		"pnl_tracker": pnl_tracker,
		"pnl": pnl,
		"log_data": log_data,
		"pnl_total": last_row["pnl_total"].values[0] if "pnl_total" in last_row.columns else 0
	}


def update_log(config, spx, calls, puts, bid_price_spread, size, expiry, premium_data, is_buy=False):
	"""Append today's trade to log and write to today's CSV. Assumes previous row was already settled in settle_previous_trade."""
	log_folder = config.get("log_folder")
	if log_folder is None:
		return
	if not os.path.exists(log_folder):
		os.makedirs(log_folder)

	# premium_data["log_data"] is the latest log we read in calculate_premium_and_pnl (with last row settled)
	log_data = premium_data["log_data"]
	pnl_tracker = premium_data["pnl_tracker"]
	premium = premium_data["premium"]
	pnl_total = premium_data["pnl_total"]
	pnl = premium_data["pnl"]

	# Create new row for today's trade
	new_row = pd.DataFrame({
		"trade_date": [today],
		"exp": [expiry],
		"long_put_strike": [puts["long_strike"]],
		"short_put_strike": [puts["short_strike"]],
		"short_call_strike": [calls["short_strike"]],
		"long_call_strike": [calls["long_strike"]],
		"size": [size],
		"price": [bid_price_spread],
		"spx_on_trade_date": [spx],
		"spx_on_exp": [np.nan],
		"pnl_tracker": [pnl_tracker],
		"pnl_total": [pnl_total + pnl] if not log_data.empty else [0],
		"premium_target": [premium],
		"pnl": [np.nan],
		"atmVol": [calls["vol"]],
		"premium_sold": [bid_price_spread * size * 100],
		"is_buy": [is_buy],
	})

	if not log_data.empty:
		# Append new row to existing history
		log_data = pd.concat([log_data, new_row], ignore_index=True)
	else:
		log_data = new_row

	log_data.sort_values(by=["trade_date"], inplace=True)
	log_data.to_csv(f"{log_folder}/{today.strftime('%Y_%m_%d')}.csv", index=False)


