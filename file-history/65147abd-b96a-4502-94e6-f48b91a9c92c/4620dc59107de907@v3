def ts():
	"""Return current timestamp string for logging with milliseconds."""
	now = getNowEst()
	return now.strftime('%I:%M:%S') + f'.{now.microsecond // 1000:03d}' + now.strftime(' %p')


# ========================== Preview ==========================
def generate_preview(configs, end_of_week, yesterday_implied_move):
	"""Generate a preview of today's trades at current market levels. Sent to chat before the 4pm wait.

	Purely informational - no state is mutated (no log writes, no orders). Each config
	is wrapped in its own try/except so one failure doesn't block the rest. The entire
	function is also wrapped so a preview failure never prevents the real trading flow.
	"""
	from math import ceil
	try:
		spx_snap = blp.bdp("SPX Index", "PX_LAST")
		spx = spx_snap.iloc[0, 0]
		# Cache underlying prices by settlement ticker (SPX always needed; NDX only if configs use it)
		_underlying_cache = {"SPX INDEX": spx}
		lines = [f"PREVIEW (at current levels, SPX: {spx:,.2f}):\n"]

		for config in configs:
			name = config["name"]
			try:
				# Get underlying price for this config's symbol
				_sym = config.get("symbol", "SPXW")
				_ticker = SETTLEMENT_TICKERS.get(_sym, "SPX INDEX")
				if _ticker not in _underlying_cache:
					_snap = blp.bdp(_ticker, "PX_LAST")
					_underlying_cache[_ticker] = _snap.iloc[0, 0]
				_upx = _underlying_cache[_ticker]

				triggered, trigger_info = should_trade(config, end_of_week, yesterday_implied_move, spx=_upx)
				reason = trigger_info.get("reason", "") if trigger_info else ""

				if not triggered:
					lines.append(f"[{name}] Would skip - {reason}")
					continue

				# Direction
				config_direction = config.get("direction", "Sell")
				if config_direction == "Buy/Sell":
					direction = trigger_info.get("direction", "Sell")
				else:
					direction = config_direction
				is_sale = (direction == "Sell")

				# Expiry and spreads
				expiry = get_expiry_for_config(config)
				limit_for_sql_query = 100 if config.get("trigger_condition") == "end_of_week" else 60
				calls = get_spreads_for_expiry("Call", _upx, expiry, symbol=_sym, limit=limit_for_sql_query)
				puts = get_spreads_for_expiry("Put", _upx, expiry, symbol=_sym, limit=limit_for_sql_query)

				if calls is None or puts is None:
					lines.append(f"[{name}] Trigger: {reason}. Could not fetch spreads.")
					continue

				# Price calc via shared compute_bid_ask
				_params = SYMBOL_PARAMS[_sym]
				bid, ask = compute_bid_ask(calls, puts, offset=_params["bid_ask_offset"], tick=_params["bid_ask_tick"])
				price = bid if is_sale else ask

				# Premium and size (read-only log access)
				premium_data = calculate_premium_and_pnl(config, spx, calls, puts, price, is_test=False)
				premium = premium_data["premium"]
				pnl = premium_data["pnl"]

				fixed_size = config.get("fixed_size")
				if fixed_size is not None:
					size = fixed_size
				elif price > 0:
					size = max(round(premium / 100 / price), 1)
				else:
					size = 0

				max_trade_size = config["max_trade_size"]
				size_to_send = min(size, max_trade_size)

				# Format
				direction_str = "SELL" if is_sale else "BUY"
				exp_str = expiry.strftime("%m/%d")
				p_long = puts["long_strike"]
				p_short = puts["short_strike"]
				c_short = calls["short_strike"]
				c_long = calls["long_strike"]

				_idx_label = "NDX" if _sym == "NDXP" else "SPX"
				line = f"[{name}] {_idx_label}: {_upx:,.2f}. *Trigger: {reason}.*"
				if config.get("double_down", True) and config.get("log_folder") is not None:
					line += f" Pnl from last: {pnl:,.2f}. Premium target: {premium:,.2f}."
				else:
					line += f" Premium: {premium:,.2f} (fixed)."
				direction_word = "Selling" if is_sale else "Buying"
				line += f"\n  {direction_word} ~{size_to_send} lot(s) of {exp_str} {p_long:.0f}/{p_short:.0f}/{c_short:.0f}/{c_long:.0f} IC @ ~{price:.2f}."

				if size > max_trade_size:
					line += f"\n  *Must manually {direction_word.lower()} ~{size - max_trade_size} lot(s) for ~{price:.2f} additional.*"

				lines.append(line)

			except Exception as e:
				lines.append(f"[{name}] Preview error: {e}")

		preview_msg = "\n".join(lines)
		print(preview_msg)
		send_message(f"{ts()}\n{preview_msg}", my_chat)

	except Exception as e:
		print(f"{ts()} -- Preview generation failed (non-fatal): {e}")


# ========================== Main ==========================
if __name__ == "__main__":
	print(f"{ts()} -- Script starting...")

	# Prevent running with SEND_TRADES=False in production (would only update implied move and exit)
	if not SEND_TRADES and not IS_TEST:
		raise AssertionError("SEND_TRADES is set to False but IS_TEST is False. This is not allowed.")

	try:
		configs = load_icon_configs()
		print(f"{ts()} -- Loaded {len(configs)} ICON configs: {[c['name'] for c in configs]}")
	except Exception as e:
		print(f"{ts()} -- ERROR loading configs: {e}")
		raise

	# True when next trading day is 3+ calendar days away (e.g. Friday -> Monday); used for end_of_week trigger and weekly expiry
	END_OF_WEEK = (tomorrow - today).days >= 3
	print(f"{ts()} -- END_OF_WEEK={END_OF_WEEK} (tomorrow={tomorrow}, today={today}, days_diff={(tomorrow - today).days})")

	# Get yesterday's implied move for big_move trigger evaluation
	print(f"{ts()} -- Getting yesterday's implied move...")
	try:
		yesterday_implied_move = get_yesterday_implied_move()
		if pd.isna(yesterday_implied_move):
			print(f"{ts()} -- Yesterday's implied move for today: NaN (ICON_BIG_MOVE will not trade)")
		else:
			print(f"{ts()} -- Yesterday's implied move for today: {yesterday_implied_move:.2f}%")
	except Exception as e:
		print(f"{ts()} -- ERROR getting yesterday's implied move: {e}. Setting to NaN (ICON_BIG_MOVE will not trade).")
		yesterday_implied_move = np.nan

	# Start message
	if not IS_TEST:
		print(f"{ts()} -- Sending start message to chat...")
		try:
			send_message(f"{ts()} Starting ICON v3 script.", my_chat)
		except Exception as e:
			print(f"{ts()} -- ERROR sending start message: {e}")

	# Preview of today's trades at current market levels (non-test only)
	warm_up_bloomberg_connection()   # startup: generate_preview below is this script's first Bloomberg call (see helpers)
	if not IS_TEST:
		generate_preview(configs, END_OF_WEEK, yesterday_implied_move)

	summary = f"{dt.date.today().strftime('%m/%d/%Y')} {'4pm Condor v3' if not IS_TEST else 'TEST'} RECAP:\n\n"

	if END_OF_WEEK:
		summary += "Today is end of week, also trading weekly ICONS.\n\n"

	# Wait until 4:00:15 PM (or LAST_HOUR + 1)
	print(f"{ts()} -- Waiting until {LAST_HOUR}:00:15...")
	while getNowEst().time() <= dt.time(7 if IS_TEST else LAST_HOUR - 1, 59, 20):
		time.sleep(30)
	while getNowEst().time() <= dt.time(7 if IS_TEST else LAST_HOUR, 0, 15):
		time.sleep(1)
	print(f"{ts()} -- Wait complete. Proceeding with data collection...")

	# Drop preview-time cache entries so every phase-2 chain pull is fresh.
	_run_query_cache.clear()

	# Get SPX price (always needed for daily PnL tracking and SPX configs)
	print(f"{ts()} -- Fetching SPX price from Bloomberg...")
	try:
		spx = blp.bdp("SPX Index", "PX_LAST").iloc[0, 0]
		print(f"{ts()} -- SPX price: {spx:.2f}")
	except Exception as e:
		print(f"{ts()} -- ERROR fetching SPX price: {e}")
		raise

	# Cache underlying prices by settlement ticker; fetch additional tickers if any config needs them
	underlying_prices = {"SPX INDEX": spx}
	needed_tickers = set(SETTLEMENT_TICKERS[cfg.get("symbol", "SPXW")] for cfg in configs) - {"SPX INDEX"}
	for ticker in needed_tickers:
		try:
			px = blp.bdp(ticker, "PX_LAST").iloc[0, 0]
			underlying_prices[ticker] = px
			print(f"{ts()} -- {ticker} price: {px:.2f}")
		except Exception as e:
			print(f"{ts()} -- ERROR fetching {ticker} price: {e}")
			raise

	summary += f"SPX (settlement): {spx:,.2f}\n\n"

	# Settle any expired rows in iron_condor_daily_pnl.csv (so mean_reversion streak is up to date)
	if not IS_TEST:
		print(f"{ts()} -- Settling daily P&L for streak tracking...")
		try:
			settle_daily_pnl(spx)
		except Exception as e:
			print(f"{ts()} -- ERROR settling daily P&L: {e}")

	# Tomorrow's implied move: used in recap; saved to CSV only when not IS_TEST
	print(f"{ts()} -- Calculating tomorrow's implied move...")
	try:
		tomorrow_implied_move = get_implied_move_for_tomorrow()
		print(f"{ts()} -- Tomorrow's implied move: {tomorrow_implied_move:.2f}%")
		if not IS_TEST:
			save_implied_move_for_tomorrow(tomorrow_implied_move)
			print(f"{ts()} -- Saved implied move to {IMPLIED_MOVE_FILE}")
	except Exception as e:
		print(f"{ts()} -- ERROR calculating/saving implied move: {e}")
		tomorrow_implied_move = None

	if tomorrow_implied_move is not None:
		summary += f"Tomorrow's implied move: {tomorrow_implied_move:.2f}%\n\n"

	if not SEND_TRADES:
		msg = f"{ts()} -- SEND_TRADES=False. Exiting without sending trades."
		if not IS_TEST:
			msg = f"{ts()} -- SEND_TRADES=False. Updated implied move file. Exiting without sending trades."
		print(msg)
		summary += "SEND_TRADES=False. No trades sent.\n"
		print(summary)
		try:
			send_message(f"{ts()}\n" + summary, my_chat)
		except Exception as e:
			print(f"{ts()} -- ERROR sending summary message: {e}")
		exit()

	# Daily P&L tracking: one row per day with tomorrow's expiry spreads; used only for mean_reversion streak (sell/buy PnL). Saved so we can settle tomorrow.
	print(f"{ts()} -- Fetching spreads for daily P&L tracking...")
	try:
		calls_for_tracking = get_spreads_for_expiry("Call", spx, tomorrow, limit=60)
		puts_for_tracking = get_spreads_for_expiry("Put", spx, tomorrow, limit=60)
		_params = SYMBOL_PARAMS["SPXW"]
		bid_price_tracking, ask_price_tracking = compute_bid_ask(calls_for_tracking, puts_for_tracking, offset=_params["bid_ask_offset"], tick=_params["bid_ask_tick"])

		if not IS_TEST:
			save_daily_pnl(
				trade_date=today,
				expiry=tomorrow,
				calls=calls_for_tracking,
				puts=puts_for_tracking,
				bid_price=bid_price_tracking,
				ask_price=ask_price_tracking,
				spx_at_trade=spx,
				atmVol=calls_for_tracking["vol"]
			)
	except Exception as e:
		print(f"{ts()} -- ERROR with daily P&L tracking: {e}")

	trades = []           # Coroutines from send_complex_two_waves (awaited later)
	trade_summaries = []  # Lines for recap message
	errors = []

	print(f"{ts()} -- Processing {len(configs)} strategies...")
	for config in configs:
		name = config["name"]
		print(f"{ts()} -- [{name}] Starting evaluation...")

		try:
			# Resolve symbol and underlying price for this config
			_sym = config.get("symbol", "SPXW")
			_ticker = SETTLEMENT_TICKERS.get(_sym, "SPX INDEX")
			_upx = underlying_prices[_ticker]

			# Settle last row of this strategy's log with today's underlying (so premium/size calc and pnl_tracker are correct). Skip in test to avoid overwriting with wrong price.
			if not IS_TEST and config.get("log_folder") is not None:
				print(f"{ts()} -- [{name}] Settling previous trade if needed...")
				settle_previous_trade(config, _upx)

			print(f"{ts()} -- [{name}] Checking trigger condition '{config.get('trigger_condition')}'...")
			should_trade_result, trigger_info = should_trade(config, END_OF_WEEK, yesterday_implied_move, spx=_upx)

			if not should_trade_result:
				trigger_cond = config.get('trigger_condition')
				skip_msg = f"[{name}] Skipped - trigger condition '{trigger_cond}' not met."
				if trigger_info and "reason" in trigger_info:
					skip_msg += f" ({trigger_info['reason']})"
				print(f"{ts()} -- {skip_msg}")
				trade_summaries.append(skip_msg + "\n")
				continue

			print(f"{ts()} -- [{name}] Trigger condition met. Processing trade...")

			# Determine direction based on config
			config_direction = config.get("direction", "Sell")
			if config_direction == "Buy/Sell":
				# Dynamic direction from trigger_info
				direction = trigger_info.get("direction", "Sell")
			else:
				direction = config_direction

			is_sale = (direction == "Sell")
			print(f"{ts()} -- [{name}] Direction: {direction} (is_sale={is_sale})")

			# Determine account
			account = config["test_account"] if IS_TEST else config["account"]
			# Sending test orders to v8 -> route to the v8 test account (T.AGM* only exists on v7).
			if IS_TEST and SEND_V8 and str(account).startswith("T.AGM"):
				account = "T.AGMV8.01"
			max_trade_size = config["max_trade_size"]
			print(f"{ts()} -- [{name}] Account: {account}, Max size: {max_trade_size}")

			# Get expiry for this strategy
			expiry = get_expiry_for_config(config)
			limit_for_sql_query = 100 if config.get("trigger_condition") == "end_of_week" else 60
			print(f"{ts()} -- [{name}] Expiry: {expiry}, Query limit: {limit_for_sql_query}")

			# Get spreads
			print(f"{ts()} -- [{name}] Fetching call spreads...")
			calls = get_spreads_for_expiry("Call", _upx, expiry, symbol=_sym, limit=limit_for_sql_query)
			print(f"{ts()} -- [{name}] Call spread: {calls['short_strike']:.0f}/{calls['long_strike']:.0f} @ {calls['spread_price_mid']:.2f}")

			print(f"{ts()} -- [{name}] Fetching put spreads...")
			puts = get_spreads_for_expiry("Put", _upx, expiry, symbol=_sym, limit=limit_for_sql_query)
			print(f"{ts()} -- [{name}] Put spread: {puts['long_strike']:.0f}/{puts['short_strike']:.0f} @ {puts['spread_price_mid']:.2f}")

			# Price used for sizing and log: for sell use bid (we receive); for buy use ask (we pay).
			_params = SYMBOL_PARAMS[_sym]
			_bid, _ask = compute_bid_ask(calls, puts, offset=_params["bid_ask_offset"], tick=_params["bid_ask_tick"])
			if is_sale:
				bid_price_spread = _bid
				print(f"{ts()} -- [{name}] SELL price (bid): {bid_price_spread:.2f}")
			else:
				bid_price_spread = _ask  # Reuse var for "price of the trade"
				print(f"{ts()} -- [{name}] BUY price (ask): {bid_price_spread:.2f}")

			# Calculate premium and P&L (reads log from disk here; no cache, so settled pnl from settle_previous_trade above is visible)
			print(f"{ts()} -- [{name}] Calculating premium and P&L...")
			premium_data = calculate_premium_and_pnl(config, spx, calls, puts, bid_price_spread, is_test=IS_TEST)
			premium = premium_data["premium"]
			pnl = premium_data["pnl"]
			print(f"{ts()} -- [{name}] Premium: {premium:.2f}, P&L from last: {pnl:.2f}")

			if not premium > 0:
				raise ValueError(f"Premium is not greater than 0 ({premium}). Cannot proceed.")

			# Calculate size
			fixed_size = config.get("fixed_size")
			if fixed_size is not None:
				# Use fixed size (e.g., mean reversion strategy)
				size = fixed_size
				print(f"{ts()} -- [{name}] Using fixed size: {size}")
			else:
				# Use premium-based sizing (existing behavior)
				size = max([round(premium / 100 / bid_price_spread), 1])
			size_to_send = min([size, max_trade_size])
			size_unsent = size - size_to_send
			print(f"{ts()} -- [{name}] Size: {size}, size_to_send: {size_to_send}, size_unsent: {size_unsent}")

			# send_complex_two_waves expects short_legs/long_legs; for buy we pass legs reversed so we buy the former short and sell the former long. is_sale=True is API convention (we're still "selling" the combo to the venue).
			# Sells use standard duration/edge; buys rest longer (BUY_ORDER_DURATION) and quote tighter (BUY_EDGE_MULTIPLIER).
			print(f"{ts()} -- [{name}] Creating trade order (is_sale={is_sale})...")
			if is_sale:
				short_legs = [calls["short_option"], puts["short_option"]]
				long_legs = [calls["long_option"], puts["long_option"]]
				order_duration, edge_mult = SELL_ORDER_DURATION, 1.0
			else:
				# Buy: swap legs (buy the normally-long, sell the normally-short)
				short_legs = [calls["long_option"], puts["long_option"]]
				long_legs = [calls["short_option"], puts["short_option"]]
				order_duration, edge_mult = BUY_ORDER_DURATION, BUY_EDGE_MULTIPLIER

			# 8/28/2026: bad SR surface (uPrcAdjResult=OtherError) mheld fills ~2 min; refresh_legs now logs
			# surface health at W2. If it recurs, consider a wave-3 with simple limit prices (no surface check).
			trades.append(send_complex_two_waves(
				symbol=_sym,
				size=size_to_send,
				short_legs=short_legs,
				long_legs=long_legs,
				exp=expiry,
				account=account,
				edge_target1=EDGE_TARGET_4_LEGGED_1 * edge_mult,
				max_edge1=MAX_EDGE_4_LEGGED_1 * edge_mult,
				edge_target2=EDGE_TARGET_4_LEGGED_2 * edge_mult,
				max_edge2=MAX_EDGE_4_LEGGED_2 * edge_mult,
				is_sale=True,
				orderDuration=order_duration,
				userData=f"4PM {name}" + ("" if is_sale else " BUY")
			))
			print(f"{ts()} -- [{name}] Trade order created.")

			# Update log (only in production and if strategy has a log folder)
			if not IS_TEST:
				print(f"{ts()} -- [{name}] Updating log file...")
				try:
					update_log(config, _upx, calls, puts, bid_price_spread, size, expiry, premium_data, is_buy=not is_sale)
					print(f"{ts()} -- [{name}] Log updated.")
				except Exception as log_e:
					print(f"{ts()} -- [{name}] ERROR updating log: {log_e}")

			# Recap line: trigger reason, premium/pnl_tracker, direction, size, strikes, price; mention if size capped
			trigger_cond = config.get("trigger_condition")
			direction_str = "Buying" if not is_sale else "Selling"
			_idx_label = "NDX" if _sym == "NDXP" else "SPX"
			strat_summary = f"[{name}] {_idx_label}: {_upx:,.2f}."
			if trigger_info and "reason" in trigger_info:
				strat_summary += f" *Trigger: {trigger_info['reason']}.*"

			if config.get("double_down", True) and config.get("log_folder") is not None:
				strat_summary += f" Pnl from last: {pnl:,.2f}. Premium target: {premium:,.2f}."
			else:
				strat_summary += f" Premium: {premium:,.2f} (fixed)."

			strat_summary += f"\n  {direction_str} {size_to_send} lot(s) of {expiry.strftime('%m/%d')} {puts['long_strike']:.0f}/{puts['short_strike']:.0f}/{calls['short_strike']:.0f}/{calls['long_strike']:.0f} IC @ {bid_price_spread:.2f}.\n"

			if size_unsent > 0:
				strat_summary += f"  *Must manually {direction_str.lower()} {size_unsent} lot(s) for {bid_price_spread:.2f} additional.*\n"

			trade_summaries.append(strat_summary)
			print(f"{ts()} -- [{name}] Processing complete.")

		except Exception as e:
			error_msg = f"[{name}] ERROR: {str(e)}"
			print(f"{ts()} -- {error_msg}")
			errors.append(error_msg)
			trade_summaries.append(f"[{name}] FAILED - {str(e)}\n")
			continue  # Process remaining configs

	# Fire all orders concurrently (send_complex_two_waves returns coroutines)
	print(f"{ts()} -- Sending {len(trades)} trade(s)...")
	if trades:
		try:
			async def send_all_trades():
				await asyncio.gather(*trades)
			asyncio.run(send_all_trades())
			print(f"{ts()} -- All trades sent successfully.")
		except Exception as e:
			print(f"{ts()} -- ERROR sending trades: {e}")
			errors.append(f"Trade sending error: {str(e)}")

	# Final summary
	summary += "\n".join(trade_summaries)

	if errors:
		summary += "\n\n*ERRORS:*\n" + "\n".join(errors)

	print(f"{ts()} -- Final summary:")
	print(summary)

	print(f"{ts()} -- Sending summary to chat...")
	try:
		send_message(f"{ts()}\n" + summary, my_chat)
		print(f"{ts()} -- Summary sent.")
	except Exception as e:
		print(f"{ts()} -- ERROR sending summary: {e}")

	print(f"{ts()} -- Script complete.")
