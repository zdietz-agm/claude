def warm_up_bloomberg_connection(verbose=True):
	"""Open this process's xbbg/blpapi session up front so the first REAL Bloomberg
	call does not pay the session-start cost inside a time-critical window.
	Returns elapsed ms (None if Bloomberg was unreachable). Never raises.

	WHY (observed 9/11/26 and 9/14/26): a process's first xbbg call pays
	blpapi.Session.start() once. Normally ~10-200ms, but on both days it was 16.3s
	for EVERY fresh process -- save_spy_prices.py's 15:49:58 SPY snap took 16464ms,
	340PM_script's get_market_measurements took 16.5s (0.3s the day before), and
	350pm_stock_script's get_change_in_realized ran past its 15:50:03 gate. The
	blpapi TRACE log puts the 16s between "blpapidapisup dll loaded" and "bbcomm
	started": blpapi's Desktop API layer tries to launch/handshake its own
	bbcomm.exe before falling back to the one already listening on 127.0.0.1:8194.

	ROOT CAUSE (proven 9/14/26): bbcomm.exe was running in Windows Session 0. The
	UpdateDataEOD scheduled task (07:16, logon type Password = non-interactive) was
	the first Bloomberg client of the day because no interactive bbcomm existed --
	the Bloomberg Updater ran the evening of 9/10, and the PC rebooted 9/11 17:28.
	Its blpapi spawned bbcomm in Session 0, and every Session-1 client then stalled
	16s on start. Killing that bbcomm (needs an elevated Stop-Process; plain
	taskkill is Access Denied) let the next call spawn a Session-1 bbcomm and
	Session.start dropped to 12ms. Days with a live Session-1 bbcomm at 07:16
	(9/3-9/10) never showed the lag. Check: powershell
	"Get-Process bbcomm | select Id,SessionId" -> SessionId should be 1.

	Call this ~30-50s BEFORE the script's first real Bloomberg call, right after a
	wait_until to a fixed clock time, so the cost lands in idle time but the session
	is fresh for the fire. Scripts that share a first-call time stagger their
	warm-ups 3s apart (3:40 cluster: 15:39:15 355pm, :18 355pm_v8, :21 340PM,
	:24 350PM, :27 350PM_fast, :30 350pm_v8; then 15:47:16 350pm_ss, 15:49:05
	350pm_stock, 15:49:08 save_spy_prices, 15:49:11 355pm_stock) so bbcomm never
	sees simultaneous session starts. It only helps in-process blp.* callers (all
	prod algos); bloomberg_helpers.my_bdh/my_bdp spawn a child process per call
	and each child pays its own Session.start().
	Repro / timing script: D:/agent_projects/adhoc/spy_price_first_call_lag_test.py"""
	t0 = time.perf_counter()
	try:
		from xbbg.core import conn
		conn.bbg_session()
		conn.bbg_service("//blp/refdata")
		blp.bdp("SPY US Equity", "PX_LAST")   # dummy call: exercises the full request path
	except Exception as e:
		print(f"{pretty_time()} -- WARNING: warm_up_bloomberg_connection failed "
			  f"({type(e).__name__}: {e}); first real Bloomberg call will connect instead.", flush=True)
		return None
	ms = (time.perf_counter() - t0) * 1000
	if verbose:
		print(f"{pretty_time()} -- Bloomberg connection warm in {ms:.0f}ms", flush=True)
	if ms > 5000:
		print(f"{pretty_time()} -- NOTE: >5s warm-up usually means bbcomm.exe is in Session 0 "
			  f"(spawned by a pre-logon scheduled task). Check: powershell "
			  f"\"Get-Process bbcomm | select Id,SessionId\"; kill it from an elevated shell.", flush=True)
	return ms


def get_market_measurements(return_spy_price=False):
	"""Compute market type / today's return / rolling std from SPY historicals.

	return_spy_price=True returns a 4-tuple (market, today_ret, std, spy_price_now) so
	callers can skip a separate blp.bdp SPY snap -- the bdh with end_date=today already
	includes today's live PX_LAST at position -1. Default False preserves the legacy
	3-tuple return for existing callers.
	"""
	start = x_days_ago(LOOKBACK + 1)
	close = blp.bdh(tickers=[x + " US EQUITY" for x in ["SPY"]], flds=['px_last'], start_date=start,
					end_date=dt.date.today(), adjust="all")
	rets = close.pct_change().dropna()
	std = rets.iloc[:-1].std()

	today_move = (rets.iloc[-1] / std.mul(.5)).values[0]

	if today_move > 1:
		market = "UP"
	elif today_move < -1:
		market = "DOWN"
	else:
		market = "FLAT"

	if return_spy_price:
		return market, rets.iloc[-1].values[0], std.values[0], close.iloc[-1, 0]
	return market, rets.iloc[-1].values[0], std.values[0]

def get_market_measurements_qqq():
	"""Get QQQ market ratio for NDX factor evaluation.

	Returns qqq_market_ratio as ret / rolling_std (NOT divided by 2).
	This matches the backtest formula in update_data.py:396 where
	market_ratio = ret / rolling_std.

	Note: SPY's get_market_measurements() returns ret / (std * 0.5) which
	is 2x the backtest scale, but its thresholds (1.0 for UP/DOWN) are also
	2x the backtest thresholds (0.5), so SPY's UP/DOWN/FLAT classification
	matches the backtest exactly.
	For QQQ, we return on the backtest scale directly because config thresholds
	(e.g. 0.8) were calibrated on that scale.
	"""
	start = x_days_ago(LOOKBACK + 1)
	close = blp.bdh(tickers=["QQQ US EQUITY"], flds=['px_last'],
					start_date=start, end_date=dt.date.today(), adjust="all")
	rets = close.pct_change().dropna()
	std = rets.iloc[:-1].std().values[0]
	today_return = rets.iloc[-1].values[0]
	qqq_market_ratio = today_return / std  # backtest scale, no 0.5 multiplier
	return qqq_market_ratio, today_return, std


def get_change_in_realized(n=3 * 22):
	end = last_trade_day()
	start = x_days_ago(n + 2)
	closes = blp.bdh(tickers=["SPY US EQUITY"], flds=['px_last'], start_date=start, end_date=end, adjust="all")
	log_rets = (np.log(closes.shift(-1)) - np.log(closes)).shift(1).dropna()

	def calc_realized(x):
		return (x.tail(n).sum() * 252 / n) ** .5

	diff = calc_realized(log_rets.pow(2).tail(n)) - calc_realized(log_rets.pow(2).head(n))
	return diff.iloc[0]

def get_change_in_realized_biz_day_method(days=90):
	end = last_trade_day()
	start = dt.date.today() - dt.timedelta(days=days)
	if start not in trading_range(x_days_ago(1, start), x_days_ahead(1, start)):
		start = x_days_ago(1, start)
	start = x_days_ago(2, start)
	closes = blp.bdh(tickers=["SPY US EQUITY"], flds=['px_last'], start_date=start, end_date=end, adjust="all")
	log_rets = (np.log(closes.shift(-1)) - np.log(closes)).shift(1).dropna()
	def calc_realized(x):
		return (x.sum() * 252 / len(x)) ** .5

	diff = calc_realized(log_rets.pow(2).iloc[1:]) - calc_realized(log_rets.pow(2).iloc[:-1])

	return diff.iloc[0]

def calculate_rsi(daily_returns):
	ups = daily_returns[daily_returns > 0]
	downs = abs(daily_returns[daily_returns < 0])
	if len(downs) == 0:
		RS = 9e9
	elif len(ups) == 0:
		RS = 0
	else:
		RS = np.average(ups) / np.average(downs)
	return round(100 - (100 / (1 + RS)), 2)


def get_rsi(today_ret):
	# last 2 days of returns
	close = blp.bdh("SPY US EQUITY", "px_last", start_date=x_days_ago(3), end_date=dt.date.today())
	rets = close.pct_change().dropna().iloc[0:2][("SPY US EQUITY", "px_last")].to_list()
	rets = np.array(rets + [float(today_ret)])
	return calculate_rsi(rets)


