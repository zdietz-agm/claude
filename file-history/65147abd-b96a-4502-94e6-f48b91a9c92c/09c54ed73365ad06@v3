def get_vix_edge_multiplier(vix, base=20, floor=0.85, cap=3.0): # increased floor from .7 to .85
	"""Scale edge values with VIX. 1x at VIX=20, +1x per 7 above, -0.5x per 7 below.
	LEGACY -- retained for EDGE_OFFSET_OUTRIGHT scaling and any callers not yet migrated
	to compute_edge_mult. New 350PM/355PM path uses compute_edge_mult below."""
	if vix >= base:
		mult = 1 + (vix - base) / 7
	else:
		mult = 1 - (base - vix) / 7
	return round(max(floor, min(cap, mult)), 2)

