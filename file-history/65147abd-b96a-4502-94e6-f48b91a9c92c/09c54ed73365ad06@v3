# --- Fill-aggressiveness add-ons (2026-07-24) -------------------------------------------------
# Two additive dollar offsets layered ON TOP of the regime edges (ET1/ME1/ET2/ME2) to reduce
# missed fills. Positive = more aggressive (matches takesurfPrcoffset semantics). Each add-on is
# capped independently at ADDON_PCT_CAP * sprc, so on wave-2 both can stack (up to 6% of sprc).
# Applied centrally in orchestrate_batched_send off FINAL (post-loss-cap) sizes; 2-legged credit
# spreads only (complex + price > 0).
EDGE_MULTIPLIER       = 100      # SPX/NDX contract multiplier (mirrors spdr_rock_order_functions.MULTIPLIER)
ADDON_PCT_CAP         = 0.03     # neither add-on exceeds 3% of the spread's sprc
# Add-on #1 (premium): bigger per-ORDER premium -> more aggressive so big-dollar orders don't miss.
PREM_ADDON_LO_PREMIUM = 9_000   # below this ($ premium): no add-on
PREM_ADDON_HI_PREMIUM = 20_000   # at/above this: add-on flat at PREM_ADDON_HI_ADD
PREM_ADDON_LO_ADD     = 0.01     # add-on at LO_PREMIUM
PREM_ADDON_HI_ADD     = 0.07     # add-on at/above HI_PREMIUM
# Add-on #2 (wave-1 underfill): if W1 filled < this fraction of total sent FOR THAT OPTION TYPE
# (Call vs Put, bucketed in orchestrate_batched_send), bump that type's WAVE-2 edges by
# W1_UNDERFILL_ADD (flat, no ramp).
W1_UNDERFILL_RATIO    = 0.10
W1_UNDERFILL_ADD      = 0.07


def compute_premium_add_on(size, sprc):
	"""Add-on #1: dollar edge bump scaling with total ORDER premium (size * sprc * multiplier)
	so large-dollar orders are worked more aggressively and don't miss. Linear from
	PREM_ADDON_LO_PREMIUM->HI_PREMIUM (LO_ADD->HI_ADD), zero below, flat above; capped at
	ADDON_PCT_CAP * sprc.
	Args:
		size -- final (post-loss-cap) number of spreads being sent
		sprc -- surface price (net credit) of the 2-legged spread
	"""
	if size <= 0 or sprc <= 0:
		return 0.0
	premium = size * sprc * EDGE_MULTIPLIER
	if premium < PREM_ADDON_LO_PREMIUM:
		raw = 0.0
	elif premium >= PREM_ADDON_HI_PREMIUM:
		raw = PREM_ADDON_HI_ADD
	else:
		raw = PREM_ADDON_LO_ADD + (PREM_ADDON_HI_ADD - PREM_ADDON_LO_ADD) * \
			(premium - PREM_ADDON_LO_PREMIUM) / (PREM_ADDON_HI_PREMIUM - PREM_ADDON_LO_PREMIUM)
	return round(min(raw, ADDON_PCT_CAP * sprc), 3)


def compute_wave1_underfill_add_on(total_w1_sent, total_w1_filled, sprc):
	"""Add-on #2: flat dollar edge bump applied to WAVE-2 edges when wave-1 filled less than
	W1_UNDERFILL_RATIO of the wave-1 quantity sent (a near-total W1 miss). Caller buckets sent/filled
	by option type (Call vs Put) in orchestrate_batched_send and passes the per-type totals here, so
	a fully filled book of one type doesn't mask a total miss of the other. No ramp; capped at
	ADDON_PCT_CAP * sprc.
	Args:
		total_w1_sent   -- wave-1 qty sent for this option-type bucket
		total_w1_filled -- wave-1 fills for this option-type bucket
		sprc            -- surface price (net credit) of the spread being bumped
	"""
	if total_w1_sent <= 0 or sprc <= 0:
		return 0.0
	if (total_w1_filled / total_w1_sent) < W1_UNDERFILL_RATIO:
		return round(min(W1_UNDERFILL_ADD, ADDON_PCT_CAP * sprc), 3)
	return 0.0


def compute_edge_mult_factor(vix_level, atm_vol_0dte, abs_imbal, abs_chg_imbal=None, abs_chg_stats=None):
	"""Composite edge multiplier = mean of three (default) or four (if abs_chg_imbal given)
	per-factor multipliers. No clipping on per-factor or composite values; the dict [lo, hi]
	window in compute_edge_mult below is the only bound on the final output.

	abs_chg_imbal is opt-in: the change-in-imbal factor (350PM: 3:40->3:50; 355PM: 3:50->3:55).
	Callers that omit it stay a 3-factor mean, byte-identical to prior behavior.
	abs_chg_stats: which {mean,std} to z-score abs_chg_imbal against; defaults to
	ABS_CHG_IMBAL_STATS (the empirical set used by 350PM/FAST). 355PM overrides with its
	intentionally-low ABS_CHG_IMBAL_STATS_355PM.
	"""
	z_vix   = (vix_level    - VIX_STATS["mean"])       / VIX_STATS["std"]
	z_vol   = (atm_vol_0dte - ATM_VOL_STATS["mean"])   / ATM_VOL_STATS["std"]
	z_imbal = (abs_imbal    - ABS_IMBAL_STATS["mean"]) / ABS_IMBAL_STATS["std"]
	if abs_chg_imbal is None:
		return ((1 + z_vix) + (1 + z_vol) + (1 + z_imbal)) / 3.0
	stats = abs_chg_stats if abs_chg_stats is not None else ABS_CHG_IMBAL_STATS
	z_chg = (abs_chg_imbal - stats["mean"]) / stats["std"]
	return ((1 + z_vix) + (1 + z_vol) + (1 + z_imbal) + (1 + z_chg)) / 4.0


def compute_edge_mult(vix_level, atm_vol_0dte, abs_imbal, srprc, edge_config, abs_chg_imbal=None, abs_chg_stats=None):
	"""Return the final $ edge for a 2-legged credit-spread trade, rounded to the nearest cent.

	edge_config keys: target, min_dollar_value, max_dollar_value, min_pct_of_sprc, max_pct_of_sprc.
	Pipeline:
	  raw_edge = target * compute_edge_mult_factor(...)
	  lo       = max(min_dollar_value, min_pct_of_sprc/100 * srprc)
	  hi       = min(max_dollar_value, max_pct_of_sprc/100 * srprc)
	  final    = clip(raw_edge, lo, hi).
	Inverted window (lo > hi) -> return hi (tighter cap wins).
	abs_chg_stats forwarded to compute_edge_mult_factor (see there).
	"""
	edge_mult = compute_edge_mult_factor(vix_level, atm_vol_0dte, abs_imbal, abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats)
	raw_edge  = edge_config["target"] * edge_mult

	lo_dollar = edge_config["min_dollar_value"]
	hi_dollar = edge_config["max_dollar_value"]
	lo_pct    = edge_config["min_pct_of_sprc"] / 100.0 * srprc
	hi_pct    = edge_config["max_pct_of_sprc"] / 100.0 * srprc

	lo = max(lo_dollar, lo_pct)
	hi = min(hi_dollar, hi_pct)
	if lo > hi:
		return round(hi, 2)
	return round(max(lo, min(hi, raw_edge)), 2)


