def apply_closer_resize(trade_dict, log_fn=None):
	"""355PM-specific: when a CLOSER variant trades, decrement its parent's
	traded size by the CLOSER's size so combined exposure stays consistent
	with the parent's original target. Parent floors at 1 lot if it was
	originally trading. Mutates trade_dict in place. Returns nothing.

	Single source of truth: both 355pm_script.py and simulate_prod.py call
	this function so behavior cannot drift.

	`log_fn` is an optional callable for log lines (e.g. print). If None,
	the function runs silently.

	Detection: a CLOSER is "triggering" iff it appears in trade_dict["trades"]
	with size > 0 (prep_trades only appends size>0 trades, but apply_size_limits
	may have knocked a trade down to 0 -- so we re-check size here).
	"""
	any_closer_triggering = any(
		t["name"].endswith("_CLOSER") and t["size"] > 0
		for t in trade_dict["trades"]
	)
	if not any_closer_triggering:
		return
	if log_fn:
		log_fn("Starting Resize Trades (CLOSER offsets)")
	for closer_trade in trade_dict["trades"]:
		if not closer_trade["name"].endswith("_CLOSER"):
			continue
		closer_size = closer_trade["size"]
		if closer_size <= 0:
			continue
		parent_name = closer_trade["name"][:-len("_CLOSER")]
		# Match the CLOSER's side (Put vs Call) to the parent's same side.
		side = "Put" if "Put" in closer_trade["structure"] else "Call"
		for parent_trade in trade_dict["trades"]:
			if parent_trade["name"] != parent_name:
				continue
			if side not in parent_trade["structure"]:
				continue
			old_size = parent_trade["size"]
			if old_size <= 0:
				continue  # parent didn't trade -- nothing to offset
			new_size = max(1, old_size - closer_size)
			if new_size != old_size:
				if log_fn:
					log_fn(f"Resize: {parent_name} {side} {old_size} -> {new_size} (offset by CLOSER size {closer_size})")
				parent_trade["size"] = new_size
			break  # only reached on the matching parent; stop searching
	if log_fn:
		log_fn("Finished Resize Trades")


def load_configs_from_directory(directory, time, priority_algos=None):
    """Load config modules whose filename matches `time`. Returns the enabled/active configs.
    priority_algos: optional list of algo names. Configs whose 'name' matches go to the front
                    of the returned list, in priority-list order; non-priority configs keep
                    their existing (filename-alpha) order. Names in priority_algos that don't
                    match any loaded config are printed as a warning so typos surface early.
    """
    configs = []

    for filename in os.listdir(directory):
        if filename.endswith(".py") and (time in filename):
            filepath = os.path.join(directory, filename)

            # Load module from file
            spec = importlib.util.spec_from_file_location("module.name", filepath)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)

            # Extract config if it exists
            if hasattr(module, "config"):
                configs.append(module.config)

    # pare down configs to only ones that are active and enabled
    active = [cfg for cfg in configs if (cfg.get("size_target", False) or (cfg.get("dollar_target", 0) != 0)) and cfg.get("enabled", True)]

    if priority_algos:
        prio_idx = {name: i for i, name in enumerate(priority_algos)}
        # Stable sort: priority (tier 0, sorted by priority index) then non-priority (tier 1, preserve order).
        active.sort(key=lambda c: (0, prio_idx[c["name"]]) if c.get("name") in prio_idx else (1, 0))
        loaded_names = {c.get("name") for c in active}
        unmatched = [name for name in priority_algos if name not in loaded_names]
        if unmatched:
            print(f"{pretty_time()} -- [load_configs] WARNING: priority_algos contains {len(unmatched)} name(s) with no matching config: {unmatched}")
    return active


def load_configs_from_directory_for_stock(directory, time, is_month_end=False, is_fed_day=False, is_serial=False, fast_only=False):
	"""Load stock strategy configs from directory, filtering based on special day flags.

	Args:
		directory: path to directory containing config files
		time: time string to filter config filenames (e.g. "350PM")
		is_month_end: bool, if True only load configs with allowed_on_month_end=True
		is_fed_day: bool, if True only load configs with allowed_on_fed=True
		is_serial: bool, if True only load configs with allowed_on_serial=True
		fast_only: if True only load fast configs; if False skip fast configs
	"""
	configs = []

	for filename in os.listdir(directory):
		if filename.endswith(".py") and (time in filename):
			filepath = os.path.join(directory, filename)

			# Load module from file
			spec = importlib.util.spec_from_file_location("module.name", filepath)
			module = importlib.util.module_from_spec(spec)
			spec.loader.exec_module(module)

			# Extract config if it exists
			if hasattr(module, "config"):
				# On month ends, only load configs that are allowed on month ends
				if is_month_end and not module.config.get("allowed_on_month_end", False):
					continue
				# On fed days, only load configs that are allowed on fed days
				if is_fed_day and not module.config.get("allowed_on_fed", False):
					continue
				# On serial expiry days, only load configs that are allowed on serials
				if is_serial and not module.config.get("allowed_on_serial", True):
					continue
				configs.append(module.config)

	# Filter fast vs non-fast configs
	if fast_only:
		configs = [c for c in configs if c.get("fast", False)]
	else:
		configs = [c for c in configs if not c.get("fast", False)]

	# pare down configs to only ones that are active and enabled
	return [cfg for cfg in configs if (cfg.get("size_target", False) or (cfg.get("dollar_target", 0) != 0)) and cfg.get("enabled", True)]

def _get_size(row,
		 cp_type="P",
		 call_dont_trade_factors=[],
		 call_trade_factors=[None],
		 call_small_trade_factors=[],
		 put_dont_trade_factors=[],
		 put_trade_factors=[None],
		 put_small_trade_factors=[],
		explanation_name=""
	):
	if cp_type == "C":
		for col, val in call_dont_trade_factors:
			if row[col] == val:
				explanation = f"*Don't trade Call{explanation_name}* because {col} = {val}.\n"
				size = 0
				return size, explanation
		for col, val in call_trade_factors:
			if row[col] == val:
				explanation = f"*Trade Call{explanation_name}* because {col} = {val}.\n"
				size = 1
				return size, explanation
		for col, val in call_small_trade_factors:
			if row[col] == val:
				explanation = f"*Trade Call{explanation_name}* half size because {col} = {val}.\n"
				size = .5
				return size, explanation
		return 0, f"No conditions met for Call{explanation_name}.\n"
	if cp_type == "P":
		for col, val in put_dont_trade_factors:
			if row[col] == val:
				explanation = f"*Don't trade Put{explanation_name}* because {col} = {val}.\n"
				size = 0
				return size, explanation
		for col, val in put_trade_factors:
			if row[col] == val:
				explanation = f"*Trade Put{explanation_name}* because {col} = {val}.\n"
				size = 1
				return size, explanation
		for col, val in put_small_trade_factors:
			if row[col] == val:
				explanation = f"*Trade Put{explanation_name}* half size because {col} = {val}.\n"
				size = .5
				return size, explanation
		return 0, f"No conditions met for Put{explanation_name}.\n"

