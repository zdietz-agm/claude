		FROM   EODStrategies.t_Monitor_ImbalanceMonitorSnaps
		WHERE  runDate = :run_date
		  AND  period = 'Close'
		  AND  offset = 20
		  AND  tsSnapTime IN :snap_times
		  AND  userName = :user_name
		ORDER BY tsSnapTime ASC
		LIMIT 1
	""").bindparams(sql.bindparam("snap_times", expanding=True))

	def _try(engine, query, col, label, attempt, extra=None):
		try:
			params = {"run_date": run_date, "user_name": IMBAL_USERNAME}
			if extra:
				params.update(extra)
			df = pd.read_sql_query(query, engine, params=params)
			if not df.empty:
				val = df.iloc[0][col]
				if pd.notna(val) and val != 0:
					return float(val)
		except Exception as e:
			print(f"get_340_imbal: attempt {attempt}/{max_attempts} {label} errored: {e}")
		return None

	try:
		for attempt in range(1, max_attempts + 1):
			val = _try(basket_engine, basket_sql, "totalNetImbalance", "BasketSnapshots", attempt)
			if val is not None:
				print(f"get_340_imbal: got value from BasketSnapshots on attempt {attempt}/{max_attempts} ({val/1e9:+.2f}B)")
				return val
			val = _try(monitor_engine, monitor_sql, "netImbalance", "MonitorSnaps", attempt,
			           extra={"snap_times": list(SNAP_TIMES_340)})
			if val is not None:
				print(f"get_340_imbal: got value from MonitorSnaps (fallback) on attempt {attempt}/{max_attempts} ({val/1e9:+.2f}B)")
				return val

			if attempt < max_attempts:
				print(f"get_340_imbal: both sources returned no data on attempt {attempt}/{max_attempts}. Retrying in {sleep_between}s.")
				time.sleep(sleep_between)

		print("WARNING: get_340_imbal exhausted all retries. Returning NO_IMBAL_VAL.")
		return NO_IMBAL_VAL
	finally:
		basket_engine.dispose()
		monitor_engine.dispose()

