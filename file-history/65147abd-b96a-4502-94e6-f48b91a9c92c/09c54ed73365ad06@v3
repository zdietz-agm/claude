def get_340_imbal(is_test=False, test_imbal=-.6e9, max_attempts=7, sleep_between=1.0):
	"""Pull 3:40pm SPX imbalance, trying two sources per attempt (mirrors get_350_imbal).

	Per attempt:
	  1. imbalanceSnapshots.t_imbal_BasketSnapshots (.SPX, totalNetImbalance, 15:40:00-15:40:50)
	  2. EODStrategies.t_Monitor_ImbalanceMonitorSnaps (Close / offset 20, SNAP_TIMES_340) [fallback]
	Both filtered to userName = IMBAL_USERNAME; zero/null is treated as no-data. If both miss,
	sleeps sleep_between and retries (up to max_attempts). Each query has a 0.5s timeout. Returns
	scalar or NO_IMBAL_VAL.

	is_test=True, test_imbal=<num>  -> returns <num> immediately, no DB call.
	is_test=True, test_imbal=None   -> runs real queries against x_days_ago(1) (last trade day).
	"""
	if is_test and test_imbal is not None:
		return test_imbal

	run_date = (x_days_ago(1) if is_test else dt.date.today()).strftime("%Y-%m-%d")

	basket_engine = create_engine(
		f'mysql+pymysql://{VBAM_USERNAME}:{VBAM_PASSWORD}@{VBAM_HOSTNAME}/imbalanceSnapshots',
		connect_args={"read_timeout": 0.5, "write_timeout": 0.5, "connect_timeout": 0.5},
	)
	basket_sql = sql.text("""
		SELECT totalNetImbalance
		FROM   imbalanceSnapshots.t_imbal_BasketSnapshots
		WHERE  runDate = :run_date
		  AND  userName = :user_name
		  AND  basket = '.SPX'
		  AND  snapTimestamp BETWEEN '15:40:00' AND '15:40:50'
		  AND  totalNetImbalance <> 0.0
		ORDER BY snapTimestamp ASC
		LIMIT 1
	""")

	monitor_engine = create_engine(
		f'mysql+pymysql://{VBAM_USERNAME}:{VBAM_PASSWORD}@{VBAM_HOSTNAME}/{VBAM_DATABASE}',
		connect_args={"read_timeout": 0.5, "write_timeout": 0.5, "connect_timeout": 0.5},
