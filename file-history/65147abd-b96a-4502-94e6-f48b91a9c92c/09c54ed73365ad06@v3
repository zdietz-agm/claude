				atm_vol_0dte=None,
				abs_imbal=None,
				abs_chg_imbal=None,
				abs_chg_stats=None,
				is_test=False,
				puts_size_mult=1.0,
				calls_size_mult=1.0):
	"""Build trade dicts from configs. New regime-aware edge sizing for 2-legged credit
	spreads activates if at least 2 of (vix, atm_vol_0dte, abs_imbal) are provided -- the
	missing one(s) default to their VIX_STATS/ATM_VOL_STATS/ABS_IMBAL_STATS mean. The
	new path is skipped for outrights (separate code branch) and for debit spreads
	(price < 0); both fall back to the legacy EDGE_TARGET_2_LEGGED_* scalars.
	"""
	# Decide whether to use regime-aware edge sizing for 2-legged credit spreads.
	_provided = sum(x is not None for x in (vix, atm_vol_0dte, abs_imbal))
	use_regime_edges = (_provided >= 2)
	if use_regime_edges:
		# Fill any missing input with its mean so the math still produces a sensible mult.
		if vix          is None: vix          = VIX_STATS["mean"]
		if atm_vol_0dte is None: atm_vol_0dte = ATM_VOL_STATS["mean"]
		if abs_imbal    is None: abs_imbal    = ABS_IMBAL_STATS["mean"]

	trade_dict = {"trades": [], "explanations": [], "trade_types": []}
	explanations_dict = {}
	MIN_MAGNET_DISTANCE = 29  # don't sell options within this many points of a magnet

	for config in configs:
		# Route each config to its symbol's option chain
		symbol = config.get("symbol", "SPXW")
		chain = option_chains[symbol]
		puts = chain["puts"]
		calls = chain["calls"]
		spx = chain["underlying"]
		edge_mult = NDX_EDGE_MULT if symbol == "NDXP" else 1

		call_size, put_size = 0, 0  # set to 0 to start as safeguard

		put_mult, put_explanation = get_size(factor_dict,
											 "P",
											 call_dont_trade_factors=config["call_dont_trade_factors"],
											 call_trade_factors=config["call_trade_factors"],
											 call_small_trade_factors=config["call_small_trade_factors"],
											 put_dont_trade_factors=config["put_dont_trade_factors"],
											 put_trade_factors=config["put_trade_factors"],
											 put_small_trade_factors=config["put_small_trade_factors"],
											 explanation_name=config["explanation_name"])
		call_mult, call_explanation = get_size(factor_dict,
											   "C",
											   call_dont_trade_factors=config["call_dont_trade_factors"],
											   call_trade_factors=config["call_trade_factors"],
											   call_small_trade_factors=config["call_small_trade_factors"],
											   put_dont_trade_factors=config["put_dont_trade_factors"],
											   put_trade_factors=config["put_trade_factors"],
											   put_small_trade_factors=config["put_small_trade_factors"],
											   explanation_name=config["explanation_name"])

		# Bucket-based size multiplier -- scales dollar_target/size_target per trade based on
		# which factor tuple currently matches. 1.0x if config has no size_multiplier_factors
		# or no rule matches.
		size_mult = resolve_size_multiplier(factor_dict, config.get("size_multiplier_factors", []))
		# Side-specific bucket multipliers (opt-in keys; absent -> 1.0 -> no behavior change).
		# Compose multiplicatively with the side-agnostic size_mult. Added 8/7/26 so a rule can
		# scale ONE side (e.g. 0.5x puts on high realized-vol-change days) without touching calls.
		put_bucket_mult  = size_mult * resolve_size_multiplier(factor_dict, config.get("put_size_multiplier_factors", []))
		call_bucket_mult = size_mult * resolve_size_multiplier(factor_dict, config.get("call_size_multiplier_factors", []))

		# Per-side spread-sale mult from the caller (script-level SIZE_MULT_XXX_PUTS/CALLS). Only
		# applies to 2-legged credit spreads (Sell direction with BOTH short + long legs present).
		# Outright shorts + debit spreads (Buy) pass through unchanged. Scales dollar_target,
		# size_target, AND max_size in the block below.
		_is_sell = config["direction"] == "Sell"
		_puts_extra_mult  = puts_size_mult  if (_is_sell and config.get("short_put_strikes")  and config.get("long_put_strikes"))  else 1.0
		_calls_extra_mult = calls_size_mult if (_is_sell and config.get("short_call_strikes") and config.get("long_call_strikes")) else 1.0

		# PUTS

		puts_cp = puts.copy()
		# Drop put strikes closer than min_strike_distance dollars from spot.
		# Literal-dollar semantics; negative msd allows up to |msd| ITM.
		msd = config["min_strike_distance"]
		puts_cp = puts_cp[(spx - puts_cp.okey_xx) >= msd].copy()

		price = 0
		for strike in config["short_put_strikes"]:
			price += puts_cp.iloc[strike].obid
		for strike in config["long_put_strikes"]:
			price -= puts_cp.iloc[strike].oask
		price = price.round(2)
		# FIX: floor sell credit spread net entry at $0.05 to prevent negative/tiny price from blowing up sizing
		if config["direction"].lower() == "sell" and len(config["short_put_strikes"]) > 0 and len(config["long_put_strikes"]) > 0 and a_lt_b(a=price, b=0.05):
			price = 0.05
		# print(f"Debug: Price is {price} for puts.")

		if config["dollar_target"]:
			# Use abs() on both dollar_target and price so Buy (debit) configs with negative
			# dollar_target / negative price still produce positive size.
			put_size = 0 if price==0 else put_mult * ceil(abs(config["dollar_target"] * put_bucket_mult * _puts_extra_mult) / (abs(price) * 100))
		if config["size_target"]:
			put_size = put_mult * config["size_target"] * put_bucket_mult * _puts_extra_mult
		put_size = ceil(put_size)
		if put_bucket_mult != 1.0 and put_size > 0:
			put_explanation += f"*Put{config['explanation_name']} size multiplier* {put_bucket_mult}x applied.\n"
		if _puts_extra_mult != 1.0 and put_size > 0:
			put_explanation += f"*Put{config['explanation_name']} side mult* {_puts_extra_mult}x applied.\n"

		if put_size > 0:
			if config["min_price"] and a_lt_b(a=abs(price), b=config["min_price"]):
				put_size = 0
				put_explanation += f"*Don't trade Put{config['explanation_name']}* because price = {price} < min price {config['min_price']}.\n"
			# Opt-in: when allow_scale_up_of_max_size=True, the size_multiplier_factors
			# value scales max_size too (not just dollar_target). Legacy configs lack
			# the flag and see identical pre-existing behavior (effective_max = max_size).
			# size_mult < 1.0 ALWAYS scales max_size down (no flag needed -- strictly
			# risk-reducing; without it a sub-1.0 mult is a no-op on cap-bound days).
			# EDGE (known + accepted 8/7/26): on a FLAGGED config, if the agnostic size_mult
			# is > 1.0 while a side bucket mult is < 1.0, the scale-UP branch wins and the
			# side-down is ignored for the cap. No config can hit this today (BTIC is the
			# only flagged config and has no side rules) -- revisit if that ever changes.
			if config.get("allow_scale_up_of_max_size", False) and size_mult > 1.0:
				effective_max = int(ceil(config["max_size"] * size_mult)) if config["max_size"] else 0
			elif config["max_size"] and put_bucket_mult < 1.0:
				effective_max = int(config["max_size"] * put_bucket_mult)  # truncate: errs conservative
			else:
				effective_max = config["max_size"]
			# Also apply per-side mult to max_size (int truncation -- errs conservative on caps).
			if effective_max and _puts_extra_mult != 1.0:
				effective_max = int(effective_max * _puts_extra_mult)
			if effective_max and put_size > effective_max:
				put_size = effective_max
				_reason = "config max size" if effective_max == config["max_size"] else "unmapped reason"
				put_explanation += f"*Put{config['explanation_name']} sized down* to {put_size} due to {_reason}.\n"
			if config["max_price"] and a_gt_b(a=abs(price), b=config["max_price"]):
				put_size = 0
				put_explanation += f"*Don't trade Put{config['explanation_name']}* because price = {price} > max price {config['max_price']}.\n"
			if config["min_size"] and put_size < config["min_size"]:
				put_size = config["min_size"]
				put_explanation += f"*Put{config['explanation_name']} sized up* to {put_size}."

			if price == 0:
				put_size = 0
				put_explanation += f"*Don't trade Put{config['explanation_name']}* because price = {price}.\n"

			# check to make sure you are not selling puts near a magnet (SPX only)
			if magnets and config["direction"] != "Buy" and symbol == "SPXW":
				for i in config["short_put_strikes"]:
					strike = puts_cp.iloc[i].okey_xx
					too_close_to_magnet = any([
						(strike >= magnet and strike - magnet <= MIN_MAGNET_DISTANCE) or
						(strike < magnet and magnet - strike < 7)
						for magnet in magnets
					])
					if too_close_to_magnet:
						put_size = 0
						put_explanation += f"*Don't trade Put{config['explanation_name']}* because short strike {strike} is too close to a magnet.\n"
						break

		if trigger_all and (put_size == 0):
			put_size = trigger_all_size
			put_explanation += f"*Trade Put{config['explanation_name']}* because trigger_all is set.\n"
			if magnets and config["direction"] != "Buy" and symbol == "SPXW":
				for i in config["short_put_strikes"]:
					strike = puts_cp.iloc[i].okey_xx
					too_close_to_magnet = any([
						(strike >= magnet and strike - magnet <= MIN_MAGNET_DISTANCE) or
						(strike < magnet and magnet - strike < 7)
						for magnet in magnets
					])
					if too_close_to_magnet:
						put_size = 0
						put_explanation += f"*Don't trade Put{config['explanation_name']}* because short strike {strike} is too close to a magnet.\n"
						break

		trade, trade_type = {}, ""
		if config["short_put_strikes"] and config["long_put_strikes"] and put_size > 0:
			# Regime-aware edges for credit spreads only; debit spreads (price < 0) and
			# legacy callers (use_regime_edges=False) fall back to old scalars.
			if use_regime_edges and price > 0:
				_et1, _me1, _et2, _me2 = compute_trade_edges(vix, atm_vol_0dte, abs_imbal, price, abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats)
			else:
				_et1, _me1 = EDGE_TARGET_2_LEGGED_1, MAX_EDGE_2_LEGGED_1
				_et2, _me2 = EDGE_TARGET_2_LEGGED_2, MAX_EDGE_2_LEGGED_2
			trade = {
				"name": config["name"],
				"symbol": config["symbol"],
				"size": put_size,
				"short_legs": [puts_cp.iloc[x] for x in config["short_put_strikes"]],
				"long_legs": [puts_cp.iloc[x] for x in config["long_put_strikes"]],
				"exp": today,
				"account": config["account"],
				"direction": config["direction"],
				"edge_target1": _et1 * edge_mult,
				"max_edge1": _me1 * edge_mult,
				"edge_target2": _et2 * edge_mult,
				"max_edge2": _me2 * edge_mult,
				"is_sale": config["direction"] == "Sell",
				"structure": f"Put{config['explanation_name']}",
				"price": price,
				"min_price": config["min_price"]
			}
			trade_type = "complex"
			print_algo_traded_banner(trade)
		elif (config["short_put_strikes"] or config["long_put_strikes"]) and put_size > 0:
			trade = {
				"name": config["name"],
				"symbol": config["symbol"],
				"cp": "Put",
				"option": puts_cp.iloc[config["short_put_strikes"][0]] if config["short_put_strikes"] else puts_cp.iloc[
					config["long_put_strikes"][0]],
				"size": put_size,
				"account": config["account"],
				"direction": config["direction"],
				"offset": EDGE_OFFSET_OUTRIGHT,
				"structure": f"Put{config['explanation_name']}",
				"price": price,
				"min_price": config["min_price"]
			}
			trade_type = "outright"

		if trade_type:
			trade_dict["trades"].append(trade)
			trade_dict["explanations"].append(put_explanation)
			trade_dict["trade_types"].append(trade_type)

		# CALLS

		calls_cp = calls.copy()
		# Drop call strikes closer than min_strike_distance dollars from spot.
		# Literal-dollar semantics; negative msd allows up to |msd| ITM.
		msd = config["min_strike_distance"]
		calls_cp = calls_cp[(calls_cp.okey_xx - spx) >= msd].copy()

		price = 0
		for strike in config["short_call_strikes"]:
			price += calls_cp.iloc[strike].obid
		for strike in config["long_call_strikes"]:
			price -= calls_cp.iloc[strike].oask
		price = price.round(2)
		# FIX: floor sell credit spread net entry at $0.05 to prevent negative/tiny price from blowing up sizing
		if config["direction"].lower() == "sell" and len(config["short_call_strikes"]) > 0 and len(config["long_call_strikes"]) > 0 and a_lt_b(a=price, b=0.05):
			price = 0.05
		# print(f"Debug: Price is {price} for calls.")

		if config["dollar_target"]:
			# Use abs() on both dollar_target and price so Buy (debit) configs with negative
			# dollar_target / negative price still produce positive size.
			call_size = 0 if price==0 else call_mult * config["call_put_ratio"] * ceil(abs(config["dollar_target"] * call_bucket_mult * _calls_extra_mult) / (abs(price) * 100))
		if config["size_target"]:
			call_size = call_mult * config["call_put_ratio"] * config["size_target"] * call_bucket_mult * _calls_extra_mult
		call_size = ceil(call_size)
		if call_bucket_mult != 1.0 and call_size > 0:
			call_explanation += f"*Call{config['explanation_name']} size multiplier* {call_bucket_mult}x applied.\n"
		if _calls_extra_mult != 1.0 and call_size > 0:
			call_explanation += f"*Call{config['explanation_name']} side mult* {_calls_extra_mult}x applied.\n"

		if call_size > 0:
			if config["min_price"] and a_lt_b(a=abs(price), b=config["min_price"]):
				call_size = 0
				call_explanation += f"*Don't trade Call{config['explanation_name']}* because price = {price} < min price {config['min_price']}.\n"
			# See put-side comment above re allow_scale_up_of_max_size opt-in flag
			# (and re bucket_mult < 1.0 always scaling max_size down).
			if config.get("allow_scale_up_of_max_size", False) and size_mult > 1.0:
				effective_max = int(ceil(config["max_size"] * size_mult)) if config["max_size"] else 0
			elif config["max_size"] and call_bucket_mult < 1.0:
				effective_max = int(config["max_size"] * call_bucket_mult)  # truncate: errs conservative
			else:
				effective_max = config["max_size"]
			# Also apply per-side mult to max_size (int truncation -- errs conservative on caps).
			if effective_max and _calls_extra_mult != 1.0:
				effective_max = int(effective_max * _calls_extra_mult)
			if effective_max and call_size > effective_max:
				call_size = effective_max
				_reason = "config max size" if effective_max == config["max_size"] else "unmapped reason"
				call_explanation += f"*Call{config['explanation_name']} sized down* to {call_size} due to {_reason}.\n"
			if config["max_price"] and a_gt_b(a=abs(price), b=config["max_price"]):
				call_size = 0
				call_explanation += f"*Don't trade Call{config['explanation_name']}* because price = {price} > max price {config['max_price']}.\n"
			if config["min_size"] and call_size < config["min_size"]:
				call_size = config["min_size"]
				call_explanation += f"*Call{config['explanation_name']} sized up* to {call_size}."

			if price == 0:
				# price must equal 0
				call_size = 0
				call_explanation += f"*Don't trade Call{config['explanation_name']}* because price = {price}.\n"

			# check to make sure you are not selling calls near a magnet (SPX only)
			if magnets and config["direction"] != "Buy" and symbol == "SPXW":
				for i in config["short_call_strikes"]:
					strike = calls_cp.iloc[i].okey_xx
					too_close_to_magnet = any([
						(strike <= magnet and magnet - strike <= MIN_MAGNET_DISTANCE) or
						(strike > magnet and strike - magnet < 7)
						for magnet in magnets
					])
					if too_close_to_magnet:
						call_size = 0
						call_explanation += f"*Don't trade Call{config['explanation_name']}* because short strike {strike} is too close to a magnet.\n"
						break

		if trigger_all and (call_size == 0):
			call_size = trigger_all_size
			call_explanation += f"*Trade Call{config['explanation_name']}* because trigger_all is set.\n"
			if magnets and config["direction"] != "Buy" and symbol == "SPXW":
				for i in config["short_call_strikes"]:
					strike = calls_cp.iloc[i].okey_xx
					too_close_to_magnet = any([
						(strike <= magnet and magnet - strike <= MIN_MAGNET_DISTANCE) or
						(strike > magnet and strike - magnet < 7)
						for magnet in magnets
					])
					if too_close_to_magnet:
						call_size = 0
						call_explanation += f"*Don't trade Call{config['explanation_name']}* because short strike {strike} is too close to a magnet.\n"
						break


		trade, trade_type = {}, ""
		if config["short_call_strikes"] and config["long_call_strikes"] and call_size > 0:
			# Regime-aware edges for credit spreads only; debit spreads (price < 0) and
			# legacy callers (use_regime_edges=False) fall back to old scalars.
			if use_regime_edges and price > 0:
				_et1, _me1, _et2, _me2 = compute_trade_edges(vix, atm_vol_0dte, abs_imbal, price, abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats)
			else:
				_et1, _me1 = EDGE_TARGET_2_LEGGED_1, MAX_EDGE_2_LEGGED_1
				_et2, _me2 = EDGE_TARGET_2_LEGGED_2, MAX_EDGE_2_LEGGED_2
			trade = {
				"name": config["name"],
				"symbol": config["symbol"],
				"size": call_size,
				"short_legs": [calls_cp.iloc[x] for x in config["short_call_strikes"]],
				"long_legs": [calls_cp.iloc[x] for x in config["long_call_strikes"]],
				"exp": today,
				"account": config["account"],
				"direction": config["direction"],
				"edge_target1": _et1 * edge_mult,
				"max_edge1": _me1 * edge_mult,
				"edge_target2": _et2 * edge_mult,
				"max_edge2": _me2 * edge_mult,
				"is_sale": config["direction"] == "Sell",
				"structure": f"Call{config['explanation_name']}",
				"price": price,
				"min_price": config["min_price"]
			}
			trade_type = "complex"
			print_algo_traded_banner(trade)
		elif (config["short_call_strikes"] or config["long_call_strikes"]) and call_size > 0:
			trade = {
				"name": config["name"],
				"symbol": config["symbol"],
				"cp": "Call",
				"option": calls_cp.iloc[config["short_call_strikes"][0]] if config["short_call_strikes"] else
				calls_cp.iloc[config["long_call_strikes"][0]],
				"size": call_size,
				"account": config["account"],
				"direction": config["direction"],
				"offset": EDGE_OFFSET_OUTRIGHT,
				"structure": f"Call{config['explanation_name']}",
				"price": price,
				"min_price": config["min_price"]
			}
			trade_type = "outright"

		if trade_type:
			trade_dict["trades"].append(trade)
			trade_dict["explanations"].append(call_explanation)
			trade_dict["trade_types"].append(trade_type)

		explanations_dict[config["name"]] = {'put': put_explanation, 'call': call_explanation}

	return trade_dict, explanations_dict

def read_spy_data(file_path="spy_data.csv"):
	"""Read SPY price data from CSV (written by save_spy_prices.py)."""
	try:
		return pd.read_csv(file_path, parse_dates=["label", "request_ts", "return_ts"])
	except Exception as e:
		print(f"Failed to read SPY data file: {e}")
		return pd.DataFrame()

def getFirstTick(IS_TEST=False, window_seconds=5, retries=5, wait_between_retries=0.1, test_tick_bps=None):
	"""Get first tick in raw decimal (multiply by 100*100 for bps).

	Uses the labeled SPY samples bracketing the imbalance print at 15:50:00.
	(SPY last trade since 9/1/26; previously the SPX calculated index, whose ~1/sec
	recalculation lagged the tape and read pre-imbalance at the 1-second anchor.)
	The label-15:50:00 sample is the LAST pre-imbalance snap (fired ~300ms early),
	so it counts as the pre anchor:
	    1-sec mode: (first SPY label >= 15:50:01) - (last SPY label <= 15:50:00)
	    5-sec mode: (first SPY label >= 15:50:05) - (last SPY label <= 15:50:00)

	If the result is NaN (data not yet present), waits wait_between_retries
	seconds and retries up to `retries` times before giving up.

	Args:
		IS_TEST: test mode; gates the test_tick_bps override (otherwise unused)
		window_seconds: 5 = anchor end at 15:50:05 (default), 1 = anchor end at 15:50:01 (fast)
		retries: max number of retries when result is NaN (default 5)
		wait_between_retries: seconds to sleep between retries (default 0.1)
		test_tick_bps: test-mode first-tick override in BPS, None = read the CSV
	"""
	# Test-mode override, mirroring get_340_imbal / get_350_imbal's (is_test, test_imbal) pattern.
	# Taken in BPS because that is the unit every caller works in, then converted to the raw
	# decimal this function contracts to return -- callers' own *100*100 recovers the bps exactly.
	# Needed because spy_data.csv is written by save_spy_prices.py, which test runs do not launch.
	if IS_TEST and test_tick_bps is not None:
		return test_tick_bps / 1e4

	start_boundary = dt.time(LAST_HOUR, 50, 0)
	end_boundary = dt.time(LAST_HOUR, 50, 1) if window_seconds == 1 else dt.time(LAST_HOUR, 50, 5)

	file_path = "spy_data.csv"

	def _compute():
		for _ in range(3):
			df = read_spy_data(file_path)
			if not df.empty:
				break
			print("Empty data found while reading SPY data, sleeping for .1 seconds and retrying...")
			time.sleep(0.1)

		if df.empty:
			print("No data available.")
			return np.nan

		# Start anchor: last label at or before 15:50:00 (the pre-imbalance snap)
		pre_df = df[df['label'].dt.time <= start_boundary]
		if pre_df.empty:
			print(f"No pre-{start_boundary} SPY label available.")
			return np.nan
		start_row = pre_df.iloc[-1]

		# End anchor: first label at/after the end boundary
		post_df = df[df['label'].dt.time >= end_boundary]
		if post_df.empty:
			print(f"No post-{end_boundary} SPY label available.")
			return np.nan
		end_row = post_df.iloc[0]

		return (end_row.SPY - start_row.SPY) / start_row.SPY

	for attempt in range(retries + 1):
		result = _compute()
		if not pd.isna(result):
			return result
		if attempt < retries:
			print(f"getFirstTick got NaN on attempt {attempt + 1}/{retries + 1}, sleeping {wait_between_retries}s and retrying...")
			time.sleep(wait_between_retries)

	return np.nan


