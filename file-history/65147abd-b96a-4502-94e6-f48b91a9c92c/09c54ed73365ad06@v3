def resolve_size_multiplier(factor_dict, size_multiplier_factors):
	"""Return the first matching multiplier from size_multiplier_factors, or 1.0 if no match.

	size_multiplier_factors: list of (factor_tuple, multiplier) where factor_tuple is a
	tuple of (col, val) pairs that must ALL hold simultaneously for the multiplier to apply.

	Rules are evaluated in order; first match wins. Rules should be mutually exclusive by
	construction -- typically each rule includes a side-specific imbal trigger (e.g.
	factor_355_imbal_less_than_minus_1p5b for puts, factor_355_imbal_greater_than_1p5B for
	calls), so put-rules cannot match on a day the call-rule is meant to catch.
	"""
	if not size_multiplier_factors:
		return 1.0
	for factor_tuple, mult in size_multiplier_factors:
		if all(factor_dict.get(col) == val for col, val in factor_tuple):
			return float(mult)
	return 1.0


def _get_size_n_factors(row, cp_type, dont_trade_factors, trade_factors,
						small_trade_factors, explanation_name=""):
	"""Evaluate factor tuples with any number of (factor, value) pairs per tuple."""
	side = "Call" if cp_type == "C" else "Put"

	for factor_tuple in dont_trade_factors:
		if all(row[col] == val for col, val in factor_tuple):
			parts = " and ".join(f"{col} = {val}" for col, val in factor_tuple)
			return 0, f"*Don't trade {side}{explanation_name}* because {parts}.\n"

	for factor_tuple in trade_factors:
		if all(row[col] == val for col, val in factor_tuple):
			parts = " and ".join(f"{col} = {val}" for col, val in factor_tuple)
			return 1, f"*Trade {side}{explanation_name}* because {parts}.\n"

	for factor_tuple in small_trade_factors:
		if all(row[col] == val for col, val in factor_tuple):
			parts = " and ".join(f"{col} = {val}" for col, val in factor_tuple)
			return 0.5, f"*Trade {side}{explanation_name}* half size because {parts}.\n"

	return 0, f"No conditions met for {side}{explanation_name}.\n"

def get_size(row,
		 cp_type="P",
		 call_dont_trade_factors=[],
		 call_trade_factors=[None],
		 call_small_trade_factors=[],
		 put_dont_trade_factors=[],
		 put_trade_factors=[None],
		 put_small_trade_factors=[],
		explanation_name=""):
	try:
		# Detect max tuple length across all non-empty factor lists
		max_tuple_len = 0
		for flist in [call_trade_factors, put_trade_factors, call_dont_trade_factors,
					  put_dont_trade_factors, call_small_trade_factors, put_small_trade_factors]:
			if flist and flist[0] is not None and isinstance(flist[0], tuple) and isinstance(flist[0][0], tuple):
				max_tuple_len = max(max_tuple_len, len(flist[0]))

		if max_tuple_len >= 3:
			# N-factor path: route pre-split lists to _get_size_n_factors
			if cp_type == "C":
				return _get_size_n_factors(row, cp_type, call_dont_trade_factors,
					call_trade_factors, call_small_trade_factors, explanation_name)
			else:
				return _get_size_n_factors(row, cp_type, put_dont_trade_factors,
					put_trade_factors, put_small_trade_factors, explanation_name)
		elif (call_trade_factors and (len(call_trade_factors[0][0]) == 2)) or (put_trade_factors and (len(put_trade_factors[0][0]) == 2)):
			return _get_size_two_factors(row, cp_type, call_dont_trade_factors, call_trade_factors, call_small_trade_factors,
				put_dont_trade_factors, put_trade_factors, put_small_trade_factors, explanation_name)
		else:
			return _get_size(row, cp_type, call_dont_trade_factors, call_trade_factors, call_small_trade_factors,
				put_dont_trade_factors, put_trade_factors, put_small_trade_factors, explanation_name)
	except KeyError as e:
		available = sorted([k for k in row.keys() if k.startswith("factor_")])
		raise KeyError(
			f"\n\nFactor {e} not found in combined data.\n"
			f"If this is a custom factor from custom_test_factors.py, make sure to run:\n\n"
			f"    from custom_test_factors import add_custom_factors\n"
			f"    combined = add_custom_factors(combined)\n"
			f"    test_strategy('CONFIG_NAME', combined=combined)\n\n"
			f"Available factor columns: {available}"
		) from None


