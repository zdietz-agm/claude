def insert_before_parent(trade_dict, new_trade, new_trade_type, parent_trade):
	"""Insert `new_trade` (a CLOSER or bumped derivative) into trade_dict IMMEDIATELY BEFORE
	its parent trade so it (a) inherits the parent's send-order priority and (b) fires ahead
	of the parent -- the derivative typically carries the bulk of the size while the parent
	is decremented to min_size, so the bigger order goes to SR first.

	Uses identity lookup (`t is parent_trade`) so subsequent inserts that shifted the parent's
	index still resolve correctly. Falls back to append if the parent isn't found (defensive;
	shouldn't happen with identity-safe iteration in the caller)."""
	for j, t in enumerate(trade_dict["trades"]):
		if t is parent_trade:
			trade_dict["trades"].insert(j, new_trade)
			trade_dict["trade_types"].insert(j, new_trade_type)
			return
	# Fallback -- parent not found in trade_dict.
	trade_dict["trades"].append(new_trade)
	trade_dict["trade_types"].append(new_trade_type)


def compute_trade_edges(vix_level, atm_vol_0dte, abs_imbal, srprc, abs_chg_imbal=None, abs_chg_stats=None):
	"""Return the 4-tuple (edge_target1, max_edge1, edge_target2, max_edge2) for a 2-legged
	credit-spread trade at the given regime inputs + structure srprc. Single source of truth
	used by prep_trades(), closer_spread_trader, and bumped_spread_trader -- so all three
	produce identical edges for the same (regime, srprc) inputs.

	abs_chg_imbal is opt-in (350PM: 3:40->3:50; 355PM: 3:50->3:55). When None, 3-factor formula
	is used. abs_chg_stats selects the z-score {mean,std} for abs_chg_imbal (default
	ABS_CHG_IMBAL_STATS; 355PM passes ABS_CHG_IMBAL_STATS_355PM)."""
	return (
		compute_edge_mult(vix_level, atm_vol_0dte, abs_imbal, srprc, EDGE_TARGET_2_LEGGED_1_NEW, abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats),
		compute_edge_mult(vix_level, atm_vol_0dte, abs_imbal, srprc, MAX_EDGE_2_LEGGED_1_NEW,    abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats),
		compute_edge_mult(vix_level, atm_vol_0dte, abs_imbal, srprc, EDGE_TARGET_2_LEGGED_2_NEW, abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats),
		compute_edge_mult(vix_level, atm_vol_0dte, abs_imbal, srprc, MAX_EDGE_2_LEGGED_2_NEW,    abs_chg_imbal=abs_chg_imbal, abs_chg_stats=abs_chg_stats),
	)


equivalents_cache = {}
def myGetSpyEquivalent(strike):
	if strike in equivalents_cache:
		return equivalents_cache[strike]

	# get the equivalent SPY strike
	equivalent = getSpyEquivalents([strike])[0]
	equivalents_cache[strike] = equivalent
	return equivalent

def is_month_end():
	today = dt.date.today()
	tomorrow = x_days_ahead(1)
	return not (today.month == tomorrow.month)

def is_fed_day(date=None):
	"""Check if a given date (or today) is a Fed announcement day."""
	if date is None:
		date = dt.date.today()
	return date in _cal.FEDS

def likely_stale_calendars():
	"""Warn if SERIALS, FEDS, or QUARTERLIES calendars look stale. Returns warning string or empty string.
	Reads the lists off the calendar_utils module handle (_cal) so a reload is honored."""
	warnings = []

	if _cal.SERIALS:
		max_serial = max(_cal.SERIALS)
		if max_serial < x_days_ago(15):
			warnings.append(f"SERIALS may be stale (max={max_serial})")

	if _cal.FEDS:
		max_fed = max(_cal.FEDS)
		if max_fed < x_days_ago(22):
			warnings.append(f"FEDS may be stale (max={max_fed})")

	if _cal.QUARTERLIES:
		# Quarterlies are ~90 days apart; warn if forward coverage is under 30 days.
		# The BTIC ticker resolver needs at least ROLL_DAYS_BEFORE_EXPIRY (3) trading
		# days of lookahead, so 30 calendar days is a comfortable buffer.
		max_q = max(_cal.QUARTERLIES)
		if max_q < x_days_ahead(30):
			warnings.append(f"QUARTERLIES may be stale (max={max_q})")

	return "\nWARNING: ".join([""] + warnings).strip() if warnings else ""

def create_counter(seed=0):
    """Return a thread-safe monotonic counter. Wraps itertools.count(...).__next__ which is
    implemented in C and atomic under the GIL -- safe to call concurrently from asyncio.to_thread
    workers (required now that spdr_rock_order_functions parallelizes SR INSERTs across threads).
    Returns seed, seed+1, seed+2, ... on successive calls (matches the original closure semantics)."""
    import itertools
    return itertools.count(seed).__next__

def get_engine(username, password, host, db_name, driver='mysql+pymysql'):
    return create_engine(f'{driver}://{username}:{password}@{host}/{db_name}')

def to_percentile_string(x, n=5):
	if n == 5:
		mult = 20
	elif n == 10:
		mult = 10
	else:
		raise AssertionError("Invalid argument for to_percentile_string.")

	percentile = (x + 1) * mult
	if percentile < 51:
		return f"<{percentile:.0f}th %"
	return f">{(percentile - mult):.0f}th %"

