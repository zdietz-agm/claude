def pull_chains_for_symbols(symbols):
    """One SQL round-trip for option chains of all qualifying symbols.
    Returns df with okey_tk, okey_xx, okey_cp, uprc, sprc, obid, oask, okey_yr/mn/dy.
    Filters to today's expiry and strikes within +/- 1% of underlying."""
    today = dt.date.today()
    in_clause = ", ".join(f"'{s}'" for s in symbols)
    chain_sql = f"""
        SELECT okey_tk, okey_xx, okey_cp, uprc, sprc, obid, oask,
               okey_yr, okey_mn, okey_dy
        FROM {_srof.IMPLIED_QUOTE_TABLE}
        WHERE okey_tk IN ({in_clause})
          AND okey_yr = {today.year} AND okey_mn = {today.month} AND okey_dy = {today.day}
          AND okey_xx BETWEEN uprc * 0.98 AND uprc * 1.02
        ORDER BY okey_tk, okey_xx
    """
    return run_query(chain_sql)


def pick_strike(chain, symbol, spot, cp,
                max_otm_bps=CFG.MAX_OTM_BPS, max_itm_bps=CFG.MAX_ITM_BPS):
    """Closest listed strike to spot in the asymmetric ITM/OTM band.
    cp='Call': allowed range [spot - max_itm_bps, spot + max_otm_bps].
    cp='Put':  allowed range [spot - max_otm_bps, spot + max_itm_bps].
    Returns the chain row (Series) or None."""
    sub = chain[(chain['okey_tk'] == symbol) & (chain['okey_cp'] == cp)]
    if sub.empty: return None
    if cp == 'Call':
        lo = spot * (1 - max_itm_bps/1e4); hi = spot * (1 + max_otm_bps/1e4)
    else:
        lo = spot * (1 - max_otm_bps/1e4); hi = spot * (1 + max_itm_bps/1e4)
    cand = sub[(sub['okey_xx'] >= lo) & (sub['okey_xx'] <= hi)]
    if cand.empty: return None
    idx = (cand['okey_xx'] - spot).abs().idxmin()
    return cand.loc[idx]


