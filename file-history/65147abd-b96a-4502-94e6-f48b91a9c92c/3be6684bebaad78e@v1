def _build_outright_order_sql(symbol, option_row, size, direction, account,
                                limit_price, grouping_code, duration, userData,
                                limit_class="Simple", parent_handling="Activetaker",
                                surf_offset=None):
    """REPLACE INTO srtrade.msgoptordergateway for an outright single-leg order.

    limit_class      -- "Simple" or "Surface". Sets BOTH takeLimitClass and
                        makeLimitClass.
    parent_handling  -- "Activetaker" (current outright default) or "Seeker"
                        (matches send_complex_two_waves; recommended with Surface).
    surf_offset      -- if not None, adds takesurfPrcoffset + makesurfPrcoffset
                        to the SQL (both set to this value). SR interprets the
                        sign automatically based on orderSide -- always pass a
                        positive number where positive = more aggressive.

    orderPrcLimit acts as a hard price cap (for Buy) / floor (for Sell). With
    limit_class="Surface", the effective limit is BEST(orderPrcLimit, surfLimit)
    where surfLimit = liveSurfaceMid + surf_offset (in the appropriate direction).
    """
    surf_fields = ""
    surf_values = ""
    if surf_offset is not None:
        surf_fields = ", takesurfPrcoffset, makesurfPrcoffset"
        surf_values = f", {float(surf_offset)}, {float(surf_offset)}"
    # v8 (gated on _srf_flags.SEND_V8, v7 byte-identical): Timeinforce -> marketSession ('Day' ->
    # 'RegMkt'), groupingcode/riskgroupid -> hex to_v8_id strings. The !r formatting quotes hex
    # strings on v8 while leaving v7 ints as bare digits (repr(int) == str(int)). Same four-fix
    # family as extra_spread_trader (this script builds its own INSERT, shared path never sees it).
    _tif_col = "marketSession" if _srf_flags.SEND_V8 else "Timeinforce"
    _tif_val = "RegMkt" if _srf_flags.SEND_V8 else "Day"
    _rgid = to_v8_id(counter()) if _srf_flags.SEND_V8 else counter()
    # v8's OUTRIGHT gateway (msgoptordergateway) dropped 'Seeker' from the parentOrderHandling
    # enum (1265 reject, found 8/24 test run; the COMPLEX gateway kept it). Map to ActiveTaker
    # on v8 (per Zach; same value the shared outright path always used). NOTE: ActiveTaker works
    # the book differently than Seeker's seek-liquidity algo -- W1 fill character changes on v8.
    if _srf_flags.SEND_V8 and parent_handling == "Seeker":
        parent_handling = "ActiveTaker"
    return f"""REPLACE INTO srtrade.msgoptordergateway
    (okey_at, okey_ts, okey_tk, okey_yr, okey_mn, okey_dy, okey_xx, okey_cp,
     ordersize, orderPrcLimit, accnt, spdractiontype, groupingcode, orderside,
     {_tif_col}, orderduration, orderlimittype, Parentorderhandling,
     parentbalancehandling, takelimitclass, makelimitclass, autohedge,
     riskgroupid, spdrstagetype, tradername, CHECKSUM, UserData1{surf_fields})
    VALUES
    ('EQT', 'NMS', '{symbol}', {int(option_row['okey_yr'])},
     {int(option_row['okey_mn'])}, {int(option_row['okey_dy'])},
     {float(option_row['okey_xx'])}, '{option_row['okey_cp']}',
     {int(size)}, {float(limit_price)}, '{account}', 'addreplace',
     {grouping_code!r}, '{direction}', '{_tif_val}', {int(duration)}, 'Prc',
     '{parent_handling}', 'postlimit', '{limit_class}', '{limit_class}', 'None',
     {_rgid!r}, 'None', 'agm.zdietz', 13, '{userData}'{surf_values})"""


def _refresh_outright_quote(option_row):
    """Re-query SR surface for fresh sprc/obid/oask. Returns updated copy.
    Sets 'quote_refreshed' = True only when the re-query returned a row -- callers
    use it to decide whether obid/oask are live NBBO or the stale startup snap."""
    s = f"""SELECT sprc, obid, oask FROM {_srof.IMPLIED_QUOTE_TABLE}
            WHERE okey_tk='{option_row['okey_tk']}'
              AND okey_xx={float(option_row['okey_xx'])}
              AND okey_cp='{option_row['okey_cp']}'
              AND okey_yr={int(option_row['okey_yr'])}
              AND okey_mn={int(option_row['okey_mn'])}
              AND okey_dy={int(option_row['okey_dy'])}"""
    fresh = run_query(s)
    out = option_row.copy()
    out['quote_refreshed'] = not fresh.empty
    if not fresh.empty:
        out['sprc'] = float(fresh['sprc'].iloc[0])
        out['obid'] = float(fresh['obid'].iloc[0])
        out['oask'] = float(fresh['oask'].iloc[0])
    return out


# ---- Outright order broker-state helpers ----------------------------------
# Orders inserted into srtrade.msgoptordergateway are "converted to
# SpdrParentOrder records" (per SR docs), so their broker state lives in
# msgsrparentbrkrstate -- NOT msgsrmlegbrkrstate (which is for orders sent via
# msgparentordergatewayext, i.e. the multi-leg gateway).
def _outright_get_parent(grouping_code):
    """Look up SpdrParent broker state for an outright option grouping_code.
    Returns (parent_number, is_closed):
        parent_number -- alive parent (str/int) or None if state row not yet visible
        is_closed     -- True if order finished (filled/cxld/expired)
    Empty result row -> (None, False)  (state hasn't propagated yet).
    """
    sql = f"""SELECT parentNumber, spdrBrokerStatus
              FROM srtrade.msgsrparentbrkrstate
              WHERE groupingCode = {grouping_code!r}"""
    df = run_query(sql, "srtrade")
    if df.empty:
        return None, False
    status = df['spdrBrokerStatus'].iloc[0]
    return df['parentNumber'].iloc[0], status in ('Closed', 'Filled',
                                                  'Cancelled', 'Expired')


def _outright_get_fill_data(grouping_code):
    """(cumFillQuantity, avgFillPrice) for an outright option grouping_code.
    Returns (0, 0.0) if state row not yet visible. Used for premium budget
    reconciliation between waves -- W2 sizing nets against the REAL W1 spend
    (filled * avgFillPrice * 100), not the W1 cap."""
    sql = f"""SELECT cumFillQuantity, avgFillPrice FROM srtrade.msgsrparentbrkrstate
              WHERE groupingCode = {grouping_code!r}"""
    df = run_query(sql, "srtrade")
    if df.empty:
        return 0, 0.0
    qty = int(df['cumFillQuantity'].iloc[0] or 0)
    avg = float(df['avgFillPrice'].iloc[0] or 0.0)
    return qty, avg


def _outright_cancel(parent_number, grouping_code, account):
    """Cancel an outright SpdrParentOrder. Returns (cumFillQuantity, avgFillPrice)
    at cancel time."""
    # v8: userName->modifiedBy, timestamp_us dropped, clientFirm='AGM' REQUIRED (AccountMatches
    # rule -> 1105 without it). v7 keeps the original columns. Same rewrite as cancel_order.
    if _srf_flags.SEND_V8:
        cancel_sql = f"""INSERT INTO srtrade.msgsrparentcancel
                           (accnt, parentNumber, cxlReason, modifiedBy, clientFirm, timestamp)
                         VALUES
                           ('{account}', '{parent_number}', 'cxlReason', 'agm.zdietz', 'AGM', NOW())"""
    else:
        cancel_sql = f"""INSERT INTO srtrade.msgsrparentcancel
                           (accnt, parentNumber, cxlReason, userName, timestamp, timestamp_us)
                         VALUES
                           ('{account}', '{parent_number}', 'cxlReason', 'agm.zdietz', NOW(), '0')"""
    run_query(cancel_sql, "srtrade", fetch=False)
    return _outright_get_fill_data(grouping_code)


async def send_outright_two_waves(symbol, option_row, target_premium, account,
                                    max_edge_from_sprc=CFG.MAX_EDGE_FROM_SPRC,
                                    max_edge_for_limit1=CFG.MAX_EDGE_FOR_LIMIT1,
                                    max_edge_for_limit2=CFG.MAX_EDGE_FOR_LIMIT2,
                                    max_edge_pct_of_sprc=CFG.MAX_EDGE_PCT_OF_SPRC,
                                    direction='Buy', userData='',
                                    wave1_duration=CFG.WAVE_1_DURATION_S,
                                    wave2_duration=CFG.WAVE_2_DURATION_S):
    """Outright single-leg with 2 waves, target_premium-budgeted.

    target_premium is a HARD $ budget. Each wave sizes itself from the freshest
    sprc + (effective cap), and W2 nets against the REAL W1 spend (filled *
    avgFillPrice * 100) so the strategy can't blow through budget on a stale
    snapshot ask.

    Effective edges = min(dollar value, sprc * max_edge_pct_of_sprc). The pct
    cap binds on low-priced options; the dollar caps bind otherwise. Caller
    picks the pct (normal vs special-day).

    Wave 1 (SURFACE):
        effective_surf_off = min(max_edge_from_sprc, sprc * pct)
        effective_W1_cap   = min(max_edge_for_limit1, sprc * pct)
        size_W1 = ceil(target_premium / (W1_cap_price * 100)), W1_cap_price = sprc +/- effective_W1_cap.
        takeLimitClass / makeLimitClass = "Surface", parentOrderHandling = "Seeker"
        takesurfPrcoffset = makesurfPrcoffset = effective_surf_off.
        orderPrcLimit = W1_cap_price. Effective limit = BEST(orderPrcLimit, surfLimit).

    Wave 2 (SIMPLE limit, surface-free fallback, budget-reconciled):
        effective_W2_cap = min(max_edge_for_limit2, refreshed_sprc * pct)
        spent1 = filled1 * avgFillPrice_W1 * 100  (REAL spend; fallback to W1 cap if avg unavailable)
        remaining_budget = max(0, target_premium - spent1)
        size_W2 = ceil(remaining_budget / (W2_cap_price * 100)).
        W2 limit is NBBO-clamped: min(sprc-based limit, oask + 0.03). The sprc-based
        limit alone tripped SR's limit collar on 7/31 (broken AAPL surface -> sprc
        0.80 vs 0.60 mid -> limit 1.20 rejected: PR:LmtCollar). oask is live NBBO
        even when the surface fit is broken (per SR support), and ask+0.03 is always
        inside the collar. Clamp skipped if the quote refresh failed (stale snap
        obid/oask are untrustworthy -- 7/31 snap oask was below intrinsic).
        takeLimitClass / makeLimitClass = "Simple", parentOrderHandling = "Activetaker", no surf fields.

    FIRES W2 AND RETURNS IMMEDIATELY (355pm-style) -- does NOT wait out
    wave2_duration. The caller sends the chat recap right away, then
    collect_w2_fills() reads W2 fills after the order expires.

    Returns {'w1_filled', 'w1_avg', 'w1_spent', 'w2_gc', 'w2_size', 'w2_limit',
    'w2_end_dt'} -- the w2_* fields are None/0 when no W2 was sent.
    """
    print(f"{pretty_time()} -- send_outright_two_waves [{userData}]: {symbol} "
          f"{option_row['okey_xx']:g}{option_row['okey_cp'][0]} "
          f"target_prem=${target_premium:,.0f} dir={direction}  "
          f"surf_off={max_edge_from_sprc} cap1={max_edge_for_limit1} "
          f"cap2={max_edge_for_limit2} pct_cap={max_edge_pct_of_sprc:.0%}")

    # -------------------- Wave 1: surface-priced (pct-capped) --------------------
    sprc1 = float(option_row['sprc'])
    pct_cap_1  = sprc1 * max_edge_pct_of_sprc
    eff_surf_1 = min(max_edge_from_sprc,  pct_cap_1)
    eff_cap_1  = min(max_edge_for_limit1, pct_cap_1)
    if direction == 'Buy':
        limit1 = round(sprc1 + eff_cap_1, 2)
    else:
        limit1 = round(sprc1 - eff_cap_1, 2)
    size1 = max(1, math.ceil(target_premium / (abs(limit1) * 100)))
    gc1 = to_v8_id(counter()) if _srf_flags.SEND_V8 else counter()
    sql1 = _build_outright_order_sql(
        symbol, option_row, size1, direction, account,
        limit_price=limit1, grouping_code=gc1, duration=wave1_duration,
        userData=f"{userData}_W1",
        limit_class="Surface", parent_handling="Seeker",
        surf_offset=eff_surf_1,
    )
    run_query(sql1, "srtrade", fetch=False)
    binds_1 = "pct" if pct_cap_1 < max_edge_for_limit1 else "dollar"
    print(f"  W1 sent (Surface/Seeker): {symbol} sprc=${sprc1:.2f} "
          f"surf_off=${eff_surf_1:.3f} eff_cap=${eff_cap_1:.3f} ({binds_1} binds; "
          f"pct_cap=${pct_cap_1:.3f}) limit=${limit1} size={size1} "
          f"(budget ${target_premium:,.0f}) gc={gc1} dur={wave1_duration}s")

    await asyncio.sleep(wave1_duration)

    # Check fill / cancel residual against the SpdrParent state table.
    parent1, is_closed = _outright_get_parent(gc1)
    # Retry briefly when state isn't visible -- the most common cause is SR Trade
    # write-latency (gateway -> msgsrparentbrkrstate write), not rejection. 3 retries
    # x 0.3s = up to +0.9s after the W1 sleep. Most lag cases resolve here, letting
    # us cleanly cancel W1 and budget-reconcile W2 instead of falling through to the
    # full-budget W2 path (which risks doubling exposure if W1 silently fills).
    for _ in range(3):
        if is_closed or parent1 is not None:
            break
        time.sleep(0.3)
        parent1, is_closed = _outright_get_parent(gc1)

    if is_closed:
        filled1, avg1 = _outright_get_fill_data(gc1)
    elif parent1 is not None:
        filled1, avg1 = _outright_cancel(parent1, gc1, account)
    else:
        # State STILL invisible after retries. Per design preference (prefer overfill
        # to missed fill), proceed with W2 at FULL budget. Risk: if W1 is alive-but-
        # untracked and silently fills, total exposure could be up to 2x target_premium.
        filled1, avg1 = 0, 0.0
        print(f"  W1: parent state not visible for gc={gc1} after retries -- "
              f"proceeding with W2 at FULL budget (double-fill possible if W1 silently fills)")
    # Safety net: if filled but avgFillPrice not yet populated, conservatively
    # treat the fill as having cleared at the cap (the worst we'd have paid).
    if filled1 > 0 and avg1 <= 0:
        avg1 = abs(limit1)
        print(f"  W1: avgFillPrice not yet populated; using cap ${avg1:.2f} for budget reconciliation")
    spent1 = filled1 * avg1 * 100
    print(f"  W1 result: filled {filled1}/{size1} @ ${avg1:.3f} avg  (spent ${spent1:,.0f})")

    no_w2 = {'w1_filled': int(filled1), 'w1_avg': float(avg1), 'w1_spent': spent1,
             'w2_gc': None, 'w2_size': 0, 'w2_limit': None, 'w2_end_dt': None}

    if filled1 >= size1:
        print(f"  Fully filled on W1 -- {symbol}")
        return no_w2

    # -------------------- Wave 2: simple limit (refreshed sprc, NBBO-clamped, budget-reconciled) --------------------
    remaining_budget = max(0.0, target_premium - spent1)
    if remaining_budget <= 0:
        print(f"  W1 spend ${spent1:,.0f} consumed budget ${target_premium:,.0f}; no W2")
        return no_w2

    # Refresh sprc/obid/oask before computing wave 2's limit (pct-capped).
    fresh = _refresh_outright_quote(option_row)
    sprc2 = float(fresh['sprc'])
    pct_cap_2 = sprc2 * max_edge_pct_of_sprc
    eff_cap_2 = min(max_edge_for_limit2, pct_cap_2)
    if direction != 'Buy':
        raise AssertionError("W2 NBBO clamp only implemented for Buy -- "
                             "review clamp direction before enabling Sell")
    limit2_sprc = round(sprc2 + eff_cap_2, 2)
    oask2 = float(fresh['oask'])
    quote_ok = bool(fresh['quote_refreshed']) and oask2 > 0
    nbbo_clamp = round(oask2 + 0.03, 2)
    limit2 = min(limit2_sprc, nbbo_clamp) if quote_ok else limit2_sprc
    size2 = max(0, math.ceil(remaining_budget / (abs(limit2) * 100)))
    if size2 <= 0:
        print(f"  W2 size=0 after budget reconciliation; no W2 sent")
        return no_w2

    gc2 = to_v8_id(counter()) if _srf_flags.SEND_V8 else counter()
    sql2 = _build_outright_order_sql(
        symbol, fresh, size2, direction, account,
        limit_price=limit2, grouping_code=gc2, duration=wave2_duration,
        userData=f"{userData}_W2",
        limit_class="Simple", parent_handling="Activetaker",
        surf_offset=None,
    )
    run_query(sql2, "srtrade", fetch=False)
    w2_end_dt = getNowEst() + dt.timedelta(seconds=wave2_duration)
    binds_2 = "pct" if pct_cap_2 < max_edge_for_limit2 else "dollar"
    clamp_desc = (f"nbbo-clamp binds; sprc-based=${limit2_sprc}, oask=${oask2}"
                  if quote_ok and nbbo_clamp < limit2_sprc
                  else f"sprc-based binds; oask={f'${oask2}' if quote_ok else 'UNAVAILABLE (refresh failed)'}")
    print(f"  W2 sent (Simple/Activetaker): {symbol} refreshed_sprc=${sprc2:.2f} "
          f"eff_cap=${eff_cap_2:.3f} ({binds_2} binds; pct_cap=${pct_cap_2:.3f}) "
          f"limit=${limit2} ({clamp_desc}) size={size2} "
          f"(remaining budget ${remaining_budget:,.0f}) gc={gc2} dur={wave2_duration}s")

    # Fire-and-return (355pm-style): W2 rests at SR for wave2_duration; fills are
    # read later by collect_w2_fills so the chat recap can go out immediately.
    return {'w1_filled': int(filled1), 'w1_avg': float(avg1), 'w1_spent': spent1,
            'w2_gc': gc2, 'w2_size': int(size2), 'w2_limit': abs(limit2),
            'w2_end_dt': w2_end_dt}


