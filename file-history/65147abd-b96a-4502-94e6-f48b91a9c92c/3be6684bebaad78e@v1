# Take the FIRST imbal capture at-or-after this time-of-day for each ticker.
# Matches the backtest's signal_snap convention.
SIGNAL_START_TIME = '15:50:01'

def get_350_ss_imbal(tickers, start_time=SIGNAL_START_TIME,
                     is_test=False, test_imbal=None,
                     max_attempts=7, sleep_between=0.8):
    """Pull 3:50 closing-imbalance per ticker. Returns
        {ticker: signed_notional_dollars}
    where the value is positive for buy-side imbal, negative for sell-side, 0
    for no-side / no-marketable. Returns None on total failure.

    For each ticker, the value is from the FIRST capture with capture_timestamp
    >= today + start_time (default '15:50:01') -- mirrors the backtest's
    signal_snap convention.

    GOOG is included implicitly when GOOGL is in `tickers`, so the caller can
    sum the two for Alphabet.

    Retries up to `max_attempts` with `sleep_between`s between each.
    Triggers a retry on: db error, empty result, missing ticker, or zero
    notional (treated as 'feed not yet published').
    """
    if is_test and test_imbal:
        return dict(test_imbal)

    run_date = (x_days_ago(1) if is_test else dt.date.today()).strftime("%Y-%m-%d")
    pull_tickers = list(set(tickers) | ({'GOOG'} if 'GOOGL' in tickers else set()))

    engine_timed = create_engine(
        f"mysql+pymysql://{VBAM_USERNAME}:{VBAM_PASSWORD}@{VBAM_HOSTNAME}/{VBAM_DATABASE}",
        connect_args={"read_timeout": 5, "write_timeout": 5, "connect_timeout": 5},
    )
    sql_obj = sql.text("""
        SELECT t.ticker,
               (CASE t.imbalance_side
                    WHEN 1 THEN  t.order_imbalance_vol
                    WHEN 2 THEN -t.order_imbalance_vol
                    ELSE 0
                END) * t.price AS notional
        FROM auctionResearch.t_prices_daily_price_capture t
        INNER JOIN (
            SELECT ticker, MIN(capture_timestamp) AS first_ts
            FROM auctionResearch.t_prices_daily_price_capture
            WHERE run_date = :run_date AND ticker IN :tickers
              AND capture_timestamp >= TIMESTAMP(:run_date, :start_time)
            GROUP BY ticker
        ) first_cap ON t.ticker = first_cap.ticker
                    AND t.capture_timestamp = first_cap.first_ts
        WHERE t.run_date = :run_date
        ORDER BY t.ticker
    """).bindparams(sql.bindparam("tickers", expanding=True))

    try:
        latest_df = None    # remember last non-empty result for end-of-retries fallback
        for attempt in range(1, max_attempts + 1):
            try:
                df = pd.read_sql_query(sql_obj, engine_timed,
                                        params={"run_date": run_date,
                                                "tickers": pull_tickers,
                                                "start_time": start_time})
                if df.empty:
                    raise ValueError("empty result set")
                latest_df = df
                missing = sorted(set(pull_tickers) - set(df['ticker']))
                zero    = sorted(df.loc[df['notional'] == 0, 'ticker'].tolist())
                if not missing and not zero:
                    return dict(zip(df['ticker'], df['notional'].astype(float)))
                print(f"get_350_ss_imbal attempt {attempt}/{max_attempts}: "
                      f"missing={missing} zero_imbal={zero}")
            except Exception as e:
                print(f"get_350_ss_imbal attempt {attempt}/{max_attempts} errored: {e}")
            if attempt < max_attempts:
                print(f"  Sleeping {sleep_between}s before retry.")
                time.sleep(sleep_between)

        # All retries exhausted. If we ever got a non-empty response, return the
        # PARTIAL dict -- tickers still missing/zero won't trigger downstream
        # (threshold check fails on 0), but tickers with real data trade normally.
        # Avoids the "one bad ticker kills the whole run" failure mode.
        if latest_df is not None:
            partial = dict(zip(latest_df['ticker'], latest_df['notional'].astype(float)))
            missing = sorted(set(pull_tickers) - set(partial))
            zero    = sorted([t for t, v in partial.items() if v == 0])
            n_ok    = sum(1 for v in partial.values() if v != 0)
            print(f"WARNING: get_350_ss_imbal exhausted all retries -- returning PARTIAL "
                  f"({n_ok}/{len(pull_tickers)} with valid imbal; "
                  f"missing={missing}, zero_imbal={zero})")
            return partial

        print("WARNING: get_350_ss_imbal exhausted all retries with NO data. Returning None.")
        return None
    finally:
        engine_timed.dispose()


