def is_special_day(today=None):
    """Special day = serial (monthly) expiry OR trading month-end. FED days do
    NOT count as special (backtest showed FED days never triggered a trade and
    are not part of the edge)."""
    today = today or dt.date.today()
    serial_set = set(pd.to_datetime(SERIALS).date)
    if today in serial_set:
        return True
    # Trading month-end: next business day is in a different month
    today_ts = pd.Timestamp(today)
    nxt = today_ts + pd.tseries.offsets.BDay(1)
    return nxt.month != today_ts.month


def build_trade_for_symbol(signal_symbol, combined_imbal, spot_300, spot_350,
                            chain, spx_imbal, today_is_special, force=False):
    """Decide whether to trade `signal_symbol` and (if so) what option to trade.

    All imbalance values are in DOLLARS (signed).

    Always returns a flat dict. Keys ALWAYS populated:
        signal_symbol     -- one of the 8 universe names (e.g. 'GOOGL' for Alphabet)
        combined_imbal    -- signed imbal in $ (Alphabet sums GOOG+GOOGL)
        triggered         -- True if |imbal| >= per-symbol ADV threshold (or force)
        will_trade        -- True if a qualifying strike was found and order will go
        note              -- human-readable status string

    Keys ADDITIONALLY populated when will_trade=True:
        symbol         -- actual traded ticker (Alphabet may pick GOOG fallback)
        cp             -- 'Call' or 'Put'
        option_row     -- chain row (pandas Series)
        strike         -- float strike price
        trade_spot     -- 3:50 spot used for the chosen leg
        ref_spot_300   -- 3pm spot used for momentum calc
        move_bps       -- 3pm -> 3:50 move in bps (None if 3pm spot missing)
        ask, bid       -- floats
        mult_special   -- 1 or CFG.MULT_SPECIAL (special-day flag: serial/month-end)
        mult_momentum  -- 1 or CFG.MULT_MOMENTUM (3pm -> 3:50 momentum confirm flag)
        mult_spx       -- 1 or CFG.MULT_SPX (SPX broad-market confirm flag)
        size_mult      -- product of the three multipliers
        target_premium -- $ target premium = BASE_PREMIUM * size_mult
        contracts      -- ceil(target_premium / (ask * 100)), min 1
        user_data      -- userData string for the order ('{NAME}_{symbol}')
    """
    out = {
        'signal_symbol' : signal_symbol,
        'combined_imbal': combined_imbal,
        'triggered'     : False,
        'will_trade'    : False,
        'note'          : '',
    }

    threshold = CFG.UNIVERSE[signal_symbol]['threshold']
    if not force and abs(combined_imbal) < threshold:
        out['note'] = (f'imbal {combined_imbal/1e6:+.0f}M below '
                       f'threshold ${threshold/1e6:.0f}M')
        return out
    out['triggered'] = True

    cp = 'Call' if combined_imbal > 0 else 'Put'

    # Alphabet: prefer GOOGL, fall back to GOOG if GOOGL has no qualifying strike.
    candidates = ['GOOGL', 'GOOG'] if signal_symbol == 'GOOGL' else [signal_symbol]
    chosen = None
    for try_sym in candidates:
        try_spot = spot_350.get(try_sym)
        if try_spot is None:
            continue
        opt = pick_strike(chain, try_sym, try_spot, cp)
        if opt is None:
            continue
        chosen = (try_sym, try_spot, opt)
        break

    if chosen is None:
        out['cp']   = cp
        out['note'] = f'no qualifying {cp} strike for {signal_symbol} (or GOOG fallback)'
        return out

    trade_sym, trade_spot, opt = chosen
    ref_300 = spot_300.get(trade_sym)
    move_bps = ((trade_spot / ref_300) - 1) * 1e4 if ref_300 else None

    # Compounding multipliers (size_mult = product). Each defaults to 1 when its
    # flag is off; the active values come from CFG (special=4x, momentum=1.2x, spx=1.5x).
    mult_special  = CFG.MULT_SPECIAL if today_is_special else 1
    mult_momentum = CFG.MULT_MOMENTUM if (
        (cp == 'Call' and move_bps is not None and move_bps >  CFG.MOVE_CONFIRM_BPS) or
        (cp == 'Put'  and move_bps is not None and move_bps < -CFG.MOVE_CONFIRM_BPS)
    ) else 1
    mult_spx = CFG.MULT_SPX if (
        (cp == 'Call' and spx_imbal is not None and spx_imbal >  CFG.SPX_CONFIRM) or
        (cp == 'Put'  and spx_imbal is not None and spx_imbal < -CFG.SPX_CONFIRM)
    ) else 1
    size_mult = mult_special * mult_momentum * mult_spx

    target_premium = CFG.BASE_PREMIUM * size_mult
    # Sizing now lives in send_outright_two_waves -- it derives contracts per wave
    # from the freshest sprc + cap and budget-reconciles W2 against the REAL W1 spend.
    # This avoids the AAPL-5/29-style blowup where a stale snapshot oask led to 3x
    # over-spend. We just pass target_premium downstream.

    out.update({
        'will_trade'    : True,
        'symbol'        : trade_sym,
        'cp'            : cp,
        'option_row'    : opt,
        'strike'        : float(opt['okey_xx']),
        'trade_spot'    : trade_spot,
        'ref_spot_300'  : ref_300,
        'move_bps'      : move_bps,
        'sprc'          : float(opt['sprc']),
        'snap_ask'      : float(opt['oask']),  # informational only, NOT used for sizing
        'snap_bid'      : float(opt['obid']),  # informational only
        'mult_special'  : mult_special,
        'mult_momentum' : mult_momentum,
        'mult_spx'      : mult_spx,
        'size_mult'     : size_mult,
        'target_premium': target_premium,
        'user_data'     : f"{CFG.NAME}_{trade_sym}",
        'note'          : (f'will trade {trade_sym} {opt["okey_xx"]:g}{cp[0]} '
                           f'target_prem=${target_premium:,.0f} '
                           f'(mult {mult_special}x{mult_momentum}x{mult_spx} = {size_mult}x)'),
    })
    return out


# ============================================================================
# Phase functions -- main is a thin orchestration over these.
# ============================================================================
def format_imbal_table(tickers, imbal):
    """Render the per-ticker imbal vs threshold table as a multi-line string.
    Used both for terminal logging in pull_signal_data and for chat pings in
    post_no_trade_summary / post_chat_summary."""
    lines = ["Imbal per ticker (signed | threshold | %thresh):"]
    for t in tickers:
        imbal_d  = imbal.get(t, 0.0)
        thresh_d = CFG.UNIVERSE[t]['threshold']
        pct      = abs(imbal_d) / thresh_d * 100 if thresh_d else 0
        flag     = "  *QUALIFIES*" if abs(imbal_d) >= thresh_d else ""
        lines.append(f"  {t:<6} {imbal_d/1e6:>+5.0f}M | "
                     f"{thresh_d/1e6:>4.0f}M | {pct:>3.0f}%{flag}")
    return "\n".join(lines)


def pull_signal_data(tickers):
    """Phase 1: gather all market data needed to make trade decisions.

    Waits at the appropriate ET clock times (skipped when IS_TEST=True),
    pulls 3pm prices, 3:50 spot, and SS/SPX/NDX imbals.

    Returns a dict with (all imbal values in DOLLARS, signed):
        spot_300   -- dict {ticker: 3pm price}     (includes GOOG for Alphabet)
        spot_350   -- dict {ticker: 3:50 spot}     (includes GOOG)
        imbal      -- dict {ticker: signed_imbal_$}, with GOOG summed into GOOGL
        spx_imbal  -- float or None
        ndx_imbal  -- float or None
    Or None if SS imbal pull failed entirely (caller should bail).
    """
    # Wait until ~3:38 (coarse), then ~3:48 (fine), then pull 3pm prices.
    if not IS_TEST:
        wait_until(dt.time(LAST_HOUR, 38, 1), poll_interval=30)
        wait_until(dt.time(LAST_HOUR, 48, 1))

    ref_label = "9:31 AM" if IS_TEST else "3:00 PM"
    print(f"{pretty_time()} -- Pulling {ref_label} prices via blp.bdib")
    spot_300 = (dict(TEST_SPOT_300) if TEST_SPOT_300 is not None
                else pull_3pm_prices_bbg(tickers + ['GOOG'], is_test=IS_TEST))
    print(f"  {ref_label} prices: {spot_300}")

    # Wait until 3:50:01.7 (shifted +0.2s from 3:50:01.5 on 2026-08-24 for SR query-collision
    # avoidance: separates the chain pull + option sends that follow from the jitter-timed
    # sends of the fast scripts at ~3:50:01.1-02.0), then snapshot live spot.
    if not IS_TEST:
        wait_until(dt.time(LAST_HOUR, 50, 1, 700_000), poll_interval=0.05)

    print(f"{pretty_time()} -- Pulling 3:50 spot via blp.bdp")
    spot_350 = (dict(TEST_SPOT_350) if TEST_SPOT_350 is not None
                else pull_350_spot_bbg(tickers + ['GOOG']))
    print(f"  3:50 spot: {spot_350}")

    # Pull imbals immediately after spot (no extra wait).
    print(f"{pretty_time()} -- Pulling SS / SPX / NDX imbals")
    ss_imbals = get_350_ss_imbal(tickers, is_test=IS_TEST, test_imbal=TEST_SS_IMBALS,
                                  max_attempts=CFG.IMBAL_MAX_ATTEMPTS,
                                  sleep_between=CFG.IMBAL_SLEEP_BETWEEN)
    # Pass is_test=IS_TEST so these pull YESTERDAY's data when in test mode
    # (which has actual auction snapshots regardless of when test runs).
    # get_350_imbal accepts a stub override directly via test_imbal=...
    # get_qqq_net_imbal has no stub override -- handle TEST_NDX_IMBAL at script level.
    spx_imbal_raw = get_350_imbal(is_test=IS_TEST, test_imbal=TEST_SPX_IMBAL)
    ndx_imbal_raw = (TEST_NDX_IMBAL if TEST_NDX_IMBAL is not None
                     else get_qqq_net_imbal(is_test=IS_TEST))
    spx_imbal = spx_imbal_raw if spx_imbal_raw not in (None, NO_IMBAL_VAL) else None
    ndx_imbal = ndx_imbal_raw if ndx_imbal_raw is not None else None
    print(f"  SPX: {f'{spx_imbal/1e6:+.0f}M' if spx_imbal is not None else 'N/A'}  "
          f"NDX: {f'{ndx_imbal/1e6:+.0f}M' if ndx_imbal is not None else 'N/A'}")

    if not ss_imbals:
        return None

    # Per-ticker imbal in $, with Alphabet aggregation (GOOG + GOOGL).
    imbal = dict(ss_imbals)
    if 'GOOGL' in imbal and 'GOOG' in imbal:
        imbal['GOOGL'] += imbal['GOOG']

    # Pretty-print: imbal vs threshold so non-qualifying near-misses are obvious.
    for line in format_imbal_table(tickers, imbal).split("\n"):
        print(f"  {line}")

    return {'spot_300': spot_300, 'spot_350': spot_350, 'imbal': imbal,
            'spx_imbal': spx_imbal, 'ndx_imbal': ndx_imbal}


def decide_trades(tickers, signal_data, today_is_special):
    """Phase 2: per-ticker decision -- run threshold + strike-pick + sizing.

    Pulls option chains for qualifying symbols (one SQL round-trip), then
    builds a decision dict (from build_trade_for_symbol) for each qualifier.

    Returns the list of decision dicts. Decisions where will_trade=False are
    included for transparency (visible in the printed log) but are filtered
    out before sending.
    """
    imbal = signal_data['imbal']

    qualifiers = [t for t in tickers
                  if TEST_FORCE_TRADE or abs(imbal.get(t, 0.0)) >= CFG.UNIVERSE[t]['threshold']]
    print(f"  Qualifying symbols: {qualifiers}")
    if not qualifiers:
        return []

    # ONE SQL for option chains of qualifying symbols. Include GOOG for Alphabet fallback.
    chain_symbols = list(set(qualifiers) | ({'GOOG'} if 'GOOGL' in qualifiers else set()))
    print(f"{pretty_time()} -- Pulling option chains for {chain_symbols}")
    chain = pull_chains_for_symbols(chain_symbols)
    print(f"  Chain: {len(chain)} rows; symbols={sorted(chain['okey_tk'].unique())}")

    decisions = []
    for t in qualifiers:
        d = build_trade_for_symbol(t, imbal.get(t, 0.0),
                                    signal_data['spot_300'], signal_data['spot_350'],
                                    chain, signal_data['spx_imbal'],
                                    today_is_special, force=TEST_FORCE_TRADE)
        print(f"  {t}: {d['note']}")
        decisions.append(d)
    return decisions


def send_option_orders(decisions, account, today_is_special):
    """Phase 3: send option orders concurrently for all will_trade decisions.

    Records option-send timestamp BEFORE awaiting any coroutine, returns it
    so the caller can compute the LOC delay target.

    today_is_special selects the percent-of-sprc edge cap (more aggressive on
    serial/month-end days).

    Returns as soon as every trade's W2 is FIRED (not filled) -- ~4s, not 40s.
    Mutates each will_trade decision in-place with the send_outright_two_waves
    result dict plus provisional 'filled'/'premium_paid' (W1-only numbers;
    collect_w2_fills folds in W2 later).
    Returns the option-send timestamp (dt.datetime, ET).
    """
    trades = [d for d in decisions if d['will_trade']]
    edge_pct = (CFG.MAX_EDGE_PCT_OF_SPRC_SPECIAL if today_is_special
                else CFG.MAX_EDGE_PCT_OF_SPRC)

    print(f"{pretty_time()} -- Preparing {len(trades)} trade(s)  "
          f"(edge_pct_of_sprc={edge_pct:.0%}, special={today_is_special})")
    for d in trades:
        print(f"    {d['symbol']} {d['cp']} K={d['strike']:g} "
              f"mult={d['size_mult']} target_prem=${d['target_premium']:,.0f} "
              f"sprc=${d['sprc']:.2f} (snap_ask=${d['snap_ask']:.2f})")

    # Capture t=0 BEFORE building coroutines (which is essentially immediate
    # but we want the timestamp anchored before any awaits).
    t_options_send = getNowEst()

    # Build (coroutine, decision) tuples upfront -- mirrors 350pm_script.py pattern.
    # Sizing happens inside send_outright_two_waves from target_premium + fresh sprc.
    order_coros = []
    for d in trades:
        coro = send_outright_two_waves(
            symbol=d['symbol'], option_row=d['option_row'],
            target_premium=d['target_premium'],
            account=account,
            max_edge_from_sprc=CFG.MAX_EDGE_FROM_SPRC,
            max_edge_for_limit1=CFG.MAX_EDGE_FOR_LIMIT1,
            max_edge_for_limit2=CFG.MAX_EDGE_FOR_LIMIT2,
            max_edge_pct_of_sprc=edge_pct,
            direction='Buy', userData=d['user_data']
        )
        order_coros.append((coro, d))

    print(f"{pretty_time()} -- Starting asyncio.run(send_trades()) 350PM_SS")
    if SEND_TRADES:
        async def safe_send(coro, trade_name):
            """Wrap a trade coroutine so one failure doesn't kill the rest.
            Returns the send_outright_two_waves result dict (zeros on error)."""
            try:
                return await coro
            except Exception as e:
                print(f"ERROR sending trade '{trade_name}': {e}")
                return {'w1_filled': 0, 'w1_avg': 0.0, 'w1_spent': 0.0,
                        'w2_gc': None, 'w2_size': 0, 'w2_limit': None, 'w2_end_dt': None}

        async def send_trades():
            return await asyncio.gather(
                *[safe_send(coro, d['user_data']) for coro, d in order_coros]
            )

        results = asyncio.run(send_trades())
        for (_, d), res in zip(order_coros, results):
            d.update(res)
            # Provisional totals = W1 only; collect_w2_fills adds W2 after it expires.
            d['filled'] = int(res['w1_filled'])
            d['premium_paid'] = float(res['w1_spent'])
    else:
        # Dry-run: estimate filled at target_premium / snap_ask and premium = target_premium
        for _, d in order_coros:
            est_ct = max(1, math.ceil(d['target_premium'] / max(d['snap_ask'], 0.01) / 100))
            d['filled'] = est_ct
            d['premium_paid'] = d['target_premium']
            d.update({'w1_filled': est_ct, 'w1_avg': 0.0, 'w1_spent': d['target_premium'],
                      'w2_gc': None, 'w2_size': 0, 'w2_limit': None, 'w2_end_dt': None})
    print(f"{pretty_time()} -- Finished asyncio.run(send_trades()) 350PM_SS")

    return t_options_send


def post_chat_summary(decisions, signal_data, today_is_special, account):
    """Phase 4: build the chat recap, print it, and post to chat.

    Sent IMMEDIATELY after the W2 orders are fired (355pm-style) -- fill numbers
    are W1-only at this point; any W2 still resting is shown as 'working' and its
    final fills go out later via post_w2_final_summary.
    """
    spx_imbal = signal_data['spx_imbal']
    ndx_imbal = signal_data['ndx_imbal']

    summary = (f"{dt.date.today().strftime('%m/%d/%Y')} {CFG.NAME} "
               f"3:50 PM Algo{' TEST' if IS_TEST else ''} RECAP:\n\n")
    summary += f"SPX imbal: {f'{spx_imbal/1e6:+,.0f}M' if spx_imbal is not None else 'N/A'}.  "
    summary += f"NDX imbal: {f'{ndx_imbal/1e6:+,.0f}M' if ndx_imbal is not None else 'N/A'}.  "
    summary += f"Special day: {today_is_special}.\n"

    total_premium_paid = 0.0
    for d in decisions:
        if not d['will_trade']:
            continue
        filled = d.get('filled', 0)
        premium_paid = d.get('premium_paid', 0.0)   # REAL spend from avg fill price
        total_premium_paid += premium_paid
        avg_fill = (premium_paid / filled / 100) if filled > 0 else 0.0
        summary += (
            f"\n*{d['user_data']}* ({account}):\n"
            f"Buy {filled} {d['symbol']} "
            f"{d['strike']:g}{d['cp'][0]} @ ${avg_fill:.2f} avg "
            f"(mult={d['size_mult']}x, target=${d['target_premium']:,.0f}, "
            f"prem ${premium_paid:,.0f}, imbal {d['combined_imbal']/1e6:+,.0f}M)\n"
        )
        if d.get('w2_gc') is not None:
            summary += (f"W2 working {d['w2_size']} more @ ${d['w2_limit']:.2f} limit "
                        f"({CFG.WAVE_2_DURATION_S}s) -- fills in follow-up msg\n")

    any_w2 = any(d.get('w2_gc') is not None for d in decisions if d['will_trade'])
    summary += (f"\nTotal premium paid{' (W1 so far; W2 fills follow)' if any_w2 else ''}: "
                f"${total_premium_paid:,.0f}\n")

    # Size-multiplier breakdown per trade (special-day / momentum / SPX flags).
    for d in decisions:
        if not d['will_trade']:
            continue
        summary += (
            f"\n{d['symbol']} size mult breakdown:\n"
            f"mult_special_day = {d['mult_special']}\n"
            f"mult_momentum = {d['mult_momentum']}\n"
            f"mult_spx_imbal = {d['mult_spx']}\n"
        )

    print(summary)
    try:
        send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + summary,
                     my_chat)
    except Exception as e:
        print(f"WARNING: chat send failed: {e}")


def collect_w2_fills(decisions):
    """Phase 4b: wait for each W2 order to expire, then fold its fills into
    d['filled'] / d['premium_paid'] (which hold W1-only numbers from the
    immediate-recap phase). No-op for trades without a W2. Must run BEFORE
    write_bbg_exit_file and send_stock_unwinds -- both need final fill counts."""
    for d in decisions:
        if not d['will_trade'] or d.get('w2_gc') is None:
            continue
        # W2 dies at fire-time + wave2_duration; +1.5s for SR state to settle.
        target = d['w2_end_dt'] + dt.timedelta(seconds=1.5)
        if getNowEst() < target:
            wait_until(target, poll_interval=0.1)
        filled2, avg2 = _outright_get_fill_data(d['w2_gc'])
        if filled2 > 0 and avg2 <= 0:
            avg2 = float(d['w2_limit'])
            print(f"  {d['symbol']} W2: avgFillPrice not yet populated; using cap ${avg2:.2f}")
        d['w2_filled'] = int(filled2)
        d['w2_avg'] = float(avg2)
        d['filled'] = int(d['w1_filled']) + int(filled2)
        d['premium_paid'] = float(d['w1_spent']) + filled2 * avg2 * 100
        print(f"  {d['symbol']} W2 result: filled {filled2}/{d['w2_size']} @ ${avg2:.3f} avg  "
              f"(trade total {d['filled']} contracts, prem ${d['premium_paid']:,.0f})")


def post_w2_final_summary(decisions):
    """Phase 4c: short follow-up chat message with final W2 fills. Skipped
    entirely when no W2 was sent (recap numbers were already final)."""
    lines = []
    for d in decisions:
        if not d['will_trade'] or d.get('w2_gc') is None:
            continue
        lines.append(f"{d['symbol']} W2 final: filled {d['w2_filled']}/{d['w2_size']} "
                     f"@ ${d['w2_avg']:.2f} -- trade total {d['filled']} contracts, "
                     f"prem ${d['premium_paid']:,.0f}")
    if not lines:
        return
    msg = (f"{dt.date.today().strftime('%m/%d/%Y')} {CFG.NAME}"
           f"{' TEST' if IS_TEST else ''} W2 fills:\n" + "\n".join(lines))
    print(msg)
    try:
        send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + msg, my_chat)
    except Exception as e:
        print(f"WARNING: chat send failed: {e}")


def post_no_trade_summary(tickers, signal_data, today_is_special, reason):
    """Chat ping for the no-trade path so we know the algo ran cleanly even on
    quiet days. Includes SPX/NDX context + the per-ticker imbal table.

    Called from main's early-exit branches. signal_data may be None (when the
    SS imbal pull failed entirely) -- in that case we just send the reason."""
    summary = (f"{dt.date.today().strftime('%m/%d/%Y')} {CFG.NAME} "
               f"3:50 PM Algo{' TEST' if IS_TEST else ''} -- {reason}\n")
    if signal_data is not None:
        spx_imbal = signal_data['spx_imbal']
        ndx_imbal = signal_data['ndx_imbal']
        summary += (
            f"SPX imbal: {f'{spx_imbal/1e6:+,.0f}M' if spx_imbal is not None else 'N/A'}.  "
            f"NDX imbal: {f'{ndx_imbal/1e6:+,.0f}M' if ndx_imbal is not None else 'N/A'}.  "
            f"Special day: {today_is_special}.\n"
        )
        # Triple-backtick code block so the table renders monospaced in chat.
        summary += "```\n" + format_imbal_table(tickers, signal_data['imbal']) + "\n```"

    print(summary)
    try:
        send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + summary,
                     my_chat)
    except Exception as e:
        print(f"WARNING: chat send failed: {e}")


def write_bbg_exit_file(decisions):
    """Write a Bloomberg OI-format CSV with the stock unwind orders, one row per
    filled option trade. Backup for when SR Trade LOC orders fail -- the user
    uploads this file into Bloomberg to execute the stock leg.

    Format (no header), one row per filled trade:
        TICKER, SIDE, SHARES, STRIKE, ACCOUNT, DESCRIPTION, , , LOC

    SIDE:   B if we bought Puts  (need to BUY stock to cover the short assignment)
            S if we bought Calls (need to SELL stock to deliver the long assignment)
    TICKER: the actual traded leg (e.g. GOOG when Alphabet falls back to GOOG).
    Always written when any trade filled, regardless of IS_TEST / SEND_LOC -- this
    is a low-cost backup artifact that prod overwrites if it runs later in the day.
    """
    rows = []
    for d in decisions:
        if not d['will_trade'] or d.get('filled', 0) <= 0:
            continue
        side = 'B' if d['cp'] == 'Put' else 'S'
        shares = int(d['filled']) * 100
        rows.append(f"{d['symbol']} US EQUITY,{side},{shares},{d['strike']:g},"
                    f"{EXIT_FILE_ACCOUNT},{EXIT_FILE_DESC},,,LOC")
    if not rows:
        print(f"{pretty_time()} -- No filled trades; skipping BBG exit backup file")
        return
    EXIT_FILE_DIR.mkdir(parents=True, exist_ok=True)
    path = EXIT_FILE_DIR / f"{dt.date.today().strftime('%m_%d_%Y')}.csv"
    with open(path, 'w') as f:
        f.write('\n'.join(rows) + '\n')
    print(f"{pretty_time()} -- BBG exit backup file: {path} ({len(rows)} rows, LOC)")


def send_stock_unwinds(decisions, account, t_options_send):
    """Phase 5: wait LOC_DELAY_S after option send, then fire stock unwinds.

    For each filled option, send a stock order at the strike price:
      - Call -> Sell shares at strike (assigned long shares -> deliver)
      - Put  -> Buy  shares at strike (assigned short shares -> cover)

    Mode controlled by global SEND_LOC: True -> tradeSharesLOC (LmtOnCls),
    False -> tradeSharesLimit (immediate limit).
    """
    target_loc_dt = t_options_send + dt.timedelta(seconds=CFG.LOC_DELAY_S)
    print(f"{pretty_time()} -- Waiting until "
          f"{target_loc_dt.strftime('%I:%M:%S.%f %p')[:-3]} "
          f"(option_send + {CFG.LOC_DELAY_S}s) before stock unwind")
    if not IS_TEST:
        wait_until(target_loc_dt, poll_interval=0.1)

    print(f"{pretty_time()} -- Starting stock unwind orders "
          f"({'LOC' if SEND_LOC else 'immediate-limit'}) 350PM_SS")
    for d in decisions:
        if not d['will_trade']:
            continue
        filled = d.get('filled', 0)
        if filled <= 0:
            print(f"  {d['symbol']}: SKIP (0 contracts filled)")
            continue
        stock_size = int(filled) * 100
        side = 'Sell' if d['cp'] == 'Call' else 'Buy'   # call->long->sell; put->short->buy
        limit = float(d['strike'])
        unwind_user_data = f"{d['user_data']}_UNWIND"

        if not SEND_TRADES:
            print(f"  {d['symbol']}: DRY-RUN  {side} {stock_size} @ ${limit:g} "
                  f"({'LOC' if SEND_LOC else 'limit-immediate'})")
            continue

        try:
            if SEND_LOC:
                gc = tradeSharesLOC(symbol=d['symbol'], size=stock_size, account=account,
                                     order_side=side, limit_price=limit,
                                     userData=unwind_user_data)
                print(f"  {d['symbol']}: LOC sent  {side} {stock_size} @ ${limit:g}  gc={gc}")
            else:
                gc = tradeSharesLimit(symbol=d['symbol'], size=stock_size, account=account,
                                       order_side=side, limit_price=limit,
                                       order_duration=60,
                                       userData=unwind_user_data)
                print(f"  {d['symbol']}: limit-immediate  {side} {stock_size} @ ${limit:g}  gc={gc}")
        except Exception as e:
            print(f"  {d['symbol']}: ERROR sending stock unwind -- {e}")
    print(f"{pretty_time()} -- Finished stock unwind orders 350PM_SS")


