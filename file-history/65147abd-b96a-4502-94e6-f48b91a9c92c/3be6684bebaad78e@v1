if __name__ == "__main__":
    print(f"{pretty_time()} -- Starting 350pm SS algo. Strategy={CFG.NAME}")
    print(f"  IS_TEST={IS_TEST}  SEND_TRADES={SEND_TRADES}")

    if is_month_end():
        # We already include month_end in the special-day multiplier so this is
        # informational rather than a skip.
        print(f"  NOTE: today is month-end (will trigger 2x multiplier)")

    tickers = list(CFG.UNIVERSE.keys())
    today_is_special = is_special_day()
    account = TEST_ACCOUNTS[CFG.ACCOUNT] if IS_TEST else CFG.ACCOUNT
    # Sending test orders to v8 -> route to the v8 test account (T.AGM* only exists on v7).
    if IS_TEST and SEND_V8 and str(account).startswith("T.AGM"):
        account = "T.AGMV8.01"
    print(f"  Universe: {tickers}")
    print(f"  Account: {CFG.ACCOUNT} -> {account} (IS_TEST={IS_TEST})")
    print(f"  today_is_special: {today_is_special}")

    if not IS_TEST and not SEND_TRADES:
        raise AssertionError("SEND_TRADES=False with IS_TEST=False is not allowed")

    # Pre-check: are 0DTE single-stock options listed today for ANY universe name?
    # Probes the whole universe (NVDA-as-sentinel broke 8/26/2026: NVDA skipped a
    # daily while the other 7 had listings). Exit only if NONE have 0DTE today.
    _today = dt.date.today()
    _probe_sql = f"""SELECT 1 FROM {_srof.IMPLIED_QUOTE_TABLE}
                     WHERE okey_tk IN ({','.join(f"'{t}'" for t in tickers)})
                       AND okey_yr = {_today.year}
                       AND okey_mn = {_today.month}
                       AND okey_dy = {_today.day}
                     LIMIT 1"""
    if run_query(_probe_sql).empty:
        print(f"{pretty_time()} -- No 0DTE SS options today, exiting")
        sys.exit(0)

    # Startup chat ping (concise, matches 350pm_script.py format). Stale-calendar
    # warning is appended on a second line only if it fires.
    start_msg = (f"{getNowEst().time().strftime('%I:%M:%S %p')} "
                 f"Starting 350pm SS algo. Special day: {today_is_special}")
    stale_warning = likely_stale_calendars()
    if stale_warning:
        start_msg += f"\n{stale_warning}"

    print(f"{pretty_time()} -- {start_msg}")
    try:
        send_message(start_msg, my_chat)
    except Exception as e:
        print(f"WARNING: startup chat send failed: {e}")

    # Phase 1: data pulls (3pm prices, 3:50 spot, imbals).
    signal_data = pull_signal_data(tickers)
    if signal_data is None:
        print(f"{pretty_time()} -- No SS imbal data. Exiting.")
        post_no_trade_summary(tickers, None, today_is_special,
                               "No SS imbal data, exiting")
        sys.exit(0)

    # Phase 2: per-ticker decisions (qualifiers, chain pull, build trades).
    decisions = decide_trades(tickers, signal_data, today_is_special)
    if not any(d['will_trade'] for d in decisions):
        print(f"{pretty_time()} -- No trades to send. Exiting.")
        post_no_trade_summary(tickers, signal_data, today_is_special,
                               "No qualifying signals, no trades sent")
        sys.exit(0)

    # Phase 3: send option orders. Returns at W2-fire (~t+4s), not W2-expiry.
    # Records t=0 for LOC delay.
    t_options_send = send_option_orders(decisions, account, today_is_special)

    # Phase 4: post chat recap IMMEDIATELY (W1 fills + any W2 shown as working).
    post_chat_summary(decisions, signal_data, today_is_special, account)

    # Phase 4b: wait out the W2 windows, fold W2 fills into decisions.
    collect_w2_fills(decisions)

    # Phase 4c: write Bloomberg OI-format backup file BEFORE LOCs so it's on disk
    # in case the LOC sends fail and the user needs to upload manually. Needs
    # final fill counts -> must follow collect_w2_fills.
    write_bbg_exit_file(decisions)

    # Phase 4d: short follow-up chat message with final W2 fills (if any W2 sent).
    post_w2_final_summary(decisions)

    # Phase 5: wait LOC_DELAY_S after option send, then fire stock unwinds.
    # (LOC timing unchanged: W2 expires ~t+41s, LOC target is t+LOC_DELAY_S.)
    send_stock_unwinds(decisions, account, t_options_send)

    print(f"{pretty_time()} -- Done.")
