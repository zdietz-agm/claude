# ============================================================================
def pull_3pm_prices_bbg(tickers, target_date=None, is_test=False):
    """One bdib call per ticker (Bloomberg bdib doesn't support multi-symbol).
    Returns dict {ticker: price}.

    Reference time is 15:00 in prod, 9:31 in test mode -- test runs typically
    happen well before 15:00, so 9:31 gives an early-morning bar that already
    exists in the bdib feed.
    """
    target_date = target_date or dt.date.today()
    target_time = dt.time(9, 31, 0) if is_test else dt.time(15, 0, 0)
    target_ts = pd.Timestamp(dt.datetime.combine(target_date, target_time))
    out = {}
    for t in tickers:
        try:
            df = blp.bdib(ticker=f'{t} US Equity', dt=target_date.strftime('%Y-%m-%d'),
                           interval=1, ref="EquityUS")
            df.index = pd.to_datetime(df.index)
            # bdib returns a tz-aware index in America/New_York. Normalize to naive
            # for an apples-to-apples comparison with a naive target_ts.
            if df.index.tz is not None:
                df.index = df.index.tz_localize(None)
            mask = df.index <= target_ts
            if not mask.any():
                out[t] = None
                continue
            closest = df.index[mask].max()
            row = df.loc[closest]
            # Multi-level columns (ticker, field) -- grab close (typical idx 3 for OHLCV)
            close_key = (f'{t} US Equity', 'close')
            if close_key in row.index:
                out[t] = float(row[close_key])
            elif 'close' in row.index:
                out[t] = float(row['close'])
            else:
                out[t] = float(row.iloc[3])
        except Exception as e:
            print(f"  pull_3pm_prices_bbg({t}): {e}")
            out[t] = None
    return out


def pull_350_spot_bbg(tickers):
    """Snapshot live PX_LAST for all tickers in one bdp call."""
    try:
        df = blp.bdp([f'{t} US Equity' for t in tickers], 'PX_LAST')
        df.index = df.index.str.replace(' US Equity', '', regex=False)
        return df['px_last'].to_dict()
    except Exception as e:
        print(f"  pull_350_spot_bbg failed: {e}")
        return {t: None for t in tickers}


