	wait_until(dt.time(8 if IS_TEST else LAST_HOUR, 55, 1, 200000), poll_interval=0.05)

	print(f"{pretty_time()} -- Refreshing SPXW option chains at 355PM")
	# Wider chain (includes up to 1$ ITM strike) so the CLOSER variants
	# (msd=-1) can pick a near-ATM short leg. Regular configs (msd>=1) drop
	# the ITM row in helpers.py's filter, so their behavior is unchanged.
	calls = run_query(get_closest_and_slightly_itm_calls_sql, verbose=True, tag="refresh355_calls")
	puts = run_query(get_closest_and_slightly_itm_puts_sql, verbose=True, tag="refresh355_puts")
	spx = puts.uprc[0]
	# Log each side's own uprc and its nearest-to-ATM strike: the ITM window in these SQLs
	# gates on each ROW's own uprc, not on the puts.uprc[0] used as spot downstream, so when
	# the two diverge the CLOSER (msd=-1) can silently lose its near-ATM strike (observed
	# 8/24/26 on v8: puts uprc 7655.83 but 7655C absent -> CLOSER landed on its parent's
	# 7660/7665). Highest put / lowest call returned make that visible per side.
	calls_uprc = calls.uprc[0] if len(calls) else float("nan")
	lowest_call = calls.okey_xx[0] if len(calls) else float("nan")
	highest_put = puts.okey_xx[0] if len(puts) else float("nan")
	print(f"{pretty_time()} -- Finished refreshing. SPX: {spx:,.2f} (puts uprc, highest put "
		  f"strike returned: {highest_put:,.0f}); calls uprc: {calls_uprc:,.2f}, lowest call "
		  f"strike returned: {lowest_call:,.0f}")

	# helpers.py now applies min_strike_distance natively (literal-$ semantics
	# after the May 2026 migration). No script-level pre-filter needed -- each
	# config's own min_strike_distance controls its strike filtering. CLOSER
	# variants (msd=-1) require seeing strikes within $1 of spot to pick the
	# closest-to-ATM short leg, so any blanket script-level filter would block
	# them. Reset index for defensive correctness so iloc[0] in prep_trades
	# still hits the closest OTM strike.
	puts_filtered = puts.reset_index(drop=True)
	calls_filtered = calls.reset_index(drop=True)

	option_chains = {
		"SPXW": {"puts": puts_filtered, "calls": calls_filtered, "underlying": spx},
	}

	print(f"{pretty_time()} -- Starting prep_trades() 355PM")
	# Compute 4th regime factor: abs change in SPX imbal from 3:50 to 3:55. 355PM only.
	# Falls back to None (-> 3-factor edges) if either snap failed.
	abs_chg_imbal = None
	if (isinstance(imbal_350, (int, float)) and isinstance(imbal_355, (int, float))
	    and imbal_350 != NO_IMBAL_VAL and imbal_355 != NO_IMBAL_VAL):
		abs_chg_imbal = abs(imbal_355 - imbal_350)
	_chg_str = f"{abs_chg_imbal/1e9:.2f}B" if abs_chg_imbal is not None else "None"
	print(f"{pretty_time()} -- Regime edge inputs: VIX={vix:.2f}, atmVol={today_vol:.3f}, absImbal={abs(imbal_355)/1e9:.2f}B, absChgImbal={_chg_str}")
	# Live-reload SIZE_MULT_355_PUTS/CALLS from algo_globals so mid-run edits take effect.
	from algo_globals import get_live_size_mults
	_puts_mult_355, _calls_mult_355 = get_live_size_mults("355")
	print(f"{pretty_time()} -- Live size mults (355): puts={_puts_mult_355}, calls={_calls_mult_355}")
	trade_dict, explanations_dict = prep_trades(configs=configs,
												factor_dict=factor_dict,
												option_chains=option_chains,
												today=today,
												trigger_all=TRIGGER_ALL,
												trigger_all_size=TRIGGER_ALL_SIZE,
												magnets=[],
												vix=vix,
												atm_vol_0dte=today_vol,
												abs_imbal=abs(imbal_355),
												abs_chg_imbal=abs_chg_imbal,
												abs_chg_stats=helpers.ABS_CHG_IMBAL_STATS_355PM,  # intentionally-low 355 set (see helpers.py)
												is_test=IS_TEST,
												puts_size_mult=_puts_mult_355,
												calls_size_mult=_calls_mult_355,
												)
	print(f"{pretty_time()} -- Finished prep_trades() 355PM")

	# _____________________________________________________________Resize Trades_____________________________________________________________
	# 355pm-specific: when a CLOSER variant trades, decrement its parent's size by the CLOSER's size.
	# Parent floors at 1 lot. Defined in helpers.apply_closer_resize so simulate_prod.py
	# can call the exact same function (no copy-paste drift).
	# Runs BEFORE apply_size_limits so the loss-cap sees post-resize sizes.
	apply_closer_resize(trade_dict, log_fn=lambda msg: print(f"{pretty_time()} -- {msg}"))

	# Apply size limits (loss-cap pro-rata) -- AFTER apply_closer_resize so resizes are reflected.
	try:
		from position_logging_helper import apply_size_limits
		print(f"{pretty_time()} -- Starting size limit check (355PM)")
		apply_size_limits(trade_dict, is_test=IS_TEST, explanations_dict=explanations_dict, max_loss_cap=MAX_LOSS_CAP_355)
		print(f"{pretty_time()} -- Finished size limit check (355PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in size limit check (355PM): {e}")

	# _____________________________________________________________Send Trades_____________________________________________________________
	if IS_TEST:
		for trade in trade_dict["trades"]:
			trade["account"] = TEST_ACCOUNTS[trade["account"]]

	print(f"{pretty_time()} -- Starting orchestrate_batched_send() 355PM (+ fire_hackers concurrently)")
	if SEND_TRADES:
		# Run orchestrator and hackers CONCURRENTLY in a single event loop. Hackers wait
		# ~100ms so orchestrator's wave-1 hits SR first, then fire during orchestrator's
		# Phase-3 3s sleep. Wall-time added by hackers: 0s (they fit inside orchestrator's
		# ~3-4s window). Hackers append themselves to trade_dict so log_trades sees them.
		async def _fire_all_355():
			tasks = [orchestrate_batched_send(
				trade_dict, orderDuration=30,
				srtrade_pool=srtrade_pool_355,
				sranalytics_pool=sranalytics_pool_355,
			)]
			if HACKING_350_ENABLED and hacker_fills:
				tasks.append(fire_hackers(
					trade_dict=trade_dict,
					hacker_fills=hacker_fills,
					factor_355_imbal_less_than_neg_950m=factor_dict.get("factor_355_imbal_less_than_neg_950m", 0),
					factor_355_imbal_greater_than_950m=factor_dict.get("factor_355_imbal_greater_than_950m", 0),
					today=today, is_test=IS_TEST,
					delay_start_seconds=0.05,   # 50ms head start for orchestrator wave-1 -- sranalytics SELECT adds another ~20-50ms of implicit buffer
					log_fn=lambda msg: print(f"{pretty_time()} -- [hacker] {msg}"),
					# Regime inputs for the floored 355-methodology edge blend (same set 355PM uses).
					vix=vix, atm_vol_0dte=today_vol, abs_imbal=abs(imbal_355), abs_chg_imbal=abs_chg_imbal,
				))
			await asyncio.gather(*tasks, return_exceptions=True)
		asyncio.run(_fire_all_355())
	print(f"{pretty_time()} -- Finished orchestrate_batched_send() 355PM (+ hackers)")

	# Log net option positions
	try:
		from position_logging_helper import log_positions
		print(f"{pretty_time()} -- Starting position logging (355PM)")
		log_positions(trade_dict, script_name="355PM", is_test=IS_TEST)
		print(f"{pretty_time()} -- Finished position logging (355PM)")
	except Exception as e:
		print(f"{pretty_time()} -- ERROR in position logging (355PM): {e}")

	# ================= 355 EXTRA-SPREADS LIMIT LADDER (added 2026-08-24/25) =====================
	# Rest $5-wide sell limits until 15:59:30 ET when the GROWS / VS_MKT_LOW_VOL parents fire.
	# Mirrors the 350 hook: try/except so a ladder failure can never crash the 3:55 run; orders
	# send in a background thread. Config: configs_extra_spreads/extra_spread_config_355.py.
	# (The recap block for extra_spread_summary_355 sits after *Explanations:* below -- the only
	# other line this feature touches in this file.)
	extra_spread_summary_355 = ""
	try:
		from extra_spread_trader_355 import send_extra_spread_orders_355
		print(f"{pretty_time()} -- Starting 355 extra spread orders")
		extra_spread_summary_355 = send_extra_spread_orders_355(
			trade_dict=trade_dict, puts=puts_filtered, calls=calls_filtered,
			today=today, counter=counter, is_test=IS_TEST, send_trades=SEND_TRADES,
		)
		print(f"{pretty_time()} -- Finished 355 extra spread orders")
	except Exception as e:
		extra_spread_summary_355 = f"ERROR in 355 extra spread trader: {e}"
		print(f"{pretty_time()} -- ERROR in 355 extra spread trader: {e}")
	# ============================ END 355 EXTRA-SPREADS LADDER ==================================

	# _____________________________________________________________Summary_____________________________________________________________

	summary += f"SPX: {spx:,.2f}. 350PM Imbal: {imbal_350:,.0f}. 355PM Imbal: {imbal_355:,.0f}.\n"
	summary += f"Market at 3:55: {market_355}.\n"
	summary += f"SPY 3:40-3:50: {spy_chg_1540_1550_bps:.1f}bps. SPY 3:50-3:55: {spy_chg_1550_1555_bps:.1f}bps.\n"
	if ndx_imbal_355 is not None:
		summary += f"NDX 355PM Imbal: {ndx_imbal_355 / 1e9:.2f}B.\n"
	else:
		summary += "NDX 355PM Imbal: N/A.\n"
	summary += f"Today's Vol: {today_vol:.3f}.\n"
	summary += f"Regime inputs: VIX={vix:.2f}, atmVol={today_vol:.3f}, absImbal={abs(imbal_355)/1e9:.2f}B.\n"

	summary_dict = {}

	for trade, trade_type in zip(trade_dict["trades"], trade_dict["trade_types"]):
		if not trade["name"] in summary_dict:
			summary_dict[trade["name"]] = f"""\n*{trade["name"]}* ({trade["account"]}):\n"""
		if trade_type == "complex":
			if trade["direction"] == "Sell":
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["short_legs"][0].okey_xx} {trade["long_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""
			else:
				summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["long_legs"][0].okey_xx} {trade["short_legs"][0].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""
		else:
			summary_dict[trade["name"]] += f"""{trade["direction"]} {trade["size"]} {trade["symbol"]} {trade["option"].okey_xx} {trade["structure"]} for {trade["price"]}.\n"""

	for single_algo_summary in summary_dict.values():
		summary += single_algo_summary

	summary += "\n*Explanations:*"
	for algo_name, explanations in explanations_dict.items():
		summary += f"""\n{algo_name}:\n"""
		summary += explanations["put"]
		summary += explanations["call"]

	if extra_spread_summary_355:   # 355 extra-spreads ladder recap (hook above, before Summary)
		summary += f"\n*355 Extra Spreads:*\n{extra_spread_summary_355}\n"

	# Prepend any loud send-phase warnings (wave-1 not confirmed terminal -> hedged wave-2 from the
	# orchestrator; FULL-SIZE-NOT-SENT 4-order-cap drops from trade_complex) so they sit at the TOP.
	_warns = (trade_dict.get("send_warnings") or []) + drain_send_warnings()
	_warn_block = ("\n".join(_warns) + "\n\n") if _warns else ""
	print(summary)
	send_message(f"{getNowEst().time().strftime('%I:%M:%S %p')}\n" + _warn_block + summary, my_chat)

	# Log per-algo trade attempts to optionsResearch.algo_trade_log (60s wait for SR fills to settle).
	# Wrapped in try/except so logging failure never affects trading (trading is already done at this point).
	# Skipped entirely in test mode -- we don't want test trades polluting the prod log table.
	# Note: 355PM doesn't capture rsi / high_low / 3m_realized_chg / qqq_imbal / paired_imbal -> logged NULL.
	if IS_TEST:
		print(f"{pretty_time()} -- algo_trade_logger SKIPPED (IS_TEST=True)")
	else:
		try:
			from algo_trade_logger import log_trades
			factors_for_log = {
				"spx_price":       float(spx) if spx is not None else None,
				"vix":             float(vix) if vix is not None else None,
				"atm_vol":         float(today_vol) if today_vol is not None else None,
				"market_ratio":    float(today_move_355 / std_355) if std_355 else None,
				"rsi":             None,
				"high_low_ratio":  None,
				"realized_3m_chg": None,
				"imbal_340":       None,
				"imbal_350":       int(imbal_350) if (not isinstance(imbal_350, str) and imbal_350 is not None) else None,
				"imbal_355":       int(imbal_355) if (not isinstance(imbal_355, str) and imbal_355 is not None) else None,
				"qqq_imbal":       None,
				"paired_imbal":    None,
			}
			print(f"{pretty_time()} -- Starting algo_trade_logger (60s wait for SR fills)")
			log_trades(trade_dict, factors_for_log, wait_seconds=60, script_name="355PM")
			print(f"{pretty_time()} -- Finished algo_trade_logger")
			# Second pass for wave-3 resting hackers (fills can land up to 16:00, after the
			# 60s snapshot above). Fast no-op on non-hack days; sleeps to ~16:00:30 otherwise.
			from hacker_trades import refresh_hacker_fills
			refresh_hacker_fills(trade_dict, factors_for_log, script_name="355PM",
			                     log_fn=lambda msg: print(f"{pretty_time()} -- [hacker] {msg}"))
		except Exception as _log_e:
			print(f"{pretty_time()} -- ERROR in algo_trade_logger (non-fatal): {_log_e}")
			traceback.print_exc()

	if srtrade_pool_355 is not None:     srtrade_pool_355.close()
	if sranalytics_pool_355 is not None: sranalytics_pool_355.close()
