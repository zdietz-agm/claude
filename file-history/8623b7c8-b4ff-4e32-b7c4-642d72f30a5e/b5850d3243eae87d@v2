        for q in f["quotes"]:
            if "net_sprc" not in q:
                continue
            key = (q["wave"], q["legs"][0]["strike"], q["legs"][1]["strike"],
                   q["net_sprc"], q["net_cross"])
            rows.setdefault(key, {"q": q, "algos": []})["algos"].append(
                short_algo(q["algo"]))
        emit(f"   {'wave':<5}{'legs':<14}{'net sprc':>9}{'net cross':>10}"
             f"{'net mid':>9}{'sprc-cross':>11}  algos")
        for key, v in rows.items():
            q = v["q"]
            legs = f"{q['legs'][0]['strike']:.0f}/{q['legs'][1]['strike']:.0f}" \
                   f"{q['legs'][0]['cp']}"
            emit(f"   {q['wave']:<5}{legs:<14}{q['net_sprc']:>9.3f}"
                 f"{q['net_cross']:>10.3f}{q['net_mid']:>9.3f}"
                 f"{q['sprc_minus_cross']:>11.3f}  "
                 f"{', '.join(sorted(set(v['algos'])))}")
        if f["sprc_outside_nbbo"]:
            any_flag = True
            emit("   *** legs where the SR surface price sat OUTSIDE its own NBBO ***")
            seen = {}
            for o in f["sprc_outside_nbbo"]:
                key = (o["wave"], o["leg"], o["sprc"], o["nbbo"], o["is_short_leg"])
                seen.setdefault(key, []).append(short_algo(o["algo"]))
            for (wave, leg, sprc, nbbo, is_short), algos in seen.items():
