# ---------------------------------------------------------------- date helpers

def is_trading_day(d):
    """True if d is an NYSE trading day (holiday-aware, via calendar_utils)."""
    window = calendar_utils._trading_range(d - dt.timedelta(days=10), d)
    return d in window


def prior_trading_day(d):
    """Most recent trading day strictly before d."""
    window = calendar_utils._trading_range(d - dt.timedelta(days=15), d)
    before = [x for x in window if x < d]
    if not before:
        raise RuntimeError(f"no trading day found before {d}")
    return before[-1]


def trailing_trading_days(end, n):
    """The n trading days ending at (and including) end."""
    window = calendar_utils._trading_range(end - dt.timedelta(days=3 * n + 15), end)
    window = [x for x in window if x <= end]
    return window[-n:]


