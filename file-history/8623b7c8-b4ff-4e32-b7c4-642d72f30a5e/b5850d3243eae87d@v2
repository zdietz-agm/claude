    if len(other):
        sub("NON-ALGO PNL ROWS SAME DAY (context only, not part of this review)")
        for _, r in other.sort_values("pnl").iterrows():
            emit(f"   {str(r['strategy'])[:56]:<56}{r['pnl']:>12,.0f}")
    return bt_pnl


PNL_DISAGREE_PCT = 0.10


def section_reconciliation(prod_df, review_date, statuses, atl):
    """Per-strategy AGREE / DISAGREE verdict, so the review never eyeballs two numbers.

    Materiality bar (Zach, 2026-08-21, correction #7 amendment): a disagreement is a PnL gap
    of >= 10% of the larger side, a different strike on either leg, one side trading while
    the other did not, or a different side/direction. Anything tighter is agreement and gets
    no line in the review.
    """
    hdr("RECONCILIATION VERDICT")
    day = prod_df[prod_df["trade_date"] == review_date]
    # Scope rule (correction #3): only strategies belonging to a run_algos.sh script. The
    # discretionary / iron condor / wheel book is out of scope for this review entirely.
    day = day[day["strategy"].str.contains("ALGO_42|EQUITY_ALGO|BTIC", case=False, na=False)]
    prod_pnl, prod_note = {}, {}
    for _, r in day.iterrows():
        prod_pnl[str(r["strategy"])] = float(r["pnl"])
        if isinstance(r.get("notes"), str) and r["notes"].strip():
            prod_note[str(r["strategy"])] = r["notes"].strip()

    bt_pnl, bt_strikes, bt_src = {}, {}, {}
    for st in statuses:
        for full, v in st["pnl"].items():
            name = prod_name_for(full)
            bt_pnl[name] = v
            bt_src[name] = st["key"]
            if st["strikes"].get(full):
                bt_strikes[name] = st["strikes"][full]

    # Prod strikes from the base (non-v8, non-fast) book; those are what the backtest models.
    prod_strikes = {}
    if not atl.empty:
        base = atl[~atl["script_name"].astype(str).str.contains("_V8|_FAST", regex=True)]
        for _, r in base.iterrows():
            name = prod_name_for(r["algo_name"])
            cp = str(r["cp"])
            if cp in ("Put", "Call"):
                prod_strikes.setdefault(name, {})[cp] = (
                    _f(r["short_strike"]), _f(r["long_strike"]))

    names = sorted(set(prod_pnl) | set(bt_pnl))
    if not names:
        emit("   nothing traded on either side.")
        return
    verdicts = []
    for name in names:
        p, b = prod_pnl.get(name), bt_pnl.get(name)
        reasons = []
        if p is None and b is not None and abs(b) > 0:
            reasons.append("backtest traded, prod did not")
        elif b is None and p is not None and "OUTRIGHT" not in name.upper():
            # OUTRIGHT never has a backtest row (create_backtests filters it unless
            # --outright). Structural, already understood, and Zach asked not to be told
            # about it again -- correction #2.
            reasons.append("prod traded, backtest has no row")
        elif p is not None and b is not None:
            denom = max(abs(p), abs(b))
            if denom > 0:
                pct = abs(p - b) / denom
                if pct >= PNL_DISAGREE_PCT:
                    reasons.append(f"PnL differs {pct * 100:.0f}% "
                                   f"(prod {p:,.0f} vs bt {b:,.0f})")
        ps, bs = prod_strikes.get(name, {}), bt_strikes.get(name, {})
        if ps and bs:
            for cp in sorted(set(ps) | set(bs)):
                if cp not in ps:
                    reasons.append(f"backtest traded {cp}, prod did not")
                elif cp not in bs:
                    reasons.append(f"prod traded {cp}, backtest did not")
                elif ps[cp] != bs[cp]:
                    reasons.append(
                        f"{cp} strikes differ: prod {ps[cp][0]:.0f}/{ps[cp][1]:.0f} "
                        f"vs bt {bs[cp][0]:.0f}/{bs[cp][1]:.0f}")
        verdicts.append((name, p, b, bt_src.get(name, "-"), reasons))

    dis = [v for v in verdicts if v[4]]
    agree = [v for v in verdicts if not v[4]]
    emit(f"   {len(dis)} disagreement(s), {len(agree)} in agreement "
         f"(bar: >={PNL_DISAGREE_PCT * 100:.0f}% PnL, any strike diff, or one-sided trade)")
    if dis:
        sub("DISAGREE -- name these in the review")
        for name, p, b, src, reasons in dis:
            emit(f"   {name}")
            emit(f"      prod {'-' if p is None else f'{p:,.0f}'}   "
                 f"backtest {'-' if b is None else f'{b:,.0f}'}   [{src}]")
            for why in reasons:
                emit(f"      - {why}")
            if name in prod_note:
                emit(f"      prod note: {prod_note[name][:110]}")
    if agree:
        sub("AGREE -- one flat line in the review, no per-strategy detail")
        for name, p, b, src, _ in agree:
            emit(f"   {name[:58]:<58}prod {'-' if p is None else f'{p:>10,.0f}'}   "
                 f"bt {'-' if b is None else f'{b:>10,.0f}'}")
    if not prod_strikes:
        emit()
        emit("   NOTE: no algo_trade_log rows, so strike-level comparison was not possible; "
             "verdicts above are PnL-only.")


def section_streaks(prod_df, review_date):
    hdr("CONSECUTIVE PNL STREAKS (sizing signal)")
    days = trailing_trading_days(review_date, 15)
    window = prod_df[prod_df["trade_date"].isin(days)].copy()
    window = window[window["strategy"].str.contains("ALGO_42|EQUITY_ALGO|BTIC",
                                                    case=False, na=False)]
    if window.empty:
        emit("   no algo rows in the trailing window")
        return
    traded_today = set(
        prod_df[prod_df["trade_date"] == review_date]["strategy"].astype(str))

    emit(f"   window: {days[0]} .. {days[-1]} ({len(days)} trading days), "
         "fire days only (a day with no row is not a break in the streak)")
    emit()
    emit(f"   {'strategy':<56}{'run':>5}{'run $':>12}{'last 6 fire days':>26}")
    emit("   " + "-" * 100)
    rows = []
    for name, grp in window.groupby("strategy"):
        grp = grp.sort_values("trade_date")
        if review_date not in set(grp["trade_date"]):
            continue
        pnls = list(grp["pnl"])
        sign = 1 if pnls[-1] > 0 else (-1 if pnls[-1] < 0 else 0)
        run, total = 0, 0.0
        for v in reversed(pnls):
            if sign > 0 and v > 0 or sign < 0 and v < 0:
                run += 1
                total += v
            else:
                break
        recent = " ".join(f"{v/1000:+.0f}k" for v in pnls[-6:])
        rows.append((run * sign, name, run, total, recent, name in traded_today))
    for _, name, run, total, recent, _ in sorted(rows, key=lambda x: -abs(x[0])):
        flag = "  <== 3+ day run" if run >= 3 else ""
        emit(f"   {name[:56]:<56}{run:>5}{total:>12,.0f}{recent:>26}{flag}")
    emit()
    emit("   Interpretation is the review's job: a 3+ day same-sign run is a size-up "
         "(positive) or size-down (negative) candidate ONLY after checking "
         "eod_option_algos/prod_change_logs/ for a deliberate recent change.")


def _bin_of(value, edges):
    """Bin index for a value against ascending edges, plus distance to the nearest edge."""
    idx = sum(1 for e in edges if value >= e)
    near = min(edges, key=lambda e: abs(value - e))
    return idx, near, value - near


def _daily_moves_row(path, review_date):
    """One row of a spy_daily_moves CSV for the review date, or None."""
    try:
        df = pd.read_csv(path)
    except Exception as e:
        return None, f"could not read {os.path.basename(path)}: {e}"
    df["date"] = pd.to_datetime(df["date"]).dt.date
    row = df[df["date"] == review_date]
    if row.empty:
        return None, (f"{os.path.basename(path)} has no row for {review_date} "
                      f"(latest {df['date'].max()}) -- market-metric CSVs may be stale")
    return row.iloc[0], None


def section_market_state(log_facts, review_date):
    """Trade-gate distances, reporting ONLY the gates that were genuinely near (#16, #17).

    A prod log line "*Don't trade X* because <veto>" proves only that the veto was evaluated
    first -- helpers.py:1250 returns on the first match -- so it says nothing about whether a
    trade trigger would have fired. This section measures the trade side instead.

    Zach, 2026-08-26: report a gate ONLY if it was within 5 bps / one vol point / $100M of
    its boundary. Everything wider is a recap he has to read for nothing, so it is suppressed
    here rather than left for the review to filter. When nothing is near, this section says so
    in one line and the review writes no near-miss at all.
    """
    hdr("TRADE-GATE DISTANCES (near-misses only)")
    near = []      # (label, text) for gates inside the bars
    state = []     # one compact context line per script

    # --- market type: the +-0.5 market_ratio boundary, measured in SPY bps ----------------
    for label, path in [("350PM", DAILY_MOVES_350), ("355PM", DAILY_MOVES_355)]:
        row, err = _daily_moves_row(path, review_date)
        if err:
            near.append((label, f"market metrics unavailable -- {err}"))
            continue
        ratio, px, yest, std = (row["market_ratio"], row["trade_price"],
                                row["yest_close_price"], row["rolling_std"])
        mtype = ("UP" if ratio > MKT_RATIO_BOUND else
                 "DOWN" if ratio < -MKT_RATIO_BOUND else "FLAT")
        state.append(f"{label} market {mtype} (ratio {ratio:+.3f})")
        for bound, name in [(MKT_RATIO_BOUND, "UP"), (-MKT_RATIO_BOUND, "DOWN")]:
            if mtype == name:
                continue
            flip_px = yest * (1 + bound * std)
            gap_bps = abs((flip_px / px - 1) * 1e4)
            if gap_bps < NEAR_BPS:
                near.append((label, f"market type was {gap_bps:.1f} bps from {name} "
                                    f"(ratio {ratio:+.3f} vs {bound:+.1f}; SPY {px:.2f}, "
                                    f"needed {flip_px:.2f})"))
        # prod's own logged type vs the CSV the backtest reads -- a real disagreement, always
        # worth a line regardless of distance.
        key = "mkt_type_log" if label == "350PM" else "mkt_355"
        stem = "350pm_script" if label == "350PM" else "355pm_script"
        logged = (log_facts.get(stem) or {}).get("state", {}).get(key)
        if logged and logged != mtype:
            near.append((label, f"prod logged market {logged} but "
                                f"{os.path.basename(path)} gives {mtype} "
                                f"(ratio {ratio:+.3f}) -- prod and backtest disagree, FLAG"))

    # --- the +-12bps DONT_TRADE veto on the GROWS family ----------------------------------
    st355 = (log_facts.get("355pm_script") or {}).get("state", {})
    if "bps_1550_1555" in st355:
        b = st355["bps_1550_1555"]
        state.append(f"SPY 3:50-3:55 {b:+.1f} bps")
        for edge in (12.0, -12.0):
            d = abs(b - edge)
            if d < NEAR_BPS:
                tripped = b >= 12.0 if edge > 0 else b <= -12.0
                near.append(("355PM", f"the {edge:+.0f}bps veto was {'TRIPPED' if tripped else 'missed'}"
                                      f" by {d:.1f} bps ({b:+.1f} bps actual)"))

    # --- vol gates ------------------------------------------------------------------------
    for stem, label in [("350pm_script", "350PM"), ("355pm_script", "355PM")]:
        st = (log_facts.get(stem) or {}).get("state", {})
        vol = st.get("atm_vol", st.get("today_vol"))
        if vol is None:
            continue
        bits = [f"vol {vol:.3f}"]
        if "vix" in st:
            bits.append(f"VIX {st['vix']:.2f}")
        state.append(f"{label} " + ", ".join(bits))
        _, edge, d = _bin_of(vol, TODAY_VOL_EDGES)
        if abs(d) < NEAR_VOL:
            near.append((label, f"vol {vol:.3f} was {abs(d):.3f} from the {edge:.4f} bin "
                                f"edge (factor_vol / factor_vol_high_enough)"))
        if abs(vol - BUMPED_VOL_MAX) < NEAR_VOL:
            near.append((label, f"vol {vol:.3f} was {abs(vol - BUMPED_VOL_MAX):.3f} from the "
                                f"BUMPED {BUMPED_VOL_MAX} gate"))

    # --- imbalance ladders ----------------------------------------------------------------
    for stem, label in [("350pm_script", "350PM"), ("355pm_script", "355PM")]:
        st = (log_facts.get(stem) or {}).get("state", {})
        for key, thresholds, nm in [("imbal_350", IMBAL_THRESHOLDS_350, "350 imbal"),
                                    ("imbal_355", IMBAL_THRESHOLDS_355, "355 imbal")]:
            if key not in st:
                continue
            v = st[key]
            if stem == "355pm_script" or key == "imbal_350":
                state.append(f"{nm} {v/1e9:+.2f}B")
            for t in thresholds:
                for signed in ({t, -t} if t else {0.0}):
                    d = abs(v - signed)
                    if d < NEAR_IMBAL:
                        near.append((label, f"{nm} {v/1e9:+.3f}B was ${d/1e6:.0f}M from the "
                                            f"{signed/1e9:+.1f}B threshold"))
        if "imbal_350" in st and "imbal_355" in st:
            d = st["imbal_355"] - st["imbal_350"]
            gap = abs(abs(d) - IMBAL_DELTA_THRESHOLD)
            if gap < NEAR_IMBAL:
                near.append((label, f"(355-350) delta {d/1e9:+.3f}B was ${gap/1e6:.0f}M from "
                                    f"the +-{IMBAL_DELTA_THRESHOLD/1e9:.1f}B SML gate"))

    # --- output ---------------------------------------------------------------------------
    seen, uniq = set(), []
    for label, txt in near:
        if (label, txt) not in seen:
            seen.add((label, txt))
            uniq.append((label, txt))
    if uniq:
        emit(f"   Gates within the reporting bars ({NEAR_BPS:.0f} bps / {NEAR_VOL} vol / "
             f"${NEAR_IMBAL/1e6:.0f}M). A near gate is NOT a near-miss on its own -- before "
