def read_hacker_prod_policy():
    """(HACK_MAX_PRICE, TARGET_NAMES) from prod hacker_trades.py by regex -- text read only,
    never imported (it pulls SpiderRock deps). (None, []) if unreadable."""
    path = os.path.join(ALGOS_DIR, "hacker_trades.py")
    cap, names = None, []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            src = f.read()
    except OSError:
        return cap, names
    m = re.search(r"^HACK_MAX_PRICE\s*=\s*([\d.]+)", src, re.M)
    if m:
        cap = float(m.group(1))
    m = re.search(r"^TARGET_NAMES\s*=\s*\((.*?)^\)", src, re.M | re.S)
    if m:
        names = re.findall(r'"([A-Z0-9_]+)"', m.group(1))
    return cap, names


def _hack_label(algo_name):
    """Prod algo name -> hacker-backtest sheet label. HACK_ALGO_42_350PM_SPREAD_SALES_SPX_
    IMBAL_GROWS_CLOSER -> 'IMBAL_GROWS CLOSER'; ..._BUMPED -> '... BUMP'; base -> 'BASE'."""
    s = str(algo_name)
    if s.startswith(HACK_PREFIX):
        s = s[len(HACK_PREFIX):]
    s = s.split("SPREAD_SALES_SPX")[-1].lstrip("_")
    if not s:
        return "BASE"
    for suf, rep in (("_CLOSER", " CLOSER"), ("_BUMPED", " BUMP")):
        if s.endswith(suf):
            s = s[: -len(suf)] + rep
    return s


def _label_config(label):
    """Inverse of _hack_label: sheet label -> prod parent config name."""
    base = "ALGO_42_350PM_SPREAD_SALES_SPX"
    s = str(label).replace(" CLOSER", "_CLOSER").replace(" BUMP", "_BUMPED")
    return base if s == "BASE" else f"{base}_{s}"


def _cp1(v):
    return str(v).strip()[:1].upper()


def _hacker_block(stem, atl, hacker_rows, cap, scope):
    """Per-script hacker line for 355pm_script / 355pm_script_v8. Prints ONLY when prod has a
    HACK_ row for this script or the backtest attempted a hack on the review date; quiet
    days print nothing. Flags only the four real discrepancies (trigger outside the
    0.9-1.1B buffer, cap violation, size relation, attempted-but-unfilled when the model
    filled); price/timing, half-of-model vs half-of-filled sizing, v8 ratio sizing and
    unfilled-parent differences are by design and are named as such, not flagged."""
    script = {"355pm_script": "355PM", "355pm_script_v8": "355PM_V8"}.get(stem)
    if script is None:
        return
    parent_script = {"355PM": "350PM", "355PM_V8": "350PM_V8"}[script]
    prod = pd.DataFrame()
    parents = pd.DataFrame()
    if not atl.empty:
        is_hack = atl["algo_name"].astype(str).str.startswith(HACK_PREFIX)
        prod = atl[(atl["script_name"] == script) & is_hack]
        parents = atl[(atl["script_name"] == parent_script) & ~is_hack]
    bt_att = [r for r in hacker_rows if bool(r.get("attempted_hacked"))]
    if prod.empty and not bt_att:
        return

    cap_s = f"${cap:.2f}" if cap else "UNKNOWN (hacker_trades.py unreadable)"
    emit(f"   355 HACKER -- prod vs hacker backtest (prod cap {cap_s}, half-size unwind):")

    def parent_filled(cfg, cp):
        if parents.empty:
            return None
        pr = parents[(parents["algo_name"].astype(str) == cfg)
                     & (parents["cp"].astype(str).str[:1].str.upper() == _cp1(cp))]
        if pr.empty or pd.isna(pr.iloc[0]["size_filled"]):
            return None
        return int(pr.iloc[0]["size_filled"])

    def bt_match(label, cp, strikes=None):
        out = []
        for r in hacker_rows:
            if r["strategy"] != label or _cp1(r["cp"]) != _cp1(cp):
                continue
            if strikes and {_f(r["sh_strike"]), _f(r["lg_strike"])} != strikes:
                continue
            out.append(r)
        return out

    def bt_line(b, indent="       "):
        imb = _f(b.get("imbal_355"))
        imb_s = "-" if imb is None else f"{imb / 1e9:+.2f}B"
        cost = _f(b.get("hack_exit_cost"))
        cost_s = "-" if cost is None else f"{cost:.2f}"
        t = b.get("hack_exit_time")
        t_s = "-" if t is None or (isinstance(t, float) and pd.isna(t)) else str(t)
        emit(f"{indent}backtest {b['strategy']} {b['cp']} {_f(b['sh_strike']):.0f}/"
             f"{_f(b['lg_strike']):.0f}: size {int(b['size'])}, hack_size "
             f"{int(b['hack_size'])}, imbal_355 {imb_s}, triggered={bool(b['hack_triggered'])}, "
             f"attempted={bool(b['attempted_hacked'])}, filled={bool(b['hack_filled'])}, "
             f"model exit {cost_s} @ {t_s}, "
             f"delta_pnl {_f(b.get('delta_pnl')) or 0:,.0f}")

    def in_buffer(b):
        imb = _f(b.get("imbal_355"))
        return imb is not None and HACK_IMBAL_BUFFER[0] <= abs(imb) <= HACK_IMBAL_BUFFER[1]

    flags = []
    seen = set()
    for _, r in prod.iterrows():
        label, cp = _hack_label(r["algo_name"]), str(r["cp"])
        seen.add((label, _cp1(cp)))
        att = int(r["size_attempted"])
        filled = 0 if pd.isna(r["size_filled"]) else int(r["size_filled"])
        w1 = 0 if pd.isna(r["wave1_filled_qty"]) else int(r["wave1_filled_qty"])
        w2 = 0 if pd.isna(r["wave2_filled_qty"]) else int(r["wave2_filled_qty"])
        w3 = max(0, filled - w1 - w2)   # no wave-3 column exists; the re-log lands here
        avg = _f(r["avg_fill_price"])
        avg = None if avg is None else abs(avg)
        lim = lambda v: "-" if _f(v) is None else f"{abs(_f(v)):.2f}"
        strikes = {_f(r["short_strike"]), _f(r["long_strike"])}
        lo, hi = sorted(strikes)
        cfg = str(r["algo_name"])[len(HACK_PREFIX):]
        pf = parent_filled(cfg, cp)
        want = None if pf is None else pf // 2
        emit(f"     prod {label} {cp} {lo:.0f}/{hi:.0f}: sent {att}, filled {filled} "
             f"(W1 {w1}, W2 {w2}, W3 {w3}), avg debit "
             f"{'-' if avg is None else f'{avg:.2f}'}, W1lim {lim(r['wave1_limit'])} "
             f"W2lim {lim(r['wave2_limit'])}; parent {parent_script} filled "
             f"{'-' if pf is None else pf} -> floor(half) = {'-' if want is None else want}")
        if avg is not None and cap and avg > cap + 1e-9:
            flags.append(f"CAP VIOLATION: {script} {label} {cp} avg debit {avg:.2f} > "
                         f"prod cap {cap:.2f}")
        if pf is None:
            flags.append(f"SIZE RELATION UNCHECKED: no {parent_script} algo_trade_log row "
                         f"for {cfg} {cp}")
        elif att != want:
            flags.append(f"SIZE RELATION: {script} {label} {cp} sent {att} but "
                         f"floor(parent filled {pf} / 2) = {want}")
        matches = bt_match(label, cp, strikes) or bt_match(label, cp)
        if not matches:
            emit(f"       backtest: no {label} {cp} leg modeled on this date")
            continue
        b = matches[0]
        bt_line(b)
        if not bool(b["hack_triggered"]) and not in_buffer(b):
            imb = _f(b.get("imbal_355"))
            flags.append(f"TRIGGER MISMATCH: prod hacked {label} {cp} but backtest "
                         f"hack_triggered=False at imbal_355 {imb / 1e9:+.2f}B (outside the "
                         "0.9-1.1B buffer)")
        if att > 0 and filled == 0 and bool(b["hack_filled"]):
            cost = _f(b.get("hack_exit_cost"))
            flags.append(f"*** POSSIBLE WAVE-3 MALFUNCTION: prod {script} {label} {cp} sent "
                         f"{att}, filled 0, but the backtest says the cross was at/under the "
                         f"cap (model exit {cost:.2f} @ {b.get('hack_exit_time')}). "
                         "THIS SHOULD BE REVIEWED. ***")

    for b in bt_att:
        key = (b["strategy"], _cp1(b["cp"]))
        if key in seen:
            continue
        cfg = _label_config(b["strategy"])
        emit(f"     backtest-only: attempted hack with no {script} HACK_ row")
        bt_line(b)
        pf = parent_filled(cfg, b["cp"])
        if scope and cfg not in scope:
            emit(f"       {cfg} is not in prod hacker scope (hacker_trades.TARGET_NAMES) "
                 "-- expected")
        elif pf is None or pf == 0:
            emit(f"       parent {cfg} {b['cp']} had no {parent_script} fill -- expected "
                 "(prod hacks filled legs only; the backtest assumes every modeled leg "
                 "filled at 3:50)")
        elif pf // 2 < 1:
            emit(f"       parent filled {pf} -> half-size 0, 1-lot skip -- expected")
        elif in_buffer(b):
            emit("       imbal_355 inside the 0.9-1.1B buffer -- live 950M vs T+1 1B "
                 "threshold difference, expected")
        else:
            imb = _f(b.get("imbal_355"))
            flags.append(f"TRIGGER MISMATCH: backtest hacked {b['strategy']} {b['cp']} "
                         f"(imbal_355 {imb / 1e9:+.2f}B) but prod {script} did not; parent "
                         f"{parent_script} filled {pf}")

    if flags:
        emit("   HACKER FLAGS (real discrepancies):")
        for line in flags:
            emit(f"     {line}")
    else:
        emit("   no real hacker discrepancy (fill price/timing, half-of-model vs "
             "half-of-filled sizing, v8 ratio sizing and threshold-buffer differences are "
             "by design)")


