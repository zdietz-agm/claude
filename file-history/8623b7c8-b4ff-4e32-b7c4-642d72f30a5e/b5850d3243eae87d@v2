def already_running(script):
    """True if a python process is already running `script`.

    The review can fire at 8:25-8:35 while CreateBacktestsExtraLayers (8:16) is still going
    on a cold file cache. Launching a second copy of the same three backtests would waste
    ~10 minutes and have two processes writing workbooks at once, so wait for the in-flight
    run instead.
    """
    ps = ("Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" | "
          "ForEach-Object { \"$($_.ProcessId)|$($_.CommandLine)\" }")
    try:
        p = subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                           capture_output=True, text=True, timeout=60)
    except Exception:
        return False
    mine = os.getpid()
    for line in (p.stdout or "").splitlines():
        pid, _, cmdline = line.partition("|")
        if not pid.strip().isdigit() or int(pid) == mine:
            continue   # never match this process's own command line
        if script in cmdline:
            return True
    return False


def wait_for_workbook(spec, today, minutes):
    """Poll for a workbook written today, up to `minutes`. Returns True if it appeared."""
    deadline = time.time() + minutes * 60
    while time.time() < deadline:
        path = newest_workbook(spec)
        if path and dt.datetime.fromtimestamp(os.path.getmtime(path)).date() == today:
            return True
        time.sleep(20)
    return False


def run_wrapper(script, timeout_s):
    path = os.path.join(SCHED_DIR, script)
    emit(f"   running {script} (timeout {timeout_s}s)")
    try:
        p = subprocess.run([sys.executable, path], cwd=SCHED_DIR,
                           capture_output=True, text=True, timeout=timeout_s)
        tail = "\n".join((p.stdout or "").strip().splitlines()[-12:])
        emit(f"   exit={p.returncode}")
        for line in tail.splitlines():
            emit(f"     | {line[:150]}")
        if p.returncode != 0 and p.stderr:
            for line in (p.stderr or "").strip().splitlines()[-8:]:
                emit(f"     ! {line[:150]}")
        return p.returncode
    except subprocess.TimeoutExpired:
        emit(f"   TIMEOUT after {timeout_s}s")
        return 124


def attempt_regen(stale_specs, today):
    """Try to rebuild stale/missing backtests; say plainly when it cannot be done.

    A stale workbook nearly always means the T+1 pipeline failed, and the usual cause is a
    connection this script cannot fix. Two distinct gates:

    1. SpiderRock VPN is required by EVERY generator regardless of upstream status, because
       create_backtests.py imports scratch/algos/helpers.py, which imports
       spdr_rock_functions, which calls getVols("EEM") at MODULE IMPORT time. With the VPN
       down that raises MySQLdb.OperationalError (2002) before any backtest logic runs, and
       the upstream status file cannot predict it -- observed 2026-08-19, where
       UpdateDataEOD was green at 07:56 but CreateBacktestsEOD died on this import at 08:12.
    2. Bloomberg + ThetaData are required only if update_data itself has to be re-run.

    When blocked we do not thrash: name the down connection and the exact commands to run
    once it is back, so the review can hand Zach an actionable line.
    """
    log = []
    redirect(log)
    sub("REGEN ATTEMPT")
    try:
        result = _regen_body(stale_specs, today)
    finally:
        restore()
    result["log"] = log
    return result


def _regen_body(stale_specs, today):
    eod_st = read_status("UpdateDataEOD")
    st355 = read_status("UpdateData355")

    def ok(st):
        return bool(st and st.get("date") == today.isoformat()
                    and st.get("all_steps_ran"))

    emit(f"   UpdateDataEOD status : {'ran all steps today' if ok(eod_st) else eod_st}")
    emit(f"   UpdateData355 status : {'ran all steps today' if ok(st355) else st355}")

    needs_update = not (ok(eod_st) and ok(st355))
    emit(f"   update_data re-run needed: {'YES' if needs_update else 'no'}")
    emit("   probing connections (SpiderRock is required by the create_backtests import "
         "chain even when upstream is green)")
    probes = probe_connections()
    for k, v in probes.items():
        emit(f"     {k}: {'UP' if v else 'DOWN'}")

    required = {"spiderrock"}
    if needs_update:
        required |= {"bbg", "thetadata"}
    blocked = sorted(r for r in required if not probes.get(r, False))

    if blocked:
        emit(f"   REGEN BLOCKED -- {', '.join(blocked)} down.")
        if "spiderrock" in blocked:
            emit("     SpiderRock/VPN down: every backtest generator dies at import "
                 "(helpers.py -> spdr_rock_functions -> getVols). Nothing can be rebuilt "
                 "until the corp VPN is back.")
        if "bbg" in blocked:
            emit("     Bloomberg down: update_data steps 3a/3b/4 cannot run, so the "
                 "market-metric CSVs stay stale.")
        if "thetadata" in blocked:
            emit("     ThetaData down: update_data step 5a cannot refresh the OPRA cache.")
        emit("   ACTION FOR ZACH -- fix the connection(s) above, then run:")
        if needs_update:
            emit("     python D:/agent_projects/scheduled_tasks/run_update_eod.py")
            emit("     python D:/agent_projects/scheduled_tasks/run_update_355.py")
        for spec in stale_specs:
            emit(f"     {spec['manual_cmd']}")
        return {"attempted": True, "blocked": blocked, "regen_ok": False}

    if needs_update:
        run_wrapper("run_update_eod.py", 3000)
        run_wrapper("run_update_355.py", 3000)

    wrappers = []
    for spec in stale_specs:
        if spec["generator"] not in wrappers:
            wrappers.append(spec["generator"])
    for w in wrappers:
        if already_running(w):
            emit(f"   {w} is ALREADY RUNNING (the scheduled task has not finished) -- "
                 "waiting for it rather than starting a duplicate")
            for spec in stale_specs:
                if spec["generator"] != w:
                    continue
                got = wait_for_workbook(spec, today, minutes=12)
                emit(f"     {spec['label']}: "
                     f"{'appeared' if got else 'still missing after 12 min'}")
            continue
        run_wrapper(w, 1800)
    return {"attempted": True, "blocked": blocked, "regen_ok": True}


