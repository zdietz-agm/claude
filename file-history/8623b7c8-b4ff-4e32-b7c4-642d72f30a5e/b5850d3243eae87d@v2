# --- Fill quality (correction #13): quote AT the fill, from SpiderRock's execution table ---
# Zach's calibration (2026-08-25): sold 0.82 on fillBid 0.80 / fillAsk 0.95 = fine;
# sold 0.82 on fillBid 0.80 / fillAsk 1.20 = flag. Both conditions must hold to flag:
# fill near the disadvantageous side AND an extremely wide fill-time spread.
SR_FILLS_USER, SR_FILLS_PASS = "agm.zdietz", "m9c8mu.m"

# Both books must be queried: v8 accounts (EOD61_C42, the 355 SPREAD_BUYS book) do NOT appear
# in the v7 table at all. NOTE THE NAMING -- v8 drops the _agm_ infix, and srtrade_agm_<date>
# does not exist on v8. Confirmed with SpiderRock (Will) 2026-08-26.
#   ("label", host, port, db-name template)
SR_FILL_SOURCES = [
    ("v7", "198.102.4.55", 3307, "srtrade_agm_%Y_%m_%d"),
    ("v8", "192.81.231.66", 3700, "srtrade_%Y_%m_%d"),
]
# The v8 endpoint is load-balanced and some backends lack the grant, so the same query can
# return "ERROR 1142 SELECT command denied" on one connection and succeed on the next.
# Measured 2026-08-26: 8 of 12 fresh connections succeeded, and a denial recurred 5s after a
# success. Retry on a NEW connection -- a retry on the same one lands on the same backend.
# 6 attempts, not 3: the denials cluster rather than arriving independently -- 4 consecutive
# failures were observed on 2026-08-26 despite a ~2/3 per-connection success rate. Worst case
# this costs 25s of waiting on a day v8 is genuinely down, which is fine for a T+1 batch job.
SR_FILL_RETRIES = 6
SR_FILL_RETRY_WAIT_S = 5
FILL_POS_AGGRESSIVE = 0.25   # fill within this fraction of the quote from the bad side
FILL_SPREAD_WIDE_ABS = 0.25  # $; 0.15 (his fine example) stays under, 0.40 (his flag) over
FILL_SPREAD_WIDE_REL = 0.30  # and spread >= this fraction of mid, so deep-ITM $ spreads pass
FILL_OUTSIDE_EPS = 0.005     # beyond-quote tolerance (fillPrice==fillBid differs by ~2e-8)


# Columns we want. v7 and v8 do NOT share a schema -- v7 has 254 columns including the
# _us microsecond companions, v8 has 339 and drops them (its datetimes carry microseconds
# directly). Selecting a v7-only column against v8 raises 1054 Unknown column, which looks
# exactly like a failed connection if you are not reading the error. So the SELECT is built
# per source from the columns that actually exist there.
SR_FILL_WANT = ["accnt", "secKey_tk", "secKey_xx", "secKey_cp", "orderSide", "fillPrice",
                "fillQuantity", "fillBid", "fillAsk", "fillMark", "fillExch", "fillExecId",
                "fillTransactDttm"]
SR_FILL_REQUIRED = ["accnt", "secKey_xx", "secKey_cp", "orderSide", "fillPrice",
                    "fillQuantity", "fillBid", "fillAsk"]


def _load_sr_fills_one(host, port, db):
    """Option fills from one srtrade host, retrying a denial on a fresh connection.

    The v8 endpoint sits behind a load balancer whose backends do not all carry the grant, so
    a 1142 "SELECT command denied" is not proof the table is unavailable -- a new connection
    often lands on a backend that has it. Returns (DataFrame or None, error or None, attempts).
    """
    import pymysql
    last = None
    for attempt in range(1, SR_FILL_RETRIES + 1):
        if attempt > 1:
            time.sleep(SR_FILL_RETRY_WAIT_S)
        try:
            # New connection each attempt: reusing one keeps hitting the same backend.
            conn = pymysql.connect(host=host, port=port, user=SR_FILLS_USER,
                                   password=SR_FILLS_PASS, database=db, connect_timeout=15)
            try:
                cur = conn.cursor()
                cur.execute("SHOW COLUMNS FROM msgsrparentexecution")
                have = {r[0] for r in cur.fetchall()}
                missing = [c for c in SR_FILL_REQUIRED if c not in have]
                if missing:
                    return None, (f"msgsrparentexecution is missing required column(s) "
                                  f"{missing} -- schema changed, the fill-quality check "
                                  f"needs updating"), attempt
                cols = [c for c in SR_FILL_WANT if c in have]
                df = pd.read_sql(
                    f"SELECT {', '.join(cols)} FROM msgsrparentexecution "
                    "WHERE secKey_cp IN ('Call','Put')", conn)
                for c in SR_FILL_WANT:
                    if c not in df.columns:
                        df[c] = pd.NA   # keep one shape for both books
            finally:
                conn.close()
            return df, None, attempt
        except Exception as e:
            last = f"{type(e).__name__}: {e}"
            # Retry only the load-balancer family: 1044/1142 access denied (a backend without
            # the grant), 2003/2013 connect/lost. Anything else -- a bad column, a missing
            # table -- is deterministic, so retrying just wastes 25s and reports the wrong
            # cause. This is the trap that hid a v8 schema difference as a connection failure.
            code = getattr(getattr(e, "orig", e), "args", [None])[0]
            if code not in (1044, 1142, 2003, 2013):
                return None, last, attempt
    return None, last, SR_FILL_RETRIES


def load_sr_fills(review_date):
    """All option fills for the trade date, from BOTH the v7 and v8 execution tables.

    v8 accounts do not appear in the v7 table, so the day is only complete with both. Returns
    (DataFrame, error string or None, notes). The error is set only when NEITHER host could be
    read; if one host works, the notes say which failed and the review carries on with a
    partial book. fillBid/fillAsk are SpiderRock's quote AT the fill -- the only valid
    fill-quality evidence (correction #13).
    """
    frames, notes, errors = [], [], []
    for label, host, port, tmpl in SR_FILL_SOURCES:
        db = review_date.strftime(tmpl)
        df, err, attempts = _load_sr_fills_one(host, port, db)
        if err is not None:
            errors.append(f"{label} ({db} at {host}:{port}): {err}")
            notes.append(f"{label}: FAILED after {attempts} attempt(s) "
                         f"{SR_FILL_RETRY_WAIT_S}s apart -- {db} at {host}:{port}")
            continue
        retried = f" (succeeded on attempt {attempts})" if attempts > 1 else ""
        notes.append(f"{label}: {len(df)} option fill row(s) from {db}{retried}")
        if not df.empty:
            df = df.copy()
            df["book"] = label
            frames.append(df)
    if not frames and errors:
        return None, " | ".join(errors), notes
    if not frames:
        return pd.DataFrame(), None, notes
    out = pd.concat(frames, ignore_index=True)
    # The two tables OVERLAP -- they are not one book each. Measured 2026-08-25: v8's
    # srtrade_2026_08_25 held all 416 v7 rows PLUS the 2 EOD61_C42 fills that v7 was missing,
    # so a plain concat doubled every lot. Dedupe on fillExecId, which is unique per fill.
    before = len(out)
    if "fillExecId" in out.columns and out["fillExecId"].notna().all():
        out = out.drop_duplicates(subset=["fillExecId"], keep="last")
    else:
        out = out.drop_duplicates(
            subset=["accnt", "secKey_xx", "secKey_cp", "orderSide", "fillPrice",
                    "fillQuantity", "fillTransactDttm"], keep="last")
        notes.append("dedupe: fillExecId missing on some rows, fell back to a composite key")
    dupes = before - len(out)
    if dupes:
        notes.append(f"dedupe: {dupes} row(s) present in both books, counted once "
                     f"({len(out)} unique fills)")
    for c in ("secKey_xx", "fillPrice", "fillQuantity", "fillBid", "fillAsk", "fillMark"):
        out[c] = pd.to_numeric(out[c], errors="coerce")
    return out.reset_index(drop=True), None, notes


def _classify_fill(r):
    """'' | 'AGGRESSIVE' | 'OUTSIDE QUOTE' per correction #13. When in doubt, alert."""
    bid, ask, px = r["fillBid"], r["fillAsk"], r["fillPrice"]
    if pd.isna(bid) or pd.isna(ask) or ask <= bid:
        return "NO QUOTE"
    if px < bid - FILL_OUTSIDE_EPS or px > ask + FILL_OUTSIDE_EPS:
        return "OUTSIDE QUOTE"
    spread, mid = ask - bid, (ask + bid) / 2
    pos = (px - bid) / spread
    near_bad_side = (pos <= FILL_POS_AGGRESSIVE if r["orderSide"] == "Sell"
                     else pos >= 1 - FILL_POS_AGGRESSIVE)
    wide = spread >= FILL_SPREAD_WIDE_ABS and spread >= FILL_SPREAD_WIDE_REL * mid
    return "AGGRESSIVE" if (near_bad_side and wide) else ""


