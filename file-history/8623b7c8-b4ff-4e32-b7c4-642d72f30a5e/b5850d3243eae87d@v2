def _parse_time_args(argstr, base_hour):
    """dt.time argument list -> seconds-of-day, or None if it cannot be resolved.

    The hour is an expression, not a literal: "8 if IS_TEST else LAST_HOUR" in the EOD
    scripts, "LAST_HOUR - 1" in 4pm_script_v3. Take the prod branch (after "else"),
    substitute this file's LAST_HOUR, and evaluate only if what remains is arithmetic on
    digits -- never eval arbitrary text out of a source file.
    """
    parts = [p.strip() for p in argstr.split(",") if p.strip()]
    if not parts:
        return None
    hour_expr = parts[0].split("else")[-1].strip().replace("LAST_HOUR", str(base_hour))
    if not re.fullmatch(r"[\d\s+\-*]+", hour_expr):
        return None
    try:
        hour = int(eval(hour_expr, {"__builtins__": {}}, {}))  # digits/operators only
    except Exception:
        return None
    nums = []
    for p in parts[1:]:
        p = p.split("=")[-1].strip()   # handles microsecond=100000
        if re.fullmatch(r"\d+", p):
            nums.append(int(p))
    minute = nums[0] if len(nums) > 0 else 0
    second = nums[1] if len(nums) > 1 else 0
    micro = nums[2] if len(nums) > 2 else 0
    if not (0 <= hour <= 23 and 0 <= minute <= 59 and 0 <= second <= 59):
        return None
    return _sod(hour, minute, second, micro)


