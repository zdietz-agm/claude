    hdr("PER-SCRIPT INVENTORY AND FINDINGS")
    hacker_rows = hacker_rows or []
    hack_cap, hack_scope = read_hacker_prod_policy()
    traded_scripts, sent_sizes = set(), {}
    if not atl.empty:
        traded_scripts = {_script_key(s) for s in atl["script_name"].unique()}
        # (log stem, algo name) -> [(cp, size actually sent), ...]. The banner size upstream
        # is pre-resize; this is what went to SR.
        for _, r in atl.iterrows():
            key = (_script_key(r["script_name"]), str(r["algo_name"]))
            sent_sizes.setdefault(key, []).append(
                (str(r["cp"]), int(r["size_attempted"])))

    present = sorted(log_facts.keys())
    missing = [s for s in EXPECTED_SCRIPTS if s not in present]
    extra = [s for s in present if s not in EXPECTED_SCRIPTS]
    emit(f"   logs found ({len(present)}): {', '.join(present)}")
    if extra:
        emit(f"   not in run_algos.sh (launched by hand?): {', '.join(extra)}")
    if missing:
        emit(f"   *** EXPECTED BUT NO LOG: {', '.join(missing)} -- "
             "either the script was intentionally not launched or it never started ***")

    for stem in present:
        f = log_facts[stem]
        depth = "DEEP" if stem in DEEP_SCRIPTS else "brief"
        sub(f"{stem}  [{depth}]")
        if f["traded"]:
            emit(f"   prep_trades fired {len(f['traded'])} order(s). NOTE: the size on the")
            emit("   ALGO TRADED banner is PRE-RESIZE (before the CLOSER offset and before")
            emit("   the loss cap). NEVER use it as a fill denominator -- the sent size is")
            emit("   size_attempted in FILLS BY WAVE. Both are shown below.")
            for t in f["traded"]:
                e = t["edges"]
                sent = sent_sizes.get((stem, t["algo"]))
                sent_s = ("  -> SENT " + "/".join(f"{cp} {n}" for cp, n in sent)
                          if sent else "  -> no algo_trade_log row")
                if e:
                    emit(f"     {t['algo']} {t['structure']} price={e['price']} "
                         f"size(pre-resize)={e['size']}{sent_s}")
                    emit(f"        ET1={e['et1']} ME1={e['me1']} "
                         f"ET2={e['et2']} ME2={e['me2']}")
                else:
                    emit(f"     {t['algo']} {t['structure']}{sent_s}")
        elif stem in traded_scripts:
            emit("   traded (algo_trade_log has rows) but no ALGO TRADED banner parsed")
        else:
            emit("   no ALGO TRADED banner (this script family does not print one; "
                 "see ORDER ACTIVITY below)")
        if f["orders"]:
            emit("   order activity / skip reasons:")
            for o in f["orders"][:22]:
                emit(f"     {o}")
        if f["clamps"]:
            emit(f"   min_price clamps ({len(f['clamps'])} distinct): "
                 + "; ".join(f["clamps"][:6]))
        if f["underfill"]:
            emit("   wave-1 underfill handling:")
            emit("   NOTE: the 'WAVE1 UNDERFILL [side]: x/y' figure is a SIDE-LEVEL total "
                 "across EVERY order on that side, not one algo. Never quote it against a "
                 "single strategy -- use size_attempted / wave1_filled_qty from FILLS BY "
                 "WAVE for per-algo numbers.")
            side_totals = {}
            for (s, algo), rows in sent_sizes.items():
                if s != stem:
                    continue
                for cp, n in rows:
                    side_totals.setdefault(cp, []).append((short_algo(algo), n))
            for cp, parts in side_totals.items():
                tot = sum(n for _, n in parts)
                emit(f"     side {cp} sent {tot} = "
                     + " + ".join(f"{a} {n}" for a, n in parts))
            for u in f["underfill"][:8]:
                emit(f"     {u}")
        if f["premium_addon"]:
            emit("   premium add-on applied:")
            for p in f["premium_addon"][:8]:
                emit(f"     {p}")
        _hacker_block(stem, atl, hacker_rows, hack_cap, hack_scope)
        if f["losscap"]:
            emit("   loss cap:")
            for l in f["losscap"][:8]:
                emit(f"     {l}")
        if f["notable"]:
            emit("   month-end / MOC lines:")
            for n in f["notable"][:6]:
                emit(f"     {n}")
        if f["errors"]:
            emit(f"   *** ERROR-LIKE LINES ({len(f['errors'])}) -- read these ***")
            for e in f["errors"][:12]:
                emit(f"     {e}")
        else:
            emit("   no error-like lines")
        emit(f"   last log line: {f['last_line']}")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("date", nargs="?", help="trade date to review (YYYY-MM-DD)")
    ap.add_argument("--regen", action="store_true",
                    help="attempt to rebuild stale/missing backtest workbooks")
    args = ap.parse_args()

    today = dt.date.today()
    if args.date:
        review_date = dt.date.fromisoformat(args.date)
    else:
        review_date = prior_trading_day(today)

    statuses = [workbook_status(spec, review_date, today) for spec in BACKTEST_SOURCES]
    regen_info = None
    if args.regen:
        stale = [spec for spec, st in zip(BACKTEST_SOURCES, statuses)
                 if not st["fresh"]]
        if stale:
            print(f"Regenerating {len(stale)} stale workbook(s)...", flush=True)
            regen_info = attempt_regen(stale, today)
            statuses = [workbook_status(spec, review_date, today)
                        for spec in BACKTEST_SOURCES]
        else:
            regen_info = {"log": ["", "-- REGEN ATTEMPT",
                                  "   all workbooks already fresh -- "
                                  "nothing to regenerate"]}

    # Logs for the review date.
    log_facts = {}
    for path in sorted(glob.glob(os.path.join(LOG_DIR, f"{review_date}_*.txt"))):
        stem = os.path.basename(path)[len(str(review_date)) + 1: -4]
        log_facts[stem] = parse_log(path, stem)

    load_notes = []
    try:
        atl = load_algo_trade_log(review_date)
    except Exception as e:
        atl = pd.DataFrame()
        load_notes.append(f"   *** algo_trade_log query FAILED: "
                          f"{type(e).__name__}: {e} ***")
    try:
        prod_df = load_prod_pnl()
    except Exception as e:
        prod_df = pd.DataFrame(columns=["trade_date", "strategy", "pnl", "notes"])
        load_notes.append(f"   *** PNL LOG NEW.xlsx read FAILED: "
                          f"{type(e).__name__}: {e} ***")

    section_inputs(review_date, today, statuses, regen_info, load_notes)
    if not prod_df.empty:
        section_prod_pnl(prod_df, review_date, statuses)
        section_reconciliation(prod_df, review_date, statuses, atl)
        section_streaks(prod_df, review_date)
    else:
        hdr("PROD PNL vs BACKTEST PNL")
        emit("   PNL LOG NEW.xlsx unreadable -- prod PnL unavailable this run.")
    section_market_state(log_facts, review_date)
    section_rebal_veto(review_date, atl)
    section_fills(atl, review_date, log_facts)
    section_fill_quality(review_date, atl)
    section_v7_v8_spx(log_facts, review_date)
    section_sprc(log_facts)
    section_slowness(log_facts)
    hacker_rows = next((s["hacker_rows"] for s in statuses if s["key"] == "hacker"), [])
    section_scripts(log_facts, review_date, atl, hacker_rows)

    hdr("END OF DIGEST")
    emit("Cleaned logs sit alongside this file as <script>_clean.txt. Read the cleaned "
         "log for every script that traded, plus any script flagged above.")

    out_dir = os.path.join(PACK_ROOT, review_date.strftime("%Y_%m_%d"))
    os.makedirs(out_dir, exist_ok=True)
    digest_path = os.path.join(out_dir, "digest.txt")
    with open(digest_path, "w", encoding="ascii", errors="replace", newline="") as f:
        f.write("\r\n".join(OUT) + "\r\n")
    for stem, facts in log_facts.items():
        with open(os.path.join(out_dir, f"{stem}_clean.txt"), "w",
                  encoding="ascii", errors="replace", newline="") as f:
            f.write(clean_log_text(facts["raw"]))

    print(f"Pack written: {out_dir}")
    print(f"  digest.txt ({os.path.getsize(digest_path):,} bytes)")
    for stem in sorted(log_facts):
        p = os.path.join(out_dir, f"{stem}_clean.txt")
        print(f"  {stem}_clean.txt ({os.path.getsize(p):,} bytes)")
    bad = [s["label"] for s in statuses if not s["fresh"]]
    if bad:
        print(f"STALE OR MISSING INPUTS: {', '.join(bad)}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        import traceback
        traceback.print_exc()
        sys.exit(2)
