def prod_name_for(config_name):
    """Config name (underscores) -> PNL LOG NEW strategy name (spaces)."""
    if config_name in PROD_NAME_EXACT:
        return PROD_NAME_EXACT[config_name]
    name = config_name.replace("_", " ")
    name = name.replace("ALGO 42", "ALGO_42", 1)
    # Equity configs keep the underscore between EQUITY and ALGO in the PnL log
    # ("EQUITY_ALGO_42 350PM FIRST TICK"), so restore it after the swap above.
    name = name.replace("EQUITY ALGO_42", "EQUITY_ALGO_42", 1)
    for src, dst in PROD_NAME_ALIASES.items():
        if name.endswith(src):
            name = name[: -len(src)] + dst
    return name


def _f(v):
    """float or None."""
    try:
        return None if pd.isna(v) else float(v)
    except (TypeError, ValueError):
        return None


def _norm_cp(v):
    """'C'/'Call' -> 'Call', 'P'/'Put' -> 'Put', anything else -> None."""
    if not isinstance(v, str):
        return None
    v = v.strip().upper()
    if v.startswith("C"):
        return "Call"
    if v.startswith("P"):
        return "Put"
    return None


def _strikes_from_row(r):
    """Backtest strikes for one traded row -> {"Put": (sh, lg), "Call": (sh, lg)}.

    Only sides that ACTUALLY TRADED are returned. Two traps in these sheets:
      - `cp` is a single letter ("C"/"P"), not "Call"/"Put".
      - sh_strike_2/lg_strike_2 are populated even when the second side did NOT trade, and
        cp_2 is NaN in that case. Inferring a side for that pair overwrites the real one --
        on 8/19 IMBAL_GROWS_SML that turned a correct 7715/7730 into 7700/7685 and produced
        a phantom strike disagreement. So never infer a side for pair 2.
    """
    put_size, call_size = _f(r.get("put_size")), _f(r.get("call_size"))
    out = {}
    for idx, (cp_col, sh_col, lg_col) in enumerate(
            (("cp", "sh_strike", "lg_strike"),
             ("cp_2", "sh_strike_2", "lg_strike_2"))):
        if sh_col not in r.index:
            continue
        sh, lg = _f(r.get(sh_col)), _f(r.get(lg_col))
        if sh is None or lg is None:
            continue
        cp = _norm_cp(r.get(cp_col))
        if cp is None:
            if idx > 0:
                continue   # pair 2 with no cp = that side did not trade
            # bumped/closer sheets have no cp column; infer only if exactly one side traded.
            if put_size and not call_size:
                cp = "Put"
            elif call_size and not put_size:
                cp = "Call"
            else:
                continue
        size = put_size if cp == "Put" else call_size
        if not size:
            continue   # side named but never traded
        out[cp] = (sh, lg)
    return out


def _read_sheet_strikes(path, sheet, review_date):
    try:
        df = pd.read_excel(path, sheet_name=sheet)
    except Exception:
        return {}
    if "trade_date" not in df.columns:
        return {}
    df["trade_date"] = pd.to_datetime(df["trade_date"]).dt.date
    row = df[df["trade_date"] == review_date]
    return _strikes_from_row(row.iloc[0]) if len(row) else {}


def newest_workbook(spec):
    hits = sorted(glob.glob(os.path.join(DOWNLOADS, spec["glob"])))
    hits = [h for h in hits
            if not any(x in os.path.basename(h) for x in spec["exclude"])]
    if not hits:
        return None
    return max(hits, key=os.path.getmtime)


def workbook_status(spec, review_date, today):
    """Freshness + the per-strategy PnL map for one backtest workbook."""
    path = newest_workbook(spec)
    st = {"key": spec["key"], "label": spec["label"], "path": path,
          "mtime": None, "max_date": None, "fresh": False, "pnl": {},
          "strikes": {}, "note": "", "hacker_rows": []}
    if path is None:
        st["note"] = "MISSING -- no workbook matching " + spec["glob"]
        return st

    st["mtime"] = dt.datetime.fromtimestamp(os.path.getmtime(path))
    try:
        if spec["shape"] == "wide_stats":
            all_df = pd.read_excel(path, sheet_name="All")
            all_df["trade_date"] = pd.to_datetime(all_df["trade_date"]).dt.date
            st["max_date"] = max(all_df["trade_date"])
            stats = pd.read_excel(path, sheet_name="Stats")
            short_to_full = dict(zip(stats["Strategy"], stats["Full Name"]))
            skip = tuple(spec.get("skip_strategy_prefixes", ()))
            if skip:
                short_to_full = {s: f for s, f in short_to_full.items()
                                 if not str(s).startswith(skip)}
            row = all_df[all_df["trade_date"] == review_date]
            if len(row):
                r = row.iloc[0]
                for short, full in short_to_full.items():
                    col = f"pnl_{short}"
                    if col in all_df.columns and pd.notna(r[col]):
                        st["pnl"][full] = float(r[col])
                # Strikes live on the per-strategy sheets, not the All sheet. Only open the
                # sheets for strategies that actually have PnL on the review date -- opening
                # all ~16 costs seconds for nothing.
                for short, full in short_to_full.items():
                    if full not in st["pnl"] or st["pnl"][full] == 0:
                        continue
                    st["strikes"][full] = _read_sheet_strikes(path, short, review_date)
        elif spec["shape"] == "long_all":
            all_df = pd.read_excel(path, sheet_name="All")
            all_df["trade_date"] = pd.to_datetime(all_df["trade_date"]).dt.date
            st["max_date"] = max(all_df["trade_date"]) if len(all_df) else None
            row = all_df[all_df["trade_date"] == review_date]
            for _, r in row.iterrows():
                short = str(r["strategy"])
                if spec["strip_token"] and short.endswith(spec["strip_token"]):
                    short = short[: -len(spec["strip_token"])]
                full = (f"ALGO_42_350PM_SPREAD_SALES_SPX_{short.strip()}"
                        f"_{spec['name_suffix']}")
                st["pnl"][full] = float(r[spec["pnl_col"]])
                st["strikes"][full] = _strikes_from_row(r)
        elif spec["shape"] == "daily_total":
            daily = pd.read_excel(path, sheet_name="Daily")
            daily["trade_date"] = pd.to_datetime(daily["trade_date"]).dt.date
            st["max_date"] = max(daily["trade_date"]) if len(daily) else None
            row = daily[daily["trade_date"] == review_date]
            if len(row):
                st["pnl"][spec["prod_name"]] = float(row.iloc[0]["pnl"])
        elif spec["shape"] == "hacker_detail":
            # One detail sheet per strategy (sheet name = backtest label, e.g.
            # "IMBAL_VS_MARKET CLOSER"), one row per modeled leg. Collect the review date's
            # rows; --last-days 5 means a date with no parent fire has no row at all, so
            # max_date is informational and freshness is mtime-only (full_calendar False).
            xl = pd.ExcelFile(path)
            for sh in xl.sheet_names:
                if sh == "Summary":
                    continue
                d = xl.parse(sh)
                if "trade_date" not in d.columns or d.empty:
                    continue
                d["trade_date"] = pd.to_datetime(d["trade_date"]).dt.date
                mx = max(d["trade_date"])
                st["max_date"] = mx if st["max_date"] is None else max(st["max_date"], mx)
                for _, r in d[d["trade_date"] == review_date].iterrows():
                    rec = {c: r[c] for c in d.columns}
                    rec["strategy"] = sh
                    st["hacker_rows"].append(rec)
    except Exception as e:
        st["note"] = f"UNREADABLE -- {type(e).__name__}: {e}"
        return st

    built_today = st["mtime"].date() == today
    covers = (not spec["full_calendar"]) or (
        st["max_date"] is not None and st["max_date"] >= review_date)
    st["fresh"] = built_today and covers
    if not built_today:
        st["note"] = (f"STALE -- written {st['mtime'].date()}, not today "
                      f"({today}); T+1 backtest generation did not run or failed")
    elif not covers:
        st["note"] = (f"STALE -- built today but max trade_date {st['max_date']} "
                      f"< review date {review_date}; upstream data is behind")
    return st


