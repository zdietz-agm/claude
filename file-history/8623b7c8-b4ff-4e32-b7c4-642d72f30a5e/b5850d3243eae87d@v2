    """Wait targets parsed out of the prod script that produced this log.

    Reading them from the source is the point: if a fire time changes in the prod script,
    the review picks the new time up on the next run instead of reporting the designed wait
    as unexplained slowness. Falls back to FALLBACK_MARKS when the script cannot be found.
    """
    if stem in _MARK_CACHE:
        return _MARK_CACHE[stem]
    path = None
    for cand in os.listdir(ALGOS_DIR):
        if cand.lower() == f"{stem.lower()}.py":
            path = os.path.join(ALGOS_DIR, cand)
            break
    if path is None:
        _MARK_CACHE[stem] = (set(FALLBACK_MARKS), None)
        return _MARK_CACHE[stem]

    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    base_hour = 16 if _LAST_HOUR_BUMP_PAT.search(text) else 15
    v8_delay = float(_V8_DELAY_PAT.search(text).group(1)) if _V8_DELAY_PAT.search(text) else 0.0

    named = {}
    for name, args in _NAMED_TIME_PAT.findall(text):
        mark = _parse_time_args(args, base_hour)
        if mark is not None:
            named[name] = mark

    marks = set()
    for fn, args in _SPIN_PAT.findall(text):
        mark = _parse_time_args(args, base_hour)
        if mark is None:
            continue
        marks.add(mark)
        if fn == "_v8_gate" and v8_delay:
            marks.add(mark + v8_delay)
    for args in _WAIT_LITERAL_PAT.findall(text):
        mark = _parse_time_args(args, base_hour)
        if mark is not None:
            marks.add(mark)
    for name in _WAIT_NAMED_PAT.findall(text):
        if name in named:
            marks.add(named[name])

    # Union with the fallback so a script whose waits are expressed some other way (a
    # helper, a constant imported from another module) does not regress to noise.
    _MARK_CACHE[stem] = (marks | FALLBACK_MARKS, os.path.basename(path))
    return _MARK_CACHE[stem]


def crosses_scheduled_time(t0, t1, marks):
    return any(secs(t0) < mark <= secs(t1) for mark in marks)


def clean_log_text(raw):
    """Strip the SQL blobs and per-query timing lines that make prod logs unreadable.

    A REPLACE INTO statement sometimes has the next timestamped line concatenated onto
    its tail (no newline), so the SQL is cut out of the line rather than the line being
    dropped -- otherwise real log content disappears.
    """
    text = SQL_PAT.sub("[sql]", raw)
    out = []
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped == "[sql]":
            continue
        if "run_query [" in line:
            continue
        if stripped.startswith("REPLACE INTO") or stripped.startswith("INSERT INTO"):
            continue
        out.append(line.rstrip())
    if len(out) > MAX_CLEAN_LINES:
        keep_head = 400
        keep_tail = MAX_CLEAN_LINES - keep_head
        elided = len(out) - MAX_CLEAN_LINES
        out = (out[:keep_head]
               + [f"", f"... [{elided} lines elided by build_review_pack] ...", ""]
               + out[-keep_tail:])
    return "\r\n".join(out) + "\r\n"


def parse_log(path, stem):
    """Extract every reviewable fact from one prod script log."""
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        raw = f.read()
    marks, source_script = wait_marks_for_script(stem)

    f_out = {
        "path": path,
        "bytes": len(raw),
        "raw": raw,
        "first_ts": None, "last_ts": None,
        "gaps": [], "queries": [], "slow_queries": [], "fresh_conns": [],
        "quotes": [], "sprc_outside_nbbo": [],
        "clamps": [], "clamp_floors": set(), "retries": [], "traded": [],
        "losscap": [], "underfill": [], "premium_addon": [],
        "errors": [], "notable": [], "orders": [], "last_line": "",
        "wait_marks": marks, "wait_source": source_script,
        "spx": None, "spx_ts": None,
        "state": {},
    }

    lines = raw.splitlines()
    f_out["last_line"] = next((l.strip()[:160] for l in reversed(lines) if l.strip()), "")

    stamped = []   # (idx, time, message)
    for i, line in enumerate(lines):
        m = TS_PAT.match(line.strip())
        if m:
            stamped.append((i, parse_ts(*m.groups()[:5]), m.group(6)))

    if stamped:
        f_out["first_ts"] = stamped[0][1]
        f_out["last_ts"] = stamped[-1][1]

    # SPX the script traded off, plus the moment it snapped it.
    for _, t, msg in stamped:
        m = SPX_REFRESH_PAT.search(msg)
        if m:
            f_out["spx"] = float(m.group(1).replace(",", ""))
            f_out["spx_ts"] = t
        elif SNAP_350_PAT.search(msg) and f_out["spx_ts"] is None:
            f_out["spx_ts"] = t   # 350 prints the value only in the recap, below
    if f_out["spx"] is None:
        for line in lines:
            m = SPX_RECAP_PAT.match(line.strip())
            if m:
                f_out["spx"] = float(m.group(1).replace(",", ""))
                break

    # Raw trade-gate inputs. Scanned over the whole file (some print inside the recap block,
    # which carries no timestamp). First match wins for values printed once per run.
    st = f_out["state"]
    for pat, key, cast in [
        (MKT_355_PAT, "mkt_355", str), (MKT_350_IN_355_PAT, "mkt_350_bin", int),
        (SPY_355_PAT, "spy_355", float), (QQQ_RATIO_PAT, "qqq_ratio", float),
        (ATM_VOL_PAT, "atm_vol", float), (TODAY_VOL_PAT, "today_vol", float),
        (VIX_STATE_PAT, "vix", float), (REALIZED_PAT, "realized_bin", int),
        (IMBAL_350_PAT, "imbal_350", float),
    ]:
        m = pat.search(raw)
        if m:
            st[key] = cast(m.group(1))
    m = IMBAL_355_PAT.search(raw)
    if m:
        st["imbal_355"] = float(m.group(1)) * 1e9
    if "imbal_350" not in st:
        m = IMBAL_RECAP_PAT.search(raw)
        if m:
            st["imbal_350"] = float(m.group(1).replace(",", ""))

    # v8's pre-ratio size per algo, so the size-ratio check compares v8 against its own
    # intended size rather than against v7's (correction #19).
    f_out["v8_resize"] = {m.group(1): (int(m.group(2)), int(m.group(3)))
                          for m in V8_RESIZE_PAT.finditer(raw)}
    m = MKT_MOVE_PAT.search(raw)
    if m:
        st["mkt_type_log"], st["spy_move"], st["spy_std"] = (
            m.group(1), float(m.group(2)), float(m.group(3)))
    m = SPY_BPS_PAT.search(raw)
    if m:
        st["bps_1540_1550"], st["bps_1550_1555"] = float(m.group(1)), float(m.group(2))

    sleep_windows = []   # (start_s, end_s) per announced sleep, see SLEEP_DUR_PAT
    for _, t, msg in stamped:
        ms = SLEEP_DUR_PAT.search(msg)
        if ms:
            dur = float(ms.group(1) or ms.group(2))
            sleep_windows.append((secs(t), secs(t) + dur + SLEEP_SLACK_S))

    for (i0, t0, msg0), (i1, t1, msg1) in zip(stamped, stamped[1:]):
        gap = secs(t1) - secs(t0)
        if gap < GAP_WARN_S:
            continue
        # Two consecutive lines of the same shape are a polling loop's own cadence
        # (btic polls every ~4s, concurrent orders each print the same completion line).
        # Compare with digits stripped so "poll BTIC=20.15" and "poll BTIC=20.10" match.
        same_shape = _shape(msg0) == _shape(msg1)
        in_sleep = any(lo <= secs(t0) and secs(t1) <= hi for lo, hi in sleep_windows)
        wave_work = (gap <= WAVE_WORK_S + SLEEP_SLACK_S
                     and bool(WAVE_WORK_NEXT_PAT.search(msg1)))
        scheduled = (bool(WAIT_LINE_PAT.search(msg0))
                     or crosses_scheduled_time(t0, t1, marks)
                     or same_shape
                     or in_sleep
                     or wave_work)
        f_out["gaps"].append({
            "gap_s": round(gap, 2),
            "after": t0.strftime("%H:%M:%S.%f")[:-3],
            "before": t1.strftime("%H:%M:%S.%f")[:-3],
            "prev_line": msg0[:110],
            "next_line": msg1[:110],
            "likely_scheduled": scheduled,
        })

    for line in lines:
        mq = QUERY_PAT.search(line)
        if mq:
            db, tag, total = mq.group(1), mq.group(2), float(mq.group(3))
            f_out["queries"].append(total)
            if total > QUERY_WARN_MS:
                f_out["slow_queries"].append(f"{db} tag={tag} TOTAL={total:.1f}ms")
            mc = CONN_PAT.search(line)
            if mc and float(mc.group(1)) > CONN_WARN_MS:
                f_out["fresh_conns"].append(
                    f"{db} tag={tag} conn={float(mc.group(1)):.1f}ms")

        mquo = QUOTES_PAT.search(line)
        if mquo:
            wave, algo, rest = mquo.group(1), mquo.group(2), mquo.group(3)
            legs = []
            for lm in LEG_PAT.finditer(rest):
                strike, cp, sprc, bid, ask = lm.groups()
                sprc, bid, ask = float(sprc), float(bid), float(ask)
                outside = 0.0
                if sprc > ask:
                    outside = round(sprc - ask, 4)
                elif sprc < bid:
                    outside = round(sprc - bid, 4)
                legs.append({"strike": float(strike), "cp": cp, "sprc": sprc,
                             "bid": bid, "ask": ask, "outside": outside})
            if legs:
                rec = {"wave": wave, "algo": algo, "legs": legs}
                if len(legs) >= 2:
                    rec["net_sprc"] = round(legs[0]["sprc"] - legs[1]["sprc"], 3)
                    rec["net_cross"] = round(legs[0]["bid"] - legs[1]["ask"], 3)
                    rec["net_mid"] = round(
                        (legs[0]["bid"] + legs[0]["ask"]) / 2
                        - (legs[1]["bid"] + legs[1]["ask"]) / 2, 3)
                    rec["sprc_minus_cross"] = round(rec["net_sprc"] - rec["net_cross"], 3)
                f_out["quotes"].append(rec)
                for leg in legs:
                    if leg["outside"]:
                        f_out["sprc_outside_nbbo"].append({
                            "wave": wave, "algo": algo,
                            "leg": f"{leg['strike']:.0f}{leg['cp']}",
                            "sprc": leg["sprc"], "nbbo": f"{leg['bid']}/{leg['ask']}",
                            "outside_by": leg["outside"],
                            "side": "above ask" if leg["outside"] > 0 else "below bid",
                            "is_short_leg": leg is legs[0],
                        })

        mcl = CLAMP_PAT.search(line)
        if mcl:
            f_out["clamps"].append(
                f"limit {mcl.group(1)} -> min_price {mcl.group(2)}")
            f_out["clamp_floors"].add(round(float(mcl.group(2)), 4))

        mr = RETRY_PAT.search(line)
        if mr:
            f_out["retries"].append({
                "fn": f"{mr.group(1)}({mr.group(2)})",
                "attempt": int(mr.group(3)), "of": int(mr.group(4)),
                "got": "got value" in line,
            })

        mt = TRADED_PAT.search(line)
        if mt:
            f_out["traded"].append({"algo": mt.group(1), "structure": mt.group(2),
                                    "edges": None})
        me = EDGE_PAT.search(line)
        if me and f_out["traded"]:
            f_out["traded"][-1]["edges"] = {
                "et1": float(me.group(1)), "me1": float(me.group(2)),
                "et2": float(me.group(3)), "me2": float(me.group(4)),
                "price": float(me.group(5)), "size": int(me.group(6)),
            }

        if "[LossCap]" in line:
            f_out["losscap"].append(line.split("-- ", 1)[-1].strip()[:200])
        if "WAVE1 UNDERFILL" in line or "WAVE1_UNDERFILL" in line:
            f_out["underfill"].append(line.split("-- ", 1)[-1].strip()[:200])
        if "PREMIUM ADD-ON" in line:
            f_out["premium_addon"].append(line.split("-- ", 1)[-1].strip()[:200])
        if "MOC" in line or "month end" in line.lower() or "MONTH END" in line:
            f_out["notable"].append(line.strip()[:200])

        for pat in ORDER_ACTIVITY_PATS:
            if pat.search(line):
                f_out["orders"].append(line.split("-- ", 1)[-1].strip()[:180])
                break

        if ERROR_PAT.search(line) and not ERROR_IGNORE_PAT.search(line):
            if not line.strip().startswith(("REPLACE INTO", "INSERT INTO")):
                f_out["errors"].append(line.strip()[:220])

    # De-dupe while preserving order.
    for key in ("clamps", "losscap", "underfill", "premium_addon", "errors",
                "slow_queries", "fresh_conns", "notable", "orders"):
        seen, keep = set(), []
        for item in f_out[key]:
            if item not in seen:
                seen.add(item)
                keep.append(item)
        f_out[key] = keep
    return f_out


