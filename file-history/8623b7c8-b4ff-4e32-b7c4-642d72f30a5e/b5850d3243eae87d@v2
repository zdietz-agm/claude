def parse_ts(hh, mm, ss, ms, ampm):
    hh = int(hh)
    if ampm == "PM" and hh != 12:
        hh += 12
    if ampm == "AM" and hh == 12:
        hh = 0
    return dt.time(hh, int(mm), int(ss), int(ms) * 1000)


def secs(t):
    return t.hour * 3600 + t.minute * 60 + t.second + t.microsecond / 1e6


def _shape(msg):
    """A log line with every number removed -- two lines of the same shape are the same
    statement from a loop, not two different events."""
    return re.sub(r"[\d.,+\-]", "", msg)[:30]


def _sod(h, m, s, us=0):
    """Seconds-of-day, fractional."""
    return h * 3600 + m * 60 + s + us / 1e6


