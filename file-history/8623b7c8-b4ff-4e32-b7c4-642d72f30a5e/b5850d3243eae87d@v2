def v8_check(atl, log_facts):
    """Flag v8 sizes ONLY when they miss v8's own intended size (correction #19).

    V8_SIZE_RATIO applies to v8's OWN pre-ratio size, which the v8 log prints as
    "ALGO_...: 23 --> 4", and the result is floored: max(1, int(size * ratio)). Comparing
    v8's traded size against v7's produced false mismatches -- v7 and v8 reach different
    pre-ratio sizes (loss-cap pro-rata, CLOSER resize), and floor rounding alone puts a
    23-lot parent at 0.17x rather than 0.20x. Zach, 2026-08-26: if prod fills roughly match
    the backtest, or what the v8 ratio implies, do not flag it -- so agreement prints nothing.
    """
    ratios, pre = {}, {}
    for path, label in (("350pm_script_v8.py", "350PM"), ("355pm_script_v8.py", "355PM")):
        full = os.path.join(ALGOS_DIR, path)
        if not os.path.exists(full):
            continue
        with open(full, encoding="utf-8", errors="replace") as f:
            for line in f:
                m = re.match(r"^V8_SIZE_RATIO\s*=\s*([\d.]+)", line.strip())
                if m:
                    ratios[label] = float(m.group(1))
                    break
        stem = path[:-3]
        pre[label] = (log_facts.get(stem) or {}).get("v8_resize", {})
    if not ratios:
        emit("   could not read V8_SIZE_RATIO from the v8 scripts")
        return
    problems, compared = [], 0
    # Hacker sizes derive from each book's own parent fills, not from V8_SIZE_RATIO.
    atl = atl[~atl["algo_name"].astype(str).str.startswith(HACK_PREFIX)]
    for base, expected in ratios.items():
        b = atl[atl["script_name"] == base]
        v = atl[atl["script_name"] == f"{base}_V8"]
        if b.empty or v.empty:
            continue
        m = b.merge(v, on=["algo_name", "cp", "short_strike"], suffixes=("_v7", "_v8"))
        for _, r in m.iterrows():
            a7, a8 = int(r["size_attempted_v7"]), int(r["size_attempted_v8"])
            algo = r["algo_name"]
            compared += 1
            src = pre[base].get(algo)
            if src:
                want = max(1, int(src[0] * expected))
                if a8 != want:
                    problems.append(
                        f"   {base} {short_algo(algo)[:40]} {r['cp']}: v8 sent {a8} but its "
                        f"own pre-ratio size {src[0]} x {expected:.2f} floors to {want}")
            else:
                # No resize line for this algo -- fall back to v7, allowing floor rounding.
                want = max(1, int(a7 * expected))
                if a8 != want and a7 > 2:
                    problems.append(
                        f"   {base} {short_algo(algo)[:40]} {r['cp']}: v8 sent {a8}, expected "
                        f"{want} from v7's {a7} x {expected:.2f} (no v8 resize line in the "
                        f"log -- v8's own pre-ratio size unknown)")
    if problems:
        emit("   Sizes that do not match v8's intended size:")
        for line in problems:
            emit(line)
    elif compared:
        emit(f"   All {compared} v7/v8 pair(s) match v8's intended size "
             f"(pre-ratio size x V8_SIZE_RATIO, floored). Nothing to report.")
    else:
        emit("   no v7/v8 script pair traded the same algo -- nothing to compare")



