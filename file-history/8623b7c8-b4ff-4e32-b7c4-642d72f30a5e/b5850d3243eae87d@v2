def section_v7_v8_spx(log_facts, review_date):
    """v7 vs v8 SPX (SR uPrc) at the trade snap, for the 350 and 355 books.

    Standing check Zach asked for on 2026-08-21, active through V8_PARALLEL_RUN_ENDS. It
    exists because the two books read different quote tables (v7 msgoptionimpliedquote, v8
    msgliveimpliedquoteadj) and land on different SPX at their snaps -- 8/21 355: v7 7675.19
    at 15:55:01.269 vs v8 7676.91 at 15:55:01.444. On a $5 strike grid a ~1pt difference can
    flip a knife-edge strike selection, which is how the CLOSER picked 7675 on v7 and 7680 on
    v8 that day. Open question is whether it is the 0.1s+ gate delay or a table bias.
    """
    if review_date > V8_PARALLEL_RUN_ENDS:
        return
    hdr("V7 vs V8 SPX AT THE TRADE SNAP")
    emit(f"   Standing check through {V8_PARALLEL_RUN_ENDS} (the overlapped v7/v8 run). "
         "Retire this section after that date.")
    pairs = [("350pm_script", "350pm_script_v8", "350PM"),
             ("355pm_script", "355pm_script_v8", "355PM")]
    any_pair = False
    for v7_stem, v8_stem, label in pairs:
        f7, f8 = log_facts.get(v7_stem), log_facts.get(v8_stem)
        if not f7 or not f8:
            emit(f"   {label}: no v7/v8 pair of logs for this date "
                 f"({'v7 missing' if not f7 else 'v8 missing'}) -- cannot compare.")
            continue
        if f7["spx"] is None or f8["spx"] is None:
            emit(f"   {label}: SPX not parsed from "
                 f"{'v7' if f7['spx'] is None else 'v8'} log -- cannot compare.")
            continue
        any_pair = True
        d = f8["spx"] - f7["spx"]
        bps = d / f7["spx"] * 1e4
        t7 = f7["spx_ts"].strftime("%H:%M:%S.%f")[:-3] if f7["spx_ts"] else "?"
        t8 = f8["spx_ts"].strftime("%H:%M:%S.%f")[:-3] if f8["spx_ts"] else "?"
        lag_ms = ""
        if f7["spx_ts"] and f8["spx_ts"]:
            lag_ms = f"{(secs(f8['spx_ts']) - secs(f7['spx_ts'])) * 1000:+.0f}ms"
        emit()
        emit(f"   {label}")
        emit(f"      v7  SPX {f7['spx']:>10,.2f}  snapped {t7}")
        emit(f"      v8  SPX {f8['spx']:>10,.2f}  snapped {t8}   (v8 snap {lag_ms})")
        flag = ("*** FLAG -- at or above the "
                f"{SPX_DIFF_WARN_PTS:.2f}pt bar that can flip a $5 strike ***"
                if abs(d) >= SPX_DIFF_WARN_PTS else "under the flag bar")
        emit(f"      diff v8-v7 {d:+.2f} pts ({bps:+.2f} bps)   {flag}")
    if any_pair:
        emit()
        emit("   To tell a table bias from the gate delay: if the two snaps are within a few "
             "hundred ms and SPX still differs by ~1pt+, that is a DATA difference between "
             "the two quote tables, not latency. Report which, and say whether it changed a "
             "strike selection on the day (compare the strikes in the FILLS BY WAVE table).")


def section_sprc(log_facts):
    hdr("SPRC vs NBBO (fill-quality diagnostics)")
    any_flag = False
    for stem, f in log_facts.items():
        if not f["quotes"]:
            continue
        sub(stem)
        # Algos that sold the same strikes see identical quotes; collapse them onto one
        # row so the interesting numbers are not buried in repetition.
