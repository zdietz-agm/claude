def refresh_legs(short_legs, long_legs):
	"""Re-query SR surface for fresh sprc/bid/ask on each leg. Updates in-place.
	Also prints surface health (calcErr; plus uPrcAdjResult on v8) so a bad/untradable
	surface at wave-2 send time is diagnosable from the log (mhold incident 8/28/2026)."""
	_fmt = '%I:%M:%S.%f %p'
	_pt = lambda: (s := getNowEst().strftime(_fmt))[:-6] + s[-3:]
	print(f"{_pt()} -- Starting refresh_legs()")
	# uPrcAdjResult only exists on the v8 quote table (msgliveimpliedquoteadj); v7 has calcErr only.
	_surf_cols = ", calcErr, uPrcAdjResult" if _srf.USING_V8 else ", calcErr"
	for leg in list(short_legs) + list(long_legs):
		sql = f"""SELECT sprc, obid, oask{_surf_cols} FROM {IMPLIED_QUOTE_TABLE}
		WHERE okey_tk='{leg.okey_tk}' AND okey_xx={leg.okey_xx} AND okey_cp='{leg.okey_cp}'
		AND okey_yr={leg.okey_yr} AND okey_mn={leg.okey_mn} AND okey_dy={leg.okey_dy}"""
		row = run_query(sql)
		if not row.empty:
			old_sprc = leg.sprc
			object.__setattr__(leg, 'sprc', float(row.sprc.iloc[0]))
			object.__setattr__(leg, 'obid', float(row.obid.iloc[0]))
			object.__setattr__(leg, 'oask', float(row.oask.iloc[0]))
			surf_health = f" calcErr={row.calcErr.iloc[0]}"
			if _srf.USING_V8:
				surf_health += f" uPrcAdj={row.uPrcAdjResult.iloc[0]}"
			print(f"Refreshed {leg.okey_tk} {leg.okey_xx} {leg.okey_cp}: sprc {old_sprc:.3f} -> {leg.sprc:.3f} nbbo={leg.obid:.2f}/{leg.oask:.2f}{surf_health}")
	print(f"{_pt()} -- Finished refresh_legs()")


def _send_single_complex_order(symbol, size, short_legs, long_legs, exp, account,
							   edge_target, limit_price, is_sale, userData, orderDuration,
							   srtrade_pool=None, t_await=None,
							   limit_class="Surface", parent_handling="Seeker"):
	"""Send one complex spread order via SQL INSERT. Returns grouping_code.
	srtrade_pool/t_await are forwarded to run_query for pooling + split-phase timing prints.
	limit_class/parent_handling default to the Seeker+Surface behavior every existing caller
	gets; 'Simple'+'Activetaker' makes orderPrcLimit the actual working price (ss-script
	style, used by the hacker's NBBO-priced waves 3/4)."""
	grouping_code = _gen_id()   # v8 hex string when SEND_V8, else v7 int; carried through to fill lookups
	risk_group_id = _gen_id()

	fields_and_values = {
		"accnt": account,
		"spdrActionType": "AddReplace",
		"groupingCode": grouping_code,
		"riskGroupId": risk_group_id,
		"secKey_at": "EQT",
		"secKey_ts": "NMS" if (_srf.SEND_V8 or symbol == "NDXP") else "CBOE",
		"secKey_tk": "SPX" if symbol == "SPXW" else "NDX" if symbol == "NDXP" else symbol,
		"orderSize": size,
		"secType": "MLeg",
		"mlegNumLegs": len(short_legs) + len(long_legs),
		"parentOrderHandling": parent_handling,
		"parentBalanceHandling": "PostLimit",
		"orderLimittype": "Prc",
		"takeLimitClass": limit_class,
		"makeLimitClass": limit_class,
		"takesurfPrcoffset": edge_target, # across the whole structure # a positive number is always more aggressive (regardless of buy/sell)
		"makesurfPrcoffset": edge_target,
		# v8 dropped 'Immediate' from the progressRule enum. SR recommends 'None' as the v8 default
		# (AllowImmediate also accepted). v7 keeps 'Immediate'.
		"progressRule": ("None" if _srf.SEND_V8 else "Immediate"),
		# v8 renamed timeInForce -> marketSession (Day -> V8_MARKET_SESSION, default RegMkt).
		# v7 keeps timeInForce/Day. Post-close senders (4pm_script_v3) override the module
		# global to 'PostMkt' -- v8 expires RegMkt orders arriving after 16:00 ("Expired On
		# Arrival", seen 8/24).
		("marketSession" if _srf.SEND_V8 else "timeInForce"): (V8_MARKET_SESSION if _srf.SEND_V8 else "Day"),
		"traderName": "agm.zdietz",
		"orderSide": "Buy",
		"visibleInSV": "Yes",
		"orderPrcLimit": -limit_price,
		"optPremium": -limit_price,
		"userData1": userData,
		"orderDuration": orderDuration,

		"CHECKSUM": 13
	}
	for i, leg in enumerate(short_legs):
		fields_and_values[f"mlegSecKey{i+1}_at"] = "EQT"
		fields_and_values[f"mlegSecKey{i+1}_ts"] = "NMS"
		fields_and_values[f"mlegSecKey{i+1}_tk"] = symbol
		fields_and_values[f"mlegSecKey{i+1}_yr"] = exp.year
		fields_and_values[f"mlegSecKey{i+1}_mn"] = exp.month
		fields_and_values[f"mlegSecKey{i+1}_dy"] = exp.day
		fields_and_values[f"mlegSecKey{i+1}_xx"] = leg.okey_xx
		fields_and_values[f"mlegSecKey{i+1}_cp"] = leg.okey_cp
		fields_and_values[f"mlegMult{i+1}"] = 1
		fields_and_values[f"mlegSide{i+1}"] = "Sell"
		fields_and_values[f"mlegPosType{i+1}"] = "Auto"
		fields_and_values[f"mlegSecType{i+1}"] = "Option"
		fields_and_values[f"mlegLegId{i+1}"] = counter()

	for j, leg in enumerate(long_legs):
		k = i + j + 1
		fields_and_values[f"mlegSecKey{k+1}_at"] = "EQT"
		fields_and_values[f"mlegSecKey{k+1}_ts"] = "NMS"
		fields_and_values[f"mlegSecKey{k+1}_tk"] = symbol
		fields_and_values[f"mlegSecKey{k+1}_yr"] = exp.year
		fields_and_values[f"mlegSecKey{k+1}_mn"] = exp.month
		fields_and_values[f"mlegSecKey{k+1}_dy"] = exp.day
		fields_and_values[f"mlegSecKey{k+1}_xx"] = leg.okey_xx
		fields_and_values[f"mlegSecKey{k+1}_cp"] = leg.okey_cp
		fields_and_values[f"mlegMult{k+1}"] = 1
		fields_and_values[f"mlegSide{k+1}"] = "Buy"
		fields_and_values[f"mlegPosType{k+1}"] = "Auto"
		fields_and_values[f"mlegSecType{k+1}"] = "Option"
		fields_and_values[f"mlegLegId{k+1}"] = counter()

	columns = ", ".join(fields_and_values.keys())
	values = ", ".join(f"'{v}'" if isinstance(v, str) else str(v) for v in fields_and_values.values())

	sql = f"REPLACE INTO srtrade.msgparentordergatewayext ({columns}) VALUES ({values});"
	print(sql)
	# verbose ONLY when a pool was passed (i.e. 350PM). Keeps 340PM/355PM code path unchanged.
	run_query(sql, "srtrade", fetch=False,
	          pool=srtrade_pool, verbose=(srtrade_pool is not None), t_await=t_await,
	          tag=f"{userData} gc={grouping_code}")
	return grouping_code


# NOTE (2026-09-04): replaced at runtime in the v8 scripts by helpers_v8.compute_spread_limit_v8 (signature-checked) -- port edits there too.
def compute_spread_limit(short_legs, long_legs, max_edge, min_price=None, verbose=False):
	"""Net spread limit price sent to SR: sum(short sprc) - sum(long sprc) - max_edge, with the
	same min_price clamp + 2dp rounding as trade_complex. Single source of truth so callers
	(orchestrator, send_complex_two_waves) can record the exact wave limit without re-deriving it.
	verbose=True prints the clamp message (used only by trade_complex to preserve its logging)."""
	limit_price = 0
	for short_leg in short_legs:
		limit_price += short_leg.sprc
	for long_leg in long_legs:
		limit_price -= long_leg.sprc
	limit_price -= max_edge
	limit_price = round(limit_price, 2)
	if min_price and a_lt_b(a=limit_price, b=min_price):
		if verbose:
			print(f"Limit price {limit_price} below min_price {min_price}, clamping to {min_price}")
		limit_price = round_price(min_price)
	return limit_price


def compute_spread_srprc(short_legs, long_legs):
	"""Surface fair of the spread: sum(short sprc) - sum(long sprc). Signed/raw (no clamp/round);
	debit (Buy) spreads come out negative. This is the surface mid the wave limit is derived from
	(limit = srprc - max_edge). Logged as srprc1/srprc2 for cross-vs-surface divergence analysis."""
	return sum(leg.sprc for leg in short_legs) - sum(leg.sprc for leg in long_legs)


def compute_spread_cross(short_legs, long_legs):
	"""Executable cross of the spread: sum(short obid) - sum(long oask) -- the credit obtainable by
	selling the shorts at their bid and buying the longs at their ask. Signed/raw. Logged as
	cross_price1/cross_price2; divergence vs the surface fair = srprc - cross."""
	return sum(leg.obid for leg in short_legs) - sum(leg.oask for leg in long_legs)


# NOTE (2026-09-04): the v8 scripts REPLACE this function at runtime with helpers_v8.trade_complex_v8 (signature-checked
# monkeypatch, process-local). Any edit here (signature, chunking, limit math) must be ported to helpers_v8.py or the v8 scripts fail at startup.
def trade_complex(symbol, size, short_legs, long_legs, exp, account, edge_target=.1, max_edge=.2, is_sale=True, userData='', orderDuration=ORDER_DURATION, min_price=None,
                   srtrade_pool=None, t_await=None,
                   limit_class="Surface", parent_handling="Seeker", explicit_limit=None):
	"""Send a complex spread order, splitting into sub-$14k premium chunks if needed. Returns list of grouping_codes.
	srtrade_pool/t_await forwarded to _send_single_complex_order (default None -> current behavior).
	explicit_limit: when set, used verbatim as the limit (caller owns rounding + min_price
	clamping) instead of the sprc-based compute_spread_limit; pairs with limit_class='Simple' +
	parent_handling='Activetaker' for NBBO-priced orders (hacker waves 3/4)."""
	if explicit_limit is not None:
		limit_price = round(float(explicit_limit), 2)
		print(f"Limit price (explicit): {limit_price}")
	else:
		limit_price = compute_spread_limit(short_legs, long_legs, max_edge, min_price, verbose=True)
		print(f"Limit price: {limit_price}")

	estimated_premium = size * abs(limit_price) * MULTIPLIER

	if estimated_premium > PREMIUM_LIMIT and abs(limit_price) > 0:
		max_chunk = max(1, int(PREMIUM_LIMIT / (abs(limit_price) * MULTIPLIER)))
		chunks = []
		remaining = size
		while remaining > 0:
			chunks.append(min(remaining, max_chunk))
			remaining -= chunks[-1]

		# SpiderRock blocks repeat orders sent more than 4 times in a row with identical
		# quantity/account/price details, and its detection is not fully trusted -- so chunks
		# 5-8 are ALWAYS sent with unique sizes: chunk 5 = -1, chunk 6 = -2, chunk 7 = -3,
		# chunk 8 = -4 (floored at 1 lot). Shed lots are picked up by the wave-2 remainder resend.
		for i in range(4, min(len(chunks), 8)):
			chunks[i] = max(1, chunks[i] - (i - 3))

		# Anything past 8 chunks is DROPPED (not sent) -- warn loudly so it's obvious in the
		# log that we underfilled the intended size.
		if len(chunks) > 8:
			dropped_size = sum(chunks[8:])
			chunks = chunks[:8]
			sent_size = sum(chunks)
			warn_msg = (f"!!!!!!!!!!!!!!!! FULL SIZE NOT SENT for {userData}: capped at 8 orders -- "
			            f"{sent_size}/{size} sent, {dropped_size} DROPPED (per-order premium "
			            f"${PREMIUM_LIMIT:,} x 8 max). VERIFY POSITION. !!!!!!!!!!!!!!!!")
			print("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
			print(warn_msg)
			print("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
			record_send_warning(warn_msg)   # surface in the Google-chat recap too

		if len(chunks) > 4:
			print(f"Post-decrement chunk sizes: {chunks} -- wave-1 total {sum(chunks)}/{size} "
			      f"(shed lots picked up by the wave-2 remainder resend)")

		delay = 0.03 if len(chunks) > 3 else 0.01
		print(f"Splitting order: size={size} into {len(chunks)} chunks of up to {max_chunk} "
			  f"(premium/chunk ~${max_chunk * abs(limit_price) * MULTIPLIER:,.0f}, delay={delay}s)")

		grouping_codes = []
		for i, chunk_size in enumerate(chunks):
			gc = _send_single_complex_order(symbol, chunk_size, short_legs, long_legs, exp, account,
											edge_target, limit_price, is_sale, userData, orderDuration,
											srtrade_pool=srtrade_pool, t_await=t_await,
											limit_class=limit_class, parent_handling=parent_handling)
			grouping_codes.append(gc)
			if i < len(chunks) - 1:
				time.sleep(delay)
		return grouping_codes
	else:
		gc = _send_single_complex_order(symbol, size, short_legs, long_legs, exp, account,
										edge_target, limit_price, is_sale, userData, orderDuration,
										srtrade_pool=srtrade_pool, t_await=t_await,
											limit_class=limit_class, parent_handling=parent_handling)
		return [gc]

def GetParentNumber(grouping_code):
	print(f"\nGetting parent number for grouping code: {grouping_code}")
	sql = f"""SELECT  spdrOrderStatus, spdrCloseReason, parentNumber, fillQuan1 FROM srtrade.msgsrmlegbrkrstate WHERE groupingcode='{grouping_code}'"""
	results = run_query(sql, "srtrade")
	print("RESULTS: _____________________________________________________")
	print(results)
	# "Done" = order terminal, no more fills coming -> don't cancel. v8 gates on spdrOrderStatus
	# (terminal = Closed/Rejected/SendReject); a filled v8 order shows spdrOrderStatus='Closed' with
	# spdrCloseReason='Filled', so the old v7 spdrCloseReason=='Closed' check never matched on v8.
	if _srf.SEND_V8:
		done = str(results.spdrOrderStatus.values[0]) in {"Closed", "Rejected", "SendReject"}
	else:
		done = results.spdrCloseReason.values[0] == "Closed"
	if done:
		print("Order done (terminal) -- no cancel needed.")
		return False
	return results.parentNumber.values[0]

def cancel_order(parent_number, grouping_code, account):
	# v8 renamed userName -> modifiedBy and dropped timestamp_us (timestamp is now yyyy-mm-dd
	# hh:mm:ss.sssss; NOW() is fine per SR). v7 keeps the original columns.
	if _srf.SEND_V8:
		# clientFirm='AGM' required on v8 -- the "AccountMatches" rule keys on accnt+clientFirm (v7 had
		# no clientFirm and matched on userName). SR-confirmed. All our accounts book under firm AGM.
		sql = f"""INSERT INTO srtrade.msgsrparentcancel (accnt,parentNumber,cxlReason,modifiedBy,clientFirm,timestamp)
					VALUES  ('{account}',  '{parent_number}', 'cxlReason', 'agm.zdietz', 'AGM', NOW() )"""
	else:
		sql = f"""INSERT INTO srtrade.msgsrparentcancel (accnt,parentNumber,cxlReason,userName,timestamp,timestamp_us)
					VALUES  ('{account}',  '{parent_number}', 'cxlReason', 'agm.zdietz', NOW(), '0' )"""
	run_query(sql, "srtrade", fetch=False)

	# v8 package fill = cumSquareQty (fillQuan1 is a per-leg qty); v7 keeps fillquan1.
	_qty_col = "cumSquareQty" if _srf.SEND_V8 else "fillquan1"
	sql = f"""SELECT {_qty_col} FROM srtrade.msgsrmlegbrkrstate WHERE groupingcode='{grouping_code}'"""
	results = run_query(sql, "srtrade")
	return results.iloc[0, 0]

