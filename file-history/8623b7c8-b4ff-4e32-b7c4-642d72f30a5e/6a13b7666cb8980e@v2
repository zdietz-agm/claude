def record_send_warning(msg):
	"""Thread-safe: stash a send-time warning for the script to surface in the chat recap."""
	with _SEND_WARNINGS_LOCK:
		_SEND_WARNINGS.append(msg)

def drain_send_warnings():
	"""Return + clear all accumulated send warnings. Call once, at chat-summary build time."""
	with _SEND_WARNINGS_LOCK:
		out = _SEND_WARNINGS[:]
		_SEND_WARNINGS.clear()
	return out


