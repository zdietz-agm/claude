def to_v8_id(n):
	"""v8 groupingCode/riskGroupId format: 16 hex digits as XXXX-XXXX-XXXX-XXXX. Mask to 63 bits so
	the leading digit is 0-7 -- v8 rejects ids that parse as negative (high bit set)."""
	n &= 0x7FFFFFFFFFFFFFFF
	h = f"{n:016x}"
	return f"{h[0:4]}-{h[4:8]}-{h[8:12]}-{h[12:16]}"

def _gen_id():
	"""Next order id: v8 hex string when SEND_V8, else the plain v7 decimal counter int. The value's
	TYPE (str vs int) also drives SQL quoting downstream (hex ids get quoted, v7 ints don't)."""
	n = counter()
	return to_v8_id(n) if _srf.SEND_V8 else n

