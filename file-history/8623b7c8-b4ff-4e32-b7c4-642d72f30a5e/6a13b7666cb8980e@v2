def _build_quote_sql():
	"""(Re)build the get_closest_* SQL strings from IMPLIED_QUOTE_TABLE. Called at import (v7) and
	by use_v8() so the table swap propagates to these otherwise-import-time f-strings."""
	global get_closest_calls_sql, get_closest_puts_sql
	global get_closest_and_slightly_itm_calls_sql, get_closest_and_slightly_itm_puts_sql
	global get_closest_ndxp_calls_sql, get_closest_ndxp_puts_sql
	t = IMPLIED_QUOTE_TABLE
	get_closest_calls_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'SPXW' AND okey_xx > uprc AND okey_cp = 'Call' AND okey_yr = {today.year}  AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx ASC LIMIT 10;"""
	get_closest_puts_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'SPXW' AND okey_xx < uprc AND okey_cp = 'Put' AND okey_yr = {today.year}  AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx DESC LIMIT 10;"""

	# Wider chain that also includes up to 1 ITM strike (within $1 of uprc).
	# Used by the CLOSER variant which can pick strikes up to $1 ITM. All other algos
	# should filter this to OTM-only to preserve their existing behavior.
	# (SPX strikes are integer multiples of $5; `uprc - 1` captures any strike that is
	#  at most $1 ITM and never anything deeper.)
	get_closest_and_slightly_itm_calls_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'SPXW' AND okey_xx >= uprc - 1 AND okey_cp = 'Call' AND okey_yr = {today.year}  AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx ASC LIMIT 11;"""
	get_closest_and_slightly_itm_puts_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'SPXW' AND okey_xx <= uprc + 1 AND okey_cp = 'Put' AND okey_yr = {today.year}  AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx DESC LIMIT 11;"""

	get_closest_ndxp_calls_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'NDXP' AND okey_xx > uprc AND okey_cp = 'Call' AND okey_yr = {today.year} AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx ASC LIMIT 15;"""
	get_closest_ndxp_puts_sql = f"""SELECT * FROM {t}
WHERE okey_tk = 'NDXP' AND okey_xx < uprc AND okey_cp = 'Put' AND okey_yr = {today.year} AND okey_mn = {today.month} AND okey_dy = {today.day} ORDER BY okey_xx DESC LIMIT 15;"""

_build_quote_sql()   # build at import with the v7 table

def use_v8(enable=True, send=None):
	"""Migrate this module (and spdr_rock_functions' connection + table selection) to SpiderRock v8,
	or back to v7 when enable=False. Flips the option-quote table to msgliveimpliedquoteadj (a DATA
	read, governed by `enable`), rebuilds the get_closest_* SQL, and routes run_query's connection.
	  enable -- data reads (sranalytics/srlive) on v8.
	  send   -- srtrade order/fill traffic on v8; defaults to `enable` when None. Pass send=False to
	            pull data from v8 while still SENDING orders to v7 (staged migration test)."""
	global IMPLIED_QUOTE_TABLE
	IMPLIED_QUOTE_TABLE = "sranalytics.msgliveimpliedquoteadj" if enable else "sranalytics.msgoptionimpliedquote"
	_build_quote_sql()
	import spdr_rock_functions
	spdr_rock_functions.use_v8_connection(enable, send=send)


def _fmt_row_ts(leg):
	"""SR row write time (CT) carried on the leg -- from the chain pull's SELECT * at wave-1,
	re-stamped by batched_refresh_legs_deduped at wave-2. 'n/a' if the leg has no timestamp."""
	ts = getattr(leg, 'timestamp', None)
	if ts is None:
		return 'n/a'
	us = getattr(leg, 'timestamp_us', None)
	try:
		return f"{ts}.{int(us):06d}CT" if us is not None and not pd.isna(us) else f"{ts}CT"
	except (TypeError, ValueError):
		return f"{ts}CT"


def _fmt_leg_quotes(short_legs, long_legs):
	"""One line of sprc + SR NBBO + row write time per leg (from the in-memory leg Series -- no
	query). Printed at wave-fire time so sprc-vs-NBBO dislocations and SR row staleness are
	diagnosable from the log."""
	return " | ".join(
		f"{leg.okey_xx:g}{str(leg.okey_cp)[0]} sprc={float(leg.sprc):.3f} nbbo={float(leg.obid):.2f}/{float(leg.oask):.2f}"
		f" row_ts={_fmt_row_ts(leg)}"
		for leg in list(short_legs) + list(long_legs)
	)


