# Debit price cap: we pay at most this much per spread. Above this, every wave's
# limit_price is clamped to -HACK_MAX_PRICE, and wave 3 rests at exactly that limit
# until the close (1.70 chosen 2026-08-31 off the resting-limit backtest sweep;
# optimum plateau 1.40-1.60, 1.70 adds fill cushion).
HACK_MAX_PRICE = 1.70

# Debit spread edge constants -- the STATIC BASELINE / floor for hacker edges.
# NOTE (2026-08-31): these are set DELIBERATELY OVER-AGGRESSIVE to maximize the odds
# wave 1/2 actually fill (prod history: wave 1 filled 0 in all 4 attempts to date).
# After several prod days with real hacker fills, re-evaluate whether to soften them.
HACK_EDGE_TARGET_1 = 0.060
HACK_MAX_EDGE_1    = 0.120
HACK_EDGE_TARGET_2 = 0.080
HACK_MAX_EDGE_2    = 0.160

# Hacker edges are a floored blend between the static baseline above and the 355-regime-aware value
# (compute_trade_edges with the intentionally-low ABS_CHG_IMBAL_STATS_355PM -- same methodology the
# 355PM CLOSER uses). Per edge: max(static, static + w*(dynamic - static)), so on quiet days it
# stays at the static baseline and on fast/adversarial days it leans toward the dynamic value.
# w=0 -> pure static (today's behavior); w=1 -> pure dynamic.
HACK_DYNAMIC_BLEND_WEIGHT = 0.5


def _hacker_edges(srprc, vix, atm_vol_0dte, abs_imbal, abs_chg_imbal, log_fn, label):
	"""Return (et1, me1, et2, me2) for a hacker debit spread: a floored 355-methodology blend of the
	static HACK_* baseline. Per edge: round(max(static, static + w*(dynamic - static)), 2). Falls
	back to the static baseline if any regime input is missing or anything errors (never raises --
	hackers must not crash the run)."""
	static = (HACK_EDGE_TARGET_1, HACK_MAX_EDGE_1, HACK_EDGE_TARGET_2, HACK_MAX_EDGE_2)
	if srprc is None or srprc <= 0 or None in (vix, atm_vol_0dte, abs_imbal, abs_chg_imbal):
		return static
	try:
		from helpers import compute_trade_edges, ABS_CHG_IMBAL_STATS_355PM
		dyn = compute_trade_edges(vix, atm_vol_0dte, abs_imbal, srprc,
		                          abs_chg_imbal=abs_chg_imbal, abs_chg_stats=ABS_CHG_IMBAL_STATS_355PM)
		w = HACK_DYNAMIC_BLEND_WEIGHT
		blended = tuple(_round_half_up(max(s, s + w * (d - s)), 2) for s, d in zip(static, dyn))
		log_fn(f"{label} edges: static={static} dynamic={tuple(round(x, 3) for x in dyn)} "
		       f"-> blend(w={w})={blended}")
		return blended
	except Exception as e:
		log_fn(f"{label} edge blend failed ({e}); using static baseline {static}")
		return static


