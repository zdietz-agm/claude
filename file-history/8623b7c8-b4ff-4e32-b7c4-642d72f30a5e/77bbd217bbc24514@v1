def _lookup_parent_account(parent_full_name, log_fn):
	"""Look up the hacked strategy's account from its own config module at call time (dynamic --
	picks up mid-day edits). _CLOSER names -> CLOSER_PARENT_CONFIGS; _BUMPED names ->
	BUMPED_PARENT_CONFIGS (both keyed by the parent-base name, suffix stripped); anything
	else is a plain parent -> its own configs/<name>.py 'account' field.
	Fail-soft: log + return None on any miss."""
	if parent_full_name.endswith("_BUMPED"):
		try:
			from configs_bumped_spreads.bumped_spread_config import BUMPED_PARENT_CONFIGS
		except Exception as e:
			log_fn(f"account lookup: could not import BUMPED_PARENT_CONFIGS ({e})")
			return None
		parent_base = parent_full_name[:-len("_BUMPED")]
		cfg = BUMPED_PARENT_CONFIGS.get(parent_base)
		if cfg is None:
			log_fn(f"account lookup: no entry for '{parent_base}' in BUMPED_PARENT_CONFIGS")
			return None
		return cfg.get("account")
	if parent_full_name.endswith("_CLOSER"):
		try:
			from configs_closer_strikes.closer_strike_config import CLOSER_PARENT_CONFIGS
		except Exception as e:
			log_fn(f"account lookup: could not import CLOSER_PARENT_CONFIGS ({e})")
			return None
		parent_base = parent_full_name[:-len("_CLOSER")]
		cfg = CLOSER_PARENT_CONFIGS.get(parent_base)
		if cfg is None:
			log_fn(f"account lookup: no entry for '{parent_base}' in CLOSER_PARENT_CONFIGS")
			return None
		return cfg.get("account")
	# Plain parent: read 'account' from configs/<name>.py (same file-path load pattern as
	# helpers.load_configs_from_directory, so mid-day config edits are picked up).
	try:
		import os
		import importlib.util
		cfg_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "configs",
		                        f"{parent_full_name}.py")
		spec = importlib.util.spec_from_file_location("hacker_cfg_lookup", cfg_path)
		module = importlib.util.module_from_spec(spec)
		spec.loader.exec_module(module)
		account = module.config.get("account")
		if not account:
			log_fn(f"account lookup: configs/{parent_full_name}.py has no 'account' field")
			return None
		return account
	except Exception as e:
		log_fn(f"account lookup: could not load configs/{parent_full_name}.py ({e})")
		return None


# NOTE (2026-09-04): replaced at runtime in 355pm_script_v8.py by helpers_v8._fetch_legs_v8 (signature-checked) -- port edits there too.
async def _fetch_legs(needed_keys, today, log_fn):
	"""Batch-query sranalytics.msgoptionimpliedquote for the specific strikes we need.
	needed_keys is an iterable of (okey_xx: float, okey_cp: str) tuples.
	Returns dict keyed by (okey_xx, okey_cp) -> pandas Series row (or {} on failure/empty).

	This avoids relying on the caller's puts/calls chain DataFrame, which may not include
	strikes the parent traded at 3:50pm (chain window is spot-centered and may have shifted
	by 3:55pm if SPX moved). We look up EXACT strikes we need from SR directly."""
	needed_set = set((float(xx), str(cp)) for xx, cp in needed_keys)
	if not needed_set:
		return {}
	tuples_sql = ",".join(
		f"('SPXW',{xx},'{cp}',{today.year},{today.month},{today.day})"
		for xx, cp in needed_set
	)
	# Quote table read AT CALL TIME from spdr_rock_order_functions.IMPLIED_QUOTE_TABLE: v7 default
	# is sranalytics.msgoptionimpliedquote (SQL byte-identical); after use_v8() it is the v8
	# msgliveimpliedquoteadj (the v7 name does not exist on the v8 host).
	import spdr_rock_order_functions as _srof
	sql = f"""SELECT okey_at, okey_ts, okey_tk, okey_yr, okey_mn, okey_dy, okey_xx, okey_cp, sprc, obid, oask
	          FROM {_srof.IMPLIED_QUOTE_TABLE}
	          WHERE (okey_tk, okey_xx, okey_cp, okey_yr, okey_mn, okey_dy) IN ({tuples_sql})"""
	try:
		df = await asyncio.to_thread(
			run_query, sql, database="sranalytics",
			verbose=True, tag="hacker_leg_fetch",
		)
	except Exception as e:
		log_fn(f"sranalytics leg fetch FAILED ({e}); cannot build hackers")
		return {}
	if df is None or df.empty:
		log_fn(f"sranalytics leg fetch returned no rows for {len(needed_set)} needed strike(s)")
		return {}
	log_fn(f"sranalytics leg fetch returned {len(df)} row(s) for {len(needed_set)} needed strike(s)")
	return {(float(row.okey_xx), str(row.okey_cp)): row for _, row in df.iterrows()}


