def query_closer_fills(today, is_test=False, test_hack_rows=None, log_fn=None):
	"""Called at ~3:54:50. Returns list of raw fill dicts (one per non-zero CLOSER fill):
	    {parent_algo_name, cp, short_strike, long_strike, size_filled}

	In test mode with a non-empty test_hack_rows, bypasses the DB and returns rows
	built from tuples of (parent_algo_name, size_filled, cp, short_strike, long_strike).

	Never raises. On DB error returns [] and logs."""
	if log_fn is None:
		log_fn = lambda msg: None

	if is_test and test_hack_rows:
		log_fn(f"TEST mode: using {len(test_hack_rows)} TEST_HACK row(s) instead of algo_trade_log")
		return [
			{"parent_algo_name": r[0], "size_filled": int(r[1]), "cp": r[2],
			 "short_strike": float(r[3]), "long_strike": float(r[4])}
			for r in test_hack_rows
		]

	names_csv = ",".join(f"'{n}'" for n in TARGET_NAMES)
	sql = f"""
		SELECT algo_name, cp, short_strike, long_strike, size_filled
		FROM optionsResearch.algo_trade_log
		WHERE trade_date = '{today.strftime('%Y-%m-%d')}'
		  AND script_name = '{SCRIPT_NAME_FILTER}'
		  AND algo_name IN ({names_csv})
		  AND size_filled > 0
	"""
	# algo_trade_log lives in optionsResearch on alpine-vbam-dev (NOT the SR box, so
	# spdr_rock_functions.run_query lacks perms here). Use a dedicated engine with bounded
	# timeouts instead of vbam_helpers.run_query: this runs at 3:54:50, and a hung dev db
	# must fail fast (no hackers today) rather than stall the script past its 3:55 fire
	# time (vbam_helpers.run_query sets no read timeout -- pymysql default is infinite).
	try:
		engine = sqlalchemy.create_engine(
			vbam_helpers.connection_string,
			connect_args={"connect_timeout": 3, "read_timeout": 5})
		with engine.connect() as conn:
			df = pd.DataFrame(conn.execute(sqlalchemy.text(sql)).fetchall())
	except Exception as e:
		log_fn(f"algo_trade_log query FAILED ({e}); no hackers today")
		return []
	if df is None or df.empty:
		log_fn(f"no target CLOSER fills in algo_trade_log for {today}; no hackers today")
		return []
	log_fn(f"algo_trade_log returned {len(df)} candidate row(s)")
	return [
		{"parent_algo_name": str(r.algo_name), "size_filled": int(r.size_filled),
		 "cp": str(r.cp), "short_strike": float(r.short_strike),
		 "long_strike": float(r.long_strike)}
		for _, r in df.iterrows()
	]


# Wave-3 limit forcing: passed as max_edge so compute_spread_limit's min_price clamp ALWAYS
# binds -> the resting order's limit is exactly -HACK_MAX_PRICE regardless of leg staleness.
WAVE3_FORCE_CLAMP_EDGE = 99.0
# Wave-3 orderDuration ceiling (seconds). Prod fires ~15:55:08 so seconds-to-close is ~290;
# the cap only matters for test-harness runs earlier in the day (avoid an hours-long T.* order).
WAVE3_MAX_DURATION_S = 310


async def _fire_one(trade, orderDuration=30):
	"""Fire one hacker via send_complex_two_waves, then WAVE 3: cancel any still-working
	remnant and re-send the unfilled remainder as a resting order at exactly -HACK_MAX_PRICE
	with orderDuration = seconds to 16:00:00 (lives server-side at SR; self-expires at the
	close, so no cancel path is needed). Returns list of ALL grouping_codes (waves 1-3).
	The wave-3 block never raises -- a failure there must not lose the wave-1/2 codes."""
	from spdr_rock_order_functions import (
		send_complex_two_waves, trade_complex, batched_fill_check_and_cancel,
		WAIT_TIME_BETWEEN_COMPLEX_ORDER_UPDATE,
	)
	trade["_wave_capture"] = {}
	all_codes = await send_complex_two_waves(
		trade["symbol"], trade["size"],
		trade["short_legs"], trade["long_legs"],
		trade["exp"], trade["account"],
		edge_target1=trade["edge_target1"], max_edge1=trade["max_edge1"],
		edge_target2=trade["edge_target2"], max_edge2=trade["max_edge2"],
		is_sale=trade["is_sale"], userData=trade["name"],
		orderDuration=orderDuration, min_price=trade["min_price"],
		capture=trade["_wave_capture"],
	)
	try:
		if not all_codes:
			return all_codes
		# Give wave 2 the standard working window, then settle fills:
		#   wave-1 codes: ALWAYS already settled (cancelled or naturally done) inside
		#     send_complex_two_waves at the wave-1->2 transition, and terminal by now (+3s) --
		#     just read their final fill quantities. Never re-cancel them: a cancelled v7 order
		#     shows spdrOrderStatus=Closed/spdrCloseReason=UserCxl but KEEPS parentNumber, so
		#     any pn-based liveness check re-cancels it -> SR 1105 duplicate row, which is
		#     exactly what aborted wave 3 live on 2026-09-01.
		#   wave-2 codes: the only possibly-live orders -> settle via the status-gated
		#     batched_fill_check_and_cancel (terminal = spdrOrderStatus in {Closed, Rejected,
		#     SendReject}; cancels only live parents, deduped by parentNumber for chunked
		#     orders, then polls each cancel to terminal before trusting its fill qty) -- so
		#     wave 3 can never double-fill against a live remnant.
		await asyncio.sleep(WAIT_TIME_BETWEEN_COMPLEX_ORDER_UPDATE)
		import spdr_rock_functions as _srf   # SEND_V8 flag lives here (utils module)
		total_filled = 0
		w1_codes = (trade.get("_wave_capture") or {}).get("wave1_codes") or []
		w2_codes = (trade.get("_wave_capture") or {}).get("wave2_codes") or []
		if not w1_codes and not w2_codes:
			# Capture missing despite codes existing (unexpected): fills unverifiable -> no wave 3.
			print(f"{trade['name']}: wave capture empty but {len(all_codes)} code(s) exist -- "
			      f"cannot verify fills; SKIPPING wave-3 rest (overfill risk)")
			return all_codes
		if w1_codes:
			_qty_col = "cumSquareQty" if _srf.SEND_V8 else "fillQuan1"
			_csv = ",".join(f"'{gc}'" for gc in w1_codes)
			_sql = f"SELECT groupingcode, {_qty_col} FROM srtrade.msgsrmlegbrkrstate WHERE groupingcode IN ({_csv})"
			_df = await asyncio.to_thread(run_query, _sql, "srtrade")
			if _df is not None and not _df.empty:
				total_filled += int(_df[_qty_col].fillna(0).sum())
		if w2_codes:
			account_by_gc = {gc: trade["account"] for gc in w2_codes}
			filled_map, unconfirmed = await batched_fill_check_and_cancel(w2_codes, account_by_gc)
			if unconfirmed:
				print(f"{trade['name']}: {len(unconfirmed)} wave-2 order(s) NOT terminal after cancel poll "
				      f"({sorted(unconfirmed)}) -- could still fill; SKIPPING wave-3 rest (overfill risk)")
				return all_codes
			total_filled += sum(filled_map.values())
		remainder = trade["size"] - total_filled
		if remainder < 1:
			print(f"{trade['name']}: filled {total_filled}/{trade['size']} after 2 waves; no wave-3 rest needed")
			return all_codes
		from calendar_utils import getNowEst
		now = getNowEst()
		secs_to_close = int((now.replace(hour=16, minute=0, second=0, microsecond=0) - now).total_seconds())
		if secs_to_close <= 5:
			print(f"{trade['name']}: only {secs_to_close}s to close -- skipping wave-3 rest")
			return all_codes
		secs_to_close = min(secs_to_close, WAVE3_MAX_DURATION_S)
		print(f"{trade['name']}: WAVE-3 resting remainder {remainder}/{trade['size']} at limit "
		      f"{-HACK_MAX_PRICE} for {secs_to_close}s (self-expires at the close)")
		wave3_codes = await asyncio.to_thread(
			trade_complex,
			symbol=trade["symbol"], size=remainder,
			short_legs=trade["short_legs"], long_legs=trade["long_legs"],
			exp=trade["exp"], account=trade["account"],
			edge_target=trade["edge_target2"], max_edge=WAVE3_FORCE_CLAMP_EDGE,
			is_sale=trade["is_sale"], userData=trade["name"],
			orderDuration=secs_to_close, min_price=trade["min_price"],
		)
		trade["wave3_grouping_codes"] = list(wave3_codes)
		all_codes.extend(wave3_codes)
	except Exception as e:
		print(f"{trade['name']}: WAVE-3 rest FAILED (non-fatal, wave-1/2 codes intact): {e}")
	return all_codes


async def fire_hackers(trade_dict, hacker_fills,
                       factor_355_imbal_less_than_neg_950m, factor_355_imbal_greater_than_950m,
                       today, is_test=False, log_fn=None,
                       delay_start_seconds=0.05,
                       vix=None, atm_vol_0dte=None, abs_imbal=None, abs_chg_imbal=None):
	"""Run concurrently with orchestrate_batched_send inside a single asyncio.gather.
	Sleeps delay_start_seconds so orchestrator's wave-1 fires first, then:

	  1. Applies adversarial gate to each fill (Put + neg-950m factor, Call + pos-950m factor)
	     and computes hack_size, account, etc.
	  2. Batch-queries sranalytics.msgoptionimpliedquote for the EXACT strikes needed
	     (avoids reliance on caller's chain DataFrame which may not include parent's
	     strikes if the 3:55 chain window shifted since 3:50).
	  3. Builds one debit-spread trade dict per surviving fill and fires them all
	     concurrently via send_complex_two_waves.
	  4. Appends fired hackers (with grouping_codes) to trade_dict so main-script
	     log_trades picks them up on its normal 60s-wait DB write path.

	Never raises."""
	if log_fn is None:
		log_fn = lambda msg: None

	if not hacker_fills:
		log_fn("no hacker fills queried; nothing to fire")
		return

	if delay_start_seconds > 0:
		log_fn(f"waiting {delay_start_seconds*1000:.0f}ms so orchestrator wave-1 fires first")
		await asyncio.sleep(delay_start_seconds)

	try:
		from helpers import TEST_ACCOUNTS
	except Exception:
		TEST_ACCOUNTS = {}

	# ---- Step 1: adversarial gate + collect metadata for survivors ----
	surviving = []   # list of (fill, hack_size, account) for hackers that pass the gate
	needed_legs = set()   # set of (okey_xx, okey_cp) we need to fetch from SR
	for fill in hacker_fills:
		parent = fill["parent_algo_name"]
		cp     = fill["cp"]
		if cp == "Put"  and factor_355_imbal_less_than_neg_950m != 1:
			log_fn(f"{parent}: Put fill but factor_355_imbal_less_than_neg_950m != 1 -- skipping")
			continue
		if cp == "Call" and factor_355_imbal_greater_than_950m  != 1:
			log_fn(f"{parent}: Call fill but factor_355_imbal_greater_than_950m != 1 -- skipping")
			continue
		hack_size = fill["size_filled"] // 2
		if hack_size < 1:
			log_fn(f"{parent}: size_filled={fill['size_filled']}, hack_size<1 -- skipping")
			continue
		account = _lookup_parent_account(parent, log_fn)
		if account is None:
			continue
		# v8 remap (ACCOUNT_MAP set by 355pm_script_v8): _lookup_parent_account returns v7 closer
		# accounts -- map them, FAIL-CLOSED on a miss (never send a v8-book hacker to a v7 account).
		if ACCOUNT_MAP is not None:
			if account not in ACCOUNT_MAP:
				log_fn(f"{'!' * 10} {parent}: account '{account}' NOT in ACCOUNT_MAP -- SKIPPING "
				       f"hacker (fail-closed; add it to the v8 script's map) {'!' * 10}")
				continue
			account = ACCOUNT_MAP[account]
		if is_test:
			account = TEST_ACCOUNT_OVERRIDE if TEST_ACCOUNT_OVERRIDE is not None else TEST_ACCOUNTS.get(account, account)
		surviving.append((fill, hack_size, account))
		needed_legs.add((float(fill["short_strike"]), cp))
		needed_legs.add((float(fill["long_strike"]),  cp))

	if not surviving:
		log_fn("no adversarial hackers survived gate -- nothing to fire")
		return

	# ---- Step 2: batch-fetch leg data from sranalytics ----
	legs_by_key = await _fetch_legs(needed_legs, today, log_fn)
	if not legs_by_key:
		log_fn("no leg data returned from sranalytics -- cannot build hackers")
		return

	# ---- Step 3: build trade dicts + kick off send_complex_two_waves concurrently ----
	built_trades = []
	fire_tasks = []
	for fill, hack_size, account in surviving:
		parent = fill["parent_algo_name"]
		cp     = fill["cp"]
		long_key  = (float(fill["short_strike"]), cp)   # hacker BUYS parent's short strike
		short_key = (float(fill["long_strike"]),  cp)   # hacker SELLS parent's long strike
		long_leg  = legs_by_key.get(long_key)
		short_leg = legs_by_key.get(short_key)
		if long_leg is None or short_leg is None:
			log_fn(f"HACK_{parent}: missing leg data (long_key={long_key} short_key={short_key}) -- skipping")
			continue

		price = -(long_leg.sprc - short_leg.sprc)   # negative for a debit
		# Floored 355-methodology blend of the static baseline (srprc = the spread's sprc magnitude).
		_et1, _me1, _et2, _me2 = _hacker_edges(
			abs(price), vix, atm_vol_0dte, abs_imbal, abs_chg_imbal, log_fn, f"HACK_{parent}")

		trade = {
			"name":         f"HACK_{parent}",
			"structure":    "Put Debit" if cp == "Put" else "Call Debit",
			"symbol":       "SPXW",
			"exp":          today,
			"account":      account,
			"short_legs":   [short_leg],
			"long_legs":    [long_leg],
			"direction":    "Buy",
			"is_sale":      False,
			"size":         hack_size,
			"min_size":     1,
			"max_size":     hack_size,
			"dollar_target": None,
			"price":        round(price, 2),   # 2dp for recap display + logged price_attempted (raw `price` kept for srprc/edge calc above)
			"edge_target1": _et1,
			"max_edge1":    _me1,
			"edge_target2": _et2,
			"max_edge2":    _me2,
			# Cap max debit at HACK_MAX_PRICE via min_price (existing send_complex_two_waves
			# semantic: limit_price clamped to at least min_price -- for debits limit_price is
			# negative, so min_price=-HACK_MAX_PRICE caps the debit we pay at HACK_MAX_PRICE).
			"min_price":    -HACK_MAX_PRICE,
			"grouping_codes": None,
		}

		log_fn(f"HACK_{parent} ADVERSARIAL -- firing size={hack_size} price={price:.3f} "
		       f"long_strike={fill['short_strike']} short_strike={fill['long_strike']} account={account}")

		built_trades.append(trade)
		fire_tasks.append(_fire_one(trade))

	if not fire_tasks:
		log_fn("no hackers had usable leg data -- nothing to fire")
		return

	log_fn(f"firing {len(fire_tasks)} hacker(s) concurrently via asyncio.gather")
	results = await asyncio.gather(*fire_tasks, return_exceptions=True)

	# Attach grouping_codes and append to trade_dict for main-script log_trades to pick up.
	for trade, result in zip(built_trades, results):
		# Per-wave limits + gc split captured by send_complex_two_waves (empty dict if the send
		# raised before capture was filled -> wave fields stay None).
		_cap = trade.get("_wave_capture") or {}
		trade["wave1_limit"] = _cap.get("wave1_limit")
		trade["wave2_limit"] = _cap.get("wave2_limit")
		trade["wave1_grouping_codes"] = _cap.get("wave1_codes")
		trade["wave2_grouping_codes"] = _cap.get("wave2_codes")
		trade["cross_price1"] = _cap.get("cross_price1")
		trade["srprc1"] = _cap.get("srprc1")
		trade["cross_price2"] = _cap.get("cross_price2")
		trade["srprc2"] = _cap.get("srprc2")
		if isinstance(result, Exception):
			log_fn(f"{trade['name']} SEND FAILED: {result}")
			trade["grouping_codes"] = []
		elif isinstance(result, list):
			trade["grouping_codes"] = result
			log_fn(f"{trade['name']} sent; grouping_codes={result}")
		else:
			log_fn(f"{trade['name']} sent; unexpected result type {type(result).__name__}: {result}")
			trade["grouping_codes"] = []
		trade_dict["trades"].append(trade)
		trade_dict["trade_types"].append("complex")


def refresh_hacker_fills(trade_dict, factors, script_name, log_fn=None):
	"""Second algo_trade_log pass for hackers with a WAVE-3 resting order, which can fill any
	time up to 16:00 -- after the main log_trades 60s fill snapshot. Sleeps until ~16:00:30 ET,
	then re-runs log_trades on JUST those hacker trades: the ON DUPLICATE KEY UPDATE upsert
	refreshes size_filled / avg_fill_price / wave fills on the existing rows in place.
	Fast no-op (no sleep) when no hacker carries wave-3 codes, so non-hack days exit on time.
	Never raises."""
	if log_fn is None:
		log_fn = lambda msg: print(f"refresh_hacker_fills: {msg}")
	try:
		hack_trades = [
			t for t, tt in zip(trade_dict["trades"], trade_dict["trade_types"])
			if tt == "complex" and str(t.get("name", "")).startswith("HACK_")
			and t.get("wave3_grouping_codes")
		]
		if not hack_trades:
			log_fn("no wave-3 hackers today; skipping second logging pass")
			return
		from calendar_utils import getNowEst
		now = getNowEst()
		target = now.replace(hour=16, minute=0, second=30, microsecond=0)
		wait_s = max(0, min(int((target - now).total_seconds()), 600))
		log_fn(f"{len(hack_trades)} wave-3 hacker(s); re-logging fills in {wait_s}s (~16:00:30 ET)")
		sub_dict = {"trades": hack_trades, "trade_types": ["complex"] * len(hack_trades)}
		from algo_trade_logger import log_trades
		log_trades(sub_dict, factors, wait_seconds=wait_s, script_name=script_name)
		log_fn("second logging pass complete")
	except Exception as e:
		log_fn(f"ERROR (non-fatal): {e}")
