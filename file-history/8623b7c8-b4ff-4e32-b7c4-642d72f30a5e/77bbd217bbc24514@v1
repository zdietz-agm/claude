def _round_half_up(x, ndigits=2):
	"""Round half AWAY from zero to ndigits (0.125 -> 0.13), unlike Python's round() which is
	round-half-to-even. Used for hacker edge blends."""
	q = Decimal(1).scaleb(-ndigits)   # e.g. Decimal('0.01') for ndigits=2
	return float(Decimal(str(x)).quantize(q, rounding=ROUND_HALF_UP))


