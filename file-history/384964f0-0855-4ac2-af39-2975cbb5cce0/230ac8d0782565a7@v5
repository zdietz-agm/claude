        ('max_cost_bps / max_pushes', f'{bs.MAX_COST_BPS} / {bs.MAX_PUSHES}', 'if total_cost_bps > max_cost_bps push both strikes out one strike, at most max_pushes times (only MRVL triggers)'),
        ('quotes', 'ThetaData v3 1-sec NBBO bars, optionsResearch.t_opra_quotes', 'pull_0dte_quotes.py: exp == eff_date, strikes within 8% of 15:00 px, 15:00-16:00'),
        ('entry_window_sec', bs.ENTRY_WINDOW_SEC, 'quotes from entry_time:00 through entry_time:10 inclusive (11 one-sec bars)'),
