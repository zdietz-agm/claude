"""
Large index flows -- Excel export of the 0DTE strangle backtest (hold to expiry).

One tab per entry time (15_00, 15_10, 15_20, 15_30, 15_40), one row per event sorted
by index-flow size, columns per Zach's 9/14/26 spec, plus a Settings tab with every
parameter and formula so the workbook is recreatable.

Run from Git Bash:
    python /d/agent_projects/large_index_flows/export_backtest_excel.py
"""
import datetime as dt
import os
from pathlib import Path

import numpy as np
import pandas as pd
from openpyxl.utils import get_column_letter
from sqlalchemy import create_engine

import backtest_strangle as bs

EVENTS_CSV = os.path.join(bs.PROJ_DIR, 'large_flow_events.csv')
ENTRY_TIMES = [dt.time(15, 0), dt.time(15, 10), dt.time(15, 20), dt.time(15, 30), dt.time(15, 40)]
DOLLAR_COLS = {'px_trade_time', 'close', 'call_bid', 'call_ask', 'call_px', 'put_bid', 'put_ask', 'put_px',
               'total_cost', 'call_max_bid', 'put_max_bid'}
BPS_COLS = {'pnl_bps', 'move_bps', 'total_cost_bps'}
EVENT_TYPE = {('sp500_add', 'buy'): 'ADD', ('other_index_event', 'buy'): 'UPWGT', ('other_index_event', 'sell'): 'DOWNWGT'}
COLUMNS = ['eff_date', 'symbol', 'pnl_bps', 'payout', 'event_type', 'est_flow_bn', 'px_trade_time', 'close', 'move_bps',
           'call_strike', 'put_strike', 'call_bid', 'call_ask', 'call_px', 'put_bid', 'put_ask', 'put_px',
           'total_cost', 'total_cost_bps', 'winner',
           'call_max_bid', 'call_max_bid_time', 'put_max_bid', 'put_max_bid_time', 'entry_time']


def leg_quote_stats(q, strike, cp, spread_paid):
    """Median bid / ask, median fill (bid + spread_paid x spread) and n quotes for one leg over the entry window."""
    sub = q[(q.strike == strike) & (q.cp == cp) & (q.askPrc > 0) & (q.askPrc >= q.bidPrc)]
    if sub.empty:
        return dict(bid=np.nan, ask=np.nan, px=np.nan, n=0)
    fills = sub.bidPrc + spread_paid * (sub.askPrc - sub.bidPrc)
    return dict(bid=sub.bidPrc.median(), ask=sub.askPrc.median(), px=bs.round_up_cent(fills.median()), n=len(sub))


def build_tab(eng, entry_time, flows, spread_paid=bs.SPREAD_PAID, otm_bps=bs.OTM_BPS, window_sec=bs.ENTRY_WINDOW_SEC):
    """One row per event for `entry_time` (hold to expiry), columns per COLUMNS, sorted by est_flow_bn desc."""
    label = entry_time.strftime('%H:%M')
    events = bs.load_events(spot_col=label)
    bt = bs.run_backtest(events, eng, entry_time=entry_time, otm_bps=otm_bps, spread_paid=spread_paid, window_sec=window_sec)
    bt = bt.merge(flows, on=['eff_date', 'symbol'], how='left')
    end = (dt.datetime.combine(dt.date.today(), entry_time) + dt.timedelta(seconds=window_sec)).time()
    rows = []
    for r in bt.itertuples(index=False):
        q = bs.load_entry_quotes(eng, r.symbol, r.eff_date, entry_time, end)
        c = leg_quote_stats(q, r.call_strike, 'Call', spread_paid)
        p = leg_quote_stats(q, r.put_strike, 'Put', spread_paid)
        total = c['px'] + p['px']
        payoff = max(r.close - r.call_strike, 0.0) + max(r.put_strike - r.close, 0.0)
        rows.append({
            'eff_date': r.eff_date, 'symbol': r.symbol, 'pnl_bps': r.pnl_hold_bps,
            'event_type': EVENT_TYPE.get((r.event_type, r.direction), r.event_type),
            'est_flow_bn': r.est_flow_bn, 'px_trade_time': r.spot_1500, 'close': r.close, 'move_bps': r.move_bps,
            'call_strike': r.call_strike, 'put_strike': r.put_strike,
            'call_bid': c['bid'], 'call_ask': c['ask'], 'call_px': c['px'],
            'put_bid': p['bid'], 'put_ask': p['ask'], 'put_px': p['px'],
            'total_cost': total, 'total_cost_bps': r.cost_bps,
            'payout': payoff / total if total else np.nan,
            'winner': r.winner,
            'call_max_bid': r.call_max_bid, 'call_max_bid_time': r.call_max_t,
            'put_max_bid': r.put_max_bid, 'put_max_bid_time': r.put_max_t,
            'entry_time': label,
        })
    return pd.DataFrame(rows)[COLUMNS].sort_values('est_flow_bn', ascending=False).reset_index(drop=True)


