        ('event_type', 'ADD = regular-cycle S&P 500 add; UPWGT = index up-weight (buy); DOWNWGT = index down-weight (sell)', ''),
        ('px_trade_time', 'CloudQuant trade print nearest entry_time:00', 'vbam_utilities.cloudquant.get_prices_batch, team cache; intraday_prices.csv'),
