def export(sheets, base_name):
    """Write the sheets to Downloads/<base_name>_YYYYMMDD_HHMM.xlsx with filter, frozen panes, formats."""
    path = str(Path.home() / 'Downloads' / f"{base_name}_{dt.datetime.now():%Y%m%d_%H%M}.xlsx")
    with pd.ExcelWriter(path, engine='openpyxl') as w:
        for name, df in sheets.items():
            df.to_excel(w, sheet_name=name, index=False)
            ws = w.sheets[name]
            ws.auto_filter.ref = ws.dimensions
            ws.freeze_panes = 'C2'
            for i, col in enumerate(df.columns, 1):
                letter = get_column_letter(i)
                width = max(len(str(col)), df[col].astype(str).str.len().max() if len(df) else 0)
                ws.column_dimensions[letter].width = min(width + 2, 90 if name == 'Settings' else 18)
                fmt = None
                if col in DOLLAR_COLS:
                    fmt = '_($* #,##0.00_);[Red]_($* (#,##0.00)'
                elif col in BPS_COLS:
                    fmt = '0.0;[Red]-0.0'
                elif col == 'payout':
                    fmt = '0.00;[Red]-0.00'
                elif col == 'est_flow_bn':
                    fmt = '0.0'
                if fmt:
                    for row in range(2, len(df) + 2):
                        ws[f'{letter}{row}'].number_format = fmt
    print(f'Saved: {path}')
    return path


if __name__ == '__main__':
    import argparse
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--otm-bps', type=float, default=bs.OTM_BPS,
                    help=f'min OTM per leg in bps (default {bs.OTM_BPS}); 0 = closest OTM call and put')
    ap.add_argument('--max-pushes', type=int, default=bs.MAX_PUSHES,
                    help=f'one-strike push-outs allowed when cost > {bs.MAX_COST_BPS} bps (default {bs.MAX_PUSHES}); 0 = never push')
    ap.add_argument('--wrong-way', action='store_true',
                    help='buy only the wrong-way leg (put on ADD/UPWGT, call on DOWNWGT) instead of the strangle')
    args = ap.parse_args()
    bs.OTM_BPS = args.otm_bps        # so the Settings tab reports what was actually used
    bs.MAX_PUSHES = args.max_pushes

    eng = create_engine(bs.vbam_helpers.dev_connection_string, pool_pre_ping=True)
    flows = pd.read_csv(EVENTS_CSV, parse_dates=['eff_date'])
    flows['eff_date'] = flows['eff_date'].dt.date
    flows = flows[['eff_date', 'symbol', 'event_type']]
    sheets = {}
    for t in ENTRY_TIMES:
        tab = build_tab(eng, t, flows, otm_bps=args.otm_bps, max_pushes=args.max_pushes, wrong_way=args.wrong_way)
        sheets[t.strftime('%H_%M')] = tab
        print(f"{t:%H:%M}: {len(tab)} rows, total pnl {tab.pnl_bps.sum():,.1f} bps, win rate {(tab.pnl_bps > 0).mean():.0%}", flush=True)
    sheets['Settings'] = settings_tab(args.wrong_way)
    export(sheets, f"large_index_flows_strangle_hold_otm{args.otm_bps:g}" + ("_nopush" if args.max_pushes == 0 else "")
           + ("_wrong-way" if args.wrong_way else ""))
