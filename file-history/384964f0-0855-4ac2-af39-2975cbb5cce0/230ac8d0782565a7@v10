DOLLAR_COLS = {'px_trade_time', 'close', 'call_bid', 'call_ask', 'call_px', 'put_bid', 'put_ask', 'put_px',
               'total_cost', 'call_max_bid', 'put_max_bid'}
BPS_COLS = {'pnl_bps', 'move_bps', 'total_cost_bps', 'base1_bps', 'base2_bps', 'base3_bps', 'base4_bps', 'base5_bps',
            'base_mean_bps', 'one_day_move_bps'}
TAIL_COLS = ['base1_date', 'base1_bps', 'base2_date', 'base2_bps', 'base3_date', 'base3_bps', 'base4_date', 'base4_bps',
             'base5_date', 'base5_bps', 'base_mean_bps', 'richness_baseline', 'sigma_30d', 'one_day_move_bps',
             'richness_realized']
EVENT_TYPE = {('sp500_add', 'buy'): 'ADD', ('other_index_event', 'buy'): 'UPWGT', ('other_index_event', 'sell'): 'DOWNWGT'}
WRONG_WAY = {'ADD': 'put', 'UPWGT': 'put', 'DOWNWGT': 'call'}   # option that pays if the index flow reverses
COLUMNS = ['eff_date', 'symbol', 'pnl_bps', 'payout', 'traded_leg', 'event_type', 'est_flow_bn', 'px_trade_time', 'close', 'move_bps',
           'call_strike', 'put_strike', 'call_bid', 'call_ask', 'call_px', 'put_bid', 'put_ask', 'put_px',
           'total_cost', 'total_cost_bps', 'winner',
           'call_max_bid', 'call_max_bid_time', 'put_max_bid', 'put_max_bid_time', 'entry_time']


def leg_quote_stats(q, strike, cp, spread_paid):
    """Median bid / ask, median fill (bid + spread_paid x spread) and n quotes for one leg over the entry window."""
    sub = q[(q.strike == strike) & (q.cp == cp) & (q.askPrc > 0) & (q.askPrc >= q.bidPrc)]
    if sub.empty:
        return dict(bid=np.nan, ask=np.nan, px=np.nan, n=0)
    fills = sub.bidPrc + spread_paid * (sub.askPrc - sub.bidPrc)
    return dict(bid=sub.bidPrc.median(), ask=sub.askPrc.median(), px=bs.round_up_cent(fills.median()), n=len(sub))


def build_tab(eng, entry_time, flows, spread_paid=bs.SPREAD_PAID, otm_bps=bs.OTM_BPS, window_sec=bs.ENTRY_WINDOW_SEC,
              max_pushes=bs.MAX_PUSHES, wrong_way=False):
    """One row per event for `entry_time` (hold to expiry), columns per COLUMNS + TAIL_COLS (baseline-Friday
    richness and realized-vol richness), sorted by est_flow_bn desc. Args -- eng: dev engine; entry_time: entry
    snap; flows: eff_date/symbol/event_type frame; spread_paid: fraction of spread paid; otm_bps: min OTM per leg;
    window_sec: median-fill window; max_pushes: one-strike push-outs allowed when cost > MAX_COST_BPS;
    wrong_way: buy only the leg that pays if the flow reverses (put on ADD/UPWGT, call on DOWNWGT) -- cost,
    payout, pnl, winner and both richness measures then refer to that single leg."""
    label = entry_time.strftime('%H:%M')
    events = bs.load_events(spot_col=label)
    bt = bs.run_backtest(events, eng, entry_time=entry_time, otm_bps=otm_bps, spread_paid=spread_paid,
                         window_sec=window_sec, max_pushes=max_pushes)
    bt = bt.merge(flows, on=['eff_date', 'symbol'], how='left')
    end = (dt.datetime.combine(dt.date.today(), entry_time) + dt.timedelta(seconds=window_sec)).time()
    rows = []
    for r in bt.itertuples(index=False):
        q = bs.load_entry_quotes(eng, r.symbol, r.eff_date, entry_time, end)
        c = leg_quote_stats(q, r.call_strike, 'Call', spread_paid)
        p = leg_quote_stats(q, r.put_strike, 'Put', spread_paid)
        etype = EVENT_TYPE.get((r.event_type, r.direction), r.event_type)
        leg = WRONG_WAY[etype] if wrong_way else 'both'
        call_intr = max(r.close - r.call_strike, 0.0)
        put_intr = max(r.put_strike - r.close, 0.0)
        if leg == 'call':
            total, payoff = c['px'], call_intr
        elif leg == 'put':
            total, payoff = p['px'], put_intr
        else:
            total, payoff = c['px'] + p['px'], call_intr + put_intr
        pnl_bps = (payoff - total) / r.spot_1500 * 1e4
        winner = ('call' if call_intr > 0 and leg != 'put' else 'put' if put_intr > 0 and leg != 'call' else 'none')
        rows.append({
            'eff_date': r.eff_date, 'symbol': r.symbol, 'pnl_bps': pnl_bps, 'traded_leg': leg,
            'event_type': etype,
            'est_flow_bn': r.est_flow_bn, 'px_trade_time': r.spot_1500, 'close': r.close, 'move_bps': r.move_bps,
            'call_strike': r.call_strike, 'put_strike': r.put_strike,
            'call_bid': c['bid'], 'call_ask': c['ask'], 'call_px': c['px'],
            'put_bid': p['bid'], 'put_ask': p['ask'], 'put_px': p['px'],
            'total_cost': total, 'total_cost_bps': total / r.spot_1500 * 1e4,
            'payout': (payoff - total) / total if total else np.nan,   # net: -1 = expired worthless
            'winner': winner,
            'call_max_bid': r.call_max_bid, 'call_max_bid_time': r.call_max_t,
            'put_max_bid': r.put_max_bid, 'put_max_bid_time': r.put_max_t,
            'entry_time': label,
        })
    tab = pd.DataFrame(rows)[COLUMNS]
    # trailing richness columns: baseline Fridays (annc Friday excluded, mean) and realized-vol one-day move,
    # priced on the same leg(s) as the trade
    leg_map = ({(r.eff_date, r.symbol): r.traded_leg for r in tab.itertuples(index=False)} if wrong_way else None)
    base = br.build(eng, entry_time, save=False, leg_map=leg_map)
    base_cols = ['eff_date', 'symbol'] + [c for c in TAIL_COLS if c.startswith('base')]
    for c in base_cols:
        if c not in base.columns:
            base[c] = np.nan
    tab = tab.merge(base[base_cols], on=['eff_date', 'symbol'], how='left')
    tab['richness_baseline'] = tab['total_cost_bps'] / tab['base_mean_bps']
    tab['sigma_30d'] = [rv.realized_vol_tm1(s, d) for s, d in zip(tab.symbol, tab.eff_date)]
    tab['one_day_move_bps'] = tab['sigma_30d'] / np.sqrt(252) * 100
    tab['richness_realized'] = tab['total_cost_bps'] / tab['one_day_move_bps']
    return tab[COLUMNS + TAIL_COLS].sort_values('est_flow_bn', ascending=False).reset_index(drop=True)


