# ---------- endpoint wrappers (LEGACY v2 -- see warning above) ----------

def check_terminal_status(timeout=5):
    """Return True if ThetaTerminal is reachable on BASE_URL, else False.
    Any HTTP response back (even non-200) counts as reachable; only a
    connection failure means the terminal isn't running."""
    try:
        requests.get(f"{BASE_URL}/v2/system/status", timeout=timeout)
        return True
    except requests.RequestException:
        return False


@lru_cache(maxsize=None)
def list_expirations(root):
    """Sorted list of LISTED expirations (datetime.date) for a root, cached per root."""
    r = requests.get(f"{BASE_URL}/v2/list/expirations?root={root}", timeout=DEFAULT_TIMEOUT)
    r.raise_for_status()
    exps = r.json().get('response', [])
    return sorted(_parse_yyyymmdd(e) for e in exps)


def list_strikes(root, exp):
    """Sorted list of LISTED strikes (in dollars) for (root, exp).
       root -- ThetaData option root (e.g. 'SPXW', 'NDXP', 'NVDA')
       exp  -- contract expiration as datetime.date"""
    r = requests.get(
        f"{BASE_URL}/v2/list/strikes?root={root}&exp={_fmt_date(exp)}",
        timeout=DEFAULT_TIMEOUT)
    r.raise_for_status()
    # ThetaData returns strikes in 1/1000 dollars (same scale used in the quote URL)
    return sorted(s / 1000.0 for s in r.json().get('response', []))


def get_bulk_chain(root, exp, trade_date):
    """Enumerate available strikes/rights for (root, exp) on trade_date via the bulk endpoint.
       root       -- ThetaData option root
       exp        -- contract expiration as datetime.date
       trade_date -- date we sample chain availability on
       Returns DataFrame with columns [symbol, strike, cp, exp]. Empty on HTTP 472
       (no data), which callers use as a cheap 'no chain listed' pre-check."""
    url = (f"{BASE_URL}/v2/bulk_hist/option/quote?"
           f"root={root}&exp={_fmt_date(exp)}"
           f"&start_date={_fmt_date(trade_date)}&end_date={_fmt_date(trade_date)}"
           f"&ivl=900000")
    r = requests.get(url, timeout=DEFAULT_TIMEOUT)
    empty = pd.DataFrame(columns=["symbol", "strike", "cp", "exp"])
    if r.status_code == NO_DATA_STATUS:
        return empty
    if r.status_code != 200:
        raise RuntimeError(f"get_bulk_chain {root} exp={exp} date={trade_date}: "
                           f"HTTP {r.status_code} - {r.text[:300]}")
    data = r.json()
    if data.get("next_page") not in (None, "null"):
        print(f"  WARNING: get_bulk_chain {root} {trade_date} has next_page; chain may be truncated")
    resp = pd.DataFrame(data.get("response", []))
    if resp.empty:
        return empty
    resp["symbol"] = resp.contract.apply(lambda x: x["root"])
    resp["strike"] = resp.contract.apply(lambda x: x["strike"] / 1000)
    resp["cp"] = resp.contract.apply(lambda x: "Call" if x["right"] == "C" else "Put")
    resp["exp"] = resp.contract.apply(lambda x: _parse_yyyymmdd(x["expiration"]))
    return resp[["symbol", "strike", "cp", "exp"]]


def get_option_quotes(root, strike, cp, exp, start_date, end_date,
                     start_time=None, end_time=None, ivl_ms=1000, timeout=DEFAULT_TIMEOUT):
    """Bid/ask bars for one option contract over a date/time window.
       root       -- ThetaData option root (e.g. 'SPXW', 'NVDA')
       strike     -- strike in dollars (float)
       cp         -- 'Call' or 'Put' (URL right = cp[0])
       exp        -- contract expiration as datetime.date
       start_date -- first trading date to pull (datetime.date)
       end_date   -- last trading date to pull (datetime.date)
       start_time -- optional intraday start time (datetime.time or 'HH:MM:SS')
       end_time   -- optional intraday end time (datetime.time or 'HH:MM:SS')
       ivl_ms     -- bar interval in milliseconds (1000 = 1s, 5000 = 5s)
       timeout    -- per-request HTTP timeout in seconds
       Returns DataFrame with QUOTE_COLS; empty on HTTP 472 or empty response."""
    url = (f"{BASE_URL}/v2/hist/option/quote?"
           f"root={root}&exp={_fmt_date(exp)}&strike={int(strike * 1000)}&right={cp[0]}"
           f"&start_date={_fmt_date(start_date)}&end_date={_fmt_date(end_date)}"
           f"&ivl={ivl_ms}")
    if start_time is not None:
        url += f"&start_time={_fmt_hms_to_ms(start_time)}"
    if end_time is not None:
        url += f"&end_time={_fmt_hms_to_ms(end_time)}"

    r = requests.get(url, timeout=timeout)
    if r.status_code == NO_DATA_STATUS:
        return pd.DataFrame(columns=QUOTE_COLS)
    if r.status_code != 200:
        raise RuntimeError(f"get_option_quotes {root} {strike} {cp} {exp}: "
                           f"HTTP {r.status_code} - {r.text[:300]}")
    data = r.json()
    df = pd.DataFrame(data["response"], columns=data["header"]["format"])
    if df.empty:
        return pd.DataFrame(columns=QUOTE_COLS)
    df["timestmp"] = df.ms_of_day.apply(ms_to_et_time)
    df["symbol"] = root
    df["strike"] = strike
    df["cp"] = cp
    df["exp"] = exp
    df = df.rename(columns=_QUOTE_RENAME)
    if "trade_date" in df.columns:
        df["trade_date"] = df["trade_date"].apply(_parse_yyyymmdd)
    return df[QUOTE_COLS]


def get_index_price(root, start_date, end_date,
                    ivl_ms=0, start_time=None, end_time=None,
                    rth=None, timeout=DEFAULT_TIMEOUT):
    """Historical index price ticks (or bars) for a root over a date/time window.
       root       -- index symbol (e.g. 'SPX', 'NDX', 'VIX')
       start_date -- first date to pull (datetime.date or YYYYMMDD)
       end_date   -- last date to pull inclusive (datetime.date or YYYYMMDD)
       ivl_ms     -- interval in ms; 0 (default) = tick-level (one row per price change)
       start_time -- optional intraday start (datetime.time or 'HH:MM:SS')
       end_time   -- optional intraday end (datetime.time or 'HH:MM:SS')
       rth        -- restrict to regular hours; ignored when ivl_ms=0 (forced False server-side)
       timeout    -- HTTP timeout in seconds
       Returns DataFrame with columns [symbol, trade_date, timestmp, price]; empty on 472."""
    url = (f"{BASE_URL}/v2/hist/index/price?"
           f"root={root}"
           f"&start_date={_fmt_date(start_date)}&end_date={_fmt_date(end_date)}"
           f"&ivl={ivl_ms}")
    if start_time is not None:
        url += f"&start_time={_fmt_hms_to_ms(start_time)}"
    if end_time is not None:
        url += f"&end_time={_fmt_hms_to_ms(end_time)}"
    if rth is not None and ivl_ms != 0:
        url += f"&rth={'true' if rth else 'false'}"

    r = requests.get(url, timeout=timeout)
    cols = ['symbol', 'trade_date', 'timestmp', 'price']
    if r.status_code == NO_DATA_STATUS:
        return pd.DataFrame(columns=cols)
    if r.status_code != 200:
        raise RuntimeError(f"get_index_price {root} {start_date}-{end_date}: "
                           f"HTTP {r.status_code} - {r.text[:300]}")
    data = r.json()
    df = pd.DataFrame(data["response"], columns=data["header"]["format"])
    if df.empty:
        return pd.DataFrame(columns=cols)
    df["timestmp"] = df.ms_of_day.apply(ms_to_et_time)
    df["trade_date"] = df.date.apply(_parse_yyyymmdd)
    df["symbol"] = root
    return df[cols]


