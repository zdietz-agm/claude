"""Helpers for pulling data from ThetaData.

Two generations of access are wrapped side by side:

v2 (legacy) -- local ThetaTerminal HTTP API. Pre-req: terminal on 127.0.0.1:25510:
    java -jar ThetaTerminal.jar <user> <password>
  Endpoints wrapped:
    /v2/system/status          -- terminal health
    /v2/list/expirations       -- listed expirations for a root (cached)
    /v2/list/strikes           -- listed strikes for (root, exp)
    /v2/bulk_hist/option/quote -- bulk chain enumeration for (root, exp, date)
    /v2/hist/option/quote      -- per-contract bid/ask bars
    /v2/hist/index/price       -- index price ticks (e.g. SPX, NDX)

v3 (preferred) -- official `thetadata` pip library (gRPC direct to Theta servers).
  NO local terminal needed. Credentials: THETADATA_API_KEY env var or
  thetadata_creds.json next to this file. Functions carry a _v3 suffix:
    check_v3_connection, list_expirations_v3, list_strikes_v3,
    get_bulk_chain_v3, get_option_quotes_v3, get_index_price_v3

All quote-returning helpers (both generations) emit a DataFrame with the canonical
optionsResearch.t_opra_quotes schema:
    symbol, trade_date, exp, strike, cp, timestmp, bidPrc, askPrc, bidSize, askSize
"""
import datetime as dt
import json
import os
from functools import lru_cache
from urllib.parse import quote_plus

import pandas as pd
import requests
from sqlalchemy import create_engine, text


BASE_URL = "http://127.0.0.1:25510"
DEFAULT_TIMEOUT = 60
NO_DATA_STATUS = 472  # ThetaData's "no data available" response code

# Canonical column order matching optionsResearch.t_opra_quotes
QUOTE_COLS = ['symbol', 'trade_date', 'exp', 'strike', 'cp',
              'timestmp', 'bidPrc', 'askPrc', 'bidSize', 'askSize']

_QUOTE_RENAME = {"bid_size": "bidSize", "ask_size": "askSize",
                 "bid": "bidPrc", "ask": "askPrc", "date": "trade_date"}


# ---------- small utilities ----------

def ms_to_et_time(ms):
    """Convert ThetaData ms_of_day (int) to a datetime.time (ET)."""
    seconds, msec = divmod(int(ms), 1000)
    minutes, seconds = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)
    return dt.time(hour=hours, minute=minutes, second=seconds, microsecond=msec * 1000)


def _parse_yyyymmdd(yyyymmdd):
    """Parse a ThetaData YYYYMMDD int/str into a datetime.date."""
    s = str(int(yyyymmdd))
    return dt.date(int(s[:4]), int(s[4:6]), int(s[6:8]))


def _fmt_date(d):
    """Format a datetime.date (or YYYYMMDD-like value) as ThetaData YYYYMMDD."""
    if isinstance(d, (dt.date, dt.datetime)):
        return d.strftime('%Y%m%d')
    return str(int(d))


def _fmt_hms_to_ms(t):
    """Convert a datetime.time or 'HH:MM:SS' string into ms-of-day int used by ThetaData."""
    if isinstance(t, str):
        parts = [int(x) for x in t.split(':')]
        while len(parts) < 3:
            parts.append(0)
        h, m, s = parts[0], parts[1], parts[2]
    else:
        h, m, s = t.hour, t.minute, t.second
    return (h * 3600 + m * 60 + s) * 1000


