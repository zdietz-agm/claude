def _get_cache_engine():
    """Lazy singleton SQLAlchemy engine for the cache DB."""
    global _cache_engine
    if _cache_engine is None:
        _cache_engine = create_engine(_CACHE_CONN_STR, pool_pre_ping=True)
    return _cache_engine


def _fmt_time_for_sql(t):
    """Format a datetime.time or 'HH:MM:SS' string for MySQL TIME comparison."""
    if isinstance(t, str):
        return t
    return t.strftime('%H:%M:%S')


def _timedelta_to_time(td):
    """MySQL TIME columns come back as pandas.Timedelta -- coerce to datetime.time."""
    if pd.isna(td):
        return None
    total_seconds = int(td.total_seconds())
    h, rem = divmod(total_seconds, 3600)
    m, s = divmod(rem, 60)
    return dt.time(h, m, s)


def _is_date_cached(engine, root, date):
    """Fast PK-prefix lookup: does any row exist for (symbol, date)?"""
    with engine.connect() as conn:
        r = conn.execute(text(
            f'SELECT 1 FROM {INDEX_SNAPS_TABLE} WHERE symbol=:s AND trade_date=:d LIMIT 1'),
            {'s': root, 'd': date.strftime('%Y-%m-%d')}).fetchone()
    return r is not None


def _read_cached(engine, root, date, start_time, end_time):
    """Read cached rows for (symbol, date), SQL-filtered by [start_time, end_time] when provided."""
    sql = (f'SELECT symbol, trade_date, timestmp, price FROM {INDEX_SNAPS_TABLE} '
           f'WHERE symbol=:s AND trade_date=:d')
    params = {'s': root, 'd': date.strftime('%Y-%m-%d')}
    if start_time is not None:
        sql += ' AND timestmp >= :st'
        params['st'] = _fmt_time_for_sql(start_time)
    if end_time is not None:
        sql += ' AND timestmp <= :et'
        params['et'] = _fmt_time_for_sql(end_time)
    sql += ' ORDER BY timestmp'
    df = pd.read_sql(text(sql), engine, params=params)
    if not df.empty:
        df['trade_date'] = pd.to_datetime(df['trade_date']).dt.date
        df['timestmp'] = df['timestmp'].apply(_timedelta_to_time)
    return df


def _write_day_to_cache(engine, root, date, df):
    """Atomic DELETE+INSERT for (root, date). Rollback on any error leaves cache clean.
    Dedupes to one row per second (last tick wins) since the MySQL TIME column stores
    second-level precision -- ThetaData occasionally emits multiple sub-second ticks."""
    if df.empty:
        to_insert = df
    else:
        to_insert = df[INDEX_SNAPS_COLS].copy()
        to_insert['timestmp'] = to_insert['timestmp'].apply(
            lambda t: t.replace(microsecond=0) if t is not None else t)
        to_insert = to_insert.drop_duplicates(
            subset=['symbol', 'trade_date', 'timestmp'], keep='last')

    with engine.begin() as conn:
        conn.execute(text(f'DELETE FROM {INDEX_SNAPS_TABLE} WHERE symbol=:s AND trade_date=:d'),
                     {'s': root, 'd': date.strftime('%Y-%m-%d')})
        if not to_insert.empty:
            to_insert.to_sql(INDEX_SNAPS_TABLE, con=conn, if_exists='append', index=False)


def get_index_price_cached(root, start_date, end_date,
                           start_time=None, end_time=None, force_refresh=False,
                           use_v3=True):
    """Cache-backed wrapper around get_index_price / get_index_price_v3. Same return schema.
       root          -- index symbol (e.g. 'SPX', 'NDX', 'VIX')
       start_date    -- first date inclusive (datetime.date or YYYYMMDD)
       end_date      -- last date inclusive (datetime.date or YYYYMMDD); must be < today
       start_time    -- optional intraday start (datetime.time or 'HH:MM:SS'); filtered in SQL
       end_time      -- optional intraday end (datetime.time or 'HH:MM:SS'); filtered in SQL
       force_refresh -- if True, re-pull from ThetaData even for dates already cached
       use_v3        -- if True (default), cache misses pull via the v3 library (no local
                        terminal); if False, use the v2 local ThetaTerminal HTTP API
       Non-trading days are skipped via calendar_utils. Raises AssertionError if end_date >= today."""
    from calendar_utils import trading_range

    if not isinstance(start_date, dt.date):
        start_date = _parse_yyyymmdd(start_date)
    if not isinstance(end_date, dt.date):
        end_date = _parse_yyyymmdd(end_date)
    today = dt.date.today()
    assert end_date < today, (
        f"end_date {end_date} must be before today ({today}); "
        f"ThetaData has no data for today or future dates")

    engine = _get_cache_engine()
    dates = list(trading_range(start_date, end_date))
    out_frames = []
    for d in dates:
        if force_refresh or not _is_date_cached(engine, root, d):
            # full day, no time filter
            df_day = get_index_price_v3(root, d) if use_v3 else get_index_price(root, d, d)
            _write_day_to_cache(engine, root, d, df_day)
        out_frames.append(_read_cached(engine, root, d, start_time, end_time))
    if not out_frames:
        return pd.DataFrame(columns=INDEX_SNAPS_COLS)
    return pd.concat(out_frames, ignore_index=True)


def cache_index_price_data(symbol, start_date, end_date=None, use_v3=True):
    """Pre-cache every trading day in [start_date, end_date] for an index (skips
    dates already in t_index_snaps_td). end_date defaults to x_days_ago(1).
    use_v3=True (default) pulls via the v3 library (no local terminal)."""
    from calendar_utils import trading_range, x_days_ago

    if end_date is None:
        end_date = x_days_ago(1)
    if not isinstance(start_date, dt.date):
        start_date = _parse_yyyymmdd(start_date)
    if not isinstance(end_date, dt.date):
        end_date = _parse_yyyymmdd(end_date)

    today = dt.date.today()
    assert end_date < today, (
        f"end_date {end_date} must be before today ({today}); "
        f"ThetaData has no data for today or future dates")

    engine = _get_cache_engine()
    dates = list(trading_range(start_date, end_date))
    n_total = len(dates)
    n_pulled = n_skipped = n_empty = 0

    print(f"cache_index_price_data({symbol}): {n_total} trading days "
          f"from {start_date} to {end_date}")
    for i, d in enumerate(dates, 1):
        if _is_date_cached(engine, symbol, d):
            n_skipped += 1
            continue
        df_day = get_index_price_v3(symbol, d) if use_v3 else get_index_price(symbol, d, d)
        _write_day_to_cache(engine, symbol, d, df_day)
        if df_day.empty:
            n_empty += 1
            print(f"  [{i}/{n_total}] {d}: pulled 0 rows (empty response)")
        else:
            n_pulled += 1
            print(f"  [{i}/{n_total}] {d}: pulled {len(df_day):,} rows")

    print(f"Done. Pulled {n_pulled}, already-cached {n_skipped}, empty {n_empty}.")
    return {'total': n_total, 'pulled': n_pulled,
            'skipped': n_skipped, 'empty': n_empty}


# ---------- ThetaData v3 (official python library -- no local terminal needed) ----------
#
# The v3 `thetadata` pip library authenticates over HTTPS and pulls data via gRPC
# directly from Theta's servers. ThetaTerminal.jar is NOT required for any _v3 function.
#
# Credentials, in priority order:
#   1. THETADATA_API_KEY env var
#   2. thetadata_creds.json next to this file:
#        {"api_key": "..."}  OR  {"email": "...", "password": "..."}
#
# All _v3 quote helpers return the same canonical QUOTE_COLS schema as their
# v2 counterparts, so downstream t_opra_quotes writers work unchanged.

V3_CREDS_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'thetadata_creds.json')
V3_API_KEY = 'td1_prod_c725397f2b2b4c9e96fcd5df3c074a85'  # fallback if env var / creds file absent

_v3_client = None


def _get_v3_client(force_new=False):
    """Lazy singleton ThetaClient (pandas mode). Auth: THETADATA_API_KEY env var,
    then thetadata_creds.json (api_key or email/password). Raises RuntimeError
    with setup instructions if no credentials are found."""
    global _v3_client
    if _v3_client is not None and not force_new:
        return _v3_client

    from thetadata import ThetaClient  # lazy import so v2-only users don't need the lib

    api_key = os.getenv('THETADATA_API_KEY')
    email = password = None
    if not api_key and os.path.exists(V3_CREDS_FILE):
        with open(V3_CREDS_FILE) as f:
            creds = json.load(f)
        api_key = creds.get('api_key')
        email, password = creds.get('email'), creds.get('password')
    if not api_key and not (email and password):
        api_key = V3_API_KEY

    if api_key:
        _v3_client = ThetaClient(api_key=api_key, dataframe_type='pandas')
    elif email and password:
        _v3_client = ThetaClient(email=email, password=password, dataframe_type='pandas')
    else:
        raise RuntimeError(
            f"No ThetaData v3 credentials. Set THETADATA_API_KEY env var or create "
            f"{V3_CREDS_FILE} with {{'api_key': ...}} or {{'email': ..., 'password': ...}}")
    return _v3_client


def check_v3_connection():
    """Return True if a v3 client can authenticate against ThetaData servers, else False."""
    try:
        _get_v3_client()
        return True
    except Exception as e:
        print(f"ThetaData v3 connection failed: {e}")
        return False


def _v3_empty_or_raise(e):
    """Return True if the exception is ThetaData's 'no data found' error, else re-raise."""
    from thetadata.errors import NoDataFoundError
    if isinstance(e, NoDataFoundError):
        return True
    raise e


def _v3_norm_cols(df):
    """Lowercase and strip v3 response column names for defensive matching."""
    return df.rename(columns={c: str(c).strip().lower() for c in df.columns})


def _v3_fix_strike(s):
    """v3 returns strikes in dollars, but guard against 1/1000-dollar encoding."""
    s = pd.to_numeric(s, errors='coerce')
    if s.notna().any() and s.dropna().median() > 50000:
        s = s / 1000.0
    return s


def _v3_cp(right_series):
    """Map v3 right values ('call'/'put'/'C'/'P') to canonical 'Call'/'Put'."""
    return right_series.astype(str).str[0].str.upper().map({'C': 'Call', 'P': 'Put'})


def _v3_split_timestamp(df):
    """Split a v3 tz-aware NY timestamp column into (trade_date, timestmp) columns."""
    ts = pd.to_datetime(df['timestamp'])
    if getattr(ts.dt, 'tz', None) is not None:
        ts = ts.dt.tz_localize(None)  # drop tz, keep NY wall time
    df['trade_date'] = ts.dt.date
    df['timestmp'] = ts.dt.time
    return df


def _v3_parse_exp(exp_series):
    """Parse v3 expiration column (str 'YYYY-MM-DD'/'YYYYMMDD' or date) to datetime.date."""
    return pd.to_datetime(exp_series).dt.date


def _v3_quotes_to_canonical(df):
    """Convert a v3 option quote DataFrame to the canonical QUOTE_COLS schema."""
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=QUOTE_COLS)
    df = _v3_norm_cols(df.copy())
    df = _v3_split_timestamp(df)
    df['strike'] = _v3_fix_strike(df['strike'])
    df['cp'] = _v3_cp(df['right'])
    df['exp'] = _v3_parse_exp(df['expiration'])
    df = df.rename(columns={'bid': 'bidPrc', 'ask': 'askPrc',
                            'bid_size': 'bidSize', 'ask_size': 'askSize'})
    return df[QUOTE_COLS]


def _fmt_strike_v3(strike):
    """Format a dollar strike for a v3 request string (trailing zeros trimmed)."""
    return f"{float(strike):g}"


def list_expirations_v3(root):
    """v3 version of list_expirations: sorted list of expirations (datetime.date) for a root."""
    client = _get_v3_client()
    try:
        df = client.option_list_expirations(symbol=root)
    except Exception as e:
        if _v3_empty_or_raise(e):
            return []
    df = _v3_norm_cols(df)
    col = 'expiration' if 'expiration' in df.columns else df.columns[-1]
    return sorted(_v3_parse_exp(df[col]).unique())


def list_strikes_v3(root, exp):
    """v3 version of list_strikes: sorted list of strikes (dollars) for (root, exp).
       root -- ThetaData option root (e.g. 'SPXW', 'NDXP', 'NVDA')
       exp  -- contract expiration as datetime.date"""
    client = _get_v3_client()
    try:
        df = client.option_list_strikes(symbol=root, expiration=exp)
    except Exception as e:
        if _v3_empty_or_raise(e):
            return []
    df = _v3_norm_cols(df)
    col = 'strike' if 'strike' in df.columns else df.columns[-1]
    return sorted(_v3_fix_strike(df[col]).dropna().unique())


def get_bulk_chain_v3(root, exp, trade_date):
    """v3 version of get_bulk_chain: enumerate strikes/rights quoted on trade_date.
       root       -- ThetaData option root
       exp        -- contract expiration as datetime.date
       trade_date -- date we sample chain availability on
       Returns DataFrame with columns [symbol, strike, cp, exp]; empty if no data."""
    client = _get_v3_client()
    empty = pd.DataFrame(columns=['symbol', 'strike', 'cp', 'exp'])
    try:
        df = client.option_list_contracts(request_type='quote', date=trade_date, symbol=root)
    except Exception as e:
        if _v3_empty_or_raise(e):
            return empty
    if df is None or len(df) == 0:
        return empty
    df = _v3_norm_cols(df)
    df['exp'] = _v3_parse_exp(df['expiration'])
    df = df[df['exp'] == exp].copy()
    if df.empty:
        return empty
    df['symbol'] = root
    df['strike'] = _v3_fix_strike(df['strike'])
    df['cp'] = _v3_cp(df['right'])
    return df[['symbol', 'strike', 'cp', 'exp']].drop_duplicates().reset_index(drop=True)


def get_option_quotes_v3(root, strike, cp, exp, trade_date,
                         start_time=None, end_time=None, interval='1s'):
    """v3 version of get_option_quotes: bid/ask bars for one contract on one date.
       root       -- ThetaData option root (e.g. 'SPXW', 'NVDA')
       strike     -- strike in dollars (float), or None/'*' for the whole chain
       cp         -- 'Call', 'Put', or None/'both' for both rights
       exp        -- contract expiration as datetime.date
       trade_date -- trading date to pull (datetime.date); v3 history is single-day
       start_time -- optional intraday start (datetime.time or 'HH:MM:SS')
       end_time   -- optional intraday end (datetime.time or 'HH:MM:SS')
       interval   -- v3 interval string ('1s', '5s', '1m', ...)
       Returns DataFrame with QUOTE_COLS; empty when ThetaData has no data."""
    client = _get_v3_client()
    right = 'both' if cp in (None, 'both') else {'C': 'call', 'P': 'put'}[cp[0].upper()]
    kwargs = dict(symbol=root, expiration=exp, date=trade_date, interval=interval,
                  strike='*' if strike in (None, '*') else _fmt_strike_v3(strike),
                  right=right)
    if start_time is not None:
        kwargs['start_time'] = _fmt_time_for_sql(start_time)
    if end_time is not None:
        kwargs['end_time'] = _fmt_time_for_sql(end_time)
    try:
        df = client.option_history_quote(**kwargs)
    except Exception as e:
        if _v3_empty_or_raise(e):
            return pd.DataFrame(columns=QUOTE_COLS)
    return _v3_quotes_to_canonical(df)


def get_index_price_v3(root, trade_date, start_time=None, end_time=None, interval='1s'):
    """v3 version of get_index_price: index price bars for one date.
       root       -- index symbol (e.g. 'SPX', 'NDX', 'VIX')
       trade_date -- trading date to pull (datetime.date); v3 history is single-day
       start_time -- optional intraday start (datetime.time or 'HH:MM:SS')
       end_time   -- optional intraday end (datetime.time or 'HH:MM:SS')
       interval   -- v3 interval string; '1s' default (v2 tick-level is not exposed here)
       Returns DataFrame with columns [symbol, trade_date, timestmp, price]; empty if no data."""
    client = _get_v3_client()
    cols = ['symbol', 'trade_date', 'timestmp', 'price']
    kwargs = dict(symbol=root, date=trade_date, interval=interval)
    if start_time is not None:
        kwargs['start_time'] = _fmt_time_for_sql(start_time)
    if end_time is not None:
        kwargs['end_time'] = _fmt_time_for_sql(end_time)
    try:
        df = client.index_history_price(**kwargs)
    except Exception as e:
        if _v3_empty_or_raise(e):
            return pd.DataFrame(columns=cols)
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=cols)
    df = _v3_norm_cols(df.copy())
    df = _v3_split_timestamp(df)
    df['symbol'] = root
    return df[cols]


