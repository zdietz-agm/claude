sys.path.insert(0, "D:/PycharmProjects/utils")


def main():
    import pandas as pd
    import bloomberg_helpers as bbg

    targets = ["SKHY", "SPXC", "BE"]
    bench = ["SPY", "QQQ", "SMH"]
    tickers = [f"{t} US Equity" for t in targets + bench]

    end = pd.Timestamp("2026-09-15")
    start = end - pd.Timedelta(days=260)
    df = bbg.my_bdh(tickers, "PX_LAST", start.strftime("%Y-%m-%d"), end.strftime("%Y-%m-%d"),
                    adjust="-", timeout=180)
    df.columns = [c[0].replace(" US Equity", "") for c in df.columns]
    print("first valid date per ticker:")
    print(df.apply(lambda s: s.first_valid_index()).to_string())
    print("non-null counts:")
    print(df.count().to_string())

    rets = df.pct_change()
    out = {}
    for t in targets:
        row = {}
        for b in bench:
            pair = rets[[t, b]].dropna().tail(100)
            row[b] = pair[t].corr(pair[b])
            row[b + "_n"] = len(pair)
        out[t] = row
    res = pd.DataFrame(out).T
    print(res.round(3).to_string())


if __name__ == "__main__":
    main()
