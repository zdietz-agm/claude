    _p = _p.merge(
        _c[["trade_date", "cp", "size"]].rename(columns={"size": "closer_size"}),
        on=["trade_date", "cp"], how="left",
    )
    _p["closer_size"] = _p["closer_size"].fillna(0)
    _hit = _p["closer_size"] > 0
    _new_size = np.maximum(_p["size"] - _p["closer_size"], _min_sz)
    _p.loc[_hit, "original_pnl"] = _p.loc[_hit, "original_pnl"] * _new_size[_hit] / _p.loc[_hit, "size"]
    _p.loc[_hit, "size"] = _new_size[_hit]
    legs_by_strat[_pn] = _p.drop(columns=["closer_size"])
