# Prod (closer_spread_trader.py) partially replaces the parent when its CLOSER fires:
# parent size is decremented by the closer's size, floored at the parent's min_size.
# Mirror that here: on each (trade_date, cp) where the CLOSER leg exists, shrink the
# parent leg and rescale original_pnl pro-rata (PnL is linear in size).
for _pn in PARENT_NAMES:
    _cn = _pn + "_CLOSER"
    if _cn not in legs_by_strat:
