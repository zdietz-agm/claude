    _scan_seconds = np.arange(SCAN_START_SEC, SCAN_END_SEC + 1)


def scan_hack_fill(td, cp, sh, lg):
    """First second in [15:55:03, 16:00:00] where the SLIPPED cross -- (short_ask - long_bid,
    NaN long bid -> 0) plus max(SLIP_FLOOR, SLIP_PCT * cross) fast-market slippage -- is
    <= MAX_HACK_COST. Quotes forward-filled from the last update at or before each second.
    Fill price: at scan start (15:55:03) we take the market and pay the slipped cross. Any
    LATER fill models our resting bid at MAX_HACK_COST getting hit, so it fills at exactly
    MAX_HACK_COST -- never at a lower price the market gapped down to.
    Returns (exit_cost, exit_sec, priced, cross_at_fill): (nan, None, False, nan) if the short
    strike never quotes; (nan, None, True, nan) if priced but never at or under the cap.
    cross_at_fill is the raw (unslipped) displayed cross at the fill second, so
    exit_cost - cross_at_fill is the per-spread slippage paid."""
    sa = _ask_ser.get((td, cp, sh))
    if sa is None:
        return np.nan, None, False, np.nan
    sa_ff = sa.reindex(_scan_seconds, method="ffill").to_numpy(dtype=float)
    lbs = _bid_ser.get((td, cp, lg))
    if lbs is None:
        lb_ff = np.zeros(len(_scan_seconds))
    else:
        lb_ff = np.nan_to_num(lbs.reindex(_scan_seconds, method="ffill").to_numpy(dtype=float), nan=0.0)
    cross = sa_ff - lb_ff
    eff = cross + np.maximum(SLIP_FLOOR, SLIP_PCT * cross)   # achievable price after slippage
    priced = ~np.isnan(eff)
    if not priced.any():
        return np.nan, None, False, np.nan
    ok = priced & (eff <= MAX_HACK_COST + 1e-9)
    if not ok.any():
        return np.nan, None, True, np.nan
    i = int(np.argmax(ok))
    cost = float(eff[i]) if i == 0 else MAX_HACK_COST
    return cost, int(_scan_seconds[i]), True, float(cross[i])


#%% Apply the hack rule
def apply_hack(legs):
    """Adds imbal_350/355, hack_triggered, hack_size (half the leg by default; see FULL_SIZE),
    short_ask/long_bid (15:55:03 snap), hack_exit_cost, hack_exit_time, attempted_hacked,
    hack_filled, slippage_cost, hacked_pnl (always-hack hack_size at the uncapped 15:55:03
    cross, remainder held; reference only), pnl_with_hacking (conditional), delta_pnl.
    All PnL columns are WHOLE-POSITION PnL. Fill rule depends on UNCAPPED (module docstring)."""
    df = legs.copy()
    df["trade_date"] = pd.to_datetime(df["trade_date"]).dt.date
    df["sh_strike"]  = df["sh_strike"].astype(float)
    df["lg_strike"]  = df["lg_strike"].astype(float)
    df = df.merge(imbal_350_df, on="trade_date", how="left")
    df = df.merge(imbal_355_df, on="trade_date", how="left")
    df = df.merge(opra_exits_all, on=["trade_date","cp","sh_strike","lg_strike"], how="left")
    df["hack_triggered"] = (
        ((df["cp"] == "Put")  & (df["imbal_355"] < -THRESHOLD)) |
        ((df["cp"] == "Call") & (df["imbal_355"] >  THRESHOLD))
    )
    # Hack size: prod unwinds HALF the filled size (floor, so 1-lot legs are skipped);
    # --full-size unwinds the whole leg. The unhacked remainder rides to settlement.
    df["hack_size"] = df["size"].astype(float) if FULL_SIZE else np.floor(df["size"].astype(float) / 2)
    hold_frac = (df["size"] - df["hack_size"]) / df["size"]   # settlement fraction (0 in full-size)

    # 15:55:03 snapshot cross = short_ask - long_bid. NaN long_bid -> 0 (long abandoned).
    sa = df["short_ask"]
    lb = df["long_bid"].fillna(0)
    cross_1555 = np.where(pd.isna(sa), np.nan, sa - lb)

    # Reference: whole-position PnL if we ALWAYS hack hack_size at the uncapped 15:55:03 cross
    # (remainder held to settlement). NaN when OPRA missing.
    always_hack_pnl = ((df["credit"] - cross_1555) * df["hack_size"] * MULTIPLIER
                       + df["original_pnl"] * hold_frac)
    df["hacked_pnl"] = np.where(pd.isna(cross_1555), np.nan, always_hack_pnl)

    if UNCAPPED:
        # Legacy: triggered legs always fill at the 15:55:03 cross (no slippage).
        df["hack_exit_cost"] = cross_1555
        fill = df["hack_triggered"] & (~pd.isna(df["hack_exit_cost"])) & (df["hack_size"] >= 1)
        df["hack_exit_time"]   = np.where(fill, EXIT_TIME_TARGET.strftime("%H:%M:%S"), None)
        df["attempted_hacked"] = fill
        df["hack_filled"]      = fill
        df["slippage_cost"]    = np.where(fill, 0.0, np.nan)
    else:
        # Capped: first second in [15:55:03, 16:00:00] with slipped cross <= MAX_HACK_COST.
        costs, times, priced_l, slips = [], [], [], []
        for _, r in df.iterrows():
            if (not r["hack_triggered"] or r["hack_size"] < 1
                    or pd.isna(r["sh_strike"]) or pd.isna(r["lg_strike"])):
                costs.append(np.nan); times.append(None); priced_l.append(False); slips.append(np.nan)
                continue
            c, t_sec, priced, raw_cross = scan_hack_fill(r["trade_date"], r["cp"],
                                                         float(r["sh_strike"]), float(r["lg_strike"]))
            costs.append(c)
            times.append(None if t_sec is None else
                         f"{t_sec//3600:02d}:{(t_sec%3600)//60:02d}:{t_sec%60:02d}")
            priced_l.append(priced)
            # Slippage paid = (fill price - raw displayed cross at fill time) on the hacked size.
            slips.append(np.nan if pd.isna(c) else (c - raw_cross) * r["hack_size"] * MULTIPLIER)
        df["hack_exit_cost"]   = costs
        df["hack_exit_time"]   = times
        df["attempted_hacked"] = df["hack_triggered"] & pd.Series(priced_l, index=df.index)
        df["hack_filled"]      = df["attempted_hacked"] & (~pd.isna(df["hack_exit_cost"]))
        df["slippage_cost"]    = slips

    fill_pnl = ((df["credit"] - df["hack_exit_cost"]) * df["hack_size"] * MULTIPLIER
                + df["original_pnl"] * hold_frac)
    df["pnl_with_hacking"] = np.where(df["hack_filled"], fill_pnl, df["original_pnl"])

    # Strategy delta = conditional-hack PnL vs never-hack baseline
    df["delta_pnl"] = df["pnl_with_hacking"] - df["original_pnl"]
    return df


