def find_config_exact(configs, name):
    """Exact (case-insensitive) config-name match; falls back to find_config's substring
    behavior. Needed because parent names can be substrings of each other (e.g. the base
    SPREAD_SALES_SPX config vs all its variants)."""
    exact = [c for c in configs if c["name"].upper() == name.upper()]
    return exact[0] if exact else find_config(configs, name)


def build_parent_legs(strat_name, combined):
    """Run apply_config for parent strategy, expand per-day result into one row per traded side (put/call)."""
    cfg = find_config_exact(configs_all, strat_name)
    if cfg is None:
        raise ValueError(f"Config not found: {strat_name}")
    r = apply_config(combined, cfg)
    r = r[(r["put_size"] > 0) | (r["call_size"] > 0)].copy()
    rows = []
    for _, row in r.iterrows():
        if row["put_size"] > 0:
            # When put trades, put strikes are always primary (cp in {'P','P+C'})
            rows.append({
                "trade_date": row["trade_date"], "cp": "Put",
                "sh_strike": row["sh_strike"], "lg_strike": row["lg_strike"],
                "size": row["put_size"], "credit": row["put_price"],
                "idx_close": row["idx_close"], "original_pnl": row["put_pnl"],
            })
        if row["call_size"] > 0:
            # cp == 'P+C' -> call is secondary; cp == 'C' -> call is primary
            if row["cp"] == "P+C":
                c_sh, c_lg = row["sh_strike_2"], row["lg_strike_2"]
            else:
                c_sh, c_lg = row["sh_strike"], row["lg_strike"]
            rows.append({
                "trade_date": row["trade_date"], "cp": "Call",
                "sh_strike": c_sh, "lg_strike": c_lg,
                "size": row["call_size"], "credit": row["call_price"],
                "idx_close": row["idx_close"], "original_pnl": row["call_pnl"],
            })
    out = pd.DataFrame(rows, columns=None if rows else
                       ["trade_date","cp","sh_strike","lg_strike","size","credit","idx_close","original_pnl"])
    if len(out):
        out["trade_date"] = pd.to_datetime(out["trade_date"]).dt.date
        out["sh_strike"]  = out["sh_strike"].astype(float)
        out["lg_strike"]  = out["lg_strike"].astype(float)
    return out


def _pick_closer_short_strike(spot, cp_label, chain_strikes):
    if cp_label == "Put":
        candidates = [s for s in chain_strikes if (spot - MAX_OTM_DIST) <= s <= (spot + MAX_ITM_DIST + FP_EPS)]
    else:
        candidates = [s for s in chain_strikes if (spot - MAX_ITM_DIST - FP_EPS) <= s <= (spot + MAX_OTM_DIST)]
    if not candidates:
        return None
    return min(candidates, key=lambda s: abs(s - spot))


def build_closer_legs(strat_name_closer, combined):
    """Replicate closer_strike_backtest.py logic. Returns per-leg rows with CLOSER's own PnL only."""
    parent_name = strat_name_closer.replace("_CLOSER", "")
    cfg_base = find_config_exact(configs_all, parent_name)
    if cfg_base is None:
        raise ValueError(f"Parent config not found: {parent_name}")
    r_base = apply_config(combined, cfg_base)

    cl_cfg = CLOSER_CONFIGS[parent_name]
    ratio = cl_cfg["ratio_to_parent"]
    closer_dollar_target = cfg_base["dollar_target"] * ratio
    closer_max_size      = max(1, math.ceil(cfg_base["max_size"] * ratio))
    closer_min_size      = cfg_base.get("min_size") or 1

    sig_cols = [c for c in [
        "spy_market_ratio 350PM", "350pm_imbal 350PM", "340pm_imbal 350PM",
        "qqq_350pm_imbal 350PM", "spy_paired_imbal_recreated 350PM", "factor_is_serial",
    ] if c in combined.columns]
    sigs = combined[["trade_date"] + sig_cols].drop_duplicates("trade_date")
    merged = r_base.merge(sigs, on="trade_date", how="left")

    rows = []
    for _, row in merged.iterrows():
        td = row["trade_date"]
        spot = row["idx_at_trade"]
        idx_close = row["idx_close"]
        raw_signals = {
            "market_ratio":                     row.get("spy_market_ratio 350PM", 0),
            "imbal_350":                        row.get("350pm_imbal 350PM", 0),
            "imbal_340":                        row.get("340pm_imbal 350PM", 0),
            "qqq_350pm_imbal 350PM":            row.get("qqq_350pm_imbal 350PM", 0),
            "spy_paired_imbal_recreated 350PM": row.get("spy_paired_imbal_recreated 350PM", 0),
            "factor_is_serial":                 row.get("factor_is_serial", 0),
        }
        for cp_label, side_lower, cp_letter in [("Put", "put", "P"), ("Call", "call", "C")]:
            base_size = row.get(f"{side_lower}_size", 0) or 0
            base_price = row.get(f"{side_lower}_price", 0) or 0
            if base_size <= 0:
                continue
            if base_price > MAX_BASE_PRICE:
                continue
            try:
                ok = bool(cl_cfg["well_within"][side_lower](raw_signals))
            except Exception:
                ok = False
            if not ok:
                continue
            try:
                chain = opra_lookup.loc[(td, cp_letter)]
            except KeyError:
                continue
            if isinstance(chain, pd.Series):
                continue
            chain_strikes = chain.index.tolist()
            closer_short = _pick_closer_short_strike(spot, cp_label, chain_strikes)
            if closer_short is None:
                continue
            closer_long = (closer_short - SPREAD_WIDTH) if cp_label == "Put" else (closer_short + SPREAD_WIDTH)
            if closer_long not in chain_strikes:
                continue
            sh_bid = chain.loc[closer_short, "bid"]
            lg_ask = chain.loc[closer_long, "ask"]
            if pd.isna(sh_bid) or pd.isna(lg_ask):
                continue
            credit = sh_bid - lg_ask
            if credit <= 0:
                credit = 0.05
            size = min(math.ceil(closer_dollar_target / (credit * MULTIPLIER)), closer_max_size)
            size = max(size, closer_min_size)
            if size <= 0:
                continue
            # CLOSER's own PnL at settlement
            if cp_label == "Put":
                short_intrinsic = max(closer_short - idx_close, 0)
                long_intrinsic  = max(closer_long  - idx_close, 0)
            else:
                short_intrinsic = max(idx_close - closer_short, 0)
                long_intrinsic  = max(idx_close - closer_long,  0)
            per_share = max(credit - (short_intrinsic - long_intrinsic), credit - SPREAD_WIDTH)
            pnl = per_share * size * MULTIPLIER
            rows.append({
                "trade_date": td, "cp": cp_label,
                "sh_strike": closer_short, "lg_strike": closer_long,
                "size": size, "credit": credit,
                "idx_close": idx_close, "original_pnl": pnl,
            })
    out = pd.DataFrame(rows, columns=None if rows else
                       ["trade_date","cp","sh_strike","lg_strike","size","credit","idx_close","original_pnl"])
    if len(out):
        out["trade_date"] = pd.to_datetime(out["trade_date"]).dt.date
        out["sh_strike"]  = out["sh_strike"].astype(float)
        out["lg_strike"]  = out["lg_strike"].astype(float)
    return out


def build_bumped_legs(strat_name_bumped, combined):
    """Replicate bumped_spread_backtest.py logic: on days the parent's traded side was 1-lot
    (min_size), sell a bumped spread (short 1 index closer to ATM, $15-wide, prod bumped
    sizing, atmVol < 0.14 filter). Returns per-leg rows with the BUMP's own settlement PnL."""
    parent_name = strat_name_bumped.replace("_BUMP", "")
    cfg = find_config_exact(configs_all, parent_name)
    if cfg is None:
        raise ValueError(f"Parent config not found: {parent_name}")
    r_orig = apply_config(combined, cfg)
    min_sz = cfg.get("min_size", 1)

    # Build bumped config exactly as bumped_spread_backtest.py does
    sizing = BUMPED_PARENT_CONFIGS[parent_name]
    bumped = {**cfg, "name": cfg["name"] + " BUMP",
              "min_strike_distance": max(0, cfg.get("min_strike_distance", 0) - BUMPED_BUMP_STEP),
              "dollar_target": sizing["dollar_target"], "max_size": sizing["max_size"]}
    for key in ["short_put_strikes", "short_call_strikes"]:
        if key in bumped and bumped[key]:
            bumped[key] = [max(0, idx - 1) for idx in bumped[key]]
    spread_offset = BUMPED_SPREAD_WIDTH // STRIKE_STEP  # 15/5 = 3 indices
    for short_key, long_key in [("short_put_strikes", "long_put_strikes"),
                                ("short_call_strikes", "long_call_strikes")]:
        if short_key in bumped and bumped[short_key] and long_key in bumped:
            bumped[long_key] = [s + spread_offset for s in bumped[short_key]]
    r_bump = apply_config(combined, bumped)

    vol_by_date = (combined[["trade_date", "atmVol 350PM"]]
                   .drop_duplicates("trade_date")
                   .set_index("trade_date")["atmVol 350PM"])

    # Days/sides CLOSER took -- prod suppresses bumped on these (closer_applied).
    closer_keys = (closer_fired_keys(parent_name, r_orig, combined, opra_lookup)
                   if RESPECT_CLOSER_PRECEDENCE else set())
    n_suppressed = 0

    rows = []
    for _, orig_row in r_orig.iterrows():
        orig_put_1lot  = orig_row["put_size"]  == min_sz and orig_row["put_size"]  > 0
        orig_call_1lot = orig_row["call_size"] == min_sz and orig_row["call_size"] > 0
        if not orig_put_1lot and not orig_call_1lot:
            continue
        td = orig_row["trade_date"]
        # atmVol filter (NaN vol -> excluded, matching bumped_spread_backtest's < comparison)
        if BUMPED_MAX_ATM_VOL is not None and not (vol_by_date.get(td, np.nan) < BUMPED_MAX_ATM_VOL):
            continue
        bump_match = r_bump[r_bump["trade_date"] == td]
        if bump_match.empty:
            continue
        bump_row = bump_match.iloc[0]
        td_key = pd.Timestamp(td).date()
        if orig_put_1lot and (td_key, "Put") in closer_keys:
            orig_put_1lot = False
            n_suppressed += 1
        if orig_call_1lot and (td_key, "Call") in closer_keys:
            orig_call_1lot = False
            n_suppressed += 1
        if orig_put_1lot and bump_row["put_size"] > 0:
            # When put trades, put strikes are always primary (cp in {'P','P+C'})
            rows.append({
                "trade_date": td, "cp": "Put",
                "sh_strike": bump_row["sh_strike"], "lg_strike": bump_row["lg_strike"],
                "size": bump_row["put_size"], "credit": bump_row["put_price"],
                "idx_close": bump_row["idx_close"], "original_pnl": bump_row["put_pnl"],
            })
        if orig_call_1lot and bump_row["call_size"] > 0:
            if bump_row["cp"] == "P+C":
                c_sh, c_lg = bump_row["sh_strike_2"], bump_row["lg_strike_2"]
            else:
                c_sh, c_lg = bump_row["sh_strike"], bump_row["lg_strike"]
            rows.append({
                "trade_date": td, "cp": "Call",
                "sh_strike": c_sh, "lg_strike": c_lg,
                "size": bump_row["call_size"], "credit": bump_row["call_price"],
                "idx_close": bump_row["idx_close"], "original_pnl": bump_row["call_pnl"],
            })
    if n_suppressed:
        print(f"    [closer precedence] {parent_name.split('SPX_')[-1]}: {n_suppressed} bumped leg(s) suppressed (CLOSER took the day)")
    out = pd.DataFrame(rows, columns=None if rows else
                       ["trade_date","cp","sh_strike","lg_strike","size","credit","idx_close","original_pnl"])
    if len(out):
        out["trade_date"] = pd.to_datetime(out["trade_date"]).dt.date
