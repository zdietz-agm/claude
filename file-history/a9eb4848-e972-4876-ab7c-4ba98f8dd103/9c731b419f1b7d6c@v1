    # --- Number formatting on Summary sheet ---
    def _apply_fmt(sheet, header_row, df_local, dollar_set, dollar2_set=None):
        """Apply dollar/sharpe/pct formats to data rows below a header row."""
        for i, col in enumerate(df_local.columns, 1):
            fmt = None
            if col in dollar_set:
                fmt = "_($* #,##0_);[Red]_($* (#,##0)"
            elif dollar2_set and col in dollar2_set:
                fmt = "_($* #,##0.00_);[Red]_($* (#,##0.00)"
            elif isinstance(col, str) and col.startswith("Sharpe"):
                fmt = "0.00"
            if fmt:
                letter = get_column_letter(i)
                for r in range(header_row + 1, header_row + 1 + len(df_local)):
                    sheet[f"{letter}{r}"].number_format = fmt

    _apply_fmt(ws, header_row=1,        df_local=summary_df, dollar_set=dollar_cols_in_summary)
    _apply_fmt(ws, header_row=n1 + 2,   df_local=top10,      dollar_set=dollar_cols_in_hackday)
    _apply_fmt(ws, header_row=n2 + 2,   df_local=bot10,      dollar_set=dollar_cols_in_hackday)

    # --- Strategy detail sheets ---
    for sh, df in detail_sheets.items():
        df.to_excel(writer, sheet_name=sh, index=False)
        ws2 = wb[sh]
        ws2.auto_filter.ref = ws2.dimensions
        ws2.freeze_panes    = "C2"   # freeze trade_date + cp
        for i, col in enumerate(df.columns, 1):
            letter = get_column_letter(i)
            width = max(12, min(28, int(df[col].astype(str).map(len).max()) if len(df) else 12))
            ws2.column_dimensions[letter].width = width
            fmt = None
            if col in dollar_cols_in_detail:
                fmt = "_($* #,##0_);[Red]_($* (#,##0)"
            elif col in dollar2_cols_in_detail:
                fmt = "_($* #,##0.00_);[Red]_($* (#,##0.00)"
            if fmt:
                for row in range(2, len(df) + 2):
                    ws2[f"{letter}{row}"].number_format = fmt

print(f"\nSaved: {filepath}")
