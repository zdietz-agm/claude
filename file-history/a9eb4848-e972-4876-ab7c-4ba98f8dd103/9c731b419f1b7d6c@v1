def _ts_to_sec(x):
    """timestmp (timedelta or string) -> integer seconds since midnight."""
    if isinstance(x, dt.timedelta):
        return int(x.total_seconds())
    t = pd.to_datetime(str(x)).time()
    return t.hour*3600 + t.minute*60 + t.second


def get_opra_window_quotes(legs_all_strats, wide_dates):
    """Pull per-second OPRA quotes for every leg strike. Window per date: 15:54:30-15:55:30
    (legacy snap window), extended to 16:00:00 on wide_dates (flip-eligible dates that need
    the capped-mode per-second scan). Returns tidy df: trade_date, cp, strike, t_sec, bid, ask."""
    if legs_all_strats.empty:
        return pd.DataFrame(columns=["trade_date","cp","strike","t_sec","bid","ask"])

    # Build (date, cp_full, strike) probe set covering both legs.
    # t_opra_quotes.cp stores full words ('Put'/'Call') -- use those, NOT first-char.
    probes = set()
    for _, r in legs_all_strats.iterrows():
        if pd.isna(r["sh_strike"]) or pd.isna(r["lg_strike"]):
            continue
        cp_full = r["cp"]
        probes.add((r["trade_date"], cp_full, float(r["sh_strike"])))
        probes.add((r["trade_date"], cp_full, float(r["lg_strike"])))

    dates_needed = sorted({d for d, _, _ in probes})
    n_wide = sum(1 for d in dates_needed if d in wide_dates)
    print(f"  Pulling OPRA quotes for {len(dates_needed)} dates ({n_wide} wide-window), {len(probes)} (date,cp,strike) probes...")
    eng = get_options_engine()

    quotes_frames = []
    for i, d in enumerate(dates_needed):
        date_probes = [(cp, s) for dd, cp, s in probes if dd == d]
        # Build a strike-list filter for this date (cast to nearest int via *1000 to dodge float-match issues)
        strikes_x1000 = sorted({int(round(s * 1000)) for _, s in date_probes})
        strikes_str   = ",".join(str(x) for x in strikes_x1000)
        hi = "16:00:00" if d in wide_dates else SNAP_WIN_HI
        sql = text(f"""
            SELECT trade_date, strike, cp, bidPrc AS bid, askPrc AS ask, timestmp
            FROM optionsResearch.t_opra_quotes
            WHERE symbol = :sym
              AND trade_date = :td
              AND exp = :td
              AND ROUND(strike * 1000) IN ({strikes_str})
              AND timestmp >= '{SNAP_WIN_LO}'
              AND timestmp <= '{hi}'
        """)
        df = pd.read_sql_query(sql, eng, params={"sym": SYMBOL, "td": d.strftime('%Y-%m-%d')})
        if len(df):
            quotes_frames.append(df)
        if (i + 1) % 50 == 0:
            print(f"    {i+1}/{len(dates_needed)} dates fetched")
    eng.dispose()
    if not quotes_frames:
        return pd.DataFrame(columns=["trade_date","cp","strike","t_sec","bid","ask"])

    q = pd.concat(quotes_frames, ignore_index=True)
    q["trade_date"] = pd.to_datetime(q["trade_date"]).dt.date
    q["t_sec"]  = q["timestmp"].apply(_ts_to_sec)
    q["strike"] = q["strike"].astype(float)
    q["bid"]    = q["bid"].astype(float)
    q["ask"]    = q["ask"].astype(float)
    # One row per (date, cp, strike, second)
    q = (q.sort_values(["trade_date","cp","strike","t_sec"])
          .drop_duplicates(["trade_date","cp","strike","t_sec"], keep="first")
          [["trade_date","cp","strike","t_sec","bid","ask"]]
          .reset_index(drop=True))
    return q


def snap_exits(q, legs_all_strats):
    """Legacy 15:55:03 snapshot: per leg, short_ask + long_bid from the quote row closest to
    EXIT_TIME_TARGET within the 15:54:30-15:55:30 window (same pick as the original script)."""
    empty = pd.DataFrame(columns=["trade_date","cp","sh_strike","lg_strike","short_ask","long_bid"])
    if q.empty or legs_all_strats.empty:
        return empty

    qq = q[q["t_sec"] <= SNAP_WIN_HI_SEC].copy()
    qq["abs_dt"] = (qq["t_sec"] - SCAN_START_SEC).abs()
    picked = qq.sort_values(["trade_date","cp","strike","abs_dt"]).drop_duplicates(["trade_date","cp","strike"], keep="first")

    bid_lookup = picked.set_index(["trade_date","cp","strike"])["bid"]
    ask_lookup = picked.set_index(["trade_date","cp","strike"])["ask"]

    out_rows = []
    seen = set()
    for _, r in legs_all_strats.iterrows():
        key = (r["trade_date"], r["cp"], r["sh_strike"], r["lg_strike"])
        if key in seen:
            continue
        seen.add(key)
        if pd.isna(r["sh_strike"]) or pd.isna(r["lg_strike"]):
            out_rows.append({"trade_date": r["trade_date"], "cp": r["cp"],
                             "sh_strike": r["sh_strike"], "lg_strike": r["lg_strike"],
                             "short_ask": np.nan, "long_bid": np.nan})
            continue
        cp_full = r["cp"]  # 'Put' or 'Call' -- matches t_opra_quotes.cp
        sh = float(r["sh_strike"]); lg = float(r["lg_strike"])
        try:
            sa = ask_lookup.loc[(r["trade_date"], cp_full, sh)]
            sa = float(sa.iloc[0]) if hasattr(sa, "iloc") else float(sa)
        except KeyError:
            sa = np.nan
        try:
            lb = bid_lookup.loc[(r["trade_date"], cp_full, lg)]
            lb = float(lb.iloc[0]) if hasattr(lb, "iloc") else float(lb)
        except KeyError:
            lb = np.nan
        out_rows.append({"trade_date": r["trade_date"], "cp": r["cp"],
                         "sh_strike": sh, "lg_strike": lg,
                         "short_ask": sa, "long_bid": lb})
    return pd.DataFrame(out_rows)


