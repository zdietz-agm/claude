| CRH    | 2025-12-10 | +121.3 | +68.8  | +52.5  |
| APP    | 2025-09-17 | +164.8 | -7.2   | +171.9 |
| HOOD   | 2025-09-17 | +86.7  | -7.2   | +93.9  |
| DASH   | 2025-03-19 | +114.6 | +70.1  | +44.5  |
| APO    | 2024-12-18 | -519.5 | -318.1 | -201.4 |
| WDAY   | 2024-12-18 | -366.5 | -318.1 | -48.4  |
| PLTR   | 2024-09-18 | +2.7   | -31.1  | +33.8  |
| DELL   | 2024-09-18 | -93.9  | -31.1  | -62.9  |
